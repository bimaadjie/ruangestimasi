{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile in RuangRAB",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "fullName": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "userType": {
          "type": "string",
          "enum": ["Student", "Estimator", "Other"],
          "description": "Account category (Student, Estimator, or Other)"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "userType", "createdAt", "updatedAt"]
    },
    "ProjectDocument": {
      "title": "ProjectDocument",
      "description": "Construction Quantity Takeoff project owned by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "floorCount": { "type": "number" },
        "floors": { "type": "array" },
        "works": { "type": "array" },
        "rejectedDraftKeys": { "type": "array" },
        "catalogVersion": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerUid", "name", "floorCount", "floors", "works", "catalogVersion", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectDocument" },
      "description": "User-isolated construction projects"
    }
  }
}
