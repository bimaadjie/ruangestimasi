            lines {
              text: "      { id: \'luas_keramik_toilet\', name: \'luas_keramik_toilet\', label: \'Pengurangan Area Keramik Dinding\', placeholder: \'Masukkan luas keramik dinding (m\302\262)\', value: null, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
