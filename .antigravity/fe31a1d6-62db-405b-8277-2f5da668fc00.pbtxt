    content: "import React, { useState, useEffect } from \'react\';\nimport {\n  X,\n  Check,\n  Calculator,\n  Info,\n  Save,\n  Sparkles,\n  AlertTriangle,\n  FileText,\n  CheckCircle2,\n} from \'lucide-react\';\nimport { ProjectWorkItem, ParameterItem } from \'../types\';\nimport { formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface WorkDetailModalProps {\n  isOpen: boolean;\n  work: ProjectWorkItem | null;\n  floorName?: string;\n  onClose: () => void;\n  onSaveWork: (updatedWork: ProjectWorkItem) => void;\n}\n\nexport const WorkDetailModal: React.FC<WorkDetailModalProps> = ({\n  isOpen,\n  work,\n  floorName,\n  onClose,\n  onSaveWork,\n}) => {\n  if (!isOpen || !work) return null;\n\n  const [localParams, setLocalParams] = useState<ParameterItem[]>([]);\n  const [activeTab, setActiveTab] = useState<\'params\' | \'formula\' | \'source\'>(\'params\');\n\n  useEffect(() => {\n    if (work) {\n      setLocalParams(JSON.parse(JSON.stringify(work.parameters || [])));\n    }\n  }, [work]);\n\n  const handleParamChange = (id: string, newVal: string) => {\n    const num = newVal === \'\' ? null : Number(newVal);\n    setLocalParams((prev) =>\n      prev.map((p) =>\n        p.id === id\n          ? {\n              ...p,\n              value: isNaN(num as number) ? newVal : num,\n              source: \'manual\',\n              isVerified: true,\n              conflict: null,\n            }\n          : p\n      )\n    );\n  };\n\n  const handleResolveConflict = (paramId: string, useNewValue: boolean) => {\n    setLocalParams((prev) =>\n      prev.map((p) => {\n        if (p.id !== paramId || !p.conflict) return p;\n        if (useNewValue) {\n          return {\n            ...p,\n            value: p.conflict.newValue,\n            rawExtractedValue: p.conflict.rawExtractedValue,\n            rawUnit: p.conflict.rawUnit,\n            sourceDocument: p.conflict.sourceDocument,\n            pageOrLocation: p.conflict.pageOrLocation,\n            source: \'ai\',\n            isVerified: true,\n            conflict: null,\n          };\n        }\n        return {\n          ...p,\n          isVerified: true,\n          conflict: null,\n        };\n      })\n    );\n  };\n\n  const handleSave = (approveAiDraft: boolean = false) => {\n    const updatedParams = localParams.map((p) => ({\n      ...p,\n      isVerified: approveAiDraft ? true : p.isVerified,\n      conflict: approveAiDraft ? null : p.conflict,\n    }));\n\n    const updated: ProjectWorkItem = {\n      ...work,\n      parameters: updatedParams,\n      aiVerificationStatus: approveAiDraft ? \'verified\' : work.aiVerificationStatus,\n      lastUpdated: new Date().toISOString(),\n    };\n    onSaveWork(updated);\n    onClose();\n  };\n\n  const isAiDraft = work.origin === \'ai\' && work.aiVerificationStatus === \'draft\';\n  const hasMissingRequired = localParams.some(\n    (p) => p.required && (p.value === null || p.value === \'\' || isNaN(Number(p.value)))\n  );\n\n  // Bangun substitusi rumus contoh\n  const substitutionParts = localParams\n    .filter((p) => p.value !== null && p.value !== \'\')\n    .map((p) => `${p.label || p.name}: ${p.value} ${p.unit}`);\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold\">\n              <Calculator className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-sm font-bold text-slate-900\">{work.name}</h3>\n                {isAiDraft && (\n                  <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-100 text-blue-800\">\n                    <Sparkles className=\"w-2.5 h-2.5\" />\n                    Draf AI\n                  </span>\n                )}\n              </div>\n              <p className=\"text-xs text-slate-500\">\n                {work.category} \302\267 {floorName || work.floorId}\n                {work.elementLocation ? ` \302\267 Lokasi: ${work.elementLocation}` : \'\'}\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/50 transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Modal Tabs */}\n        <div className=\"flex items-center px-6 border-b border-slate-100 text-xs font-semibold gap-6\">\n          <button\n            onClick={() => setActiveTab(\'params\')}\n            className={`py-3 border-b-2 transition ${\n              activeTab === \'params\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Parameter Input\n          </button>\n          <button\n            onClick={() => setActiveTab(\'formula\')}\n            className={`py-3 border-b-2 transition ${\n              activeTab === \'formula\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Rumus &amp; Substitusi\n          </button>\n          <button\n            onClick={() => setActiveTab(\'source\')}\n            className={`py-3 border-b-2 transition ${\n              activeTab === \'source\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Sumber &amp; Verifikasi\n          </button>\n        </div>\n\n        {/* Content Area */}\n        <div className=\"p-6 max-h-[62vh] overflow-y-auto space-y-4\">\n          {activeTab === \'params\' && (\n            <div className=\"space-y-3.5\">\n              <div className=\"flex items-center justify-between text-xs text-slate-500 pb-1\">\n                <span>Sesuaikan parameter dimensi untuk menghitung ulang volume:</span>\n                <span className=\"font-semibold text-blue-600\">Satuan Akhir: {work.unit}</span>\n              </div>\n\n              {localParams.map((param) => {\n                const isEmptyRequired =\n                  param.required && (param.value === null || param.value === \'\');\n                return (\n                  <div\n                    key={param.id}\n                    className={`p-3.5 rounded-xl border transition ${\n                      param.conflict\n                        ? \'bg-rose-50/60 border-rose-300\'\n                        : isEmptyRequired\n                        ? \'bg-amber-50/50 border-amber-300\'\n                        : \'bg-slate-50/70 border-slate-200/80\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between gap-4\">\n                      <div className=\"min-w-0\">\n                        <label className=\"text-xs font-bold text-slate-800 block truncate\">\n                          {param.label || param.name}\n                          {param.required && <span className=\"text-rose-500 ml-1\">*</span>}\n                        </label>\n                        <div className=\"flex flex-wrap items-center gap-1.5 mt-1\">\n                          {param.source === \'ai\' ? (\n                            <span className=\"inline-flex items-center gap-1 text-[10px] font-medium text-blue-700 bg-blue-100/80 px-1.5 py-0.5 rounded\">\n                              <Sparkles className=\"w-2.5 h-2.5\" />\n                              Ekstraksi AI\n                              {param.rawExtractedValue !== undefined && param.rawUnit\n                                ? ` (${param.rawExtractedValue} ${param.rawUnit})`\n                                : \'\'}\n                            </span>\n                          ) : param.source === \'derived\' ? (\n                            <span className=\"text-[10px] font-medium text-indigo-700 bg-indigo-50 px-1.5 py-0.5 rounded\">\n                              Turunan Otomatis\n                            </span>\n                          ) : param.value !== null && param.value !== \'\' ? (\n                            <span className=\"text-[10px] text-slate-500 bg-slate-200/70 px-1.5 py-0.5 rounded\">\n                              Input Manual\n                            </span>\n                          ) : (\n                            <span className=\"text-[10px] font-semibold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded\">\n                              Belum Diisi \342\200\224 Mohon lengkapi manual atau dari gambar potongan\n                            </span>\n                          )}\n\n                          {param.pageOrLocation && (\n                            <span className=\"text-[10px] text-slate-500\">\n                              \302\267 {param.pageOrLocation}\n                            </span>\n                          )}\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center gap-2 shrink-0\">\n                        <input\n                          type=\"number\"\n                          step=\"any\"\n                          placeholder=\"Belum diisi\"\n                          value={param.value ?? \'\'}\n                          onChange={(e) => handleParamChange(param.id, e.target.value)}\n                          className={`w-32 px-3 py-1.5 text-xs text-right font-mono font-bold bg-white border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition ${\n                            isEmptyRequired ? \'border-amber-400\' : \'border-slate-300\'\n                          }`}\n                        />\n                        <span className=\"text-xs font-semibold text-slate-600 w-8\">\n                          {param.unit}\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Conflict Resolution Box if another drawing has a different value */}\n                    {param.conflict && (\n                      <div className=\"mt-3 pt-2.5 border-t border-rose-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px]\">\n                        <div className=\"flex items-start gap-1.5 text-rose-800\">\n                          <AlertTriangle className=\"w-3.5 h-3.5 text-rose-600 shrink-0 mt-0.5\" />\n                          <span>\n                            Gambar <strong>{param.conflict.sourceDocument}</strong> mencantumkan nilai berbeda:{\' \'}\n                            <strong>\n                              {param.conflict.newValue} {param.unit}\n                            </strong>{\' \'}\n                            (tertulis {param.conflict.rawExtractedValue} {param.conflict.rawUnit})\n                          </span>\n                        </div>\n                        <div className=\"flex items-center gap-1.5 shrink-0\">\n                          <button\n                            type=\"button\"\n                            onClick={() => handleResolveConflict(param.id, false)}\n                            className=\"px-2.5 py-1 rounded bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 font-semibold transition\"\n                          >\n                            Pakai Lama ({param.value})\n                          </button>\n                          <button\n                            type=\"button\"\n                            onClick={() => handleResolveConflict(param.id, true)}\n                            className=\"px-2.5 py-1 rounded bg-blue-600 text-white hover:bg-blue-700 font-semibold transition\"\n                          >\n                            Pakai Baru ({param.conflict.newValue})\n                          </button>\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          )}\n\n          {activeTab === \'formula\' && (\n            <div className=\"space-y-4 text-xs\">\n              <div className=\"p-4 bg-blue-50/60 rounded-xl border border-blue-100\">\n                <span className=\"text-[11px] font-bold text-blue-800 uppercase tracking-wider block mb-1\">\n                  Rumus Perhitungan Volume\n                </span>\n                <p className=\"text-sm font-bold text-blue-950 font-mono\">\n                  {work.formulaDisplay || \'V = perkalian parameter\'}\n                </p>\n              </div>\n\n              <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n                <span className=\"text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-1\">\n                  Substitusi Nilai Parameter\n                </span>\n                <p className=\"font-mono text-slate-800 leading-relaxed\">\n                  {substitutionParts.length > 0\n                    ? substitutionParts.join(\' ; \')\n                    : \'Belum ada parameter yang diinput.\'}\n                </p>\n              </div>\n\n              <div className=\"p-4 bg-emerald-50/70 rounded-xl border border-emerald-200 flex items-center justify-between\">\n                <div>\n                  <span className=\"text-[11px] font-bold text-emerald-800 uppercase tracking-wider block\">\n                    Volume Terhitung Saat Ini\n                  </span>\n                  <span className=\"text-xl font-bold text-emerald-950 font-mono\">\n                    {work.calculatedVolume !== null\n                      ? `${formatIndonesianNumber(work.calculatedVolume)} ${work.unit}`\n                      : \'Menunggu parameter lengkap\'}\n                  </span>\n                </div>\n                <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800\">\n                  {work.status}\n                </span>\n              </div>\n            </div>\n          )}\n\n          {activeTab === \'source\' && (\n            <div className=\"space-y-3.5 text-xs\">\n              <div className=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                <div className=\"flex items-center justify-between mb-1\">\n                  <span className=\"font-bold text-slate-800\">Asal Pekerjaan</span>\n                  <span className=\"font-semibold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded border border-blue-100\">\n                    {work.origin === \'ai\' ? \'Otomatis dari Analisis Gambar AI\' : \'Input / Katalog Proyek\'}\n                  </span>\n                </div>\n                {work.sourceDocument && (\n                  <p className=\"text-slate-600 text-[11px] flex items-center gap-1.5 mt-1\">\n                    <FileText className=\"w-3.5 h-3.5 text-blue-600\" />\n                    Dokumen Sumber: <strong>{work.sourceDocument}</strong>\n                  </p>\n                )}\n                {work.identificationReason && (\n                  <p className=\"text-slate-500 text-[11px] mt-1\">\n                    Alasan Identifikasi: {work.identificationReason}\n                  </p>\n                )}\n              </div>\n\n              <div className=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                <span className=\"text-slate-500 block mb-1\">Status Verifikasi Estimator</span>\n                <span className=\"font-bold text-slate-900 block text-sm\">\n                  {isAiDraft\n                    ? \'Draf AI \342\200\224 Menunggu Persetujuan Pengguna\'\n                    : \'Terverifikasi (Masuk ke Rekap Volume Final)\'}\n                </span>\n              </div>\n\n              {work.statusMessage && (\n                <div className=\"p-3.5 bg-amber-50/70 rounded-xl border border-amber-200/80 text-amber-900 text-xs\">\n                  <div className=\"flex items-start gap-2\">\n                    <Info className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n                    <p>{work.statusMessage}</p>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 bg-slate-50/40\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition\"\n          >\n            Batal\n          </button>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => handleSave(false)}\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-lg transition shadow-2xs\"\n            >\n              <Save className=\"w-3.5 h-3.5 text-blue-600\" />\n              <span>Simpan Parameter</span>\n            </button>\n\n            {isAiDraft && !hasMissingRequired && (\n              <button\n                onClick={() => handleSave(true)}\n                className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition shadow-xs\"\n              >\n                <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                <span>Simpan &amp; Setujui Draf AI</span>\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n"
    num_lines: 410
    num_bytes: 17561
    line_range_bytes: 17561
  }
}
