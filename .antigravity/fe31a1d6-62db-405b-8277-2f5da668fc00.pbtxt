      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add mobile hamburger button and desktop sidebar toggle button to Header.tsx\", \"EndLine\":115, \"Instruction\":\"Update /src/components/Header.tsx with mobile menu button and sidebar collapse button\", \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport {\\n  Building2,\\n  Layers,\\n  Calendar,\\n  Pencil,\\n  Check,\\n  Plus,\\n  Save,\\n  Download,\\n  Bell,\\n  Menu,\\n  PanelLeftClose,\\n  PanelLeftOpen,\\n} from \'lucide-react\';\\nimport { ProjectData } from \'../types\';\\n\\ninterface HeaderProps {\\n  project: ProjectData;\\n  onUpdateProjectName: (newName: string) => void;\\n  onOpenFloors: () => void;\\n  onNewProject: () => void;\\n  onSaveProject: () => void;\\n  onExportExcel: () => void;\\n  onOpenMobileMenu: () => void;\\n  isSidebarCollapsed?: boolean;\\n  onToggleSidebarCollapse?: () => void;\\n  isSaving?: boolean;\\n}\\n\\nexport const Header: React.FC<HeaderProps> = ({\\n  project,\\n  onUpdateProjectName,\\n  onOpenFloors,\\n  onNewProject,\\n  onSaveProject,\\n  onExportExcel,\\n  onOpenMobileMenu,\\n  isSidebarCollapsed,\\n  onToggleSidebarCollapse,\\n  isSaving,\\n}) => {\\n  const [isEditingTitle, setIsEditingTitle] = useState(false);\\n  const [titleInput, setTitleInput] = useState(project.name);\\n\\n  const handleTitleSubmit = () => {\\n    if (titleInput.trim()) {\\n      onUpdateProjectName(titleInput.trim());\\n    } else {\\n      setTitleInput(project.name);\\n    }\\n    setIsEditingTitle(false);\\n  };\\n\\n  const formattedDate = new Date(project.createdAt).toLocaleDateString(\'id-ID\', {\\n    day: \'numeric\',\\n    month: \'short\',\\n    year: \'numeric\',\\n  });\\n\\n  return (\\n    <header className=\\\"relative bg-white border-b border-slate-200 overflow-hidden\\\">\\n      {/* Subtle civil engineering blueprint watermark background */}\\n      <div\\n        className=\\\"absolute inset-0 pointer-events-none opacity-[0.035] bg-repeat\\\"\\n        style={{\\n          backgroundImage: `radial-gradient(#173B73 1px, transparent 1px)`,\\n          backgroundSize: \'16px 16px\',\\n        }}\\n      />\\n      <div className=\\\"absolute right-0 top-0 bottom-0 w-80 pointer-events-none opacity-10 hidden lg:block overflow-hidden\\\">\\n        <svg viewBox=\\\"0 0 200 120\\\" className=\\\"w-full h-full text-blue-900 fill-current\\\">\\n          <path d=\\\"M10 110 L10 40 L60 20 L110 40 L110 110 Z M60 20 L60 110 M120 110 L120 10 L190 30 L190 110 Z\\\" />\\n        </svg>\\n      </div>\\n\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 py-5 relative z-10\\\">\\n        {/* Top bar with user profile & quick action */}\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-100\\\">\\n          <div className=\\\"flex items-start gap-3 min-w-0\\\">\\n            {/* Mobile Hamburger Button */}\\n            <button\\n              onClick={onOpenMobileMenu}\\n              className=\\\"md:hidden mt-1 p-2 rounded-lg border border-slate-200 text-slate-600 hover:text-blue-700 hover:bg-blue-50 transition shrink-0\\\"\\n              aria-label=\\\"Buka Menu Navigasi\\\"\\n              title=\\\"Buka Menu Navigasi\\\"\\n            >\\n              <Menu className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            {/* Desktop Sidebar Collapse Quick Toggle */}\\n            {onToggleSidebarCollapse && (\\n              <button\\n                onClick={onToggleSidebarCollapse}\\n                className=\\\"hidden md:inline-flex mt-1 p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-blue-700 hover:bg-blue-50 transition shrink-0\\\"\\n                title={isSidebarCollapsed ? \'Lebarkan Sidebar Menu\' : \'Ciutkan Sidebar Menu\'}\\n                aria-label={isSidebarCollapsed ? \'Lebarkan Sidebar Menu\' : \'Ciutkan Sidebar Menu\'}\\n              >\\n                {isSidebarCollapsed ? (\\n                  <PanelLeftOpen className=\\\"w-4 h-4\\\" />\\n                ) : (\\n                  <PanelLeftClose className=\\\"w-4 h-4\\\" />\\n                )}\\n              </button>\\n            )}\\n\\n            <div className=\\\"min-w-0\\\">\\n              <span className=\\\"text-xs font-medium text-slate-500\\\">Selamat datang, Adjie \360\237\221\213</span>\\n              <div className=\\\"flex items-center gap-2 mt-0.5\\\">\\n                {isEditingTitle ? (\\n                  <div className=\\\"flex items-center gap-1.5\\\">\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={titleInput}\\n                      onChange={(e) => setTitleInput(e.target.value)}\\n                      onKeyDown={(e) => e.key === \'Enter\' && handleTitleSubmit()}\\n                      className=\\\"text-xl sm:text-2xl font-bold text-slate-900 border border-blue-400 rounded-md px-2 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500\\\"\\n                      autoFocus\\n                    />\\n                    <button\\n                      onClick={handleTitleSubmit}\\n                      className=\\\"p-1.5 rounded-md bg-blue-600 text-white hover:bg-blue-700 transition\\\"\\n                    >\\n                      <Check className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  </div>\\n                ) : (\\n                  <div className=\\\"flex items-center gap-2 group min-w-0\\\">\\n                    <h2 className=\\\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight truncate\\\">\\n                      {project.name}\\n                    </h2>\\n                    <button\\n                      onClick={() => {\\n                        setTitleInput(project.name);\\n                        setIsEditingTitle(true);\\n                      }}\\n                      className=\\\"p-1 text-slate-400 hover:text-blue-600 rounded-md transition shrink-0\\\"\\n                      title=\\\"Ubah Nama Proyek\\\"\\n                    >\\n                      <Pencil className=\\\"w-3.5 h-3.5\\\" />\\n                    </button>\\n                  </div>\\n                )}\\n              </div>\\n              <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n                Kalkulator volume pekerjaan konstruksi (Quantity Takeoff)\\n              </p>\\n            </div>\\n          </div>\\n\\n          {/* Right Header User & Actions */}\\n          <div className=\\\"flex items-center gap-2 sm:gap-3\\\">\", \"StartLine\":1, \"TargetContent\":\"import React, { useState } from \'react\';\\nimport {\\n  Building2,\\n  Layers,\\n  Calendar,\\n  Pencil,\\n  Check,\\n  Plus,\\n  Save,\\n  Download,\\n  Bell,\\n  Sparkles,\\n} from \'lucide-react\';\\nimport { ProjectData } from \'../types\';\\n\\ninterface HeaderProps {\\n  project: ProjectData;\\n  onUpdateProjectName: (newName: string) => void;\\n  onOpenFloors: () => void;\\n  onNewProject: () => void;\\n  onSaveProject: () => void;\\n  onExportExcel: () => void;\\n  isSaving?: boolean;\\n}\\n\\nexport const Header: React.FC<HeaderProps> = ({\\n  project,\\n  onUpdateProjectName,\\n  onOpenFloors,\\n  onNewProject,\\n  onSaveProject,\\n  onExportExcel,\\n  isSaving,\\n}) => {\\n  const [isEditingTitle, setIsEditingTitle] = useState(false);\\n  const [titleInput, setTitleInput] = useState(project.name);\\n\\n  const handleTitleSubmit = () => {\\n    if (titleInput.trim()) {\\n      onUpdateProjectName(titleInput.trim());\\n    } else {\\n      setTitleInput(project.name);\\n    }\\n    setIsEditingTitle(false);\\n  };\\n\\n  const formattedDate = new Date(project.createdAt).toLocaleDateString(\'id-ID\', {\\n    day: \'numeric\',\\n    month: \'short\',\\n    year: \'numeric\',\\n  });\\n\\n  return (\\n    <header className=\\\"relative bg-white border-b border-slate-200 overflow-hidden\\\">\\n      {/* Subtle civil engineering blueprint watermark background */}\\n      <div\\n        className=\\\"absolute inset-0 pointer-events-none opacity-[0.035] bg-repeat\\\"\\n        style={{\\n          backgroundImage: `radial-gradient(#173B73 1px, transparent 1px)`,\\n          backgroundSize: \'16px 16px\',\\n        }}\\n      />\\n      <div className=\\\"absolute right-0 top-0 bottom-0 w-80 pointer-events-none opacity-10 hidden lg:block overflow-hidden\\\">\\n        <svg viewBox=\\\"0 0 200 120\\\" className=\\\"w-full h-full text-blue-900 fill-current\\\">\\n          <path d=\\\"M10 110 L10 40 L60 20 L110 40 L110 110 Z M60 20 L60 110 M120 110 L120 10 L190 30 L190 110 Z\\\" />\\n        </svg>\\n      </div>\\n\\n      <div className=\\\"max-w-7xl mx-auto px-6 py-5 relative z-10\\\">\\n        {/* Top bar with user profile & quick action */}\\n        <div className=\\\"flex items-center justify-between pb-4 border-b border-slate-100\\\">\\n          <div>\\n            <span className=\\\"text-xs font-medium text-slate-500\\\">Selamat datang, Adjie \360\237\221\213</span>\\n            <div className=\\\"flex items-center gap-2 mt-0.5\\\">\\n              {isEditingTitle ? (\\n                <div className=\\\"flex items-center gap-1.5\\\">\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={titleInput}\\n                    onChange={(e) => setTitleInput(e.target.value)}\\n                    onKeyDown={(e) => e.key === \'Enter\' && handleTitleSubmit()}\\n                    className=\\\"text-2xl font-bold text-slate-900 border border-blue-400 rounded-md px-2 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500\\\"\\n                    autoFocus\\n                  />\\n                  <button\\n                    onClick={handleTitleSubmit}\\n                    className=\\\"p-1.5 rounded-md bg-blue-600 text-white hover:bg-blue-700 transition\\\"\\n                  >\\n                    <Check className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                </div>\\n              ) : (\\n                <div className=\\\"flex items-center gap-2 group\\\">\\n                  <h2 className=\\\"text-2xl font-bold text-slate-900 tracking-tight\\\">{project.name}</h2>\\n                  <button\\n                    onClick={() => {\\n                      setTitleInput(project.name);\\n                      setIsEditingTitle(true);\\n                    }}\\n                    className=\\\"p-1 text-slate-400 hover:text-blue-600 rounded-md transition\\\"\\n                    title=\\\"Ubah Nama Proyek\\\"\\n                  >\\n                    <Pencil className=\\\"w-3.5 h-3.5\\\" />\\n                  </button>\\n                </div>\\n              )}\\n            </div>\\n            <p className=\\\"text-xs text-slate-500 mt-0.5\\\">Kalkulator volume pekerjaan konstruksi (Quantity Takeoff)</p>\\n          </div>\\n\\n          {/* Right Header User & Actions */}\\n          <div className=\\\"flex items-center gap-3\\\">\", \"TargetFile\":\"/src/components/Header.tsx\", \"toolAction\":\"Updating Header.tsx with mobile menu and sidebar toggle buttons\", \"toolSummary\":\"Update /src/components/Header.tsx\"}"
