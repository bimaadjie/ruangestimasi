              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationNotes: \'0.27m antrede \303\227 1.4m lebar \303\227 24 trap + 2.85 \303\227 1.2 bordes.\',"
