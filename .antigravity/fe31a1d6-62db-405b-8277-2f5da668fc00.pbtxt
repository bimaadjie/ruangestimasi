      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  X,\n  FolderKanban,\n  Plus,\n  Building,\n  Trash2,\n  Calendar,\n  RotateCcw,\n} from \'lucide-react\';\nimport { ProjectData } from \'../types\';\nimport { createNewProject, createDefaultUscProject } from \'../services/projectStorage\';\n\ninterface ProjectManagementModalProps {\n  isOpen: boolean;\n  projects: ProjectData[];\n  activeProjectId: string;\n  onClose: () => void;\n  onSelectProject: (projectId: string) => void;\n  onSaveProjects: (projects: ProjectData[]) => void;\n}\n\nexport const ProjectManagementModal: React.FC<ProjectManagementModalProps> = ({\n  isOpen,\n  projects,\n  activeProjectId,\n  onClose,\n  onSelectProject,\n  onSaveProjects,\n}) => {\n  if (!isOpen) return null;\n\n  const [isCreating, setIsCreating] = useState(false);\n  const [newProjName, setNewProjName] = useState(\'\');\n  const [newFloorCount, setNewFloorCount] = useState(3);\n  const [newLocation, setNewLocation] = useState(\'\');\n  const [deleteConfirmId, setDeleteConfirmId] = useState<string | null>(null);\n  const [confirmReset, setConfirmReset] = useState(false);\n\n  const handleCreateSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newProjName.trim()) return;\n\n    const newProj = createNewProject(newProjName.trim(), newFloorCount, newLocation.trim());\n    const updated = [newProj, ...projects];\n    onSaveProjects(updated);\n    onSelectProject(newProj.id);\n    setIsCreating(false);\n    setNewProjName(\'\');\n    onClose();\n  };\n\n  const handleDeleteProject = (projectId: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    if (projects.length <= 1) return;\n\n    if (deleteConfirmId !== projectId) {\n      setDeleteConfirmId(projectId);\n      return;\n    }\n\n    const updated = projects.filter((p) => p.id !== projectId);\n    onSaveProjects(updated);\n    setDeleteConfirmId(null);\n    if (activeProjectId === projectId && updated[0]) {\n      onSelectProject(updated[0].id);\n    }\n  };\n\n  const handleResetToUsc = () => {\n    if (!confirmReset) {\n      setConfirmReset(true);\n      return;\n    }\n\n    const defaultUsc = createDefaultUscProject();\n    const existingIdx = projects.findIndex((p) => p.id === defaultUsc.id);\n    let updated: ProjectData[];\n    if (existingIdx >= 0) {\n      updated = [...projects];\n      updated[existingIdx] = defaultUsc;\n    } else {\n      updated = [defaultUsc, ...projects];\n    }\n    onSaveProjects(updated);\n    onSelectProject(defaultUsc.id);\n    setConfirmReset(false);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-xl overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold\">\n              <FolderKanban className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">Manajemen Proyek</h3>\n              <p className=\"text-xs text-slate-500\">Pilih, buat baru, atau kelola proyek perhitungan volume</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/50 transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-6 max-h-[60vh] overflow-y-auto space-y-5 text-xs\">\n          {!isCreating ? (\n            <>\n              <div className=\"flex items-center justify-between\">\n                <label className=\"font-bold text-slate-800\">Daftar Proyek Tersimpan ({projects.length})</label>\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={handleResetToUsc}\n                    className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg transition font-semibold ${\n                      confirmReset\n                        ? \'bg-amber-600 text-white\'\n                        : \'text-slate-600 hover:text-blue-700 hover:bg-blue-50\'\n                    }`}\n                    title=\"Muat Ulang Proyek Standar Gedung USC\"\n                  >\n                    <RotateCcw className=\"w-3.5 h-3.5\" />\n                    <span>{confirmReset ? \'Klik Sekali Lagi (Reset)\' : \'Muat Ulang Contoh\'}</span>\n                  </button>\n                  <button\n                    onClick={() => setIsCreating(true)}\n                    className=\"inline-flex items-center gap-1 px-3 py-1 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition shadow-2xs\"\n                  >\n                    <Plus className=\"w-3.5 h-3.5\" />\n                    <span>Proyek Baru</span>\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"space-y-2.5\">\n                {projects.map((proj) => {\n                  const isActive = proj.id === activeProjectId;\n                  const formattedDate = new Date(proj.createdAt).toLocaleDateString(\'id-ID\', {\n                    day: \'numeric\',\n                    month: \'short\',\n                    year: \'numeric\',\n                  });\n\n                  return (\n                    <div\n                      key={proj.id}\n                      onClick={() => {\n                        onSelectProject(proj.id);\n                        onClose();\n                      }}\n                      className={`p-3.5 rounded-xl border cursor-pointer transition flex items-center justify-between gap-3 ${\n                        isActive\n                          ? \'border-blue-500 bg-blue-50/40 shadow-xs ring-1 ring-blue-400\'\n                          : \'border-slate-200 hover:border-slate-300 hover:bg-slate-50\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-3 min-w-0\">\n                        <div\n                          className={`w-9 h-9 rounded-lg flex items-center justify-center font-bold shrink-0 ${\n                            isActive ? \'bg-blue-600 text-white\' : \'bg-slate-100 text-slate-500\'\n                          }`}\n                        >\n                          <Building className=\"w-4 h-4\" />\n                        </div>\n                        <div className=\"min-w-0\">\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"font-bold text-slate-900 truncate\">{proj.name}</span>\n                            {isActive && (\n                              <span className=\"px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-700\">\n                                Aktif\n                              </span>\n                            )}\n                          </div>\n                          <span className=\"text-[11px] text-slate-500 block\">\n                            {proj.floorCount} Lantai \302\267 {proj.works.length} Pekerjaan \302\267 {proj.location || \'Tanpa Lokasi\'}\n                          </span>\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center gap-2 shrink-0\">\n                        <span className=\"text-[10px] text-slate-400 flex items-center gap-1\">\n                          <Calendar className=\"w-3 h-3\" />\n                          {formattedDate}\n                        </span>\n                        {projects.length > 1 && (\n                          <button\n                            onClick={(e) => handleDeleteProject(proj.id, e)}\n                            className={`p-1.5 rounded-lg transition ${\n                              deleteConfirmId === proj.id\n                                ? \'bg-rose-600 text-white font-bold text-[10px] px-2\'\n                                : \'text-slate-400 hover:text-rose-600 hover:bg-rose-50\'\n                            }`}\n                            title=\"Hapus Proyek\"\n                          >\n                            {deleteConfirmId === proj.id ? \'Hapus?\' : <Trash2 className=\"w-3.5 h-3.5\" />}\n                          </button>\n                        )}\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </>\n          ) : (\n            <form onSubmit={handleCreateSubmit} className=\"space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <h4 className=\"font-bold text-slate-900 text-sm\">Buat Proyek Konstruksi Baru</h4>\n                <button\n                  type=\"button\"\n                  onClick={() => setIsCreating(false)}\n                  className=\"text-xs text-slate-500 hover:text-slate-800\"\n                >\n                  Kembali ke Daftar\n                </button>\n              </div>\n\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">Nama Proyek *</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"Contoh: Gedung Laboratorium Terpadu\"\n                  value={newProjName}\n                  onChange={(e) => setNewProjName(e.target.value)}\n                  className=\"w-full px-3 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  autoFocus\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"font-bold text-slate-800 block mb-1\">Jumlah Lantai</label>\n                  <input\n                    type=\"number\"\n                    min={1}\n                    max={50}\n                    value={newFloorCount}\n                    onChange={(e) => setNewFloorCount(Number(e.target.value) || 1)}\n                    className=\"w-full px-3 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  />\n                </div>\n                <div>\n                  <label className=\"font-bold text-slate-800 block mb-1\">Lokasi Proyek</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"Contoh: Magelang, Jawa Tengah\"\n                    value={newLocation}\n                    onChange={(e) => setNewLocation(e.target.value)}\n                    className=\"w-full px-3 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"pt-2 flex justify-end gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsCreating(false)}\n                  className=\"px-4 py-2 font-semibold text-slate-600 hover:text-slate-900 rounded-xl\"\n                >\n                  Batal\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-xs\"\n                >\n                  Buat Proyek\n                </button>\n              </div>\n            </form>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-3 border-t border-slate-100 flex items-center justify-end bg-slate-50/50\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition\"\n          >\n            Tutup\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
