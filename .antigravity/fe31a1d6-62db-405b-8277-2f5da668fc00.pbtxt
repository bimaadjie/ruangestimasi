            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'antrede\', name: \'antrede\', label: \'Lebar Pijakan (Antrede)\', placeholder: \'Contoh: 0.27 atau 0.30 (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'optrede\', name: \'optrede\', label: \'Tinggi Tanjakan (Optrede)\', placeholder: \'Contoh: 0.16 atau 0.18 (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jumlah_anak_tangga\', name: \'jumlah_anak_tangga\', label: \'Jumlah Anak Tangga\', placeholder: \'Masukkan jumlah trap (bh)\', value: null, unit: \'bh\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', placeholder: \'Masukkan lebar tangga (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Pelat Bordes\', placeholder: \'Masukkan luas bordes (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tebal_bordes\', name: \'tebal_bordes\', label: \'Tebal Pelat Bordes\', placeholder: \'Contoh: 0.12 (m)\', value: 0.12, unit: \'m\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const a = params[\'antrede\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const o = params[\'optrede\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const n = params[\'jumlah_anak_tangga\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const w = params[\'lebar_tangga\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const lb = params[\'luas_bordes\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const tb = params[\'tebal_bordes\'] || 0.12;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (a == null || o == null || n == null || w == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vAnakTangga = 0.5 * a * o * n * w;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vBordes = lb * tb;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return vAnakTangga + vBordes;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
