      thinking_signature: "\022\206\021\n\203\021\001i\024}\023O\246\302\222\234\355\256=\353\f\303 =\366wU\326\020\021\216%26&!\231\236p\016\267\343\301\374z\325\216\347\363.\203\253z\230\335R\257Us\317\310\304\313\235b\t\b5\002\020\360\005!g\'t\234\314\361Z\307\206\333\341\355\367\234\b\231\fp\352Z\256`8\270Y\220\255`\355M\004\027;GN\017\377Xq\2727\252j\241\267h\\\255\030m=\345\2774\020\345\234\f\253\225\001<\204\232{CKW]&\332\324\313dC\003\227\350\232\273\235\004\325q%vc\r;C>\370\021\212~\324\356\025{\201\214!\204\252M\300\253:es\253\376\021\231\366\r\026\034\t\366\331\2035\001h\235\346\2649\336\"\031\334o\302\321\335\322\030\000\314<\372\t\316\377\244z\237\317\332\036\222\214E\347qzX\375\312\362\240\036\n\024\337\030\271\v\264\032\230\227\032\207\233\210cS\212\335\210\025\212\022N\352\327R\220\237\233\257\002\2065\a\005\323M\323\000\246<\360\266\336\245#\354\313\216ABt\313+\350\376\261\227v\342=D\003\256\3449\366$\025\373Z\004\222 \306(u.\357\201\001\320\354\300\020MaA\210hXCO\006\2335M\t\332\327\206\352\004t\222\334L\340u\"]\026\264\247\315\332x\"*W\024\217Vj/\211\\\271\316m\326\t\267\305\tA\032\320\242\3541\030\225\257\317\272\n\035\247\333\331\237XO\rw\366@y\270\343\212\313nk\353\254\020#\017\b\344u\327\316Uv\266\352M\335=s\346O`\025\322h\304N\321\202N\304\217\252\310\250vZ=~\2611\025\362\233\300\341y\323#\021\332`\214\0052\v\022\235\314\302\263s\351\370\337\337\275\030o\354\326z\330\310\033\aM]H\273\300*n.\233:<\310\323\213\377-!\244\224\\\214Q\243\273\207\251\323\'\031\353\373\265\275\355\217\251\333\371V\n\252\025I\211\374\362\223e!\277\250F\270\317\265\315\024\202\362\\\254,\246)Z\306\2135\232\257\204q3Z\a\210\002h(t\2370\314Y8\341\2370\a,\276\367\325\034\350\303\022A\231\027\177qT<\220{\234\310\252\\32\227X\307\243\270D>\346\210/ZX\230aI\200%\377\263\367\362\377\275\232\266,c|u<\322\020\231\006\360+\350\236\262(\314j\333\214\252\267\221\366M\030\227k\0031\f\276\362\305a\217y\321\327\207\360\353\203Z\tx\023\371\001\177\320\n\246\215\262\224i\252P4\331\346