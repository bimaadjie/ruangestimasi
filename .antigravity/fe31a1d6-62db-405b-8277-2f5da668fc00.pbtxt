      thinking_signature: "\022\264\022\n\261\022\001i\024}\023\320#)\265\246q\351\216,\\\361 \021\221\f\200\317<\231\340j6Gk\\\250\022\236\321.\337An\027 ;k\237\360\304\3400Q\210\205^h5c\030\321\an\267h\024\361\362\"aN\325\016x.\241^B\311I\334\335\224\352y\tO\313\311\276\201\205\230\374\364\276e\235v0%mtw\256\251\253@\225\023\272\274\237\357a\253/\344\224\353\030\276\206\024\221<\217\r\030G\201i]\251v\233\307_\236\254Y\224\277l\314\342\353\233y\023\272L\232aO\263M2\357\222\005t\004!\327\002\000\033K\227\316\241\276W\006Y\02314\312o>\217\211d\v\257\257\235\204\251>\241fN\261\365\365\306w\274l`:\276\343]\354z\323\303\025\3766\226\270\"\033\224\001\336\022ig\000\347\267\371-\033\207\020B!z\330\377\216kK\340\247A\2120z\373`\221\240r\3233\236\334\334\326\327\211\331c\030\225\276\004)>\366b\377\210)\324\337\305\a\031.\255\345\035\315\306(\337\206>#a\353\227\265\375\264t\t\030iYsz\265w\023%\224\336%~xR\376\247r\207\264\246lc\036\203\342f\250\326\302\034\265\357\247\354g\223\245[E[\017e}\311\236S\333P\344{k\312\224\203 \262\261!\366\332\227\356Z=LY\375\335\241\365\0334\'h\360O\207\177\001\224Hc\332\360H\313\343\211?\325f\325\323=U~\273w\250\vyN\235\251\264N\245c4\322\313Q\205\351\364r\266\004\317\311l\220\037\'\375\035\205\360\230:\212\324\241\032_\347Q\207\342\026\347\'\261\327\223jW\371\355\317\277L\177!\302!\342\177\276s\356\002y\236\033\\\2257\220\004WM\362\000e\017\246\221A\300{\330\203=\240(\325W\305\325\330\025R>\231<\201^\224dRr\2011\260/\312)GC#\025\240\213\366\366\277h\325\275\347\265\373\270\373C\217\277\231\025\177}\261zx2\275\316\375_;\331\271\024ZK\\\256nd\270\273Y:\361I\231\230\033\357\242u\337\342t!\236\215!c+T\377\246\001\f8(!\037\003\300D\335\304\035\374\276\262^t.\177\204\253]r\332\211h\005,\341 y\252\333\237\330\260,{\371\364\373{\256\361\372R\351\355\342\247\037G,.\270\227)\235>\030!\315a>PUe\177#\336Pdt7\205V[\tl=\307\310\004\354\270\204w2\004\335\362C\366\003\263\235f2Xh\246K\aH\343z\006m\205@-U@\334\322Q,\227E~\330>\362\327\320\025\254Z_\314\001\031