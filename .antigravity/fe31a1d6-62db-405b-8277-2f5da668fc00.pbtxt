            }
            lines {
              text: "      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Pondasi\', placeholder: \'Masukkan tinggi pondasi (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_atas\', name: \'lebar_atas\', label: \'Lebar Atas Pondasi\', placeholder: \'Masukkan lebar atas (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_bawah\', name: \'lebar_bawah\', label: \'Lebar Bawah Pondasi\', placeholder: \'Masukkan lebar bawah (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Jalur Pondasi\', placeholder: \'Masukkan panjang total (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t = params[\'tinggi\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const la = params[\'lebar_atas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const lb = params[\'lebar_bawah\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const s = params[\'panjang_total\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (t == null || la == null || lb == null || s == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return t * (0.5 * (la + lb)) * s;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
