    end_line: 314
    content: "import React, { useState } from \'react\';\nimport { X, Plus, Search, Layers, Check } from \'lucide-react\';\nimport { CATALOG_WORK_ITEMS } from \'../data/uscCatalog\';\nimport { CatalogWorkItem, FloorItem, ProjectWorkItem, WorkCategory } from \'../types\';\nimport { createProjectWorkFromCatalog } from \'../services/projectStorage\';\n\ninterface AddWorkModalProps {\n  isOpen: boolean;\n  floors: FloorItem[];\n  defaultFloorId?: string;\n  onClose: () => void;\n  onAddWork: (newWork: ProjectWorkItem) => void;\n}\n\nexport const AddWorkModal: React.FC<AddWorkModalProps> = ({\n  isOpen,\n  floors,\n  defaultFloorId,\n  onClose,\n  onAddWork,\n}) => {\n  if (!isOpen) return null;\n\n  const [selectedFloorId, setSelectedFloorId] = useState<string>(\n    defaultFloorId || floors[0]?.id || \'fl-1\'\n  );\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'Semua\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [mode, setMode] = useState<\'catalog\' | \'custom\'>(\'catalog\');\n\n  // Custom Work State\n  const [customName, setCustomName] = useState(\'\');\n  const [customCategory, setCustomCategory] = useState<WorkCategory>(\'Struktural\');\n  const [customUnit, setCustomUnit] = useState(\'m\302\263\');\n  const [customFormula, setCustomFormula] = useState(\'Panjang \303\227 Lebar \303\227 Tinggi\');\n\n  const categories = [\'Semua\', \'Persiapan Dll\', \'Struktural\', \'Arsitektural\', \'MEP\'];\n\n  const filteredCatalog = CATALOG_WORK_ITEMS.filter((item) => {\n    const matchCat = selectedCategory === \'Semua\' || item.category === selectedCategory;\n    const matchSearch =\n      searchQuery === \'\' ||\n      item.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      item.description.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      item.formulaDisplay.toLowerCase().includes(searchQuery.toLowerCase());\n    return matchCat && matchSearch;\n  });\n\n  const handleSelectCatalogItem = (catalogItem: CatalogWorkItem) => {\n    const newWork = createProjectWorkFromCatalog(catalogItem.id, selectedFloorId);\n    if (newWork) {\n      onAddWork(newWork);\n      onClose();\n    }\n  };\n\n  const handleCreateCustomWork = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!customName.trim()) return;\n\n    const newWork: ProjectWorkItem = {\n      id: `custom-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\n      name: customName.trim(),\n      category: customCategory,\n      floorId: selectedFloorId,\n      unit: customUnit.trim() || \'m\302\263\',\n      formulaDisplay: customFormula.trim() || \'Panjang \303\227 Lebar \303\227 Tinggi\',\n      customFormula: customFormula.trim(),\n      parameters: [\n        { id: \'panjang\', name: \'panjang\', label: \'Panjang (P)\', value: null, unit: \'m\', required: true },\n        { id: \'lebar\', name: \'lebar\', label: \'Lebar (L)\', value: null, unit: \'m\', required: true },\n        { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi (T)\', value: null, unit: \'m\', required: true },\n      ],\n      components: [],\n      calculatedVolume: null,\n      status: \'Perlu Input\',\n      isActive: true,\n      lastUpdated: new Date().toISOString(),\n    };\n\n    onAddWork(newWork);\n    onClose();\n  };\n\n  const getCategoryBadgeClass = (cat: WorkCategory) => {\n    switch (cat) {\n      case \'Persiapan Dll\':\n        return \'bg-blue-50 text-blue-700 border-blue-100\';\n      case \'Struktural\':\n        return \'bg-indigo-50 text-indigo-700 border-indigo-100\';\n      case \'Arsitektural\':\n        return \'bg-teal-50 text-teal-700 border-teal-100\';\n      case \'MEP\':\n        return \'bg-purple-50 text-purple-700 border-purple-100\';\n      default:\n        return \'bg-slate-50 text-slate-700 border-slate-100\';\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-3xl overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold\">\n              <Plus className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">Tambah Pekerjaan Baru</h3>\n              <p className=\"text-xs text-slate-500\">Pilih pekerjaan dari katalog atau tambahkan pekerjaan baru.</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/50 transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Top Controls: Target Floor & Mode Selector */}\n        <div className=\"px-6 py-3.5 border-b border-slate-100 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs\">\n          <div className=\"flex items-center gap-2\">\n            <Layers className=\"w-4 h-4 text-blue-600 shrink-0\" />\n            <span className=\"font-semibold text-slate-700\">Lantai Target:</span>\n            <select\n              value={selectedFloorId}\n              onChange={(e) => setSelectedFloorId(e.target.value)}\n              className=\"px-2.5 py-1 rounded-lg border border-slate-300 font-semibold text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            >\n              {floors.map((f) => (\n                <option key={f.id} value={f.id}>\n                  {f.name} {f.elevation ? `(${f.elevation})` : \'\'}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div className=\"flex items-center p-1 bg-slate-100 rounded-lg self-start sm:self-auto\">\n            <button\n              onClick={() => setMode(\'catalog\')}\n              className={`px-3 py-1 font-semibold rounded-md transition ${\n                mode === \'catalog\' ? \'bg-white text-blue-700 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Katalog Pekerjaan ({CATALOG_WORK_ITEMS.length})\n            </button>\n            <button\n              onClick={() => setMode(\'custom\')}\n              className={`px-3 py-1 font-semibold rounded-md transition ${\n                mode === \'custom\' ? \'bg-white text-blue-700 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Pekerjaan Baru\n            </button>\n          </div>\n        </div>\n\n        {/* Catalog Mode */}\n        {mode === \'catalog\' && (\n          <div>\n            {/* Search & Category Filter */}\n            <div className=\"p-4 border-b border-slate-100 flex flex-col sm:flex-row gap-3\">\n              <div className=\"relative flex-1\">\n                <Search className=\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n                <input\n                  type=\"text\"\n                  placeholder=\"Cari item pekerjaan dalam katalog...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-full pl-8 pr-3 py-1.5 text-xs rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                />\n              </div>\n\n              <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 text-xs\">\n                {categories.map((c) => (\n                  <button\n                    key={c}\n                    onClick={() => setSelectedCategory(c)}\n                    className={`px-2.5 py-1 rounded-md font-semibold shrink-0 transition ${\n                      selectedCategory === c\n                        ? \'bg-blue-600 text-white shadow-2xs\'\n                        : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n                    }`}\n                  >\n                    {c}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Catalog List with Clean Professional Cards */}\n            <div className=\"p-4 max-h-[50vh] overflow-y-auto space-y-2.5\">\n              {filteredCatalog.map((item) => (\n                <div\n                  key={item.id}\n                  className=\"p-3.5 rounded-xl border border-slate-200 hover:border-blue-300 hover:bg-blue-50/20 flex items-center justify-between gap-4 transition group\"\n                >\n                  <div className=\"min-w-0 flex-1\">\n                    <div className=\"flex items-center gap-2 mb-1\">\n                      <h4 className=\"text-xs font-bold text-slate-900 truncate\">{item.name}</h4>\n                      <span className={`text-[10px] px-2 py-0.5 rounded font-semibold border ${getCategoryBadgeClass(item.category)}`}>\n                        {item.category}\n                      </span>\n                    </div>\n                    <p className=\"text-[11px] text-slate-500 line-clamp-1\">{item.description}</p>\n                    <div className=\"flex items-center gap-4 mt-1.5 text-[11px] text-slate-600\">\n                      <span className=\"font-semibold text-slate-700\">Satuan: <span className=\"font-mono text-slate-900\">{item.defaultUnit}</span></span>\n                      <span>\302\267</span>\n                      <span className=\"text-slate-500\">Rumus: <span className=\"font-medium text-slate-800\">{item.formulaDisplay}</span></span>\n                    </div>\n                  </div>\n\n                  <button\n                    onClick={() => handleSelectCatalogItem(item)}\n                    className=\"inline-flex items-center gap-1 px-3.5 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition shadow-2xs shrink-0\"\n                  >\n                    <Plus className=\"w-3.5 h-3.5\" />\n                    <span>Pilih</span>\n                  </button>\n                </div>\n              ))}\n\n              {filteredCatalog.length === 0 && (\n                <div className=\"p-8 text-center text-xs text-slate-500\">\n                  Tidak ditemukan item pekerjaan yang cocok dengan pencarian.\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n\n        {/* Custom Mode */}\n        {mode === \'custom\' && (\n          <form onSubmit={handleCreateCustomWork} className=\"p-6 max-h-[50vh] overflow-y-auto space-y-4 text-xs\">\n            <div>\n              <label className=\"font-bold text-slate-800 block mb-1\">Nama Pekerjaan *</label>\n              <input\n                type=\"text\"\n                required\n                placeholder=\"Contoh: Balok Ekstra As 3-5 (30 x 50 cm)\"\n                value={customName}\n                onChange={(e) => setCustomName(e.target.value)}\n                className=\"w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500\"\n              />\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">Kategori</label>\n                <select\n                  value={customCategory}\n                  onChange={(e) => setCustomCategory(e.target.value as WorkCategory)}\n                  className=\"w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                >\n                  <option value=\"Persiapan Dll\">Persiapan Dll</option>\n                  <option value=\"Struktural\">Struktural</option>\n                  <option value=\"Arsitektural\">Arsitektural</option>\n                  <option value=\"MEP\">MEP</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">Satuan Volume</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"m\302\263, m\302\262, m, unit, buah\"\n                  value={customUnit}\n                  onChange={(e) => setCustomUnit(e.target.value)}\n                  className=\"w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"font-bold text-slate-800 block mb-1\">Bentuk Rumus</label>\n              <input\n                type=\"text\"\n                placeholder=\"Panjang \303\227 Lebar \303\227 Tinggi\"\n                value={customFormula}\n                onChange={(e) => setCustomFormula(e.target.value)}\n                className=\"w-full px-3 py-2 font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500\"\n              />\n              <span className=\"text-[11px] text-slate-500 mt-1 block\">\n                Variabel dimensi standar: Panjang, Lebar, Tinggi, Tebal, Jumlah.\n              </span>\n            </div>\n\n            <div className=\"pt-2 flex justify-end\">\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2.5 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition shadow-xs\"\n              >\n                Tambahkan Pekerjaan Baru\n              </button>\n            </div>\n          </form>\n        )}\n\n        {/* Footer */}\n        <div className=\"px-6 py-3 border-t border-slate-100 flex items-center justify-end bg-slate-50/50\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition\"\n          >\n            Tutup\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 315
    num_bytes: 13647
    line_range_bytes: 13647
  }
}
