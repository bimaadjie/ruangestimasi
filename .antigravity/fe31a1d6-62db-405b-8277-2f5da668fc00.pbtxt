  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * RuangRAB \342\200\224 Ringkasan Akun & Proyek Pengguna\n * Menampilkan ucapan selamat datang, jumlah proyek, proyek terakhir dibuka,\n * tombol Buat Proyek Baru, daftar proyek milik pengguna, dan aktivitas terakhir.\n */\n\nimport React from \'react\';\nimport {\n  FolderKanban,\n  Plus,\n  Clock,\n  Building,\n  CheckCircle2,\n  Sparkles,\n} from \'lucide-react\';\nimport { ProjectData, UserProfile } from \'../types\';\n\ninterface UserOverviewBannerProps {\n  user: UserProfile;\n  projects: ProjectData[];\n  activeProject: ProjectData;\n  onSelectProject: (projectId: string) => void;\n  onOpenProjectModal: () => void;\n}\n\nexport const UserOverviewBanner: React.FC<UserOverviewBannerProps> = ({\n  user,\n  projects,\n  activeProject,\n  onSelectProject,\n  onOpenProjectModal,\n}) => {\n  const lastUpdatedText = new Date(activeProject.updatedAt || activeProject.createdAt).toLocaleString(\n    \'id-ID\',\n    {\n      day: \'numeric\',\n      month: \'short\',\n      year: \'numeric\',\n      hour: \'2-digit\',\n      minute: \'2-digit\',\n    }\n  );\n\n  const verifiedWorksCount = activeProject.works.filter(\n    (w) => w.isActive && w.calculatedVolume !== null && w.aiVerificationStatus !== \'draft\'\n  ).length;\n\n  const draftAiCount = activeProject.works.filter(\n    (w) => w.isActive && w.origin === \'ai\' && w.aiVerificationStatus === \'draft\'\n  ).length;\n\n  return (\n    <div className=\"bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 mb-6 shadow-2xs\">\n      <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n        {/* Left: User Welcome & Project Stats */}\n        <div className=\"flex items-start gap-3.5 min-w-0\">\n          <div className=\"w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 text-blue-700 flex items-center justify-center shrink-0\">\n            <FolderKanban className=\"w-5 h-5\" />\n          </div>\n          <div className=\"min-w-0\">\n            <div className=\"flex items-center gap-2 flex-wrap\">\n              <h3 className=\"text-sm font-bold text-slate-900\">\n                Ruang Kerja Proyek \342\200\224 {user.fullName}\n              </h3>\n              <span className=\"px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-700\">\n                {projects.length} Proyek Tersimpan\n              </span>\n            </div>\n            <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500 mt-1\">\n              <span className=\"flex items-center gap-1\">\n                <Building className=\"w-3.5 h-3.5 text-blue-600\" />\n                Proyek Aktif: <strong className=\"text-slate-800\">{activeProject.name}</strong>\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n                Aktivitas Terakhir: <strong className=\"text-slate-700\">{lastUpdatedText}</strong>\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n                <span>{verifiedWorksCount} Pekerjaan Terverifikasi</span>\n              </span>\n              {draftAiCount > 0 && (\n                <span className=\"flex items-center gap-1 text-blue-700 font-semibold\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>{draftAiCount} Draf AI</span>\n                </span>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* Right: Quick Project Switcher & New Project CTA */}\n        <div className=\"flex flex-wrap items-center gap-2 shrink-0\">\n          {projects.length > 1 && (\n            <select\n              value={activeProject.id}\n              onChange={(e) => onSelectProject(e.target.value)}\n              className=\"px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n              title=\"Ganti Proyek Aktif\"\n            >\n              {projects.map((p) => (\n                <option key={p.id} value={p.id}>\n                  {p.name} ({p.floorCount} Lantai \302\267 {p.works.filter((w) => w.isActive).length} Item)\n                </option>\n              ))}\n            </select>\n          )}\n\n          <button\n            type=\"button\"\n            onClick={onOpenProjectModal}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition shadow-2xs cursor-pointer\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Buat / Kelola Proyek</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/UserOverviewBanner.tsx"
        }
        overwrite: true
      }
    }
