      thinking_signature: "\022\330\b\n\325\b\001i\024}\02372|~L,\365O\220\314\335r\315\325\001(\231\024kW\311\002k\331\322*\205,]\313gO\230\006\255\234\306c\301\212\344\300`f\206\315\036\310%\354\'\220\262\254\237\225\030\301\350\033\264K\333\217g\274\237\236\207\262\205H1\331C\311Z#\374\376W\275\321\v\'\320\352P8\251#e\032g\317C\322*r\254\'s\203\304\236\373\225+\311s\210w\364%\206\247&\3633\034\254\256\032\300M\376(Q4\000{\306\361@\273k\372\213\377\3110\254\037\bYw\344ny\217\034+\331\315r\257$)\313\277=\024H\322\210\005\205,K~\301\255\232\006\302`\201e\334B\255\316\025\337\351\210\247\321\374}z\306\032\262\003\b\360v.\327,\264\026\255~\261I\262G\251\fX\333Ya\332\025\343\244#\236P\213D\370k\212D\027yIl6\354\262\'\244#\236\274\350\302\217\021E&\356\322\307\213gM\377\317\266!\337\362\343\310\025G\334I\337>\237\026:T\222\217\217\315x\340\350z\220@Kx\275=04\357\374\353\031\267\305\343z\325\203[\217!\207\204\334\253\231\004\t8Hz-Q\255\023.\320e\353\016\271{\r\2108\306`\344A\017\260\312\233\224t\023\341\326]\265m\220cE-r\331\330\357\023\375\223\037\212\333\254\346\266\017\254\343\345\213\275\225\336\233i\260aD\224+&\246|\375T\326\211/\374Z\r$\004\352\032\r\366\035%\211G\204\271Y8\217\005\372\216\220\001\211\035\360\236\352\336\302J\302\327\252\376\246[\267u\2276\363\257\332\242\v\363S\231V`X\347&\373\313\262\335\255Y$\314\243\370N\223\231\004\v3\313R\224\222\3521\267\001\214*i\001\003\250\"\374{\365^\025\3631Q\035^[\200`>\351=p)\256Q\t\031OyL}or\244I_N\024\267\214\225\035\357\233R~m\266\310\260\203X}\240(\000W\025\024\025\212\275\020\307)\016\356\020\276\341\321\254\211R\237\3362\342\342\276\271\222\341\351E9\306\202gP\323>\362z>p\nH=-\251I\002\342\321+\275\"\362\343\r\330\200\330\323R\tWi>,\223\270,\306\311\361y\235\377\233|II\350\213\2462H\322\360\261\353T\237\211A$\273\363\325\t1\031)\315\a \212\215F\205\347H\201_\025.$\233\231\271\246sP\225\3212i\005\301\025Jl\230\332\230B\313|\333\241\334/\206\200V\352\355\303\205U\326\225\263\022k5\000\372\342\365D}\035\306\236\212