  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { X, Check, Calculator, Info, ExternalLink, Save } from \'lucide-react\';\nimport { ProjectWorkItem, ParameterItem } from \'../types\';\nimport { formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface WorkDetailModalProps {\n  isOpen: boolean;\n  work: ProjectWorkItem | null;\n  floorName?: string;\n  onClose: () => void;\n  onSaveWork: (updatedWork: ProjectWorkItem) => void;\n}\n\nexport const WorkDetailModal: React.FC<WorkDetailModalProps> = ({\n  isOpen,\n  work,\n  floorName,\n  onClose,\n  onSaveWork,\n}) => {\n  if (!isOpen || !work) return null;\n\n  const [localParams, setLocalParams] = useState<ParameterItem[]>([]);\n  const [activeTab, setActiveTab] = useState<\'params\' | \'formula\' | \'ref\'>(\'params\');\n\n  useEffect(() => {\n    if (work) {\n      setLocalParams(JSON.parse(JSON.stringify(work.parameters || [])));\n    }\n  }, [work]);\n\n  const handleParamChange = (id: string, newVal: string) => {\n    const num = newVal === \'\' ? null : Number(newVal);\n    setLocalParams((prev) =>\n      prev.map((p) =>\n        p.id === id ? { ...p, value: isNaN(num as number) ? newVal : num, source: \'manual\' } : p\n      )\n    );\n  };\n\n  const handleSave = () => {\n    const updated = {\n      ...work,\n      parameters: localParams,\n      lastUpdated: new Date().toISOString(),\n    };\n    onSaveWork(updated);\n    onClose();\n  };\n\n  // Bangun substitusi rumus contoh\n  const substitutionParts = localParams\n    .filter((p) => p.value !== null && p.value !== \'\')\n    .map((p) => `${p.label || p.name}: ${p.value} ${p.unit}`);\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold\">\n              <Calculator className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">{work.name}</h3>\n              <p className=\"text-xs text-slate-500\">\n                {work.category} \302\267 {floorName || work.floorId}\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/50 transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Modal Tabs */}\n        <div className=\"flex items-center px-6 border-b border-slate-100 text-xs font-semibold gap-6\">\n          <button\n            onClick={() => setActiveTab(\'params\')}\n            className={`py-3 border-b-2 transition ${\n              activeTab === \'params\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Parameter Input\n          </button>\n          <button\n            onClick={() => setActiveTab(\'formula\')}\n            className={`py-3 border-b-2 transition ${\n              activeTab === \'formula\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Rumus &amp; Substitusi\n          </button>\n          <button\n            onClick={() => setActiveTab(\'ref\')}\n            className={`py-3 border-b-2 transition ${\n              activeTab === \'ref\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Referensi Excel USC\n          </button>\n        </div>\n\n        {/* Content Area */}\n        <div className=\"p-6 max-h-[60vh] overflow-y-auto space-y-4\">\n          {activeTab === \'params\' && (\n            <div className=\"space-y-3.5\">\n              <div className=\"flex items-center justify-between text-xs text-slate-500 pb-1\">\n                <span>Sesuaikan parameter dimensi untuk menghitung ulang volume:</span>\n                <span className=\"font-semibold text-blue-600\">Satuan Akhir: {work.unit}</span>\n              </div>\n\n              {localParams.map((param) => (\n                <div\n                  key={param.id}\n                  className=\"p-3 bg-slate-50/70 rounded-xl border border-slate-200/80 flex items-center justify-between gap-4\"\n                >\n                  <div className=\"min-w-0\">\n                    <label className=\"text-xs font-bold text-slate-800 block truncate\">\n                      {param.label || param.name}\n                      {param.required && <span className=\"text-rose-500 ml-1\">*</span>}\n                    </label>\n                    {param.excelCellRef && (\n                      <span className=\"text-[10px] text-slate-400 block font-mono\">\n                        Sel Sumber: {param.excelCellRef}\n                      </span>\n                    )}\n                  </div>\n\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    <input\n                      type=\"number\"\n                      step=\"any\"\n                      placeholder=\"0.00\"\n                      value={param.value ?? \'\'}\n                      onChange={(e) => handleParamChange(param.id, e.target.value)}\n                      className=\"w-28 px-3 py-1.5 text-xs text-right font-mono font-bold bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition\"\n                    />\n                    <span className=\"text-xs font-semibold text-slate-600 w-8\">{param.unit}</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          )}\n\n          {activeTab === \'formula\' && (\n            <div className=\"space-y-4 text-xs\">\n              <div className=\"p-4 bg-blue-50/60 rounded-xl border border-blue-100\">\n                <span className=\"text-[11px] font-bold text-blue-800 uppercase tracking-wider block mb-1\">\n                  Bentuk Rumus Matematika\n                </span>\n                <p className=\"text-sm font-bold text-blue-950 font-mono\">\n                  {work.formulaDisplay || \'V = perkalian parameter\'}\n                </p>\n              </div>\n\n              <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n                <span className=\"text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-1\">\n                  Substitusi Angka Terkini\n                </span>\n                <p className=\"font-mono text-slate-800 leading-relaxed\">\n                  {substitutionParts.length > 0\n                    ? substitutionParts.join(\' ; \')\n                    : \'Belum ada parameter yang diinput.\'}\n                </p>\n              </div>\n\n              <div className=\"p-4 bg-emerald-50/70 rounded-xl border border-emerald-200 flex items-center justify-between\">\n                <div>\n                  <span className=\"text-[11px] font-bold text-emerald-800 uppercase tracking-wider block\">\n                    Volume Terhitung Saat Ini\n                  </span>\n                  <span className=\"text-xl font-bold text-emerald-950 font-mono\">\n                    {work.calculatedVolume !== null\n                      ? `${formatIndonesianNumber(work.calculatedVolume)} ${work.unit}`\n                      : \'Belum dapat dihitung\'}\n                  </span>\n                </div>\n                <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800\">\n                  {work.status}\n                </span>\n              </div>\n            </div>\n          )}\n\n          {activeTab === \'ref\' && (\n            <div className=\"space-y-3.5 text-xs\">\n              <div className=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                <div className=\"flex items-center justify-between mb-1\">\n                  <span className=\"font-bold text-slate-800\">Sumber Sheet Excel Asli</span>\n                  <span className=\"font-mono text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-100\">\n                    {work.excelSheet || \'Volume Struktural\'}\n                  </span>\n                </div>\n                <p className=\"text-slate-500 text-[11px]\">\n                  Berdasarkan konversi workbook <strong>RAB Gedung USC.xlsx</strong>.\n                </p>\n              </div>\n\n              <div className=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                <span className=\"text-slate-500 block mb-1\">Alamat Sel Hasil Volume</span>\n                <span className=\"font-mono font-bold text-slate-900 block text-sm\">\n                  {work.excelCell || \'-\'}\n                </span>\n              </div>\n\n              {work.excelFormula && (\n                <div className=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                  <span className=\"text-slate-500 block mb-1\">Formula Excel Asli</span>\n                  <span className=\"font-mono font-bold text-blue-900 block text-xs break-all bg-white p-2 rounded border border-slate-200\">\n                    {work.excelFormula}\n                  </span>\n                </div>\n              )}\n\n              {work.statusMessage && (\n                <div className=\"p-3.5 bg-amber-50/70 rounded-xl border border-amber-200/80 text-amber-900 text-xs\">\n                  <div className=\"flex items-start gap-2\">\n                    <Info className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n                    <p>{work.statusMessage}</p>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/40\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition\"\n          >\n            Batal\n          </button>\n          <button\n            onClick={handleSave}\n            className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition shadow-xs\"\n          >\n            <Save className=\"w-3.5 h-3.5\" />\n            <span>Simpan Perubahan</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/WorkDetailModal.tsx"
        }
        overwrite: true
      }
    }
