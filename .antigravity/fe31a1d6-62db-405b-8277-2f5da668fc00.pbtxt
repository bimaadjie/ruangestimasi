            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "1. KLASIFIKASI MULTI-JENIS GAMBAR TEKNIK (\"detectedRegions\"):"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   Periksa seluruh halaman dan bagian/region gambar dalam dokumen, lalu klasifikasikan masing-masing ke dalam salah satu dari 13 jenis gambar berikut:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - \"Denah Arsitektur\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
