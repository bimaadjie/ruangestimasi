            }
            lines {
              text: "     b. Telusuri setiap jalur/segmen sloof atau balok pada grid (baik jalur horizontal sepanjang Grid 1, 2, 3... antar As A-H maupun jalur vertikal sepanjang Grid A, B, C... antar As 1-8)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
