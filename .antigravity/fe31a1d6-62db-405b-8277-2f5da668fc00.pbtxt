      original_chunk {
        target_content: "/**\n * RuangRAB - Penyimpanan Proyek Terisolasi per Pengguna & Mesin Auto Quantity Takeoff\n * Mendukung:\n * - Isolasi data per akun pengguna (LocalStorage terisolasi + Cloud Firestore sync)\n * - Proyek default baru bersih tanpa data demo Gedung USC\n * - Perhitungan panjang total Balok & Sloof berbasis penjumlahan segmen per grid\n * - Penggabungan lintas jenis gambar teknik (Denah Sloof/Balok/Kolom + Tabel Dimensi & Penulangan)\n */\n\nimport { CATALOG_WORK_ITEMS, USC_CATALOG_VERSION } from \'../data/uscCatalog\';\nimport {\n  AIAutoTakeoffSummary,\n  AIBeamSloofSegment,\n  AIDetectedRegion,\n  AIExtractionItem,\n  CatalogWorkItem,\n  FloorItem,\n  ParameterItem,\n  ProjectData,\n  ProjectWorkItem,\n} from \'../types\';\nimport { recalculateAllProjectWorks, safeEvaluateMath } from \'./calculationEngine\';\nimport {\n  auth,\n  db,\n  doc,\n  setDoc,\n  getDocs,\n  deleteDoc,\n  collection,\n  OperationType,\n  handleFirestoreError,\n} from \'../firebase\';\n\nconst LEGACY_STORAGE_KEY_PROJECTS = \'ruangrab_projects_v1\';\nconst STORAGE_PREFIX_USER_PROJECTS = \'ruangrab_user_projects_v2_\';\nconst STORAGE_PREFIX_ACTIVE_PROJECT = \'ruangrab_active_project_v2_\';\nconst STORAGE_KEY_SIDEBAR_COLLAPSED = \'ruangrab_sidebar_collapsed_v1\';\nconst STORAGE_KEY_DISABLED_CATALOG_IDS = \'ruangrab_disabled_catalog_ids_v1\';\nconst STORAGE_KEY_CUSTOM_CATALOG_ITEMS = \'ruangrab_custom_catalog_items_v1\';\n\n/**\n * Preferensi Sidebar Buka-Tutup (Desktop)\n */\nexport function loadSidebarCollapsed(): boolean {\n  try {\n    return localStorage.getItem(STORAGE_KEY_SIDEBAR_COLLAPSED) === \'true\';\n  } catch {\n    return false;\n  }\n}\n\nexport function saveSidebarCollapsed(collapsed: boolean): void {\n  try {\n    localStorage.setItem(STORAGE_KEY_SIDEBAR_COLLAPSED, collapsed ? \'true\' : \'false\');\n  } catch {\n    // ignore storage errors\n  }\n}\n\n/**\n * Pengelolaan Katalog Bawaan yang Dinonaktifkan\n */\nexport function loadDisabledCatalogIds(): string[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY_DISABLED_CATALOG_IDS);\n    if (!raw) return [];\n    const parsed = JSON.parse(raw);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    return [];\n  }\n}\n\nexport function saveDisabledCatalogIds(ids: string[]): void {\n  try {\n    localStorage.setItem(STORAGE_KEY_DISABLED_CATALOG_IDS, JSON.stringify(ids));\n  } catch (err) {\n    console.error(\'Gagal menyimpan status katalog nonaktif:\', err);\n  }\n}\n\n/**\n * Pengelolaan Katalog Pekerjaan Kustom\n */\nexport function loadCustomCatalogItems(): CatalogWorkItem[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS);\n    if (!raw) return [];\n    const parsed: CatalogWorkItem[] = JSON.parse(raw);\n    if (!Array.isArray(parsed)) return [];\n    return parsed.map((item) => ({\n      ...item,\n      isCustomCatalog: true,\n      calculationMethod: (params: Record<string, number>) => {\n        if (item.customFormula) {\n          const res = safeEvaluateMath(item.customFormula, params);\n          return isNaN(res) || !isFinite(res) ? null : res;\n        }\n        const keys = Object.keys(params);\n        if (keys.length === 0) return null;\n        return keys.reduce((acc, k) => acc * params[k], 1);\n      },\n    }));\n  } catch {\n    return [];\n  }\n}\n\nexport function saveCustomCatalogItems(items: CatalogWorkItem[]): void {\n  try {\n    const serializable = items.map(({ calculationMethod, ...rest }) => ({\n      ...rest,\n      isCustomCatalog: true,\n    }));\n    localStorage.setItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS, JSON.stringify(serializable));\n  } catch (err) {\n    console.error(\'Gagal menyimpan katalog kustom:\', err);\n  }\n}\n\nexport function getAllCatalogItems(): CatalogWorkItem[] {\n  return [...CATALOG_WORK_ITEMS, ...loadCustomCatalogItems()];\n}\n\n/**\n * Buat pekerjaan proyek dari entri katalog untuk lantai tertentu\n */\nexport function createProjectWorkFromCatalog(\n  catalogId: string,\n  floorId: string,\n  initialParamValues: Record<string, number | null> = {},\n  options?: {\n    origin?: \'manual\' | \'ai\';\n    aiVerificationStatus?: \'draft\' | \'verified\';\n    sourceDocument?: string;\n    identificationReason?: string;\n    dedupKey?: string;\n    elementLocation?: string;\n    elementCode?: string;\n    segments?: AIBeamSloofSegment[];\n  }\n): ProjectWorkItem | null {\n  const allCatalog = getAllCatalogItems();\n  const catalog = allCatalog.find((c) => c.id === catalogId);\n  if (!catalog) return null;\n\n  const params: ParameterItem[] = catalog.parameters.map((p) => {\n    const hasInitial = Object.prototype.hasOwnProperty.call(initialParamValues, p.id);\n    const val = hasInitial ? initialParamValues[p.id] : p.value;\n    return {\n      ...p,\n      value: val,\n      source: hasInitial && val !== null ? (options?.origin === \'ai\' ? \'ai\' : \'manual\') : p.source,\n      sourceDocument: hasInitial && val !== null ? options?.sourceDocument : undefined,\n      isVerified: options?.origin === \'ai\' ? false : true,\n    };\n  });\n\n  const item: ProjectWorkItem = {\n    id: `work-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,\n    catalogId: catalog.id,\n    dedupKey: options?.dedupKey,\n    name: catalog.name,\n    category: catalog.category,\n    subCategory: catalog.subCategory,\n    floorId,\n    elementLocation: options?.elementLocation,\n    elementCode: options?.elementCode,\n    segments: options?.segments,\n    unit: catalog.defaultUnit,\n    formulaDisplay: catalog.formulaDisplay,\n    customFormula: catalog.customFormula,\n    parameters: params,\n    components: [],\n    calculatedVolume: null,\n    status: options?.origin === \'ai\' ? \'Draf AI \342\200\224 Perlu Verifikasi\' : \'Perlu Input\',\n    origin: options?.origin || \'manual\',\n    aiVerificationStatus: options?.aiVerificationStatus || \'verified\',\n    sourceDocument: options?.sourceDocument,\n    identificationReason: options?.identificationReason,\n    excelSheet: catalog.excelSheet,\n    excelCell: catalog.excelCell,\n    excelFormula: catalog.excelFormula,\n    isActive: true,\n    lastUpdated: new Date().toISOString(),\n  };\n\n  return item;\n}"
        replacement_content: "/**\n * RuangEstimasi - Penyimpanan Proyek Terisolasi per Pengguna & Mesin Auto Quantity Takeoff\n * Mendukung:\n * - Isolasi data per akun pengguna (LocalStorage terisolasi + Cloud Firestore sync)\n * - Penyediaan daftar pekerjaan konstruksi standar otomatis pada setiap proyek & lantai baru (tanpa nilai dimensi bawaan USC)\n * - Pemisahan tegas antara Katalog Pekerjaan Standar Global dan Data Pekerjaan Proyek\n * - Perhitungan panjang total Balok & Sloof berbasis penjumlahan segmen per grid\n * - Penggabungan lintas jenis gambar teknik (Denah Sloof/Balok/Kolom + Tabel Dimensi & Penulangan)\n */\n\nimport { CATALOG_WORK_ITEMS, USC_CATALOG_VERSION } from \'../data/uscCatalog\';\nimport {\n  AIAutoTakeoffSummary,\n  AIBeamSloofSegment,\n  AIDetectedRegion,\n  AIExtractionItem,\n  CatalogWorkItem,\n  FloorItem,\n  ParameterItem,\n  ProjectData,\n  ProjectWorkItem,\n} from \'../types\';\nimport { recalculateAllProjectWorks, safeEvaluateMath } from \'./calculationEngine\';\nimport {\n  auth,\n  db,\n  doc,\n  setDoc,\n  getDocs,\n  deleteDoc,\n  collection,\n  OperationType,\n  handleFirestoreError,\n} from \'../firebase\';\n\nconst LEGACY_STORAGE_KEY_PROJECTS = \'ruangrab_projects_v1\';\nconst STORAGE_PREFIX_USER_PROJECTS = \'ruangrab_user_projects_v2_\';\nconst STORAGE_PREFIX_ACTIVE_PROJECT = \'ruangrab_active_project_v2_\';\nconst STORAGE_KEY_SIDEBAR_COLLAPSED = \'ruangrab_sidebar_collapsed_v1\';\nconst STORAGE_KEY_DISABLED_CATALOG_IDS = \'ruangrab_disabled_catalog_ids_v1\';\nconst STORAGE_KEY_CUSTOM_CATALOG_ITEMS = \'ruangrab_custom_catalog_items_v1\';\n\n/**\n * Daftar ID Katalog Pekerjaan Standar Default per Kelompok Lantai\n * (Hanya membawa nama, satuan, rumus, dan struktur parameter kosong \342\200\224 TANPA nilai dimensi proyek USC)\n */\nexport const DEFAULT_UMUM_PONDASI_CATALOG_IDS: string[] = [\n  \'prep-pembersihan-lahan\',\n  \'prep-pagar-sementara\',\n  \'prep-bouwplank\',\n  \'prep-gudang-alat\',\n  \'str-galian-tanah-biasa-1m\',\n  \'str-galian-pondasi-footplat\',\n  \'str-urugan-kembali-tanah\',\n  \'str-urugan-pasir-pondasi\',\n  \'str-aanstamping-batu-kosong\',\n  \'str-pondasi-batu-kali\',\n  \'str-lantai-kerja-pondasi\',\n  \'str-footplat-beton\',\n  \'str-sloof-beton\',\n  \'str-sloof-s2\',\n];\n\nexport const DEFAULT_LANTAI_1_CATALOG_IDS: string[] = [\n  \'str-kolom-k1-beton\',\n  \'str-kolom-k2-beton\',\n  \'str-kolom-praktis\',\n  \'str-balok-induk\',\n  \'str-balok-anak\',\n  \'str-balok-b1-beton\',\n  \'str-balok-b2-beton\',\n  \'str-plat-lantai-beton\',\n  \'str-tangga-beton\',\n  \'ars-dinding-bata-hebel\',\n  \'ars-plesteran-acian-15mm\',\n  \'ars-pengecatan-dinding-interior\',\n  \'ars-homogenous-tile-60x60\',\n  \'ars-keramik-toilet-antislip\',\n  \'ars-plafond-gypsum-9mm\',\n  \'ars-pintu-kayu-engineering\',\n  \'ars-jendela-aluminium-kaca\',\n  \'mep-titik-lampu-nyy\',\n  \'mep-stop-kontak\',\n  \'mep-kloset-duduk\',\n  \'mep-pipa-air-bersih-pvc\',\n];\n\nexport const DEFAULT_LANTAI_ATAS_CATALOG_IDS: string[] = [\n  \'str-kolom-k1-beton\',\n  \'str-kolom-k2-beton\',\n  \'str-kolom-praktis\',\n  \'str-balok-induk\',\n  \'str-balok-anak\',\n  \'str-balok-b1-beton\',\n  \'str-balok-b2-beton\',\n  \'str-ring-balok\',\n  \'str-plat-lantai-beton\',\n  \'str-tangga-beton\',\n  \'ars-dinding-bata-hebel\',\n  \'ars-plesteran-acian-15mm\',\n  \'ars-pengecatan-dinding-interior\',\n  \'ars-homogenous-tile-60x60\',\n  \'ars-keramik-toilet-antislip\',\n  \'ars-plafond-gypsum-9mm\',\n  \'ars-pintu-kayu-engineering\',\n  \'ars-jendela-aluminium-kaca\',\n  \'mep-titik-lampu-nyy\',\n  \'mep-stop-kontak\',\n  \'mep-kloset-duduk\',\n  \'mep-pipa-air-bersih-pvc\',\n];\n\n/**\n * Preferensi Sidebar Buka-Tutup (Desktop)\n */\nexport function loadSidebarCollapsed(): boolean {\n  try {\n    return localStorage.getItem(STORAGE_KEY_SIDEBAR_COLLAPSED) === \'true\';\n  } catch {\n    return false;\n  }\n}\n\nexport function saveSidebarCollapsed(collapsed: boolean): void {\n  try {\n    localStorage.setItem(STORAGE_KEY_SIDEBAR_COLLAPSED, collapsed ? \'true\' : \'false\');\n  } catch {\n    // ignore storage errors\n  }\n}\n\n/**\n * Pengelolaan Katalog Bawaan yang Dinonaktifkan\n */\nexport function loadDisabledCatalogIds(): string[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY_DISABLED_CATALOG_IDS);\n    if (!raw) return [];\n    const parsed = JSON.parse(raw);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    return [];\n  }\n}\n\nexport function saveDisabledCatalogIds(ids: string[]): void {\n  try {\n    localStorage.setItem(STORAGE_KEY_DISABLED_CATALOG_IDS, JSON.stringify(ids));\n  } catch (err) {\n    console.error(\'Gagal menyimpan status katalog nonaktif:\', err);\n  }\n}\n\n/**\n * Pengelolaan Katalog Pekerjaan Kustom\n */\nexport function loadCustomCatalogItems(): CatalogWorkItem[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS);\n    if (!raw) return [];\n    const parsed: CatalogWorkItem[] = JSON.parse(raw);\n    if (!Array.isArray(parsed)) return [];\n    return parsed.map((item) => ({\n      ...item,\n      isCustomCatalog: true,\n      calculationMethod: (params: Record<string, number>) => {\n        if (item.customFormula) {\n          const res = safeEvaluateMath(item.customFormula, params);\n          return isNaN(res) || !isFinite(res) ? null : res;\n        }\n        const keys = Object.keys(params);\n        if (keys.length === 0) return null;\n        return keys.reduce((acc, k) => acc * params[k], 1);\n      },\n    }));\n  } catch {\n    return [];\n  }\n}\n\nexport function saveCustomCatalogItems(items: CatalogWorkItem[]): void {\n  try {\n    const serializable = items.map(({ calculationMethod, ...rest }) => ({\n      ...rest,\n      isCustomCatalog: true,\n    }));\n    localStorage.setItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS, JSON.stringify(serializable));\n  } catch (err) {\n    console.error(\'Gagal menyimpan katalog kustom:\', err);\n  }\n}\n\nexport function getAllCatalogItems(): CatalogWorkItem[] {\n  return [...CATALOG_WORK_ITEMS, ...loadCustomCatalogItems()];\n}\n\n/**\n * Buat pekerjaan proyek dari entri katalog untuk lantai tertentu\n * Seluruh parameter di-clone secara independen agar modifikasi pada satu proyek tidak mengubah katalog global atau proyek lain.\n */\nexport function createProjectWorkFromCatalog(\n  catalogId: string,\n  floorId: string,\n  initialParamValues: Record<string, number | null> = {},\n  options?: {\n    origin?: \'manual\' | \'ai\';\n    aiVerificationStatus?: \'draft\' | \'verified\';\n    sourceDocument?: string;\n    identificationReason?: string;\n    dedupKey?: string;\n    elementLocation?: string;\n    elementCode?: string;\n    segments?: AIBeamSloofSegment[];\n  }\n): ProjectWorkItem | null {\n  const allCatalog = getAllCatalogItems();\n  const catalog = allCatalog.find((c) => c.id === catalogId);\n  if (!catalog) return null;\n\n  const params: ParameterItem[] = catalog.parameters.map((p) => {\n    const hasInitial = Object.prototype.hasOwnProperty.call(initialParamValues, p.id);\n    const val = hasInitial ? initialParamValues[p.id] : null; // Selalu mulai dengan null (kosong) jika tidak diberikan\n    return {\n      ...p,\n      value: val,\n      source: hasInitial && val !== null ? (options?.origin === \'ai\' ? \'ai\' : \'manual\') : \'manual\',\n      sourceDocument: hasInitial && val !== null ? options?.sourceDocument : undefined,\n      isVerified: options?.origin === \'ai\' ? false : true,\n      conflict: null,\n    };\n  });\n\n  const item: ProjectWorkItem = {\n    id: `work-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,\n    catalogId: catalog.id,\n    dedupKey: options?.dedupKey || `${floorId}::${catalog.id}`,\n    name: catalog.name,\n    category: catalog.category,\n    subCategory: catalog.subCategory,\n    floorId,\n    elementLocation: options?.elementLocation,\n    elementCode: options?.elementCode,\n    segments: options?.segments,\n    unit: catalog.defaultUnit,\n    formulaDisplay: catalog.formulaDisplay,\n    customFormula: catalog.customFormula,\n    parameters: params,\n    components: [],\n    calculatedVolume: null,\n    status: options?.origin === \'ai\' ? \'Perlu Verifikasi\' : \'Belum Diisi\',\n    origin: options?.origin || \'manual\',\n    aiVerificationStatus: options?.aiVerificationStatus || \'verified\',\n    sourceDocument: options?.sourceDocument,\n    identificationReason: options?.identificationReason,\n    excelSheet: catalog.excelSheet,\n    excelCell: catalog.excelCell,\n    excelFormula: catalog.excelFormula,\n    isActive: true,\n    lastUpdated: new Date().toISOString(),\n  };\n\n  return item;\n}\n\n/**\n * Buat daftar pekerjaan konstruksi standar (template kosong tanpa dimensi/volume) untuk lantai tertentu\n */\nexport function createDefaultWorksForFloor(\n  floorId: string,\n  floorLevel: number\n): ProjectWorkItem[] {\n  const catalogIds =\n    floorId === \'fl-umum\' || floorLevel === 0\n      ? DEFAULT_UMUM_PONDASI_CATALOG_IDS\n      : floorLevel === 1\n      ? DEFAULT_LANTAI_1_CATALOG_IDS\n      : DEFAULT_LANTAI_ATAS_CATALOG_IDS;\n\n  const works: ProjectWorkItem[] = [];\n  for (const catId of catalogIds) {\n    const work = createProjectWorkFromCatalog(catId, floorId, {}, {\n      origin: \'manual\',\n      aiVerificationStatus: \'verified\',\n      dedupKey: `${floorId}::${catId}`,\n    });\n    if (work) {\n      works.push(work);\n    }\n  }\n  return works;\n}"
