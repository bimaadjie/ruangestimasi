    end_line: 195
    content: "import React, { useState } from \'react\';\nimport {\n  Building2,\n  Layers,\n  Calendar,\n  Pencil,\n  Check,\n  Plus,\n  Save,\n  Download,\n  Bell,\n  Sparkles,\n} from \'lucide-react\';\nimport { ProjectData } from \'../types\';\n\ninterface HeaderProps {\n  project: ProjectData;\n  onUpdateProjectName: (newName: string) => void;\n  onOpenFloors: () => void;\n  onNewProject: () => void;\n  onSaveProject: () => void;\n  onExportExcel: () => void;\n  isSaving?: boolean;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  project,\n  onUpdateProjectName,\n  onOpenFloors,\n  onNewProject,\n  onSaveProject,\n  onExportExcel,\n  isSaving,\n}) => {\n  const [isEditingTitle, setIsEditingTitle] = useState(false);\n  const [titleInput, setTitleInput] = useState(project.name);\n\n  const handleTitleSubmit = () => {\n    if (titleInput.trim()) {\n      onUpdateProjectName(titleInput.trim());\n    } else {\n      setTitleInput(project.name);\n    }\n    setIsEditingTitle(false);\n  };\n\n  const formattedDate = new Date(project.createdAt).toLocaleDateString(\'id-ID\', {\n    day: \'numeric\',\n    month: \'short\',\n    year: \'numeric\',\n  });\n\n  return (\n    <header className=\"relative bg-white border-b border-slate-200 overflow-hidden\">\n      {/* Subtle civil engineering blueprint watermark background */}\n      <div\n        className=\"absolute inset-0 pointer-events-none opacity-[0.035] bg-repeat\"\n        style={{\n          backgroundImage: `radial-gradient(#173B73 1px, transparent 1px)`,\n          backgroundSize: \'16px 16px\',\n        }}\n      />\n      <div className=\"absolute right-0 top-0 bottom-0 w-80 pointer-events-none opacity-10 hidden lg:block overflow-hidden\">\n        <svg viewBox=\"0 0 200 120\" className=\"w-full h-full text-blue-900 fill-current\">\n          <path d=\"M10 110 L10 40 L60 20 L110 40 L110 110 Z M60 20 L60 110 M120 110 L120 10 L190 30 L190 110 Z\" />\n        </svg>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-6 py-5 relative z-10\">\n        {/* Top bar with user profile & quick action */}\n        <div className=\"flex items-center justify-between pb-4 border-b border-slate-100\">\n          <div>\n            <span className=\"text-xs font-medium text-slate-500\">Selamat datang, Adjie \360\237\221\213</span>\n            <div className=\"flex items-center gap-2 mt-0.5\">\n              {isEditingTitle ? (\n                <div className=\"flex items-center gap-1.5\">\n                  <input\n                    type=\"text\"\n                    value={titleInput}\n                    onChange={(e) => setTitleInput(e.target.value)}\n                    onKeyDown={(e) => e.key === \'Enter\' && handleTitleSubmit()}\n                    className=\"text-2xl font-bold text-slate-900 border border-blue-400 rounded-md px-2 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                    autoFocus\n                  />\n                  <button\n                    onClick={handleTitleSubmit}\n                    className=\"p-1.5 rounded-md bg-blue-600 text-white hover:bg-blue-700 transition\"\n                  >\n                    <Check className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              ) : (\n                <div className=\"flex items-center gap-2 group\">\n                  <h2 className=\"text-2xl font-bold text-slate-900 tracking-tight\">{project.name}</h2>\n                  <button\n                    onClick={() => {\n                      setTitleInput(project.name);\n                      setIsEditingTitle(true);\n                    }}\n                    className=\"p-1 text-slate-400 hover:text-blue-600 rounded-md transition\"\n                    title=\"Ubah Nama Proyek\"\n                  >\n                    <Pencil className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              )}\n            </div>\n            <p className=\"text-xs text-slate-500 mt-0.5\">Kalkulator volume pekerjaan konstruksi (Quantity Takeoff)</p>\n          </div>\n\n          {/* Right Header User & Actions */}\n          <div className=\"flex items-center gap-3\">\n            <button\n              onClick={onNewProject}\n              className=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition shadow-xs\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              Proyek Baru\n            </button>\n            <button\n              onClick={onSaveProject}\n              disabled={isSaving}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition shadow-xs\"\n            >\n              <Save className=\"w-3.5 h-3.5 text-blue-600\" />\n              {isSaving ? \'Menyimpan...\' : \'Simpan\'}\n            </button>\n            <button\n              onClick={onExportExcel}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition shadow-xs\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n              Ekspor Excel\n            </button>\n            <div className=\"h-6 w-px bg-slate-200 mx-1 hidden sm:block\" />\n            <div className=\"flex items-center gap-2.5\">\n              <button className=\"p-2 text-slate-400 hover:text-slate-600 rounded-lg transition hover:bg-slate-100\">\n                <Bell className=\"w-4 h-4\" />\n              </button>\n              <div className=\"flex items-center gap-2 pl-1\">\n                <div className=\"w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold ring-2 ring-blue-100\">\n                  AK\n                </div>\n                <div className=\"text-left hidden md:block\">\n                  <span className=\"text-xs font-semibold text-slate-800 block leading-tight\">Adjie</span>\n                  <span className=\"text-[10px] text-slate-400 block leading-none\">Estimator</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* 3 Metric Cards matching Mockup */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4\">\n          <div className=\"flex items-center gap-3.5 p-3.5 bg-slate-50/80 rounded-xl border border-slate-200/80 shadow-2xs\">\n            <div className=\"w-10 h-10 rounded-lg bg-blue-100/80 text-blue-700 flex items-center justify-center shrink-0\">\n              <Building2 className=\"w-5 h-5\" />\n            </div>\n            <div className=\"min-w-0\">\n              <span className=\"text-[11px] font-medium text-slate-500 uppercase tracking-wider block\">Nama Proyek</span>\n              <span className=\"text-sm font-bold text-slate-900 truncate block\">{project.name}</span>\n            </div>\n          </div>\n\n          <div\n            onClick={onOpenFloors}\n            className=\"flex items-center gap-3.5 p-3.5 bg-slate-50/80 rounded-xl border border-slate-200/80 shadow-2xs cursor-pointer hover:border-blue-300 hover:bg-blue-50/30 transition group\"\n            title=\"Klik untuk kelola lantai\"\n          >\n            <div className=\"w-10 h-10 rounded-lg bg-blue-100/80 text-blue-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform\">\n              <Layers className=\"w-5 h-5\" />\n            </div>\n            <div className=\"min-w-0 flex-1\">\n              <span className=\"text-[11px] font-medium text-slate-500 uppercase tracking-wider block\">Jumlah Lantai</span>\n              <span className=\"text-sm font-bold text-slate-900 flex items-center gap-1.5\">\n                {project.floorCount} Lantai\n                <span className=\"text-[10px] text-blue-600 font-normal underline\">Kelola</span>\n              </span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3.5 p-3.5 bg-slate-50/80 rounded-xl border border-slate-200/80 shadow-2xs\">\n            <div className=\"w-10 h-10 rounded-lg bg-blue-100/80 text-blue-700 flex items-center justify-center shrink-0\">\n              <Calendar className=\"w-5 h-5\" />\n            </div>\n            <div className=\"min-w-0\">\n              <span className=\"text-[11px] font-medium text-slate-500 uppercase tracking-wider block\">Tanggal Proyek</span>\n              <span className=\"text-sm font-bold text-slate-900 truncate block\">{formattedDate}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    num_lines: 196
    num_bytes: 8464
    line_range_bytes: 8464
  }
}
