  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport {\n  Building2,\n  Layers,\n  Calendar,\n  Pencil,\n  Check,\n  Plus,\n  Save,\n  Download,\n  Menu,\n  PanelLeftClose,\n  PanelLeftOpen,\n  LogOut,\n  UserCog,\n} from \'lucide-react\';\nimport { ProjectData, UserProfile } from \'../types\';\nimport { getInitials } from \'../services/authService\';\n\ninterface HeaderProps {\n  user: UserProfile;\n  project: ProjectData;\n  onUpdateProjectName: (newName: string) => void;\n  onOpenFloors: () => void;\n  onNewProject: () => void;\n  onSaveProject: () => void;\n  onExportExcel: () => void;\n  onOpenMobileMenu: () => void;\n  onOpenUserProfile: () => void;\n  onLogout: () => void;\n  isSidebarCollapsed?: boolean;\n  onToggleSidebarCollapse?: () => void;\n  isSaving?: boolean;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  user,\n  project,\n  onUpdateProjectName,\n  onOpenFloors,\n  onNewProject,\n  onSaveProject,\n  onExportExcel,\n  onOpenMobileMenu,\n  onOpenUserProfile,\n  onLogout,\n  isSidebarCollapsed,\n  onToggleSidebarCollapse,\n  isSaving,\n}) => {\n  const [isEditingTitle, setIsEditingTitle] = useState(false);\n  const [titleInput, setTitleInput] = useState(project.name);\n\n  useEffect(() => {\n    setTitleInput(project.name);\n  }, [project.name]);\n\n  const handleTitleSubmit = () => {\n    if (titleInput.trim()) {\n      onUpdateProjectName(titleInput.trim());\n    } else {\n      setTitleInput(project.name);\n    }\n    setIsEditingTitle(false);\n  };\n\n  const formattedDate = new Date(project.createdAt).toLocaleDateString(\'id-ID\', {\n    day: \'numeric\',\n    month: \'short\',\n    year: \'numeric\',\n  });\n\n  return (\n    <header className=\"relative bg-white border-b border-slate-200 overflow-hidden\">\n      {/* Subtle civil engineering blueprint watermark background */}\n      <div\n        className=\"absolute inset-0 pointer-events-none opacity-[0.035] bg-repeat\"\n        style={{\n          backgroundImage: `radial-gradient(#173B73 1px, transparent 1px)`,\n          backgroundSize: \'16px 16px\',\n        }}\n      />\n      <div className=\"absolute right-0 top-0 bottom-0 w-80 pointer-events-none opacity-10 hidden lg:block overflow-hidden\">\n        <svg viewBox=\"0 0 200 120\" className=\"w-full h-full text-blue-900 fill-current\">\n          <path d=\"M10 110 L10 40 L60 20 L110 40 L110 110 Z M60 20 L60 110 M120 110 L120 10 L190 30 L190 110 Z\" />\n        </svg>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-5 relative z-10\">\n        {/* Top bar with user profile & quick action */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-100\">\n          <div className=\"flex items-start gap-3 min-w-0\">\n            {/* Mobile Hamburger Button */}\n            <button\n              onClick={onOpenMobileMenu}\n              className=\"md:hidden mt-1 p-2 rounded-lg border border-slate-200 text-slate-600 hover:text-blue-700 hover:bg-blue-50 transition shrink-0 cursor-pointer\"\n              aria-label=\"Buka Menu Navigasi\"\n              title=\"Buka Menu Navigasi\"\n            >\n              <Menu className=\"w-5 h-5\" />\n            </button>\n\n            {/* Desktop Sidebar Collapse Quick Toggle */}\n            {onToggleSidebarCollapse && (\n              <button\n                onClick={onToggleSidebarCollapse}\n                className=\"hidden md:inline-flex mt-1 p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-blue-700 hover:bg-blue-50 transition shrink-0 cursor-pointer\"\n                title={isSidebarCollapsed ? \'Lebarkan Sidebar Menu\' : \'Ciutkan Sidebar Menu\'}\n                aria-label={isSidebarCollapsed ? \'Lebarkan Sidebar Menu\' : \'Ciutkan Sidebar Menu\'}\n              >\n                {isSidebarCollapsed ? (\n                  <PanelLeftOpen className=\"w-4 h-4\" />\n                ) : (\n                  <PanelLeftClose className=\"w-4 h-4\" />\n                )}\n              </button>\n            )}\n\n            <div className=\"min-w-0\">\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                <span className=\"text-xs font-medium text-slate-500\">\n                  Selamat datang, <strong className=\"text-slate-700\">{user.fullName}</strong>\n                </span>\n                <span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200\">\n                  {user.userType}\n                </span>\n              </div>\n              <div className=\"flex items-center gap-2 mt-0.5\">\n                {isEditingTitle ? (\n                  <div className=\"flex items-center gap-1.5\">\n                    <input\n                      type=\"text\"\n                      value={titleInput}\n                      onChange={(e) => setTitleInput(e.target.value)}\n                      onKeyDown={(e) => e.key === \'Enter\' && handleTitleSubmit()}\n                      className=\"text-xl sm:text-2xl font-bold text-slate-900 border border-blue-400 rounded-md px-2 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                      autoFocus\n                    />\n                    <button\n                      onClick={handleTitleSubmit}\n                      className=\"p-1.5 rounded-md bg-blue-600 text-white hover:bg-blue-700 transition cursor-pointer\"\n                    >\n                      <Check className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"flex items-center gap-2 group min-w-0\">\n                    <h2 className=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight truncate\">\n                      {project.name}\n                    </h2>\n                    <button\n                      onClick={() => {\n                        setTitleInput(project.name);\n                        setIsEditingTitle(true);\n                      }}\n                      className=\"p-1 text-slate-400 hover:text-blue-600 rounded-md transition shrink-0 cursor-pointer\"\n                      title=\"Ubah Nama Proyek\"\n                    >\n                      <Pencil className=\"w-3.5 h-3.5\" />\n                    </button>\n                  </div>\n                )}\n              </div>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Kalkulator volume pekerjaan konstruksi (Quantity Takeoff)\n              </p>\n            </div>\n          </div>\n\n          {/* Right Header User & Actions */}\n          <div className=\"flex items-center gap-2 sm:gap-2.5\">\n            <button\n              onClick={onNewProject}\n              className=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition shadow-xs cursor-pointer\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              Proyek\n            </button>\n            <button\n              onClick={onSaveProject}\n              disabled={isSaving}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition shadow-xs cursor-pointer\"\n            >\n              <Save className=\"w-3.5 h-3.5 text-blue-600\" />\n              {isSaving ? \'Menyimpan...\' : \'Simpan\'}\n            </button>\n            <button\n              onClick={onExportExcel}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition shadow-xs cursor-pointer\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n              Ekspor Excel\n            </button>\n\n            <div className=\"h-6 w-px bg-slate-200 mx-0.5 hidden sm:block\" />\n\n            {/* User Profile Pill & Logout */}\n            <div className=\"flex items-center gap-1.5\">\n              <button\n                type=\"button\"\n                onClick={onOpenUserProfile}\n                title=\"Pengaturan Profil Akun\"\n                className=\"flex items-center gap-2 pl-1.5 pr-2.5 py-1 rounded-xl border border-slate-200 hover:border-blue-300 hover:bg-blue-50/40 transition cursor-pointer\"\n              >\n                <div className=\"w-7 h-7 rounded-full bg-blue-700 text-white flex items-center justify-center text-[11px] font-bold ring-2 ring-blue-100 shrink-0\">\n                  {getInitials(user.fullName)}\n                </div>\n                <div className=\"text-left hidden md:block max-w-[130px]\">\n                  <span className=\"text-xs font-bold text-slate-800 block leading-tight truncate\">\n                    {user.fullName}\n                  </span>\n                  <span className=\"text-[10px] text-blue-600 font-semibold block leading-none truncate\">\n                    {user.userType}\n                  </span>\n                </div>\n                <UserCog className=\"w-3.5 h-3.5 text-slate-400 hidden sm:block\" />\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={onLogout}\n                title=\"Keluar dari Akun (Logout)\"\n                className=\"p-2 rounded-xl border border-slate-200 text-slate-500 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition cursor-pointer\"\n              >\n                <LogOut className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* 3 Metric Cards */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4\">\n          <div className=\"flex items-center gap-3.5 p-3.5 bg-slate-50/80 rounded-xl border border-slate-200/80 shadow-2xs\">\n            <div className=\"w-10 h-10 rounded-lg bg-blue-100/80 text-blue-700 flex items-center justify-center shrink-0\">\n              <Building2 className=\"w-5 h-5\" />\n            </div>\n            <div className=\"min-w-0\">\n              <span className=\"text-[11px] font-medium text-slate-500 uppercase tracking-wider block\">\n                Nama Proyek\n              </span>\n              <span className=\"text-sm font-bold text-slate-900 truncate block\">{project.name}</span>\n            </div>\n          </div>\n\n          <div\n            onClick={onOpenFloors}\n            className=\"flex items-center gap-3.5 p-3.5 bg-slate-50/80 rounded-xl border border-slate-200/80 shadow-2xs cursor-pointer hover:border-blue-300 hover:bg-blue-50/30 transition group\"\n            title=\"Klik untuk kelola lantai\"\n          >\n            <div className=\"w-10 h-10 rounded-lg bg-blue-100/80 text-blue-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform\">\n              <Layers className=\"w-5 h-5\" />\n            </div>\n            <div className=\"min-w-0 flex-1\">\n              <span className=\"text-[11px] font-medium text-slate-500 uppercase tracking-wider block\">\n                Jumlah Lantai\n              </span>\n              <span className=\"text-sm font-bold text-slate-900 flex items-center gap-1.5\">\n                {project.floorCount} Lantai\n                <span className=\"text-[10px] text-blue-600 font-normal underline\">Kelola</span>\n              </span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3.5 p-3.5 bg-slate-50/80 rounded-xl border border-slate-200/80 shadow-2xs\">\n            <div className=\"w-10 h-10 rounded-lg bg-blue-100/80 text-blue-700 flex items-center justify-center shrink-0\">\n              <Calendar className=\"w-5 h-5\" />\n            </div>\n            <div className=\"min-w-0\">\n              <span className=\"text-[11px] font-medium text-slate-500 uppercase tracking-wider block\">\n                Tanggal Proyek\n              </span>\n              <span className=\"text-sm font-bold text-slate-900 truncate block\">{formattedDate}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
