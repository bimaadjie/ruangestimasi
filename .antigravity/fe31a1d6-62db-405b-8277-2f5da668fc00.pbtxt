    replacement_infos {
      original_chunk {
        target_content: "  // Cari item pada katalog bawaan\n  const catalogEntry = CATALOG_WORK_ITEMS.find((c) => c.id === item.catalogId);\n\n  // Kumpulkan nilai parameter dalam bentuk Record<string, number>\n  const paramMap: Record<string, number> = {};\n  let missingRequired = false;\n  let missingParamName = \'\';\n\n  for (const p of item.parameters) {\n    if (p.value !== null && p.value !== \'\' && !isNaN(Number(p.value))) {\n      paramMap[p.id] = Number(p.value);\n    } else if (p.required) {\n      // Cek apakah ada nilai turunan dari pekerjaan lain\n      if (p.id === \'volume_galian\') {\n        const galianWork = allProjectWorks.find(\n          (w) => w.id.includes(\'galian\') || w.name.toLowerCase().includes(\'galian\')\n        );\n        if (galianWork && galianWork.calculatedVolume !== null) {\n          paramMap[p.id] = galianWork.calculatedVolume;\n          p.value = galianWork.calculatedVolume;\n          p.source = \'derived\';\n          continue;\n        }\n      }\n\n      if (p.id === \'luas_dinding_bersih\') {\n        const dindingWork = allProjectWorks.find(\n          (w) => w.floorId === item.floorId && (w.name.toLowerCase().includes(\'dinding bata\') || w.id.includes(\'dinding\'))\n        );\n        if (dindingWork && dindingWork.calculatedVolume !== null) {\n          paramMap[p.id] = dindingWork.calculatedVolume;\n          p.value = dindingWork.calculatedVolume;\n          p.source = \'derived\';\n          continue;\n        }\n      }\n\n      missingRequired = true;\n      missingParamName = p.label || p.name;\n    }\n  }\n\n  if (missingRequired) {\n    return {\n      volume: null,\n      status: \'Perlu Input\',\n      message: `Parameter \"${missingParamName}\" belum diisi.`,\n    };\n  }\n\n  // Jalankan rumus kalkulasi katalog\n  if (catalogEntry) {\n    try {\n      const result = catalogEntry.calculationMethod(paramMap, item.components);\n      if (result === null || isNaN(result)) {\n        return {\n          volume: null,\n          status: \'Perlu Input\',\n          message: \'Parameter wajib belum lengkap.\',\n        };\n      }\n\n      if (!isFinite(result)) {\n        return {\n          volume: null,\n          status: \'Kesalahan Perhitungan\',\n          message: \'Terjadi pembagian dengan nol atau nilai tak terhingga.\',\n        };\n      }\n\n      const status: CalculationStatus =\n        catalogEntry.verificationStatus === \'Perlu Verifikasi\'\n          ? \'Perlu Verifikasi\'\n          : \'Lengkap\';\n\n      return {\n        volume: result,\n        status,\n        message: catalogEntry.verificationNotes,\n      };\n    } catch (err: unknown) {\n      const errorMsg = err instanceof Error ? err.message : String(err);\n      return {\n        volume: null,\n        status: \'Kesalahan Perhitungan\',\n        message: errorMsg || \'Gagal menghitung rumus.\',\n      };\n    }\n  }\n\n  // Jika pekerjaan kustom dengan ekspresi rumus buatan pengguna\n  if (item.customFormula) {\n    const customResult = safeEvaluateMath(item.customFormula, paramMap);\n    if (isNaN(customResult) || !isFinite(customResult)) {\n      return {\n        volume: null,\n        status: \'Kesalahan Perhitungan\',\n        message: \'Rumus kustom menghasilkan kesalahan evaluasi matematika.\',\n      };\n    }\n    return { volume: customResult, status: \'Lengkap\' };\n  }\n\n  // Default: coba perkalian sederhana parameter yang ada\n  const keys = Object.keys(paramMap);\n  if (keys.length > 0) {\n    const product = keys.reduce((acc, k) => acc * paramMap[k], 1);\n    return { volume: product, status: \'Lengkap\' };\n  }\n\n  return {\n    volume: null,\n    status: \'Perlu Input\',\n    message: \'Isi parameter perhitungan.\',\n  };\n}\n\n/**\n * Hitung ulang seluruh daftar pekerjaan dalam proyek dengan penanganan dependensi\n */\nexport function recalculateAllProjectWorks(works: ProjectWorkItem[]): ProjectWorkItem[] {\n  // Jalankan dua pass untuk menyelesaikan nilai turunan (derived dependencies)\n  let updatedWorks = [...works];\n\n  for (let pass = 0; pass < 2; pass++) {\n    updatedWorks = updatedWorks.map((work) => {\n      const { volume, status, message } = calculateWorkItemVolume(work, updatedWorks);\n      return {\n        ...work,\n        calculatedVolume: volume,\n        status,\n        statusMessage: message,\n      };\n    });\n  }\n\n  return updatedWorks;\n}\n\n/**\n * Format angka ke standar Indonesia (titik untuk ribuan, koma untuk desimal)\n * Contoh: 1224.5 -> \"1.224,50\"\n */\nexport function formatIndonesianNumber(\n  val: number | null | undefined,\n  decimals: number = 2\n): string {\n  if (val === null || val === undefined || isNaN(val)) return \'-\';\n  const parts = val.toFixed(decimals).split(\'.\');\n  const intPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, \'.\');\n  return decimals > 0 && parts[1] ? `${intPart},${parts[1]}` : intPart;\n}\n\n/**\n * Ringkasan Volume berdasarkan Kategori dan Unit\n */\nexport interface CategoryVolumeSummary {\n  category: string;\n  count: number;\n  completedCount: number;\n  totalVolumeM3: number;\n  totalAreaM2: number;\n  totalLengthM: number;\n  totalUnits: number;\n}\n\nexport function computeProjectSummaries(works: ProjectWorkItem[]) {\n  const activeWorks = works.filter((w) => w.isActive);\n\n  let totalBetonM3 = 0;\n  let totalLuasM2 = 0;\n  let totalPanjangM = 0;\n  let totalItemsCompleted = 0;\n  let totalItemsPending = 0;\n\n  for (const w of activeWorks) {\n    if (w.status === \'Lengkap\') {\n      totalItemsCompleted++;\n    } else {\n      totalItemsPending++;\n    }\n\n    const vol = w.calculatedVolume;\n    if (vol !== null && !isNaN(vol)) {\n      const u = w.unit.toLowerCase().trim();\n      if (u === \'m3\' || u === \'m\302\263\') {\n        totalBetonM3 += vol;\n      } else if (u === \'m2\' || u === \'m\302\262\') {\n        totalLuasM2 += vol;\n      } else if (u === \'m\' || u === \'m\\\'\' || u === \'m1\') {\n        totalPanjangM += vol;\n      }\n    }\n  }\n\n  return {\n    totalWorks: activeWorks.length,\n    completedWorks: totalItemsCompleted,\n    pendingWorks: totalItemsPending,\n    totalBetonM3,\n    totalLuasM2,\n    totalPanjangM,\n  };\n}"
        replacement_content: "  // Cari item pada katalog bawaan\n  const catalogEntry = CATALOG_WORK_ITEMS.find((c) => c.id === item.catalogId);\n  const isAiDraft = item.origin === \'ai\' && item.aiVerificationStatus === \'draft\';\n  const hasConflict = item.parameters.some((p) => Boolean(p.conflict));\n\n  // Kumpulkan nilai parameter dalam bentuk Record<string, number>\n  const paramMap: Record<string, number> = {};\n  const missingParams: string[] = [];\n\n  for (const p of item.parameters) {\n    if (p.value !== null && p.value !== \'\' && !isNaN(Number(p.value))) {\n      paramMap[p.id] = Number(p.value);\n    } else if (p.required) {\n      // Cek apakah ada nilai turunan dari pekerjaan lain\n      if (p.id === \'volume_galian\') {\n        const galianWork = allProjectWorks.find(\n          (w) =>\n            w.isActive &&\n            w.aiVerificationStatus !== \'draft\' &&\n            (w.id.includes(\'galian\') || w.name.toLowerCase().includes(\'galian\'))\n        );\n        if (galianWork && galianWork.calculatedVolume !== null) {\n          paramMap[p.id] = galianWork.calculatedVolume;\n          p.value = galianWork.calculatedVolume;\n          p.source = \'derived\';\n          continue;\n        }\n      }\n\n      if (p.id === \'luas_dinding_bersih\') {\n        const dindingWork = allProjectWorks.find(\n          (w) =>\n            w.isActive &&\n            w.floorId === item.floorId &&\n            (w.name.toLowerCase().includes(\'dinding bata\') || w.id.includes(\'dinding\'))\n        );\n        if (dindingWork && dindingWork.calculatedVolume !== null) {\n          paramMap[p.id] = dindingWork.calculatedVolume;\n          p.value = dindingWork.calculatedVolume;\n          p.source = \'derived\';\n          continue;\n        }\n      }\n\n      missingParams.push(p.label || p.name);\n    }\n  }\n\n  if (missingParams.length > 0) {\n    const missingList = missingParams.join(\', \');\n    return {\n      volume: null,\n      status: isAiDraft ? \'Belum Lengkap\' : \'Perlu Input\',\n      message: isAiDraft\n        ? `Parameter \"${missingList}\" belum tercantum pada gambar ini. Silakan isi manual atau unggah gambar potongan/detail.`\n        : `Parameter \"${missingList}\" belum diisi.`,\n    };\n  }\n\n  // Helper untuk menentukan status akhir setelah volume berhasil dihitung\n  const finalizeStatus = (vol: number): { volume: number; status: CalculationStatus; message?: string } => {\n    if (isAiDraft) {\n      return {\n        volume: vol,\n        status: \'Draf AI \342\200\224 Perlu Verifikasi\',\n        message: hasConflict\n          ? \'Terdapat perbedaan dimensi antar gambar \342\200\224 periksa konflik parameter sebelum menyetujui.\'\n          : \'Draf pekerjaan dari pembacaan AI \342\200\224 periksa parameter lalu klik Setujui untuk masuk ke rekap final.\',\n      };\n    }\n\n    if (hasConflict) {\n      return {\n        volume: vol,\n        status: \'Perlu Verifikasi\',\n        message: \'Terdapat perbedaan dimensi dari gambar baru \342\200\224 tinjau parameter.\',\n      };\n    }\n\n    return {\n      volume: vol,\n      status: \'Lengkap\',\n      message: \'Parameter lengkap dan terverifikasi.\',\n    };\n  };\n\n  // Jika pekerjaan memiliki ekspresi rumus kustom (atau dari katalog kustom)\n  if (item.customFormula) {\n    const customResult = safeEvaluateMath(item.customFormula, paramMap);\n    if (isNaN(customResult) || !isFinite(customResult)) {\n      return {\n        volume: null,\n        status: \'Kesalahan Perhitungan\',\n        message: \'Rumus kustom menghasilkan kesalahan evaluasi matematika.\',\n      };\n    }\n    return finalizeStatus(customResult);\n  }\n\n  // Jalankan rumus kalkulasi katalog\n  if (catalogEntry) {\n    try {\n      const result = catalogEntry.calculationMethod(paramMap, item.components);\n      if (result === null || isNaN(result)) {\n        return {\n          volume: null,\n          status: isAiDraft ? \'Belum Lengkap\' : \'Perlu Input\',\n          message: \'Parameter wajib belum lengkap.\',\n        };\n      }\n\n      if (!isFinite(result)) {\n        return {\n          volume: null,\n          status: \'Kesalahan Perhitungan\',\n          message: \'Terjadi pembagian dengan nol atau nilai tak terhingga.\',\n        };\n      }\n\n      return finalizeStatus(result);\n    } catch (err: unknown) {\n      const errorMsg = err instanceof Error ? err.message : String(err);\n      return {\n        volume: null,\n        status: \'Kesalahan Perhitungan\',\n        message: errorMsg || \'Gagal menghitung rumus.\',\n      };\n    }\n  }\n\n  // Default: coba perkalian sederhana parameter yang ada\n  const keys = Object.keys(paramMap);\n  if (keys.length > 0) {\n    const product = keys.reduce((acc, k) => acc * paramMap[k], 1);\n    return finalizeStatus(product);\n  }\n\n  return {\n    volume: null,\n    status: isAiDraft ? \'Belum Lengkap\' : \'Perlu Input\',\n    message: \'Isi parameter perhitungan.\',\n  };\n}\n\n/**\n * Hitung ulang seluruh daftar pekerjaan dalam proyek dengan penanganan dependensi\n */\nexport function recalculateAllProjectWorks(works: ProjectWorkItem[]): ProjectWorkItem[] {\n  // Jalankan dua pass untuk menyelesaikan nilai turunan (derived dependencies)\n  let updatedWorks = [...works];\n\n  for (let pass = 0; pass < 2; pass++) {\n    updatedWorks = updatedWorks.map((work) => {\n      const { volume, status, message } = calculateWorkItemVolume(work, updatedWorks);\n      return {\n        ...work,\n        calculatedVolume: volume,\n        status,\n        statusMessage: message,\n      };\n    });\n  }\n\n  return updatedWorks;\n}\n\n/**\n * Format angka ke standar Indonesia (titik untuk ribuan, koma untuk desimal)\n * Contoh: 1224.5 -> \"1.224,50\"\n */\nexport function formatIndonesianNumber(\n  val: number | null | undefined,\n  decimals: number = 2\n): string {\n  if (val === null || val === undefined || isNaN(val)) return \'-\';\n  const parts = val.toFixed(decimals).split(\'.\');\n  const intPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, \'.\');\n  return decimals > 0 && parts[1] ? `${intPart},${parts[1]}` : intPart;\n}\n\n/**\n * Ringkasan Volume berdasarkan Kategori dan Unit\n */\nexport interface CategoryVolumeSummary {\n  category: string;\n  count: number;\n  completedCount: number;\n  totalVolumeM3: number;\n  totalAreaM2: number;\n  totalLengthM: number;\n  totalUnits: number;\n}\n\nexport function computeProjectSummaries(works: ProjectWorkItem[]) {\n  const activeWorks = works.filter((w) => w.isActive);\n\n  let totalBetonM3 = 0;\n  let totalLuasM2 = 0;\n  let totalPanjangM = 0;\n  let totalItemsCompleted = 0;\n  let totalItemsPending = 0;\n\n  let draftWorksCount = 0;\n  let readyDraftWorksCount = 0;\n  let incompleteDraftWorksCount = 0;\n  let draftBetonM3 = 0;\n  let draftLuasM2 = 0;\n  let draftPanjangM = 0;\n  let conflictWorksCount = 0;\n\n  for (const w of activeWorks) {\n    const isAiDraft = w.origin === \'ai\' && w.aiVerificationStatus === \'draft\';\n    const hasConflict = w.parameters.some((p) => Boolean(p.conflict));\n    if (hasConflict) {\n      conflictWorksCount++;\n    }\n\n    const vol = w.calculatedVolume;\n    const u = w.unit.toLowerCase().trim();\n\n    if (isAiDraft) {\n      draftWorksCount++;\n      totalItemsPending++;\n      if (vol !== null && !isNaN(vol)) {\n        readyDraftWorksCount++;\n        if (u === \'m3\' || u === \'m\302\263\') {\n          draftBetonM3 += vol;\n        } else if (u === \'m2\' || u === \'m\302\262\') {\n          draftLuasM2 += vol;\n        } else if (u === \'m\' || u === \"m\'\" || u === \'m1\') {\n          draftPanjangM += vol;\n        }\n      } else {\n        incompleteDraftWorksCount++;\n      }\n      continue;\n    }\n\n    if (w.status === \'Lengkap\') {\n      totalItemsCompleted++;\n    } else {\n      totalItemsPending++;\n    }\n\n    if (vol !== null && !isNaN(vol)) {\n      if (u === \'m3\' || u === \'m\302\263\') {\n        totalBetonM3 += vol;\n      } else if (u === \'m2\' || u === \'m\302\262\') {\n        totalLuasM2 += vol;\n      } else if (u === \'m\' || u === \"m\'\" || u === \'m1\') {\n        totalPanjangM += vol;\n      }\n    }\n  }\n\n  return {\n    totalWorks: activeWorks.length,\n    completedWorks: totalItemsCompleted,\n    pendingWorks: totalItemsPending,\n    totalBetonM3,\n    totalLuasM2,\n    totalPanjangM,\n    draftWorksCount,\n    readyDraftWorksCount,\n    incompleteDraftWorksCount,\n    draftBetonM3,\n    draftLuasM2,\n    draftPanjangM,\n    conflictWorksCount,\n  };\n}\n"
