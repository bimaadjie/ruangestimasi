            }
            lines {
              text: "    name: \'Pembuatan Gudang Alat & Direksikeet\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Persiapan Dll\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subCategory: \'Pekerjaan Persiapan\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    floorRule: \'umum\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    description: \'Pembuatan gudang semen, perkakas dan kantor sementara di tapak.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    defaultUnit: \'m\302\262\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    formulaDisplay: \'Panjang \303\227 Lebar\',"
