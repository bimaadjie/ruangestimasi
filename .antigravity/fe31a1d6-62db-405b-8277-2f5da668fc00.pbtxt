  view_file {
    absolute_path_uri: "file:///server.ts"
    start_line: 434
    end_line: 664
    content: "    for (let i = 0; i < plannedAttempts.length; i++) {\n      const { model, label } = plannedAttempts[i];\n      const attemptNum = i + 1;\n\n      try {\n        console.log(`[RuangRAB AI] Attempt ${attemptNum}/3: Invoking ${label}...`);\n\n        const response = await ai.models.generateContent({\n          model,\n          contents: { parts: [documentPart, textPart] },\n          config: {\n            systemInstruction,\n            responseMimeType: \'application/json\',\n            responseSchema: {\n              type: Type.OBJECT,\n              properties: {\n                documentSummary: {\n                  type: Type.STRING,\n                  description: \'Ringkasan lengkap isi dokumen gambar teknik.\',\n                },\n                drawingType: {\n                  type: Type.STRING,\n                  description: \'Kategori utama: arsitektur_denah, struktur_denah, potongan_detail, atau lainnya.\',\n                },\n                identifiedFloor: {\n                  type: Type.STRING,\n                  description: \'Lantai atau level struktur yang tertera pada gambar.\',\n                },\n                identifiedScale: {\n                  type: Type.STRING,\n                  description: \'Skala yang tertera pada etiket gambar (misal 1:200, 1:100).\',\n                },\n                detectedRegions: {\n                  type: Type.ARRAY,\n                  description: \'Daftar jenis gambar teknik yang terdeteksi pada setiap halaman atau bagian gambar.\',\n                  items: {\n                    type: Type.OBJECT,\n                    properties: {\n                      pageNumber: { type: Type.NUMBER, description: \'Nomor halaman (mulai dari 1).\' },\n                      drawingType: {\n                        type: Type.STRING,\n                        description:\n                          \'Salah satu dari: Denah Arsitektur, Denah Kolom, Denah Balok, Denah Sloof, Denah Pondasi, Potongan Bangunan, Tampak Bangunan, Detail Tangga, Detail Pondasi, Detail Sambungan, Detail Penulangan, Tabel Dimensi dan Penulangan, Detail Konstruksi Lainnya.\',\n                      },\n                      title: { type: Type.STRING, description: \'Judul bagian gambar pada lembar tersebut.\' },\n                      scale: { type: Type.STRING, description: \'Skala bagian gambar tersebut jika tertulis.\' },\n                      summary: { type: Type.STRING, description: \'Ringkasan informasi teknis pada bagian ini.\' },\n                    },\n                    required: [\'pageNumber\', \'drawingType\', \'title\', \'summary\'],\n                  },\n                },\n                segments: {\n                  type: Type.ARRAY,\n                  description:\n                    \'Rincian segmen balok atau sloof per jalur grid untuk menghitung panjang total secara akurat (kosongkan jika tidak ada denah balok/sloof).\',\n                  items: {\n                    type: Type.OBJECT,\n                    properties: {\n                      elementCode: {\n                        type: Type.STRING,\n                        description: \'Kode elemen struktur (misal: S.1, S1, B1, B2).\',\n                      },\n                      elementCategory: {\n                        type: Type.STRING,\n                        description: \'sloof atau balok\',\n                      },\n                      segmentName: {\n                        type: Type.STRING,\n                        description: \'Nama segmen atau jalur (misal: Segmen Horizontal Grid 1, Segmen Vertikal Grid A).\',\n                      },\n                      gridLocation: {\n                        type: Type.STRING,\n                        description: \'Lokasi grid/as (misal: Grid 1 / As A-H, Grid A / As 2-7).\',\n                      },\n                      rawLength: {\n                        type: Type.NUMBER,\n                        description: \'Angka panjang tertulis untuk 1 segmen/jalur.\',\n                      },\n                      rawUnit: {\n                        type: Type.STRING,\n                        description: \'Satuan angka tertulis (m, cm, mm).\',\n                      },\n                      lengthMeters: {\n                        type: Type.NUMBER,\n                        description: \'Panjang 1 segmen/jalur setelah dikonversi ke meter (m).\',\n                      },\n                      count: {\n                        type: Type.NUMBER,\n                        description: \'Jumlah jalur/segmen identik (default 1).\',\n                      },\n                      subtotalMeters: {\n                        type: Type.NUMBER,\n                        description: \'Hasil lengthMeters * count dalam meter (m).\',\n                      },\n                      pageNumber: {\n                        type: Type.NUMBER,\n                        description: \'Nomor halaman sumber.\',\n                      },\n                      drawingType: {\n                        type: Type.STRING,\n                        description: \'Jenis gambar sumber (Denah Sloof atau Denah Balok).\',\n                      },\n                    },\n                    required: [\n                      \'elementCode\',\n                      \'elementCategory\',\n                      \'segmentName\',\n                      \'gridLocation\',\n                      \'rawLength\',\n                      \'lengthMeters\',\n                      \'count\',\n                      \'subtotalMeters\',\n                    ],\n                  },\n                },\n                items: {\n                  type: Type.ARRAY,\n                  description: \'Daftar parameter dimensi dan kuantitas pekerjaan yang terbaca.\',\n                  items: {\n                    type: Type.OBJECT,\n                    properties: {\n                      pageNumber: {\n                        type: Type.NUMBER,\n                        description: \'Nomor halaman tempat parameter ditemukan.\',\n                      },\n                      drawingType: {\n                        type: Type.STRING,\n                        description: \'Jenis gambar tempat parameter ditemukan (misal Denah Sloof, Tabel Dimensi dan Penulangan, Denah Arsitektur).\',\n                      },\n                      elementCode: {\n                        type: Type.STRING,\n                        description: \'Kode elemen jika ada (misal S.1, B1, K1).\',\n                      },\n                      targetCategory: {\n                        type: Type.STRING,\n                        description: \'Kategori: Persiapan Dll, Struktural, Arsitektural, atau MEP.\',\n                      },\n                      suggestedWorkName: {\n                        type: Type.STRING,\n                        description: \'Nama pekerjaan (misal: Sloof S1, Balok B1, Kolom K1, Pembersihan Lahan, Dinding Bata Ringan).\',\n                      },\n                      catalogId: {\n                        type: Type.STRING,\n                        description: \'ID katalog RuangRAB jika cocok (misal: str-sloof-beton, str-balok-b1-beton, str-kolom-k1-beton, prep-pembersihan-lahan, prep-bouwplank, ars-dinding-bata-hebel, ars-homogenous-tile-60x60, ars-keramik-toilet-antislip).\',\n                      },\n                      parameterId: {\n                        type: Type.STRING,\n                        description: \'ID parameter katalog (misal: panjang_total, lebar, tinggi, tebal, jumlah, panjang, panjang_keliling, luas_lantai, luas_total_toilet).\',\n                      },\n                      parameterName: {\n                        type: Type.STRING,\n                        description: \'Nama parameter yang mudah dibaca.\',\n                      },\n                      rawExtractedValue: {\n                        type: Type.NUMBER,\n                        description: \'Angka asli tertulis pada gambar tanpa perkalian skala.\',\n                      },\n                      detectedUnit: {\n                        type: Type.STRING,\n                        description: \'Satuan angka tersebut (m, cm, mm, m\302\262, titik, unit, btg).\',\n                      },\n                      confidence: {\n                        type: Type.NUMBER,\n                        description: \'Tingkat keyakinan pembacaan antara 0.0 sampai 1.0.\',\n                      },\n                      pageOrLocation: {\n                        type: Type.STRING,\n                        description: \'Lokasi grid/as atau bagian tabel pada gambar.\',\n                      },\n                      notes: {\n                        type: Type.STRING,\n                        description: \'Keterangan teknis asal angka.\',\n                      },\n                    },\n                    required: [\n                      \'targetCategory\',\n                      \'suggestedWorkName\',\n                      \'parameterName\',\n                      \'rawExtractedValue\',\n                    ],\n                  },\n                },\n              },\n              required: [\'documentSummary\', \'items\'],\n            },\n          },\n        });\n\n        successfulResponseText = response.text || \'{}\';\n        modelUsed = model;\n        console.log(`[RuangRAB AI] Success on attempt ${attemptNum} with model: ${model}`);\n        break;\n      } catch (err: any) {\n        lastError = err;\n        console.warn(\n          `[RuangRAB AI] Attempt ${attemptNum} failed with error:`,\n          err?.status || err?.code || \'\',\n          err?.message || err\n        );\n\n        if (!isRetryableError(err)) {\n          console.error(\'[RuangRAB AI] Non-retryable error, aborting attempts.\');\n          break;\n        }\n\n        if (i < plannedAttempts.length - 1) {\n          const jitter = Math.floor(Math.random() * 400);\n          const backoffMs = 1000 + i * 1000 + jitter;\n          console.log(\n            `[RuangRAB AI] Waiting ${backoffMs}ms before fallback/retry attempt ${attemptNum + 1}...`\n          );\n          await wait(backoffMs);\n        }\n      }\n    }\n\n    if (!successfulResponseText) {\n      console.error(\'[RuangRAB AI] All attempts failed. Last error:\', lastError?.message || lastError);\n      res.status(503).json({\n        success: false,\n        isBusy: true,\n        error:\n          \'Layanan AI sedang mengalami beban tinggi (503). Dokumen belum berhasil dianalisis. Silakan coba kembali beberapa saat lagi.\',\n        technicalDetail: lastError?.message\n          ? String(lastError.message).slice(0, 200)\n          : \'Layanan AI mengalami beban tinggi.\',\n      });\n      return;\n    }\n\n    let parsedData: any;"
    num_lines: 718
    num_bytes: 28998
    line_range_bytes: 10456
  }
}
