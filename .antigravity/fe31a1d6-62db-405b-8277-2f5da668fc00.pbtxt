    end_line: 707
    content: "import React, { useState, useRef, useEffect } from \'react\';\nimport {\n  X,\n  Upload,\n  Sparkles,\n  Check,\n  AlertCircle,\n  FileText,\n  Loader2,\n  Trash2,\n  ArrowRight,\n  Info,\n  RotateCcw,\n  CheckCircle2,\n  Ruler,\n  Layers,\n  Building,\n} from \'lucide-react\';\nimport { AIExtractionItem, DrawingScale, DrawingUnit, FloorItem, ProjectWorkItem, WorkCategory } from \'../types\';\nimport { formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface AIAssistantModalProps {\n  isOpen: boolean;\n  floors: FloorItem[];\n  currentFloorId: string;\n  onClose: () => void;\n  onApplyExtractedParameters: (\n    items: AIExtractionItem[],\n    targetFloorId: string\n  ) => void;\n  existingWorks: ProjectWorkItem[];\n}\n\nexport const AIAssistantModal: React.FC<AIAssistantModalProps> = ({\n  isOpen,\n  floors,\n  currentFloorId,\n  onClose,\n  onApplyExtractedParameters,\n  existingWorks,\n}) => {\n  if (!isOpen) return null;\n\n  // Configuration settings before analysis\n  const [selectedUnit, setSelectedUnit] = useState<DrawingUnit>(\'cm\'); // Default cm\n  const [selectedScale, setSelectedScale] = useState<DrawingScale>(\'1:100\');\n  const [customScaleDenom, setCustomScaleDenom] = useState<number>(125);\n  const [selectedFloorId, setSelectedFloorId] = useState<string>(currentFloorId || floors[0]?.id || \'fl-1\');\n\n  // File upload state\n  const [selectedFile, setSelectedFile] = useState<File | null>(null);\n  const [fileError, setFileError] = useState<string | null>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  // Analysis process state\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [analysisError, setAnalysisError] = useState<string | null>(null);\n  const [isServerBusy, setIsServerBusy] = useState<boolean>(false);\n  const [retryCount, setRetryCount] = useState<number>(0);\n  const [modelUsedInfo, setModelUsedInfo] = useState<string | null>(null);\n\n  // Results state\n  const [documentSummary, setDocumentSummary] = useState<string | null>(null);\n  const [identifiedFloor, setIdentifiedFloor] = useState<string | null>(null);\n  const [identifiedScale, setIdentifiedScale] = useState<string | null>(null);\n  const [extractions, setExtractions] = useState<AIExtractionItem[]>([]);\n  const [selectedItemIds, setSelectedItemIds] = useState<Record<string, boolean>>({});\n\n  // Helper konversi dimensi matematika murni\n  const computeConvertedValue = (rawVal: number, unit: DrawingUnit): number => {\n    if (rawVal == null || isNaN(rawVal)) return 0;\n    if (unit === \'mm\') return Number((rawVal / 1000).toFixed(4));\n    if (unit === \'cm\') return Number((rawVal / 100).toFixed(4));\n    return Number(rawVal.toFixed(4)); // m\n  };\n\n  // Otomatis update nilai konversi jika pengguna mengganti satuan tanpa memanggil Gemini lagi\n  const handleUnitSettingChange = (newUnit: DrawingUnit) => {\n    setSelectedUnit(newUnit);\n    if (extractions.length > 0) {\n      setExtractions((prev) =>\n        prev.map((item) => {\n          const newConverted = computeConvertedValue(item.rawExtractedValue, newUnit);\n          return {\n            ...item,\n            rawUnit: newUnit,\n            convertedValue: item.userCorrection !== undefined ? item.userCorrection : newConverted,\n          };\n        })\n      );\n    }\n  };\n\n  const handleFileSelect = (file: File) => {\n    setFileError(null);\n    setAnalysisError(null);\n    setIsServerBusy(false);\n\n    const validTypes = [\'application/pdf\', \'image/png\', \'image/jpeg\', \'image/jpg\', \'image/webp\'];\n    if (!validTypes.includes(file.type) && !file.name.match(/\\.(pdf|png|jpe?g|webp)$/i)) {\n      setFileError(\'Format file tidak didukung. Harap unggah file PDF, JPG, atau PNG.\');\n      return;\n    }\n\n    // Limit 15 MB\n    if (file.size > 15 * 1024 * 1024) {\n      setFileError(\'Ukuran file melebihi batas maksimal 15 MB.\');\n      return;\n    }\n\n    setSelectedFile(file);\n  };\n\n  const handleAnalyze = async () => {\n    if (!selectedFile) {\n      setFileError(\'Silakan pilih file gambar denah atau PDF terlebih dahulu.\');\n      return;\n    }\n\n    if (isLoading) return; // Prevent double click\n\n    setIsLoading(true);\n    setAnalysisError(null);\n    setIsServerBusy(false);\n\n    try {\n      const reader = new FileReader();\n      reader.readAsDataURL(selectedFile);\n      reader.onload = async () => {\n        try {\n          const base64Data = reader.result as string;\n          const targetFloorObj = floors.find((f) => f.id === selectedFloorId);\n\n          const scaleText =\n            selectedScale === \'custom\'\n              ? `1:${customScaleDenom}`\n              : selectedScale === \'unknown\'\n              ? \'Tidak Diketahui\'\n              : selectedScale;\n\n          const response = await fetch(\'/api/gemini/extract-dimensions\', {\n            method: \'POST\',\n            headers: { \'Content-Type\': \'application/json\' },\n            body: JSON.stringify({\n              fileBase64: base64Data,\n              mimeType: selectedFile.type || \'application/pdf\',\n              fileName: selectedFile.name,\n              floorName: targetFloorObj ? targetFloorObj.name : \'Lantai 1\',\n              unitSetting: selectedUnit,\n              scaleSetting: scaleText,\n            }),\n          });\n\n          const resJson = await response.json();\n\n          if (!response.ok || !resJson.success) {\n            if (response.status === 503 || resJson.isBusy) {\n              setIsServerBusy(true);\n              setAnalysisError(\n                \'Server AI sedang sibuk. Dokumen belum berhasil dianalisis. Silakan coba kembali beberapa saat lagi.\'\n              );\n            } else {\n              setAnalysisError(resJson.error || \'Gagal membaca dokumen.\');\n            }\n            return;\n          }\n\n          const rawData = resJson.data;\n          setModelUsedInfo(resJson.modelUsed || \'gemini-3.8-flash\');\n          setDocumentSummary(rawData.documentSummary || \'Dokumen denah berhasil dianalisis.\');\n          setIdentifiedFloor(rawData.identifiedFloor || targetFloorObj?.name || \'Lantai 1\');\n          setIdentifiedScale(rawData.identifiedScale || scaleText);\n\n          if (Array.isArray(rawData.items) && rawData.items.length > 0) {\n            const initialSelected: Record<string, boolean> = {};\n            const parsedItems: AIExtractionItem[] = rawData.items.map(\n              (item: any, idx: number) => {\n                const id = `ai-item-${Date.now()}-${idx}`;\n                const rawVal = Number(item.rawExtractedValue) || 0;\n                const converted = computeConvertedValue(rawVal, selectedUnit);\n                initialSelected[id] = true; // Auto select by default\n\n                return {\n                  id,\n                  targetCategory: item.targetCategory || \'Struktural\',\n                  suggestedWorkName: item.suggestedWorkName || \'Pekerjaan Terdeteksi\',\n                  parameterName: item.parameterName || \'Dimensi\',\n                  rawExtractedValue: rawVal,\n                  rawUnit: selectedUnit,\n                  convertedValue: converted,\n                  convertedUnit: \'m\',\n                  confidence: item.confidence ?? 0.95,\n                  sourceDocument: selectedFile.name,\n                  pageOrLocation: item.pageOrLocation || \'Notasi As Denah\',\n                  notes: item.notes || \'Angka dimensi tertulis pada gambar.\',\n                  status: \'approved\', // Default approved for easy user review\n                };\n              }\n            );\n\n            setExtractions(parsedItems);\n            setSelectedItemIds(initialSelected);\n          } else {\n            setExtractions([]);\n            setAnalysisError(\'Tidak ditemukan angka dimensi tertulis yang jelas pada gambar ini.\');\n          }\n        } catch (innerErr: unknown) {\n          const msg = innerErr instanceof Error ? innerErr.message : String(innerErr);\n          setAnalysisError(msg);\n        } finally {\n          setIsLoading(false);\n        }\n      };\n    } catch (err: unknown) {\n      const msg = err instanceof Error ? err.message : String(err);\n      setAnalysisError(msg);\n      setIsLoading(false);\n    }\n  };\n\n  const handleToggleSelect = (id: string) => {\n    setSelectedItemIds((prev) => ({\n      ...prev,\n      [id]: !prev[id],\n    }));\n  };\n\n  const handleSelectAll = (checked: boolean) => {\n    const updated: Record<string, boolean> = {};\n    for (const item of extractions) {\n      updated[item.id] = checked;\n    }\n    setSelectedItemIds(updated);\n  };\n\n  const handleEditConvertedValue = (id: string, newConvertedVal: string) => {\n    const val = Number(newConvertedVal);\n    setExtractions((prev) =>\n      prev.map((item) =>\n        item.id === id\n          ? {\n              ...item,\n              convertedValue: isNaN(val) ? item.convertedValue : val,\n              userCorrection: isNaN(val) ? undefined : val,\n              status: \'approved\',\n            }\n          : item\n      )\n    );\n  };\n\n  const handleStatusChange = (id: string, status: \'approved\' | \'rejected\') => {\n    setExtractions((prev) =>\n      prev.map((item) => (item.id === id ? { ...item, status } : item))\n    );\n  };\n\n  const handleApply = () => {\n    const itemsToApply = extractions.filter(\n      (item) => selectedItemIds[item.id] && item.status !== \'rejected\'\n    );\n\n    if (itemsToApply.length === 0) {\n      setAnalysisError(\'Pilih dan setujui minimal satu parameter yang ingin dimasukkan ke kalkulator.\');\n      return;\n    }\n\n    onApplyExtractedParameters(itemsToApply, selectedFloorId);\n    onClose();\n  };\n\n  const approvedCount = extractions.filter(\n    (item) => selectedItemIds[item.id] && item.status !== \'rejected\'\n  ).length;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-5 bg-slate-900/50 backdrop-blur-xs\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-4xl max-h-[92vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-blue-50/60 to-white shrink-0\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold shadow-xs\">\n              <Sparkles className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-sm font-bold text-slate-900\">\n                  Asisten AI \342\200\224 Pembaca Gambar Teknik\n                </h3>\n                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-700\">\n                  Human-in-the-Loop\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500\">\n                Ekstraksi dimensi gambar teknik dengan validasi satuan &amp; persetujuan pengguna sebelum masuk kalkulator.\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Scrollable Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-5 text-xs flex-1\">\n          {/* BAGIAN 1: PENGATURAN AWAL SEBELUM ANALISIS */}\n          <div className=\"p-4 bg-slate-50/80 rounded-2xl border border-slate-200 space-y-4\">\n            <div className=\"flex items-center gap-2 pb-2 border-b border-slate-200/80\">\n              <Ruler className=\"w-4 h-4 text-blue-600\" />\n              <h4 className=\"font-bold text-slate-900 text-xs\">\n                Pengaturan Satuan, Skala, &amp; Lantai Tujuan\n              </h4>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n              {/* 1. Satuan Dimensi Gambar */}\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">\n                  Satuan Dimensi Gambar *\n                </label>\n                <div className=\"flex items-center gap-1.5 bg-white p-1 rounded-xl border border-slate-200\">\n                  {([\'mm\', \'cm\', \'m\'] as DrawingUnit[]).map((unit) => (\n                    <button\n                      key={unit}\n                      type=\"button\"\n                      onClick={() => handleUnitSettingChange(unit)}\n                      className={`flex-1 py-1.5 rounded-lg font-bold text-xs transition ${\n                        selectedUnit === unit\n                          ? \'bg-blue-600 text-white shadow-2xs\'\n                          : \'text-slate-600 hover:bg-slate-100\'\n                      }`}\n                    >\n                      {unit === \'mm\' ? \'Milimeter (mm)\' : unit === \'cm\' ? \'Sentimeter (cm)\' : \'Meter (m)\'}\n                    </button>\n                  ))}\n                </div>\n                <p className=\"text-[10px] text-slate-500 mt-1.5 leading-tight\">\n                  Pilih satuan yang digunakan pada angka dimensi gambar teknik (contoh denah standar: <strong>cm</strong>).\n                </p>\n              </div>\n\n              {/* 2. Skala Gambar */}\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">\n                  Skala Gambar (Opsional)\n                </label>\n                <select\n                  value={selectedScale}\n                  onChange={(e) => setSelectedScale(e.target.value as DrawingScale)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-slate-200 bg-white font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                >\n                  <option value=\"1:20\">1:20 (Detail Khusus)</option>\n                  <option value=\"1:50\">1:50 (Denah / Potongan Detail)</option>\n                  <option value=\"1:75\">1:75</option>\n                  <option value=\"1:100\">1:100 (Standar Denah Rumah/Gedung)</option>\n                  <option value=\"1:150\">1:150</option>\n                  <option value=\"1:200\">1:200</option>\n                  <option value=\"custom\">Skala Lainnya...</option>\n                  <option value=\"unknown\">Tidak Diketahui</option>\n                </select>\n\n                {selectedScale === \'custom\' && (\n                  <div className=\"flex items-center gap-1.5 mt-2\">\n                    <span className=\"font-bold text-slate-700\">1 :</span>\n                    <input\n                      type=\"number\"\n                      placeholder=\"125\"\n                      value={customScaleDenom}\n                      onChange={(e) => setCustomScaleDenom(Number(e.target.value) || 100)}\n                      className=\"w-full px-2 py-1 rounded-lg border border-slate-300 font-bold text-slate-900\"\n                    />\n                  </div>\n                )}\n                <p className=\"text-[10px] text-slate-500 mt-1.5 leading-tight\">\n                  Angka dimensi tertulis pada gambar tidak dikalikan faktor skala.\n                </p>\n              </div>\n\n              {/* 3. Lantai Tujuan */}\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">\n                  Lantai Tujuan *\n                </label>\n                <select\n                  value={selectedFloorId}\n                  onChange={(e) => setSelectedFloorId(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-slate-200 bg-white font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                >\n                  {floors.map((f) => (\n                    <option key={f.id} value={f.id}>\n                      {f.name} {f.elevation ? `(${f.elevation})` : \'\'}\n                    </option>\n                  ))}\n                </select>\n                <p className=\"text-[10px] text-slate-500 mt-1.5 leading-tight\">\n                  Parameter yang disetujui akan dipetakan ke pekerjaan di lantai ini.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* BAGIAN 2: UNGGAH DOKUMEN & TOMBOL ANALISIS */}\n          <div className=\"p-4 bg-white rounded-2xl border border-slate-200 space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"font-bold text-slate-800 block\">\n                Unggah Dokumen Denah / Gambar Konstruksi\n              </label>\n              <span className=\"text-[11px] text-slate-500\">Format: PDF, JPG, PNG (maks. 15 MB)</span>\n            </div>\n\n            <div\n              onClick={() => fileInputRef.current?.click()}\n              className=\"border-2 border-dashed border-blue-200 hover:border-blue-400 bg-blue-50/20 hover:bg-blue-50/40 rounded-xl p-4 text-center cursor-pointer transition flex items-center justify-center gap-3\"\n            >\n              <input\n                ref={fileInputRef}\n                type=\"file\"\n                accept=\".pdf,image/png,image/jpeg,image/jpg,image/webp\"\n                className=\"hidden\"\n                onChange={(e) => e.target.files?.[0] && handleFileSelect(e.target.files[0])}\n              />\n              <div className=\"w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0\">\n                <Upload className=\"w-5 h-5\" />\n              </div>\n              <div className=\"text-left text-xs min-w-0 flex-1\">\n                <span className=\"font-semibold text-slate-900 block truncate\">\n                  {selectedFile ? selectedFile.name : \'Klik untuk memilih file denah / potongan konstruksi\'}\n                </span>\n                <span className=\"text-[11px] text-slate-400 block\">\n                  {selectedFile\n                    ? `${(selectedFile.size / (1024 * 1024)).toFixed(2)} MB \302\267 ${selectedFile.type || \'Dokumen\'}`\n                    : \'Seret & letakkan file atau klik untuk menelusuri berkas dari komputer\'}\n                </span>\n              </div>\n              {selectedFile && (\n                <span className=\"px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 shrink-0 flex items-center gap-1\">\n                  <Check className=\"w-3 h-3\" /> Berkas Terpilih\n                </span>\n              )}\n            </div>\n\n            {fileError && (\n              <div className=\"p-2.5 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 text-xs flex items-center gap-2\">\n                <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                <span>{fileError}</span>\n              </div>\n            )}\n\n            {/* Tombol Mulai Analisis AI */}\n            <div className=\"pt-1 flex items-center justify-between\">\n              <span className=\"text-[11px] text-slate-500\">\n                AI akan membaca angka tertulis, notasi as/grid, dan dimensi ruang secara deterministik.\n              </span>\n              <button\n                onClick={handleAnalyze}\n                disabled={!selectedFile || isLoading}\n                className=\"px-6 py-2.5 font-bold text-xs text-white bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 disabled:cursor-not-allowed rounded-xl transition shadow-xs flex items-center gap-2 shrink-0\"\n              >\n                {isLoading ? (\n                  <>\n                    <Loader2 className=\"w-4 h-4 animate-spin\" />\n                    <span>Menganalisis Gambar...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4\" />\n                    <span>Mulai Analisis AI</span>\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n\n          {/* ERROR & BUSY HANDLING (BAGIAN A) */}\n          {analysisError && (\n            <div className=\"p-4 bg-amber-50 border border-amber-200 rounded-2xl text-amber-900 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <div className=\"flex items-start gap-2.5\">\n                <AlertCircle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n                <div>\n                  <span className=\"font-bold block\">Status Layanan AI:</span>\n                  <p className=\"mt-0.5 leading-relaxed text-slate-700\">{analysisError}</p>\n                </div>\n              </div>\n\n              {isServerBusy && (\n                <button\n                  onClick={handleAnalyze}\n                  disabled={isLoading}\n                  className=\"px-3.5 py-1.5 bg-white border border-amber-300 text-amber-900 font-bold rounded-xl hover:bg-amber-100/70 transition shrink-0 flex items-center gap-1.5 shadow-2xs self-end sm:self-auto\"\n                >\n                  <RotateCcw className=\"w-3.5 h-3.5\" />\n                  <span>Coba Lagi</span>\n                </button>\n              )}\n            </div>\n          )}\n\n          {/* BAGIAN 3: RINGKASAN HASIL DOKUMEN */}\n          {documentSummary && (\n            <div className=\"p-4 bg-blue-50/60 border border-blue-100 rounded-2xl text-xs text-slate-700 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n              <div className=\"space-y-1\">\n                <span className=\"font-bold text-slate-900 block flex items-center gap-1.5\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                  <span>Hasil Analisis: {documentSummary}</span>\n                </span>\n                <div className=\"flex items-center gap-4 text-[11px] text-slate-500\">\n                  <span>Lantai Terdeteksi: <strong>{identifiedFloor}</strong></span>\n                  <span>\302\267</span>\n                  <span>Skala Etiket: <strong>{identifiedScale}</strong></span>\n                  {modelUsedInfo && (\n                    <>\n                      <span>\302\267</span>\n                      <span className=\"font-mono text-[10px] text-blue-700 bg-white px-1.5 py-0.5 rounded border border-blue-100\">\n                        Model: {modelUsedInfo}\n                      </span>\n                    </>\n                  )}\n                </div>\n              </div>\n\n              <div className=\"bg-white px-3 py-1.5 rounded-xl border border-blue-100 shrink-0 font-medium text-[11px] text-slate-700\">\n                Rumus konversi aktif:{\' \'}\n                <span className=\"font-mono font-bold text-blue-700\">\n                  {selectedUnit === \'cm\' ? \'Nilai \303\267 100 = Meter\' : selectedUnit === \'mm\' ? \'Nilai \303\267 1000 = Meter\' : \'Nilai = Meter\'}\n                </span>\n              </div>\n            </div>\n          )}\n\n          {/* BAGIAN 4: TABEL VERIFIKASI HASIL AI (BAGIAN E) */}\n          {extractions.length > 0 && (\n            <div className=\"space-y-3\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                <div>\n                  <h4 className=\"font-bold text-slate-900 text-xs\">\n                    Tabel Verifikasi Dimensi &amp; Parameter ({extractions.length} item ditemukan)\n                  </h4>\n                  <p className=\"text-[11px] text-slate-500\">\n                    Nilai terbaca berasal dari teks dimensi asli pada denah. Nilai konversi (meter) yang disetujui akan dimasukkan ke kalkulator.\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-3 shrink-0\">\n                  <button\n                    onClick={() => handleSelectAll(true)}\n                    className=\"text-[11px] text-blue-700 hover:underline font-semibold\"\n                  >\n                    Pilih Semua\n                  </button>\n                  <span className=\"text-slate-300\">|</span>\n                  <button\n                    onClick={() => handleSelectAll(false)}\n                    className=\"text-[11px] text-slate-500 hover:underline\"\n                  >\n                    Batal Pilih\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"border border-slate-200 rounded-xl overflow-hidden shadow-2xs\">\n                <table className=\"w-full text-left text-xs border-collapse\">\n                  <thead>\n                    <tr className=\"bg-slate-50 text-slate-700 font-bold border-b border-slate-200 select-none\">\n                      <th className=\"py-2.5 px-3 w-8 text-center\">\n                        <input\n                          type=\"checkbox\"\n                          checked={approvedCount === extractions.length && extractions.length > 0}\n                          onChange={(e) => handleSelectAll(e.target.checked)}\n                          className=\"rounded text-blue-600 focus:ring-blue-500\"\n                        />\n                      </th>\n                      <th className=\"py-2.5 px-3\">Parameter &amp; Usulan Pekerjaan</th>\n                      <th className=\"py-2.5 px-3 text-right\">Nilai Terbaca</th>\n                      <th className=\"py-2.5 px-2 text-center\">Satuan</th>\n                      <th className=\"py-2.5 px-3 text-right w-36\">Hasil Konversi (m)</th>\n                      <th className=\"py-2.5 px-3\">Sumber / Notasi As</th>\n                      <th className=\"py-2.5 px-3 text-center w-28\">Status</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-100\">\n                    {extractions.map((item) => {\n                      const isChecked = selectedItemIds[item.id] ?? false;\n                      const isRejected = item.status === \'rejected\';\n\n                      return (\n                        <tr\n                          key={item.id}\n                          className={`hover:bg-slate-50/60 transition ${\n                            isRejected ? \'opacity-40 bg-slate-100/50\' : isChecked ? \'bg-blue-50/20\' : \'\'\n                          }`}\n                        >\n                          {/* Checkbox */}\n                          <td className=\"py-2.5 px-3 text-center\">\n                            <input\n                              type=\"checkbox\"\n                              checked={isChecked}\n                              onChange={() => handleToggleSelect(item.id)}\n                              className=\"rounded text-blue-600 focus:ring-blue-500\"\n                            />\n                          </td>\n\n                          {/* Parameter & Suggested Work */}\n                          <td className=\"py-2.5 px-3\">\n                            <span className=\"font-bold text-slate-900 block\">\n                              {item.parameterName}\n                            </span>\n                            <span className=\"text-[10px] text-slate-500 block truncate max-w-xs\">\n                              {item.suggestedWorkName} ({item.targetCategory})\n                            </span>\n                          </td>\n\n                          {/* Nilai Terbaca Asli */}\n                          <td className=\"py-2.5 px-3 text-right font-mono font-semibold text-slate-800\">\n                            {item.rawExtractedValue}\n                          </td>\n\n                          {/* Satuan Asli */}\n                          <td className=\"py-2.5 px-2 text-center font-medium text-slate-500\">\n                            {item.rawUnit}\n                          </td>\n\n                          {/* Hasil Konversi (Editable by user) */}\n                          <td className=\"py-2.5 px-3 text-right\">\n                            <div className=\"flex items-center justify-end gap-1\">\n                              <input\n                                type=\"number\"\n                                step=\"any\"\n                                value={item.userCorrection !== undefined ? item.userCorrection : item.convertedValue}\n                                onChange={(e) => handleEditConvertedValue(item.id, e.target.value)}\n                                className=\"w-20 px-2 py-1 text-right text-xs font-mono font-bold border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                              />\n                              <span className=\"text-slate-600 font-semibold w-5 text-left\">m</span>\n                            </div>\n                          </td>\n\n                          {/* Sumber / Notasi As */}\n                          <td className=\"py-2.5 px-3\">\n                            <span className=\"text-[11px] font-mono text-slate-700 block\">\n                              {item.pageOrLocation || \'-\'}\n                            </span>\n                            <span className=\"text-[10px] text-slate-400 block line-clamp-1\">\n                              {item.notes}\n                            </span>\n                          </td>\n\n                          {/* Status & Actions */}\n                          <td className=\"py-2.5 px-3 text-center\">\n                            <div className=\"flex items-center justify-center gap-1.5\">\n                              <button\n                                onClick={() => handleStatusChange(item.id, \'approved\')}\n                                className={`p-1.5 rounded-lg transition ${\n                                  item.status === \'approved\'\n                                    ? \'bg-emerald-600 text-white\'\n                                    : \'text-slate-400 hover:text-emerald-700 hover:bg-emerald-50\'\n                                }`}\n                                title=\"Setujui\"\n                              >\n                                <Check className=\"w-3.5 h-3.5\" />\n                              </button>\n                              <button\n                                onClick={() => handleStatusChange(item.id, \'rejected\')}\n                                className={`p-1.5 rounded-lg transition ${\n                                  item.status === \'rejected\'\n                                    ? \'bg-rose-600 text-white\'\n                                    : \'text-slate-400 hover:text-rose-700 hover:bg-rose-50\'\n                                }`}\n                                title=\"Tolak\"\n                              >\n                                <X className=\"w-3.5 h-3.5\" />\n                              </button>\n                            </div>\n                          </td>\n                        </tr>\n                      );\n                    })}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/50 shrink-0\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition\"\n          >\n            Tutup\n          </button>\n\n          <button\n            onClick={handleApply}\n            disabled={extractions.length === 0 || approvedCount === 0}\n            className=\"inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 disabled:cursor-not-allowed rounded-xl transition shadow-xs\"\n          >\n            <Check className=\"w-4 h-4\" />\n            <span>Masukkan ke Kalkulator ({approvedCount} Parameter Disetujui)</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 708
    num_bytes: 31287
    line_range_bytes: 31287
  }
}
