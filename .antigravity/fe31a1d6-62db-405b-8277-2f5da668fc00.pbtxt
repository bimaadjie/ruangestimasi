      arguments_json: "{\"Description\":\"Update excelExport.ts to use RuangEstimasi branding in creator, sheet header, and output filename\",\"Instruction\":\"Replace RuangRAB with RuangEstimasi in excelExport.ts\",\"ReplacementChunks\":[{\"AllowMultiple\":false,\"EndLine\":20,\"ReplacementContent\":\"/**\\n * RuangEstimasi - Layanan Ekspor Excel (XLSX) Asli menggunakan ExcelJS\\n * Menghasilkan 4 Sheet Lengkap:\\n *  1. Informasi Proyek\\n *  2. Rekap Volume\\n *  3. Detail Perhitungan\\n *  4. Status Verifikasi Rumus\\n */\\n\\nimport ExcelJS from \'exceljs\';\\nimport { ProjectData } from \'../types\';\\nimport { computeProjectSummaries, formatIndonesianNumber } from \'./calculationEngine\';\\n\\nexport async function exportProjectToExcel(project: ProjectData): Promise<void> {\\n  const workbook = new ExcelJS.Workbook();\\n  workbook.creator = \'RuangEstimasi \342\200\224 AI Quantity Takeoff\';\",\"StartLine\":1,\"TargetContent\":\"/**\\n * RuangRAB - Layanan Ekspor Excel (XLSX) Asli menggunakan ExcelJS\\n * Menghasilkan 4 Sheet Lengkap:\\n *  1. Informasi Proyek\\n *  2. Rekap Volume\\n *  3. Detail Perhitungan\\n *  4. Status Verifikasi Rumus\\n */\\n\\nimport ExcelJS from \'exceljs\';\\nimport { ProjectData } from \'../types\';\\nimport { computeProjectSummaries, formatIndonesianNumber } from \'./calculationEngine\';\\n\\nexport async function exportProjectToExcel(project: ProjectData): Promise<void> {\\n  const workbook = new ExcelJS.Workbook();\\n  workbook.creator = \'RuangRAB \342\200\224 AI Quantity Takeoff\';\"},{\"AllowMultiple\":false,\"EndLine\":63,\"ReplacementContent\":\"  // Header Judul\\n  wsInfo.mergeCells(\'A1:B1\');\\n  const titleCell = wsInfo.getCell(\'A1\');\\n  titleCell.value = \'RUANGESTIMASI \342\200\224 RINGKASAN DATA PROYEK & QUANTITY TAKEOFF\';\",\"StartLine\":56,\"TargetContent\":\"  // Header Judul\\n  wsInfo.mergeCells(\'A1:B1\');\\n  const titleCell = wsInfo.getCell(\'A1\');\\n  titleCell.value = \'RUANGRAB \342\200\224 RINGKASAN DATA PROYEK & QUANTITY TAKEOFF\';\"},{\"AllowMultiple\":false,\"EndLine\":298,\"ReplacementContent\":\"  const sanitizedProjName = (project.name || \'Proyek_Konstruksi\').replace(/[^a-zA-Z0-9_-]/g, \'_\');\\n  const dateStr = new Date().toISOString().slice(0, 10);\\n  const fileName = `RuangEstimasi_${sanitizedProjName}_${dateStr}.xlsx`;\",\"StartLine\":291,\"TargetContent\":\"  const sanitizedProjName = (project.name || \'Gedung_USC\').replace(/[^a-zA-Z0-9_-]/g, \'_\');\\n  const dateStr = new Date().toISOString().slice(0, 10);\\n  const fileName = `RuangRAB_${sanitizedProjName}_${dateStr}.xlsx`;\"}],\"TargetFile\":\"/src/services/excelExport.ts\",\"toolAction\":\"Updating excelExport.ts to RuangEstimasi\",\"toolSummary\":\"Update excelExport.ts to RuangEstimasi\"}"
