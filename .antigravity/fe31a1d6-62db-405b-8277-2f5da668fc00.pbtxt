  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * RuangRAB \342\200\224 Asisten AI & Input Manual (Bersebelahan)\n * Menampilkan kartu Asisten AI (tombol \"Coba Sekarang\" untuk masuk ke tampilan Asisten AI)\n * berdampingan secara proporsional dengan kartu Input Manual.\n */\n\nimport React from \'react\';\nimport {\n  Sparkles,\n  FileEdit,\n  ArrowRight,\n  Check,\n  FileSpreadsheet,\n} from \'lucide-react\';\nimport { FloorItem, ProjectWorkItem } from \'../types\';\n\ninterface AutoQuantityTakeoffSectionProps {\n  floors: FloorItem[];\n  activeFloorId: string;\n  onOpenManualForm: (floorId: string) => void;\n  onOpenDetailedModal: () => void;\n  existingWorks: ProjectWorkItem[];\n}\n\nexport const AutoQuantityTakeoffSection: React.FC<AutoQuantityTakeoffSectionProps> = ({\n  floors,\n  activeFloorId,\n  onOpenManualForm,\n  onOpenDetailedModal,\n  existingWorks,\n}) => {\n  const activeDraftCount = existingWorks.filter(\n    (w) => w.isActive && w.origin === \'ai\' && w.aiVerificationStatus === \'draft\'\n  ).length;\n\n  const targetFloor = floors.find((f) => f.id === activeFloorId) || floors[1] || floors[0];\n\n  return (\n    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5 mb-7 items-stretch\">\n      {/* Kartu Kiri: Asisten AI \342\200\224 Auto Quantity Takeoff */}\n      <div className=\"bg-white rounded-2xl border border-blue-200/90 p-5 shadow-xs flex flex-col justify-between hover:border-blue-300 transition relative overflow-hidden\">\n        <div className=\"absolute top-0 right-0 w-40 h-40 bg-blue-50/70 rounded-full blur-2xl pointer-events-none -mr-12 -mt-12\" />\n\n        <div className=\"relative z-10\">\n          <div className=\"flex items-start justify-between gap-3 mb-2\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-xs shrink-0\">\n                <Sparkles className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-2 flex-wrap\">\n                  <h3 className=\"text-base font-bold text-slate-900 leading-tight\">\n                    Asisten AI \342\200\224 Auto Quantity Takeoff\n                  </h3>\n                  <span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700 tracking-wider\">\n                    Beta\n                  </span>\n                </div>\n                <p className=\"text-xs text-slate-500 mt-0.5\">\n                  Bantu baca gambar &amp; dokumen denah bangunan secara otomatis.\n                </p>\n              </div>\n            </div>\n\n            {activeDraftCount > 0 && (\n              <span className=\"px-2.5 py-1 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 shrink-0\">\n                {activeDraftCount} Draf AI\n              </span>\n            )}\n          </div>\n\n          <p className=\"text-xs text-slate-600 mt-2.5 leading-relaxed\">\n            Unggah gambar atau PDF denah bangunan. AI akan mengekstrak dimensi tertulis dan langsung menyusun draf pekerjaan ke kalkulator untuk Anda verifikasi.\n          </p>\n\n          <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1.5 mt-3 text-[11px] text-slate-600\">\n            <span className=\"inline-flex items-center gap-1\">\n              <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n              <span>Dimensi bangunan &amp; ruang</span>\n            </span>\n            <span className=\"inline-flex items-center gap-1\">\n              <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n              <span>Konversi satuan (mm, cm, m)</span>\n            </span>\n            <span className=\"inline-flex items-center gap-1\">\n              <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n              <span>Draf pekerjaan otomatis</span>\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-4 pt-3.5 border-t border-slate-100 relative z-10\">\n          <button\n            type=\"button\"\n            onClick={onOpenDetailedModal}\n            className=\"w-full py-2.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs transition flex items-center justify-center gap-2 shadow-xs cursor-pointer\"\n          >\n            <FileSpreadsheet className=\"w-4 h-4\" />\n            <span>Coba Sekarang</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Kartu Kanan: Input Manual */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 p-5 shadow-xs flex flex-col justify-between hover:border-slate-300 transition\">\n        <div>\n          <div className=\"flex items-center gap-3 mb-2\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-xs shrink-0\">\n              <FileEdit className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900 leading-tight\">\n                Input Manual\n              </h3>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Isi data bangunan dan parameter secara manual.\n              </p>\n            </div>\n          </div>\n\n          <p className=\"text-xs text-slate-600 mt-2.5 leading-relaxed\">\n            Pilih satu atau beberapa pekerjaan sekaligus dari Katalog Pekerjaan standar maupun kustom, lalu lengkapi parameter ukuran sesuai kelompok lantai.\n          </p>\n\n          <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1.5 mt-3 text-[11px] text-slate-600\">\n            <span className=\"inline-flex items-center gap-1\">\n              <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n              <span>Multi-pilih katalog pekerjaan</span>\n            </span>\n            <span className=\"inline-flex items-center gap-1\">\n              <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n              <span>Lantai aktif: <strong>{targetFloor?.name || \'Lantai 1\'}</strong></span>\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-4 pt-3.5 border-t border-slate-100\">\n          <button\n            type=\"button\"\n            onClick={() => onOpenManualForm(activeFloorId)}\n            className=\"w-full py-2.5 px-4 rounded-xl border border-blue-200 hover:border-blue-400 bg-white hover:bg-blue-50/50 text-blue-700 font-bold text-xs transition flex items-center justify-center gap-2 shadow-2xs cursor-pointer\"\n          >\n            <span>Buka Form Input</span>\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
