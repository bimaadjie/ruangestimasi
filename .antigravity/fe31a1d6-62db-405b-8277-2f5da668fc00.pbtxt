  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * RuangRAB - Server Backend\n * Express API server with Vite middleware integration and server-side Gemini API.\n */\n\nimport express, { Request, Response } from \'express\';\nimport { createServer as createViteServer } from \'vite\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport path from \'path\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst app = express();\nconst PORT = process.env.PORT ? parseInt(process.env.PORT, 10) : 3000;\nconst isProd = process.env.NODE_ENV === \'production\';\n\n// Increase payload limit to support civil engineering PDFs / high-res CAD drawings\napp.use(express.json({ limit: \'40mb\' }));\napp.use(express.urlencoded({ extended: true, limit: \'40mb\' }));\n\n// Health check endpoint\napp.get(\'/api/health\', (req: Request, res: Response) => {\n  res.json({\n    status: \'ok\',\n    appName: \'RuangRAB\',\n    version: \'1.0.0\',\n    hasGeminiKey: Boolean(process.env.GEMINI_API_KEY),\n  });\n});\n\n/**\n * Endpoint Ekstraksi Parameter Dimensi dari Gambar / PDF menggunakan Gemini API\n */\napp.post(\'/api/gemini/extract-dimensions\', async (req: Request, res: Response): Promise<void> => {\n  try {\n    const { fileBase64, mimeType, fileName, floorName } = req.body;\n\n    if (!fileBase64 || !mimeType) {\n      res.status(400).json({\n        success: false,\n        error: \'Data file gambar atau dokumen PDF (base64) tidak ditemukan.\',\n      });\n      return;\n    }\n\n    if (!process.env.GEMINI_API_KEY) {\n      res.status(503).json({\n        success: false,\n        error: \'GEMINI_API_KEY belum dikonfigurasi pada server.\',\n      });\n      return;\n    }\n\n    const ai = new GoogleGenAI({\n      apiKey: process.env.GEMINI_API_KEY,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    });\n\n    const systemInstruction = `\nAnda adalah Senior Civil Engineering Quantity Surveyor dan Asisten AI RuangRAB yang sangat teliti.\nTugas Anda adalah membaca gambar teknik konstruksi bangunan (denah, potongan, detail balok/kolom, atau dokumen PDF) dan mengekstrak dimensi serta parameter kuantitas pekerjaan konstruksi secara akurat.\n\nATURAN KETAT:\n1. HANYA ekstrak teks, angka dimensi, ukuran (misal: \"B1 40/60\", \"K1 50x50\", \"Plat t=12cm\", \"P=25m L=20m\", \"Tinggi 3.4m\"), atau jumlah elemen yang terlihat secara eksplisit pada gambar atau tabel legenda.\n2. JANGAN MENGARANG atau menebak ukuran yang tidak terlihat atau terpotong!\n3. Jika terdapat dimensi yang ambigu atau ada perbedaan angka, catat di bagian \'notes\'.\n4. Klasifikasikan kategori ke salah satu: \'Persiapan Dll\', \'Struktural\', \'Arsitektural\', \'MEP\'.\n5. Format nilai numerik murni pada field \'extractedValue\' jika terukur.\n6. Kembalikan JSON terstruktur sesuai responseSchema.\n`;\n\n    const userPrompt = `\nBacalah gambar teknik/dokumen konstruksi berikut (${fileName || \'Dokumen Tanpa Nama\'}, untuk lantai ${floorName || \'Semua Lantai\'}).\nEkstraksi semua parameter ukuran yang dapat diidentifikasi:\n- Dimensi bangunan (panjang, lebar gedung)\n- Elemen struktural: dimensi balok (panjang, lebar, tinggi), kolom (lebar, tebal, tinggi, jumlah titik), pelat (tebal, luas, luas bukaan void), pondasi\n- Elemen arsitektural: keliling dinding bata ringan, tinggi dinding, pintu/jendela (tipe, jumlah unit, dimensi kusen/daun)\n- Elemen kelistrikan/sanitasi: jumlah titik lampu, kran air, pipa PVC jika terdapat pada denah.\n`;\n\n    // Remove data URL header if present in base64 string\n    const cleanBase64 = fileBase64.replace(/^data:[^;]+;base64,/, \'\');\n\n    const documentPart = {\n      inlineData: {\n        mimeType: mimeType,\n        data: cleanBase64,\n      },\n    };\n\n    const textPart = {\n      text: userPrompt,\n    };\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.8-flash\',\n      contents: { parts: [documentPart, textPart] },\n      config: {\n        systemInstruction,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            documentSummary: {\n              type: Type.STRING,\n              description: \'Ringkasan singkat gambar/dokumen (jenis gambar, lantai yang diidentifikasi, skala).\',\n            },\n            identifiedFloor: {\n              type: Type.STRING,\n              description: \'Nama lantai jika tertera pada gambar (misal: Lantai 1, Lantai 2).\',\n            },\n            items: {\n              type: Type.ARRAY,\n              description: \'Daftar parameter dimensi dan kuantitas pekerjaan yang terbaca.\',\n              items: {\n                type: Type.OBJECT,\n                properties: {\n                  targetCategory: {\n                    type: Type.STRING,\n                    description: \'Kategori: Persiapan Dll, Struktural, Arsitektural, atau MEP.\',\n                  },\n                  suggestedWorkName: {\n                    type: Type.STRING,\n                    description: \'Nama pekerjaan yang relevan (misal: Balok Type 1 (40 x 60 cm), Kolom Type K1, Dinding Bata Ringan).\',\n                  },\n                  parameterName: {\n                    type: Type.STRING,\n                    description: \'Nama parameter (Panjang, Lebar, Tinggi, Tebal, Jumlah Titik, Luas Bukaan, dll).\',\n                  },\n                  extractedValue: {\n                    type: Type.NUMBER,\n                    description: \'Nilai angka hasil pembacaan.\',\n                  },\n                  unit: {\n                    type: Type.STRING,\n                    description: \'Satuan parameter (m, m2, m3, titik, unit, buah, kg).\',\n                  },\n                  confidence: {\n                    type: Type.NUMBER,\n                    description: \'Tingkat keyakinan pembacaan antara 0.0 sampai 1.0.\',\n                  },\n                  pageOrLocation: {\n                    type: Type.STRING,\n                    description: \'Lokasi as atau keterangan pada gambar (misal: As 1-4, Grid B-C, Tabel Tipe Balok).\',\n                  },\n                  notes: {\n                    type: Type.STRING,\n                    description: \'Catatan teknis atau kejelasan pembacaan.\',\n                  },\n                },\n                required: [\'targetCategory\', \'suggestedWorkName\', \'parameterName\', \'extractedValue\', \'unit\'],\n              },\n            },\n          },\n          required: [\'documentSummary\', \'items\'],\n        },\n      },\n    });\n\n    const responseText = response.text || \'{}\';\n    const parsedData = JSON.parse(responseText);\n\n    res.json({\n      success: true,\n      data: parsedData,\n    });\n  } catch (error: unknown) {\n    console.error(\'Gemini extraction error:\', error);\n    const errorMsg = error instanceof Error ? error.message : String(error);\n    res.status(500).json({\n      success: false,\n      error: `Gagal membaca gambar dengan AI: ${errorMsg}`,\n    });\n  }\n});\n\n// Setup Vite development middlewares or static files for production\nasync function startServer() {\n  if (!isProd) {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req: Request, res: Response) => {\n      res.sendFile(path.resolve(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`RuangRAB server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
        path {
          absolute_uri: "file:///server.ts"
        }
        overwrite: true
      }
    }
