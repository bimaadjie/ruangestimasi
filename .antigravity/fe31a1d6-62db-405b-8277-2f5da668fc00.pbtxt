    content: "                            <span className=\"font-bold text-slate-900\">{rec.name}</span>\n                            <span className=\"text-[10px] px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-600 font-semibold\">\n                              {rec.category}\n                            </span>\n                          </div>\n                          <p className=\"text-[11px] text-slate-500 mt-0.5\">{rec.reason}</p>\n                        </div>\n\n                        <button\n                          type=\"button\"\n                          disabled={isAdded}\n                          onClick={() => {\n                            onAddRecommendationWork(rec.catalogId, selectedFloorId, rec.reason);\n                            setAddedRecIds((prev) => ({ ...prev, [rec.catalogId]: true }));\n                          }}\n                          className={`inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold shrink-0 transition ${\n                            isAdded\n                              ? \'bg-emerald-100 text-emerald-800 cursor-default\'\n                              : \'bg-blue-600 hover:bg-blue-700 text-white shadow-2xs\'\n                          }`}\n                        >\n                          {isAdded ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5\" />\n                              <span>Ditambahkan</span>\n                            </>\n                          ) : (\n                            <>\n                              <Plus className=\"w-3.5 h-3.5\" />\n                              <span>Tambah ke Draf</span>\n                            </>\n                          )}\n                        </button>\n                      </div>\n                    );\n                  })}\n\n                  {takeoffSummary.recommendations.length === 0 && (\n                    <div className=\"p-6 text-center text-slate-500 bg-slate-50 rounded-xl border border-slate-200\">\n                      Tidak ada rekomendasi pekerjaan tambahan untuk gambar ini.\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 bg-slate-50/50 shrink-0\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition\"\n          >\n            Tutup\n          </button>\n\n          <div className=\"flex items-center gap-2.5\">\n            {currentFloorAiWorks.some(\n              (w) => w.aiVerificationStatus === \'draft\' && w.calculatedVolume !== null\n            ) && (\n              <button\n                type=\"button\"\n                onClick={onApproveAllReadyDrafts}\n                className=\"inline-flex items-center gap-1.5 px-4 py-2.5 text-xs font-bold text-emerald-800 bg-emerald-100 hover:bg-emerald-200 rounded-xl transition\"\n              >\n                <FileCheck2 className=\"w-4 h-4\" />\n                <span>Setujui Semua Draf yang Lengkap</span>\n              </button>\n            )}\n\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition shadow-xs\"\n            >\n              <span>Lihat Pekerjaan Hasil AI di Kalkulator</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n"
