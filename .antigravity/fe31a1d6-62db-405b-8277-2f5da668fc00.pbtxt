            lines {
              text: "      { id: \'keliling_toilet\', name: \'keliling_toilet\', label: \'Total Keliling Dinding Toilet (P)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tinggi_keramik\', name: \'tinggi_keramik\', label: \'Tinggi Pasangan Keramik (T)\', value: 2.0, unit: \'m\', required: true },"
