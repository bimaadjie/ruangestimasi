  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * RuangRAB - Server Backend\n * Express API server with Vite middleware integration, server-side Gemini API,\n * exponential backoff retry with jitter, and model fallback.\n */\n\nimport express, { Request, Response } from \'express\';\nimport { createServer as createViteServer } from \'vite\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport path from \'path\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst app = express();\nconst PORT = process.env.PORT ? parseInt(process.env.PORT, 10) : 3000;\nconst isProd = process.env.NODE_ENV === \'production\';\n\n// Support civil engineering high-resolution drawing PDFs & CAD image uploads\napp.use(express.json({ limit: \'40mb\' }));\napp.use(express.urlencoded({ extended: true, limit: \'40mb\' }));\n\n// Health check endpoint\napp.get(\'/api/health\', (req: Request, res: Response) => {\n  res.json({\n    status: \'ok\',\n    appName: \'RuangRAB\',\n    version: \'1.1.0\',\n    hasGeminiKey: Boolean(process.env.GEMINI_API_KEY),\n  });\n});\n\n/**\n * Helper function: delay with exponential backoff & jitter\n */\nfunction wait(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nfunction isRetryableError(err: any): boolean {\n  if (!err) return false;\n  const status = err.status || err.code || err.statusCode;\n  const message = String(err.message || \'\');\n\n  // 503 Service Unavailable / 429 Rate Limit / Transient network errors\n  if (status === 503 || status === 429) return true;\n  if (message.includes(\'503\') || message.includes(\'UNAVAILABLE\') || message.includes(\'high demand\')) return true;\n  if (message.includes(\'429\') || message.includes(\'RESOURCE_EXHAUSTED\')) return true;\n  if (message.includes(\'ECONNRESET\') || message.includes(\'ETIMEDOUT\') || message.includes(\'fetch failed\')) return true;\n\n  // Non-retryable: 400 Bad Request, 401 Unauthorized, 403 Forbidden\n  if (status === 400 || status === 401 || status === 403) return false;\n  if (message.includes(\'API_KEY_INVALID\') || message.includes(\'PERMISSION_DENIED\')) return false;\n\n  return false;\n}\n\n/**\n * Endpoint Ekstraksi Parameter Dimensi dari Gambar / PDF menggunakan Gemini API\n * Dilengkapi Exponential Backoff, Jitter, dan Fast Model Fallback\n */\napp.post(\'/api/gemini/extract-dimensions\', async (req: Request, res: Response): Promise<void> => {\n  try {\n    const { fileBase64, mimeType, fileName, floorName, unitSetting, scaleSetting } = req.body;\n\n    if (!fileBase64 || !mimeType) {\n      res.status(400).json({\n        success: false,\n        error: \'Data file gambar atau dokumen PDF (base64) tidak ditemukan.\',\n      });\n      return;\n    }\n\n    if (!process.env.GEMINI_API_KEY) {\n      res.status(503).json({\n        success: false,\n        error: \'GEMINI_API_KEY belum dikonfigurasi pada environment server.\',\n      });\n      return;\n    }\n\n    const ai = new GoogleGenAI({\n      apiKey: process.env.GEMINI_API_KEY,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    });\n\n    const chosenUnit = unitSetting || \'cm\';\n    const chosenScale = scaleSetting || \'1:100\';\n\n    const systemInstruction = `\nAnda adalah Senior Civil Engineering Quantity Surveyor RuangRAB yang sangat teliti.\nTugas Anda membaca gambar teknik denah/potongan konstruksi (PDF/gambar) dan mengekstrak dimensi serta parameter kuantitas pekerjaan secara akurat.\n\nATURAN UTAMA TEKNIK SIPIL:\n1. BACA ANGKA DIMENSI TERTULIS PADA GAMBAR (contoh: 600, 300, 150, 1270, 200, 170, 100, 37).\n2. Simpan nilai angka dimensi asli pada field \"rawExtractedValue\" (contoh: 600, 300, 150, 1270). JANGAN SEKALI-KALI mengalikan angka tertulis dengan faktor skala!\n3. Jika pada gambar angka tertulis tanpa satuan eksplisit, gunakan satuan default yang dipilih pengguna: \"${chosenUnit}\".\n4. Identifikasi dimensi total bangunan (Panjang Total dan Lebar Total) berdasarkan batas garis as/grid terjauh.\n5. Identifikasi nama ruang, elevasi lantai (FFL), dimensi grid ruangan (misal: R.Tamu, R.Makan, Dapur, KM/WC, Teras, Taman).\n6. Catat lokasi as/grid secara spesifik pada field \"pageOrLocation\" (contoh: \"As A-D\", \"As 1-9\", \"As 6-8\", \"As 4-5\").\n7. Berikan usulan nama pekerjaan RuangRAB yang relevan:\n   - \"Pembersihan Lahan\" -> Parameter: \"Panjang\", \"Lebar\" (dari dimensi total denah)\n   - \"Bouwplank\" -> Parameter: \"Panjang\", \"Lebar\" (dari dimensi total denah)\n   - \"Dinding Bata Ringan\" -> Parameter: \"Panjang Keliling Dinding\" (dari keliling ruang)\n   - \"Homogenous Tile 60x60\" -> Parameter: \"Panjang\", \"Lebar\" (dari dimensi ruang lantai)\n   - \"Keramik Lantai Toilet 40x40\" -> Parameter: \"Panjang\", \"Lebar\" (dari KM/WC)\n   - \"Kolom\" / \"Balok\" jika dimensi tertera\n8. JANGAN MENGARANG dimensi yang tidak terlihat pada gambar.\n9. Kembalikan JSON terstruktur sesuai responseSchema.\n`;\n\n    const userPrompt = `\nDokumen yang dianalisis: ${fileName || \'Dokumen Denah\'}\nTarget Lantai: ${floorName || \'Lantai 1\'}\nSatuan dimensi gambar yang dipilih pengguna: ${chosenUnit}\nSkala tertera: ${chosenScale}\n\nLakukan pembacaan lengkap:\n1. Ekstrak judul denah dan skala tertera pada gambar.\n2. Ekstrak dimensi total bangunan (Lebar total dan Panjang total dari garis dimensi terluar).\n3. Ekstrak dimensi ruang-ruang utama dan bukaan/as yang tercantum jelas.\n`;\n\n    // Remove data URL header if present in base64 string\n    const cleanBase64 = fileBase64.replace(/^data:[^;]+;base64,/, \'\');\n\n    const documentPart = {\n      inlineData: {\n        mimeType: mimeType,\n        data: cleanBase64,\n      },\n    };\n\n    const textPart = {\n      text: userPrompt,\n    };\n\n    // Sequential fallback order: try primary first; on 503 switch immediately to fallback\n    const plannedAttempts = [\n      { model: \'gemini-3.8-flash\', label: \'Primary (gemini-3.8-flash)\' },\n      { model: \'gemini-3.1-flash-lite\', label: \'Fallback 1 (gemini-3.1-flash-lite)\' },\n      { model: \'gemini-3.1-flash-lite\', label: \'Fallback 2 with Backoff (gemini-3.1-flash-lite)\' },\n    ];\n\n    let lastError: any = null;\n    let successfulResponseText: string | null = null;\n    let modelUsed = \'\';\n\n    for (let i = 0; i < plannedAttempts.length; i++) {\n      const { model, label } = plannedAttempts[i];\n      const attemptNum = i + 1;\n\n      try {\n        console.log(`[RuangRAB AI] Attempt ${attemptNum}/3: Invoking ${label}...`);\n\n        const response = await ai.models.generateContent({\n          model,\n          contents: { parts: [documentPart, textPart] },\n          config: {\n            systemInstruction,\n            responseMimeType: \'application/json\',\n            responseSchema: {\n              type: Type.OBJECT,\n              properties: {\n                documentSummary: {\n                  type: Type.STRING,\n                  description: \'Ringkasan singkat gambar (judul denah, jenis gambar, skala, elevasi FFL).\',\n                },\n                identifiedFloor: {\n                  type: Type.STRING,\n                  description: \'Nama lantai yang tertera (misal: Lantai 1, Lantai 2).\',\n                },\n                identifiedScale: {\n                  type: Type.STRING,\n                  description: \'Skala yang tertera pada etiket (misal: 1:100).\',\n                },\n                items: {\n                  type: Type.ARRAY,\n                  description: \'Daftar parameter dimensi dan kuantitas pekerjaan yang terbaca.\',\n                  items: {\n                    type: Type.OBJECT,\n                    properties: {\n                      targetCategory: {\n                        type: Type.STRING,\n                        description: \'Kategori: Persiapan Dll, Struktural, Arsitektural, atau MEP.\',\n                      },\n                      suggestedWorkName: {\n                        type: Type.STRING,\n                        description: \'Nama pekerjaan yang relevan (misal: Pembersihan Lahan, Dinding Bata Ringan, Lebar Bangunan Total, dll).\',\n                      },\n                      parameterName: {\n                        type: Type.STRING,\n                        description: \'Nama parameter (Panjang, Lebar, Tinggi, Tebal, Jumlah, dsb).\',\n                      },\n                      rawExtractedValue: {\n                        type: Type.NUMBER,\n                        description: \'Angka asli yang tertulis pada gambar tanpa perkalian skala (misal: 600, 300, 150, 1270).\',\n                      },\n                      detectedUnit: {\n                        type: Type.STRING,\n                        description: \'Satuan yang tertera atau default pengguna (mm, cm, m).\',\n                      },\n                      confidence: {\n                        type: Type.NUMBER,\n                        description: \'Tingkat keyakinan pembacaan antara 0.0 sampai 1.0.\',\n                      },\n                      pageOrLocation: {\n                        type: Type.STRING,\n                        description: \'Garis as atau lokasi pada denah (misal: As A-D, As 1-9, Ruang Tamu, KM/WC).\',\n                      },\n                      notes: {\n                        type: Type.STRING,\n                        description: \'Keterangan teknis pembacaan atau notasi.\',\n                      },\n                    },\n                    required: [\n                      \'targetCategory\',\n                      \'suggestedWorkName\',\n                      \'parameterName\',\n                      \'rawExtractedValue\',\n                    ],\n                  },\n                },\n              },\n              required: [\'documentSummary\', \'items\'],\n            },\n          },\n        });\n\n        successfulResponseText = response.text || \'{}\';\n        modelUsed = model;\n        console.log(`[RuangRAB AI] Success on attempt ${attemptNum} with model: ${model}`);\n        break;\n      } catch (err: any) {\n        lastError = err;\n        console.warn(`[RuangRAB AI] Attempt ${attemptNum} failed with error:`, err?.status || err?.code || \'\', err?.message || err);\n\n        if (!isRetryableError(err)) {\n          // Fatal error (bad request, auth error); do not retry\n          console.error(\'[RuangRAB AI] Non-retryable error, aborting attempts.\');\n          break;\n        }\n\n        if (i < plannedAttempts.length - 1) {\n          // Calculate exponential backoff with jitter\n          const jitter = Math.floor(Math.random() * 400);\n          const backoffMs = 1000 + i * 1000 + jitter;\n          console.log(`[RuangRAB AI] Waiting ${backoffMs}ms before fallback/retry attempt ${attemptNum + 1}...`);\n          await wait(backoffMs);\n        }\n      }\n    }\n\n    if (!successfulResponseText) {\n      console.error(\'[RuangRAB AI] All 3 attempts failed. Last error:\', lastError?.message || lastError);\n\n      res.status(503).json({\n        success: false,\n        isBusy: true,\n        error: \'Server AI sedang sibuk. Dokumen belum berhasil dianalisis. Silakan coba kembali beberapa saat lagi.\',\n        technicalDetail: lastError?.message ? String(lastError.message).slice(0, 200) : \'Layanan AI mengalami beban tinggi.\',\n      });\n      return;\n    }\n\n    const parsedData = JSON.parse(successfulResponseText);\n\n    res.json({\n      success: true,\n      modelUsed,\n      data: parsedData,\n    });\n  } catch (error: unknown) {\n    console.error(\'[RuangRAB AI] Server unexpected error:\', error);\n    const errorMsg = error instanceof Error ? error.message : String(error);\n    res.status(500).json({\n      success: false,\n      error: `Gagal membaca gambar dengan AI: ${errorMsg}`,\n    });\n  }\n});\n\n// Setup Vite development middlewares or static files for production\nasync function startServer() {\n  if (!isProd) {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req: Request, res: Response) => {\n      res.sendFile(path.resolve(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`RuangRAB server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
        path {
