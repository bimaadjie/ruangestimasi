      thinking_signature: "\022\231\023\n\226\023\001i\024}\023\307\315\255\200X\220J\262_!\307\034\2131-\352\003)\243\344#l>\274\326\230\"\345\004z\t\304E\260s\326\277\337\177\313@\231\2131\332\214\336\321\016\234\224\315\317\331\265\363\375G\305C\034\025_s\355\2131\342\342w\370c\213T\004\354\317\234\232\210I\221\2118\361YO\306W\346\'\222p\275\372\004\325.P\315\240YoZ\332\361h\225\205B\000/\321\255\377\226\244b\377D\216\331\b7\351\2546\230\305I\274:\001\334_\330\361\216y\343v-|+\314llT`\315*4\367\246\257W-\240\005\0333E\000\273/\273\365\023\250pT?/\177\341\2248\a\327\260\354\206\231e\320\206\206\'\260^3\252\214\345iG\272kg_\360\263\341{\2409K\3609\377\r]\321\003\006\353n\030\334\325\377\361\316~\236\364\020\367\324\353\255}\203K\310\034\321\t\342\302T\037\266a\334\206\211\265]\r<u\036\357\343x!\240D#\250[\312\211\330$4\'\377\207\005\345\306\227\327B\200\320\264\253\024\366d_\243\3503{`\200\346\303\276X\266\253\320\001K\231kM\211\252\370\360\213=\212\3120)\a\252\276\177\214\250\253\022\317\245\341d\374\350\314\0219\351\327M\037\345\217\205\301\376\306\271}\324]\336\262j\215z\312\242ax\331\022\263\356\2438\253\366\230#\306pG\262\302\336\364um\003AJ\a~\370f\214\376\006\265D*K\346\351\337\360\3767\222\005\237O\v\022g\320\350\333\031b\021\300e\340\223\223\004=`\357\322\\\v>b\324\226\tBe\027?J\267\315Qf\206S\316o\227\227\230\245P/n\261\\4\326$v\342\217\324\241\362s\214\222;\266\277pl\206\003\253\220f\274x\371\003\320\265\200\361\305:\361b\312\320\247\273\312\270\237\345\257\222\356?\006vg3\264\026G\230\320l\201\030aJd\252Bf\376\257\3336.p}\253\216\316Z\017\350F\020\327\307_\001O\200gc\226\315\t8\024\022\021\fA\252`\375s\212\216\025\310\370\374\277\316\026}#k\220-+\336\000\226\'\202\t\0264\337[wk\252\334ip\003b\350\201\025|\343\326)\362\274D\316O+aT\225\205\354\374\204\256\245E\317u\265N\334\372=\244\207\214/q\0276\3650\225\255\376\361\217\365|\027\"\345!\334\356\323,\223\276Z\v\310!\225@\242\243HL\361B\350\300\241\217zl\303h\\0\025\307\303\023\2065\313S\267J\nD\244\204\2