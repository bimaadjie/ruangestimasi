        use_fast_apply: true
        replacement_chunks {
          target_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  Plus,\n  ChevronDown,\n  ChevronRight,\n  MoreVertical,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Eye,\n  Copy,\n  Trash2,\n  Sliders,\n  Layers,\n} from \'lucide-react\';\nimport { FloorItem, ProjectWorkItem, WorkCategory } from \'../types\';\nimport { formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface WorkTableProps {\n  works: ProjectWorkItem[];\n  floors: FloorItem[];\n  onOpenWorkDetail: (work: ProjectWorkItem) => void;\n  onOpenAddWork: (floorId?: string) => void;\n  onDeleteWork: (workId: string) => void;\n  onDuplicateWork: (work: ProjectWorkItem) => void;\n  onToggleActive: (workId: string) => void;\n}\n\nexport const WorkTable: React.FC<WorkTableProps> = ({\n  works,\n  floors,\n  onOpenWorkDetail,\n  onOpenAddWork,\n  onDeleteWork,\n  onDuplicateWork,\n  onToggleActive,\n}) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'Semua\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [collapsedFloors, setCollapsedFloors] = useState<Record<string, boolean>>({});\n  const [openActionMenuId, setOpenActionMenuId] = useState<string | null>(null);\n\n  const categories: string[] = [\'Semua\', \'Persiapan Dll\', \'Struktural\', \'Arsitektural\', \'MEP\'];\n\n  const toggleFloorCollapse = (floorId: string) => {\n    setCollapsedFloors((prev) => ({\n      ...prev,\n      [floorId]: !prev[floorId],\n    }));\n  };\n\n  // Filter works by category and search text\n  const filteredWorks = works.filter((w) => {\n    const matchCategory = selectedCategory === \'Semua\' || w.category === selectedCategory;\n    const matchSearch =\n      searchQuery.trim() === \'\' ||\n      w.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (w.formulaDisplay && w.formulaDisplay.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (w.excelCell && w.excelCell.toLowerCase().includes(searchQuery.toLowerCase()));\n    return matchCategory && matchSearch;\n  });\n\n  // Group works by floor\n  const worksByFloor: Record<string, ProjectWorkItem[]> = {};\n  for (const floor of floors) {\n    worksByFloor[floor.id] = [];\n  }\n\n  for (const work of filteredWorks) {\n    if (!worksByFloor[work.floorId]) {\n      worksByFloor[work.floorId] = [];\n    }\n    worksByFloor[work.floorId].push(work);\n  }\n\n  // Helper status badge\n  const renderStatusBadge = (status: string) => {\n    switch (status) {\n      case \'Lengkap\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200\">\n            <CheckCircle2 className=\"w-3 h-3 text-emerald-600\" />\n            Lengkap\n          </span>\n        );\n      case \'Perlu Input\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200\">\n            <Clock className=\"w-3 h-3 text-amber-600\" />\n            Perlu Input\n          </span>\n        );\n      case \'Perlu Verifikasi\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200\">\n            <AlertCircle className=\"w-3 h-3 text-blue-600\" />\n            Verifikasi\n          </span>\n        );\n      default:\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200\">\n            {status}\n          </span>\n        );\n    }\n  };\n\n  const getCategoryBadgeClass = (cat: WorkCategory) => {\n    switch (cat) {\n      case \'Persiapan Dll\':\n        return \'bg-blue-50 text-blue-700 border-blue-100\';\n      case \'Struktural\':\n        return \'bg-indigo-50 text-indigo-700 border-indigo-100\';\n      case \'Arsitektural\':\n        return \'bg-teal-50 text-teal-700 border-teal-100\';\n      case \'MEP\':\n        return \'bg-purple-50 text-purple-700 border-purple-100\';\n      default:\n        return \'bg-slate-50 text-slate-700 border-slate-100\';\n    }\n  };\n\n  return (\n    <div className=\"bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden\">\n      {/* Header Bar */}\n      <div className=\"p-5 border-b border-slate-100\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900\">Daftar Pekerjaan &amp; Volume</h3>\n            <p className=\"text-xs text-slate-500\">\n              Total {filteredWorks.length} pekerjaan terdaftar untuk seluruh zona &amp; elevasi lantai.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2.5\">\n            {/* Search Input */}\n            <div className=\"relative\">\n              <Search className=\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                placeholder=\"Cari pekerjaan...\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                className=\"pl-8 pr-3 py-1.5 text-xs rounded-lg border border-slate-200 bg-slate-50/50 hover:bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 w-44 sm:w-56 transition\"\n              />\n            </div>\n\n            {/* Tambah Pekerjaan Button */}\n            <button\n              onClick={() => onOpenAddWork()}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition shadow-xs shrink-0\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              <span>Tambah Pekerjaan</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Filter Tabs */}\n        <div className=\"flex items-center gap-2 mt-4 overflow-x-auto pb-1\">\n          {categories.map((cat) => {\n            const isSelected = selectedCategory === cat;\n            return (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all shrink-0 ${\n                  isSelected\n                    ? \'bg-blue-600 text-white shadow-2xs\'\n                    : \'bg-slate-100/80 text-slate-600 hover:bg-slate-200/70 hover:text-slate-900\'\n                }`}\n              >\n                {cat}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Grouped Table View */}\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full text-left text-xs border-collapse\">\n          <thead>\n            <tr className=\"bg-slate-50/80 text-slate-600 font-semibold border-b border-slate-200/80 select-none\">\n              <th className=\"py-3 px-4 w-12 text-center\">No</th>\n              <th className=\"py-3 px-4 min-w-[200px]\">Pekerjaan</th>\n              <th className=\"py-3 px-3 w-28\">Kategori</th>\n              <th className=\"py-3 px-4 min-w-[180px]\">Parameter / Rumus</th>\n              <th className=\"py-3 px-3 w-16 text-center\">Satuan</th>\n              <th className=\"py-3 px-4 w-28 text-right\">Volume</th>\n              <th className=\"py-3 px-4 w-28 text-center\">Status</th>\n              <th className=\"py-3 px-4 w-14 text-center\">Aksi</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {floors.map((floor) => {\n              const floorWorks = worksByFloor[floor.id] || [];\n              const isCollapsed = collapsedFloors[floor.id] ?? false;\n\n              if (floorWorks.length === 0 && selectedCategory !== \'Semua\') {\n                return null;\n              }\n\n              return (\n                <React.Fragment key={floor.id}>\n                  {/* Floor Group Header Accordion */}\n                  <tr\n                    onClick={() => toggleFloorCollapse(floor.id)}\n                    className=\"bg-slate-100/60 hover:bg-slate-100 cursor-pointer transition select-none\"\n                  >\n                    <td colSpan={8} className=\"py-2.5 px-4 font-bold text-slate-800\">\n                      <div className=\"flex items-center justify-between\">\n                        <div className=\"flex items-center gap-2\">\n                          {isCollapsed ? (\n                            <ChevronRight className=\"w-4 h-4 text-slate-500\" />\n                          ) : (\n                            <ChevronDown className=\"w-4 h-4 text-slate-500\" />\n                          )}\n                          <Layers className=\"w-3.5 h-3.5 text-blue-600\" />\n                          <span>{floor.name}</span>\n                          {floor.elevation && (\n                            <span className=\"text-[11px] text-slate-500 font-normal ml-1\">\n                              ({floor.elevation})\n                            </span>\n                          )}\n                        </div>\n                        <span className=\"text-[11px] font-medium text-slate-500 bg-white border border-slate-200 rounded-md px-2 py-0.5 shadow-2xs\">\n                          {floorWorks.length} pekerjaan\n                        </span>\n                      </div>\n                    </td>\n                  </tr>\n\n                  {/* Floor Work Rows */}\n                  {!isCollapsed &&\n                    floorWorks.map((work, idx) => (\n                      <tr\n                        key={work.id}\n                        className={`hover:bg-blue-50/30 transition-colors group ${\n                          !work.isActive ? \'opacity-50 bg-slate-50/50\' : \'\'\n                        }`}\n                      >\n                        {/* No */}\n                        <td className=\"py-3 px-4 text-center text-slate-400 font-medium font-mono\">\n                          {idx + 1}\n                        </td>\n\n                        {/* Pekerjaan */}\n                        <td className=\"py-3 px-4\">\n                          <button\n                            onClick={() => onOpenWorkDetail(work)}\n                            className=\"text-left font-semibold text-slate-900 hover:text-blue-600 block transition focus:outline-none\"\n                          >\n                            {work.name}\n                          </button>\n                          {work.excelCell && (\n                            <span className=\"text-[10px] text-slate-400 block font-mono\">\n                              Ref: {work.excelSheet || \'USC\'}!{work.excelCell}\n                            </span>\n                          )}\n                        </td>\n\n                        {/* Kategori */}\n                        <td className=\"py-3 px-3\">\n                          <span\n                            className={`inline-block px-2 py-0.5 text-[10px] font-semibold rounded-md border ${getCategoryBadgeClass(\n                              work.category\n                            )}`}\n                          >\n                            {work.category}\n                          </span>\n                        </td>\n\n                        {/* Parameter / Rumus */}\n                        <td className=\"py-3 px-4\">\n                          <button\n                            onClick={() => onOpenWorkDetail(work)}\n                            className=\"text-left text-slate-600 hover:text-blue-600 font-mono text-[11px] block truncate max-w-xs transition\"\n                            title={work.formulaDisplay}\n                          >\n                            {work.formulaDisplay || \'-\'}\n                          </button>\n                        </td>\n\n                        {/* Satuan */}\n                        <td className=\"py-3 px-3 text-center font-medium text-slate-600\">\n                          {work.unit}\n                        </td>\n\n                        {/* Volume */}\n                        <td className=\"py-3 px-4 text-right font-bold text-slate-900 font-mono text-sm tabular-nums\">\n                          {work.calculatedVolume !== null\n                            ? formatIndonesianNumber(work.calculatedVolume)\n                            : \'-\'}\n                        </td>\n\n                        {/* Status */}\n                        <td className=\"py-3 px-4 text-center\">\n                          {renderStatusBadge(work.status)}\n                        </td>\n\n                        {/* Aksi */}\n                        <td className=\"py-3 px-4 text-center relative\">\n                          <div className=\"relative inline-block text-left\">\n                            <button\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                setOpenActionMenuId(openActionMenuId === work.id ? null : work.id);\n                              }}\n                              className=\"p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-700 transition\"\n                            >\n                              <MoreVertical className=\"w-4 h-4\" />\n                            </button>\n\n                            {openActionMenuId === work.id && (\n                              <div\n                                onClick={(e) => e.stopPropagation()}\n                                className=\"absolute right-0 top-full mt-1 w-44 bg-white border border-slate-200 rounded-xl shadow-lg z-30 py-1 text-xs\"\n                              >\n                                <button\n                                  onClick={() => {\n                                    setOpenActionMenuId(null);\n                                    onOpenWorkDetail(work);\n                                  }}\n                                  className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600 flex items-center gap-2 transition\"\n                                >\n                                  <Eye className=\"w-3.5 h-3.5 text-slate-400\" />\n                                  <span>Detail &amp; Rumus</span>\n                                </button>\n                                <button\n                                  onClick={() => {\n                                    setOpenActionMenuId(null);\n                                    onOpenWorkDetail(work);\n                                  }}\n                                  className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600 flex items-center gap-2 transition\"\n                                >\n                                  <Sliders className=\"w-3.5 h-3.5 text-slate-400\" />\n                                  <span>Ubah Parameter</span>\n                                </button>\n                                <button\n                                  onClick={() => {\n                                    setOpenActionMenuId(null);\n                                    onDuplicateWork(work);\n                                  }}\n                                  className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600 flex items-center gap-2 transition\"\n                                >\n                                  <Copy className=\"w-3.5 h-3.5 text-slate-400\" />\n                                  <span>Duplikasi</span>\n                                </button>\n                                <button\n                                  onClick={() => {\n                                    setOpenActionMenuId(null);\n                                    onToggleActive(work.id);\n                                  }}\n                                  className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition\"\n                                >\n                                  <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n                                  <span>{work.isActive ? \'Nonaktifkan\' : \'Aktifkan\'}</span>\n                                </button>\n                                <div className=\"h-px bg-slate-100 my-1\" />\n                                <button\n                                  onClick={() => {\n                                    setOpenActionMenuId(null);\n                                    onDeleteWork(work.id);\n                                  }}\n                                  className=\"w-full text-left px-3 py-2 text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition\"\n                                >\n                                  <Trash2 className=\"w-3.5 h-3.5\" />\n                                  <span>Hapus Pekerjaan</span>\n                                </button>\n                              </div>\n                            )}\n                          </div>\n                        </td>\n                      </tr>\n                    ))}\n                </React.Fragment>\n              );\n            })}\n          </tbody>\n        </table>\n\n        {filteredWorks.length === 0 && (\n          <div className=\"p-10 text-center text-slate-500 text-xs\">\n            Tidak ada pekerjaan yang cocok dengan filter atau kata kunci pencarian.\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};"
          replacement_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  Plus,\n  ChevronDown,\n  ChevronRight,\n  MoreVertical,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Copy,\n  Trash2,\n  Layers,\n  Sparkles,\n  Check,\n  Pencil,\n  AlertTriangle,\n  FileText,\n  X,\n} from \'lucide-react\';\nimport { FloorItem, ProjectWorkItem, WorkCategory } from \'../types\';\nimport { formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface WorkTableProps {\n  works: ProjectWorkItem[];\n  floors: FloorItem[];\n  onOpenWorkDetail: (work: ProjectWorkItem) => void;\n  onOpenAddWork: (floorId?: string) => void;\n  onDeleteWork: (workId: string) => void;\n  onDuplicateWork: (work: ProjectWorkItem) => void;\n  onToggleActive: (workId: string) => void;\n  onApproveDraftWork?: (workId: string) => void;\n  onApproveAllReadyDrafts?: () => void;\n}\n\nexport const WorkTable: React.FC<WorkTableProps> = ({\n  works,\n  floors,\n  onOpenWorkDetail,\n  onOpenAddWork,\n  onDeleteWork,\n  onDuplicateWork,\n  onToggleActive,\n  onApproveDraftWork,\n  onApproveAllReadyDrafts,\n}) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'Semua\');\n  const [statusFilter, setStatusFilter] = useState<\'all\' | \'ai_draft\' | \'incomplete\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [collapsedFloors, setCollapsedFloors] = useState<Record<string, boolean>>({});\n  const [openActionMenuId, setOpenActionMenuId] = useState<string | null>(null);\n  const [workToDelete, setWorkToDelete] = useState<ProjectWorkItem | null>(null);\n\n  const categories: string[] = [\'Semua\', \'Persiapan Dll\', \'Struktural\', \'Arsitektural\', \'MEP\'];\n\n  const toggleFloorCollapse = (floorId: string) => {\n    setCollapsedFloors((prev) => ({\n      ...prev,\n      [floorId]: !prev[floorId],\n    }));\n  };\n\n  // Hitung statistik Draf AI aktif\n  const activeDraftWorks = works.filter(\n    (w) => w.isActive && w.origin === \'ai\' && w.aiVerificationStatus === \'draft\'\n  );\n  const readyDraftWorks = activeDraftWorks.filter((w) => w.calculatedVolume !== null);\n  const incompleteDraftWorks = activeDraftWorks.filter((w) => w.calculatedVolume === null);\n\n  // Filter works by category, status filter, and search text\n  const filteredWorks = works.filter((w) => {\n    const matchCategory = selectedCategory === \'Semua\' || w.category === selectedCategory;\n    const isAiDraft = w.origin === \'ai\' && w.aiVerificationStatus === \'draft\';\n    const isIncomplete =\n      w.status === \'Belum Lengkap\' || w.status === \'Perlu Input\' || w.calculatedVolume === null;\n\n    const matchStatus =\n      statusFilter === \'all\' ||\n      (statusFilter === \'ai_draft\' && isAiDraft) ||\n      (statusFilter === \'incomplete\' && isIncomplete);\n\n    const matchSearch =\n      searchQuery.trim() === \'\' ||\n      w.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (w.formulaDisplay && w.formulaDisplay.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (w.elementLocation && w.elementLocation.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (w.sourceDocument && w.sourceDocument.toLowerCase().includes(searchQuery.toLowerCase()));\n    return matchCategory && matchStatus && matchSearch;\n  });\n\n  // Group works by floor\n  const worksByFloor: Record<string, ProjectWorkItem[]> = {};\n  for (const floor of floors) {\n    worksByFloor[floor.id] = [];\n  }\n\n  for (const work of filteredWorks) {\n    if (!worksByFloor[work.floorId]) {\n      worksByFloor[work.floorId] = [];\n    }\n    worksByFloor[work.floorId].push(work);\n  }\n\n  // Helper status badge\n  const renderStatusBadge = (work: ProjectWorkItem) => {\n    const hasConflict = work.parameters.some((p) => Boolean(p.conflict));\n    if (hasConflict) {\n      return (\n        <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200\">\n          <AlertTriangle className=\"w-3 h-3 text-rose-600 shrink-0\" />\n          Konflik Ukuran\n        </span>\n      );\n    }\n\n    switch (work.status) {\n      case \'Lengkap\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200\">\n            <CheckCircle2 className=\"w-3 h-3 text-emerald-600 shrink-0\" />\n            Terverifikasi\n          </span>\n        );\n      case \'Draf AI \342\200\224 Perlu Verifikasi\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200\">\n            <Sparkles className=\"w-3 h-3 text-blue-600 shrink-0\" />\n            Draf AI\n          </span>\n        );\n      case \'Belum Lengkap\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-300\">\n            <AlertCircle className=\"w-3 h-3 text-amber-600 shrink-0\" />\n            Belum Lengkap\n          </span>\n        );\n      case \'Perlu Input\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200\">\n            <Clock className=\"w-3 h-3 text-amber-600 shrink-0\" />\n            Perlu Input\n          </span>\n        );\n      case \'Perlu Verifikasi\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200\">\n            <AlertCircle className=\"w-3 h-3 text-indigo-600 shrink-0\" />\n            Perlu Verifikasi\n          </span>\n        );\n      default:\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200\">\n            {work.status}\n          </span>\n        );\n    }\n  };\n\n  const getCategoryBadgeClass = (cat: WorkCategory) => {\n    switch (cat) {\n      case \'Persiapan Dll\':\n        return \'bg-blue-50 text-blue-700 border-blue-100\';\n      case \'Struktural\':\n        return \'bg-indigo-50 text-indigo-700 border-indigo-100\';\n      case \'Arsitektural\':\n        return \'bg-teal-50 text-teal-700 border-teal-100\';\n      case \'MEP\':\n        return \'bg-purple-50 text-purple-700 border-purple-100\';\n      default:\n        return \'bg-slate-50 text-slate-700 border-slate-100\';\n    }\n  };\n\n  const getFloorName = (floorId: string) => {\n    return floors.find((f) => f.id === floorId)?.name || floorId;\n  };\n\n  return (\n    <div className=\"bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden\">\n      {/* AI Draft Banner when unverified AI works exist */}\n      {activeDraftWorks.length > 0 && (\n        <div className=\"px-5 py-3.5 bg-gradient-to-r from-blue-50 via-indigo-50/70 to-blue-50 border-b border-blue-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex items-start gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-2xs\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <h4 className=\"text-xs font-bold text-blue-950\">\n                  {activeDraftWorks.length} Draf Pekerjaan Hasil Analisis AI Menunggu Verifikasi\n                </h4>\n                {readyDraftWorks.length > 0 && (\n                  <span className=\"px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-100 text-emerald-800\">\n                    {readyDraftWorks.length} Siap Disetujui\n                  </span>\n                )}\n                {incompleteDraftWorks.length > 0 && (\n                  <span className=\"px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800\">\n                    {incompleteDraftWorks.length} Perlu Parameter Tambahan\n                  </span>\n                )}\n              </div>\n              <p className=\"text-[11px] text-slate-600 mt-0.5\">\n                Volume draf dipisahkan dari rekap final sampai Anda memeriksa parameter atau menekan tombol{\' \'}\n                <strong>Setujui</strong>.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 shrink-0\">\n            {readyDraftWorks.length > 0 && onApproveAllReadyDrafts && (\n              <button\n                onClick={onApproveAllReadyDrafts}\n                className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition shadow-xs\"\n              >\n                <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                <span>Setujui Semua yang Lengkap ({readyDraftWorks.length})</span>\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Header Bar */}\n      <div className=\"p-5 border-b border-slate-100\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900\">Daftar Pekerjaan &amp; Volume</h3>\n            <p className=\"text-xs text-slate-500\">\n              Menampilkan {filteredWorks.length} pekerjaan pada zona &amp; elevasi lantai proyek.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2.5\">\n            {/* Search Input */}\n            <div className=\"relative\">\n              <Search className=\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                placeholder=\"Cari pekerjaan atau lokasi...\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                className=\"pl-8 pr-3 py-1.5 text-xs rounded-lg border border-slate-200 bg-slate-50/50 hover:bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 w-48 sm:w-56 transition\"\n              />\n            </div>\n\n            {/* Tambah Pekerjaan Button */}\n            <button\n              onClick={() => onOpenAddWork()}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition shadow-xs shrink-0\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              <span>Tambah Pekerjaan</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Filter Tabs (Category + Status Quick Filter) */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 mt-4\">\n          <div className=\"flex items-center gap-2 overflow-x-auto pb-1\">\n            {categories.map((cat) => {\n              const isSelected = selectedCategory === cat;\n              return (\n                <button\n                  key={cat}\n                  onClick={() => setSelectedCategory(cat)}\n                  className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all shrink-0 ${\n                    isSelected\n                      ? \'bg-blue-600 text-white shadow-2xs\'\n                      : \'bg-slate-100/80 text-slate-600 hover:bg-slate-200/70 hover:text-slate-900\'\n                  }`}\n                >\n                  {cat}\n                </button>\n              );\n            })}\n          </div>\n\n          <div className=\"flex items-center gap-1.5 text-xs\">\n            <button\n              onClick={() => setStatusFilter(\'all\')}\n              className={`px-2.5 py-1 rounded-md font-medium transition ${\n                statusFilter === \'all\'\n                  ? \'bg-slate-800 text-white\'\n                  : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n              }`}\n            >\n              Semua Status\n            </button>\n            {activeDraftWorks.length > 0 && (\n              <button\n                onClick={() =>\n                  setStatusFilter(statusFilter === \'ai_draft\' ? \'all\' : \'ai_draft\')\n                }\n                className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold transition ${\n                  statusFilter === \'ai_draft\'\n                    ? \'bg-blue-600 text-white\'\n                    : \'bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100\'\n                }`}\n              >\n                <Sparkles className=\"w-3 h-3\" />\n                Draf AI ({activeDraftWorks.length})\n              </button>\n            )}\n            <button\n              onClick={() =>\n                setStatusFilter(statusFilter === \'incomplete\' ? \'all\' : \'incomplete\')\n              }\n              className={`px-2.5 py-1 rounded-md font-medium transition ${\n                statusFilter === \'incomplete\'\n                  ? \'bg-amber-600 text-white\'\n                  : \'bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100\'\n              }`}\n            >\n              Perlu Input / Belum Lengkap\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Grouped Table View with horizontal scroll protection */}\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full min-w-[780px] text-left text-xs border-collapse\">\n          <thead>\n            <tr className=\"bg-slate-50/80 text-slate-600 font-semibold border-b border-slate-200/80 select-none\">\n              <th className=\"py-3 px-4 w-12 text-center\">No</th>\n              <th className=\"py-3 px-4 min-w-[220px]\">Pekerjaan</th>\n              <th className=\"py-3 px-3 w-28\">Kategori</th>\n              <th className=\"py-3 px-4 min-w-[180px]\">Parameter / Rumus</th>\n              <th className=\"py-3 px-3 w-16 text-center\">Satuan</th>\n              <th className=\"py-3 px-4 w-28 text-right\">Volume</th>\n              <th className=\"py-3 px-4 w-36 text-center\">Status</th>\n              <th className=\"py-3 px-4 w-36 text-right\">Aksi</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {floors.map((floor) => {\n              const floorWorks = worksByFloor[floor.id] || [];\n              const isCollapsed = collapsedFloors[floor.id] ?? false;\n\n              if (\n                floorWorks.length === 0 &&\n                (selectedCategory !== \'Semua\' || statusFilter !== \'all\' || searchQuery.trim() !== \'\')\n              ) {\n                return null;\n              }\n\n              return (\n                <React.Fragment key={floor.id}>\n                  {/* Floor Group Header Accordion */}\n                  <tr\n                    onClick={() => toggleFloorCollapse(floor.id)}\n                    className=\"bg-slate-100/60 hover:bg-slate-100 cursor-pointer transition select-none\"\n                  >\n                    <td colSpan={8} className=\"py-2.5 px-4 font-bold text-slate-800\">\n                      <div className=\"flex items-center justify-between\">\n                        <div className=\"flex items-center gap-2\">\n                          {isCollapsed ? (\n                            <ChevronRight className=\"w-4 h-4 text-slate-500\" />\n                          ) : (\n                            <ChevronDown className=\"w-4 h-4 text-slate-500\" />\n                          )}\n                          <Layers className=\"w-3.5 h-3.5 text-blue-600\" />\n                          <span>{floor.name}</span>\n                          {floor.elevation && (\n                            <span className=\"text-[11px] text-slate-500 font-normal ml-1\">\n                              ({floor.elevation})\n                            </span>\n                          )}\n                        </div>\n                        <span className=\"text-[11px] font-medium text-slate-500 bg-white border border-slate-200 rounded-md px-2 py-0.5 shadow-2xs\">\n                          {floorWorks.length} pekerjaan\n                        </span>\n                      </div>\n                    </td>\n                  </tr>\n\n                  {/* Floor Work Rows */}\n                  {!isCollapsed &&\n                    floorWorks.map((work, idx) => {\n                      const isAiDraft =\n                        work.origin === \'ai\' && work.aiVerificationStatus === \'draft\';\n                      const hasConflict = work.parameters.some((p) => Boolean(p.conflict));\n\n                      return (\n                        <tr\n                          key={work.id}\n                          className={`hover:bg-blue-50/30 transition-colors group ${\n                            !work.isActive\n                              ? \'opacity-50 bg-slate-50/50\'\n                              : isAiDraft\n                              ? \'bg-blue-50/15\'\n                              : \'\'\n                          }`}\n                        >\n                          {/* No */}\n                          <td className=\"py-3 px-4 text-center text-slate-400 font-medium font-mono\">\n                            {idx + 1}\n                          </td>\n\n                          {/* Pekerjaan */}\n                          <td className=\"py-3 px-4\">\n                            <div className=\"flex items-start gap-2\">\n                              <div className=\"min-w-0 flex-1\">\n                                <button\n                                  onClick={() => onOpenWorkDetail(work)}\n                                  className=\"text-left font-semibold text-slate-900 hover:text-blue-600 block transition focus:outline-none\"\n                                >\n                                  {work.name}\n                                </button>\n\n                                {/* Sub-info: AI Source, Location, or Missing Parameter Hint */}\n                                <div className=\"flex flex-wrap items-center gap-1.5 mt-1\">\n                                  {work.origin === \'ai\' && (\n                                    <span className=\"inline-flex items-center gap-1 text-[10px] font-medium text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100\">\n                                      <FileText className=\"w-2.5 h-2.5\" />\n                                      {work.sourceDocument || \'Gambar AI\'}\n                                    </span>\n                                  )}\n                                  {work.elementLocation && (\n                                    <span className=\"text-[10px] text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded\">\n                                      Lokasi: {work.elementLocation}\n                                    </span>\n                                  )}\n                                </div>\n\n                                {(work.status === \'Belum Lengkap\' ||\n                                  work.status === \'Perlu Input\' ||\n                                  hasConflict) &&\n                                  work.statusMessage && (\n                                    <p\n                                      className={`text-[10px] mt-1 leading-snug ${\n                                        hasConflict ? \'text-rose-600 font-medium\' : \'text-amber-700\'\n                                      }`}\n                                    >\n                                      {work.statusMessage}\n                                    </p>\n                                  )}\n                              </div>\n                            </div>\n                          </td>\n\n                          {/* Kategori */}\n                          <td className=\"py-3 px-3\">\n                            <span\n                              className={`inline-block px-2 py-0.5 text-[10px] font-semibold rounded-md border ${getCategoryBadgeClass(\n                                work.category\n                              )}`}\n                            >\n                              {work.category}\n                            </span>\n                          </td>\n\n                          {/* Parameter / Rumus */}\n                          <td className=\"py-3 px-4\">\n                            <button\n                              onClick={() => onOpenWorkDetail(work)}\n                              className=\"text-left text-slate-600 hover:text-blue-600 font-mono text-[11px] block truncate max-w-xs transition\"\n                              title={work.formulaDisplay}\n                            >\n                              {work.formulaDisplay || \'-\'}\n                            </button>\n                            <div className=\"text-[10px] text-slate-400 mt-0.5 truncate max-w-xs\">\n                              {work.parameters\n                                .map(\n                                  (p) =>\n                                    `${p.label || p.name}: ${\n                                      p.value !== null && p.value !== \'\'\n                                        ? `${p.value} ${p.unit}`\n                                        : \'kosong\'\n                                    }`\n                                )\n                                .join(\' \302\267 \')}\n                            </div>\n                          </td>\n\n                          {/* Satuan */}\n                          <td className=\"py-3 px-3 text-center font-medium text-slate-600\">\n                            {work.unit}\n                          </td>\n\n                          {/* Volume */}\n                          <td className=\"py-3 px-4 text-right font-bold text-slate-900 font-mono text-sm tabular-nums\">\n                            {work.calculatedVolume !== null ? (\n                              <div>\n                                <span>{formatIndonesianNumber(work.calculatedVolume)}</span>\n                                {isAiDraft && (\n                                  <span className=\"block text-[9px] font-sans font-semibold text-blue-600\">\n                                    Volume Draf\n                                  </span>\n                                )}\n                              </div>\n                            ) : (\n                              \'-\'\n                            )}\n                          </td>\n\n                          {/* Status */}\n                          <td className=\"py-3 px-4 text-center\">{renderStatusBadge(work)}</td>\n\n                          {/* Aksi (Direct Edit, Approve, Delete + More Menu) */}\n                          <td className=\"py-3 px-4 text-right relative\">\n                            <div className=\"inline-flex items-center justify-end gap-1\">\n                              {isAiDraft &&\n                                work.calculatedVolume !== null &&\n                                !hasConflict &&\n                                onApproveDraftWork && (\n                                  <button\n                                    onClick={() => onApproveDraftWork(work.id)}\n                                    title=\"Setujui Draf Pekerjaan AI\"\n                                    className=\"inline-flex items-center gap-1 px-2 py-1 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-semibold transition shadow-2xs\"\n                                  >\n                                    <Check className=\"w-3 h-3\" />\n                                    <span>Setujui</span>\n                                  </button>\n                                )}\n\n                              <button\n                                onClick={() => onOpenWorkDetail(work)}\n                                title=\"Edit Parameter & Rumus Pekerjaan\"\n                                className=\"inline-flex items-center gap-1 px-2 py-1 rounded-md border border-slate-200 bg-white hover:bg-blue-50 hover:border-blue-200 text-slate-700 hover:text-blue-700 text-[11px] font-medium transition\"\n                              >\n                                <Pencil className=\"w-3 h-3\" />\n                                <span>Edit</span>\n                              </button>\n\n                              <button\n                                onClick={() => setWorkToDelete(work)}\n                                title=\"Hapus Pekerjaan dari Kalkulator\"\n                                className=\"p-1.5 rounded-md border border-slate-200 bg-white hover:bg-rose-50 hover:border-rose-200 text-slate-400 hover:text-rose-600 transition\"\n                              >\n                                <Trash2 className=\"w-3.5 h-3.5\" />\n                              </button>\n\n                              <div className=\"relative inline-block text-left\">\n                                <button\n                                  onClick={(e) => {\n                                    e.stopPropagation();\n                                    setOpenActionMenuId(\n                                      openActionMenuId === work.id ? null : work.id\n                                    );\n                                  }}\n                                  className=\"p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-700 transition\"\n                                  title=\"Menu Lainnya\"\n                                >\n                                  <MoreVertical className=\"w-4 h-4\" />\n                                </button>\n\n                                {openActionMenuId === work.id && (\n                                  <div\n                                    onClick={(e) => e.stopPropagation()}\n                                    className=\"absolute right-0 top-full mt-1 w-44 bg-white border border-slate-200 rounded-xl shadow-lg z-30 py-1 text-xs\"\n                                  >\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        onDuplicateWork(work);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600 flex items-center gap-2 transition\"\n                                    >\n                                      <Copy className=\"w-3.5 h-3.5 text-slate-400\" />\n                                      <span>Duplikasi Pekerjaan</span>\n                                    </button>\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        onToggleActive(work.id);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition\"\n                                    >\n                                      <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n                                      <span>{work.isActive ? \'Nonaktifkan\' : \'Aktifkan\'}</span>\n                                    </button>\n                                    <div className=\"h-px bg-slate-100 my-1\" />\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        setWorkToDelete(work);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition\"\n                                    >\n                                      <Trash2 className=\"w-3.5 h-3.5\" />\n                                      <span>Hapus Pekerjaan</span>\n                                    </button>\n                                  </div>\n                                )}\n                              </div>\n                            </div>\n                          </td>\n                        </tr>\n                      );\n                    })}\n                </React.Fragment>\n              );\n            })}\n          </tbody>\n        </table>\n\n        {filteredWorks.length === 0 && (\n          <div className=\"p-10 text-center text-slate-500 text-xs\">\n            Tidak ada pekerjaan yang cocok dengan filter atau kata kunci pencarian.\n          </div>\n        )}\n      </div>\n\n      {/* Confirmation Modal for Deleting Work Item from Calculator */}\n      {workToDelete && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs\">\n          <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n            <div className=\"px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-rose-50/60\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center\">\n                  <Trash2 className=\"w-4 h-4\" />\n                </div>\n                <h4 className=\"text-sm font-bold text-slate-900\">Hapus Pekerjaan dari Kalkulator?</h4>\n              </div>\n              <button\n                onClick={() => setWorkToDelete(null)}\n                className=\"p-1 rounded-lg text-slate-400 hover:text-slate-700\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"p-5 space-y-3 text-xs text-slate-600\">\n              <p className=\"leading-relaxed\">\n                Anda akan menghapus pekerjaan{\' \'}\n                <strong className=\"text-slate-900\">\"{workToDelete.name}\"</strong> pada{\' \'}\n                <strong className=\"text-slate-900\">{getFloorName(workToDelete.floorId)}</strong>.\n              </p>\n              <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl text-[11px] text-slate-600 space-y-1\">\n                <p>\342\200\242 Pekerjaan ini akan dihapus dari proyek aktif dan rekap volume akan diperbarui.</p>\n                <p>\342\200\242 Template pekerjaan pada Katalog tetap aman dan tidak ikut terhapus.</p>\n                {workToDelete.origin === \'ai\' && (\n                  <p>\342\200\242 Karena ini draf hasil AI, sistem mencatat penolakan agar tidak dibuat ulang secara otomatis saat menganalisis dokumen yang sama.</p>\n                )}\n              </div>\n            </div>\n\n            <div className=\"px-5 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2.5\">\n              <button\n                onClick={() => setWorkToDelete(null)}\n                className=\"px-4 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-200/60 transition\"\n              >\n                Batal\n              </button>\n              <button\n                onClick={() => {\n                  const id = workToDelete.id;\n                  setWorkToDelete(null);\n                  onDeleteWork(id);\n                }}\n                className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 transition shadow-xs\"\n              >\n                <Trash2 className=\"w-3.5 h-3.5\" />\n                <span>Ya, Hapus Pekerjaan</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
          start_line: 1
          end_line: 394
        }
      }
    }
