        instruction: "Update DEFAULT_*_CATALOG_IDS, createProjectWorkFromCatalog, and createDefaultWorksForFloor in src/services/projectStorage.ts to use the full USC_STANDARD_TEMPLATE with null values and Belum Diisi status"
