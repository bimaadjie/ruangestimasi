    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst { GoogleGenAI } = require(\"@google/genai\");\nrequire(\"dotenv\").config();\n\nasync function test() {\n  const ai = new GoogleGenAI({\n    apiKey: process.env.GEMINI_API_KEY,\n    httpOptions: { headers: { \"User-Agent\": \"aistudio-build\" } }\n  });\n  console.log(\"Testing gemini-3.8-flash with rencana_1-Model_2ceb7bed.pdf...\");\n  const pdfBytes = fs.readFileSync(\"public/assets/aistudio/rencana_1-Model_2ceb7bed.pdf\");\n  const base64 = pdfBytes.toString(\"base64\");\n  try {\n    const res = await ai.models.generateContent({\n      model: \"gemini-3.8-flash\",\n      contents: {\n        parts: [\n          { inlineData: { mimeType: \"application/pdf\", data: base64 } },\n          { text: \"Identifikasi judul denah, skala, dimensi horizontal dan vertikal, dan nama ruang pada gambar ini.\" }\n        ]\n      }\n    });\n    console.log(\"Success! Response text length:\", res.text.length);\n    console.log(\"Snippet:\", res.text.slice(0, 300));\n  } catch (err) {\n    console.error(\"Error with gemini-3.8-flash:\", err.message, \"status:\", err.status);\n    console.log(\"Now testing gemini-3.1-flash-lite...\");\n    try {\n      const res2 = await ai.models.generateContent({\n        model: \"gemini-3.1-flash-lite\",\n        contents: {\n          parts: [\n            { inlineData: { mimeType: \"application/pdf\", data: base64 } },\n            { text: \"Identifikasi judul denah, skala, dimensi horizontal dan vertikal, dan nama ruang pada gambar ini.\" }\n          ]\n        }\n      });\n      console.log(\"Success with gemini-3.1-flash-lite! Response snippet:\", res2.text.slice(0, 300));\n    } catch (err2) {\n      console.error(\"Error with gemini-3.1-flash-lite:\", err2.message, \"status:\", err2.status);\n    }\n  }\n}\ntest();\n\'"
