              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      { id: \'luas_dinding_bersih\', name: \'luas_dinding_bersih\', label: \'Luas Dinding Bata Bersih\', value: null, unit: \'m\302\262\', required: true, excelCellRef: \'U31\' },"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      { id: \'luas_keramik_toilet\', name: \'luas_keramik_toilet\', label: \'Pengurangan Keramik Toilet\', value: 0, unit: \'m\302\262\', required: false, excelCellRef: \'U35\' },"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      { id: \'luas_panel_ornamen\', name: \'luas_panel_ornamen\', label: \'Pengurangan Panel Kayu/Batu\', value: 0, unit: \'m\302\262\', required: false, excelCellRef: \'U37\' },"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    name: \'Plesteran & Acian Dinding\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Arsitektural\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subCategory: \'Pekerjaan Pasangan Dinding dan Plesteran\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    floorRule: \'per_lantai\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    description: \'Plesteran dan acian dua sisi permukaan dinding bata.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    defaultUnit: \'m\302\262\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    formulaDisplay: \'(Luas Bersih Dinding \303\227 2 Sisi) \342\210\222 Luas Keramik Dinding \342\210\222 Luas Panel\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excelSheet: \'Volume Arsitektural\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excelCell: \'U33\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'luas_dinding_bersih\', name: \'luas_dinding_bersih\', label: \'Luas Dinding Bata Bersih\', placeholder: \'Masukkan luas bersih dinding (m\302\262)\', value: null, unit: \'m\302\262\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'luas_keramik_toilet\', name: \'luas_keramik_toilet\', label: \'Pengurangan Area Keramik Dinding\', placeholder: \'Masukkan luas keramik dinding (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'luas_panel_ornamen\', name: \'luas_panel_ornamen\', label: \'Pengurangan Area Panel / Ornamen\', placeholder: \'Masukkan luas panel (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const a = params[\'luas_dinding_bersih\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const kt = params[\'luas_keramik_toilet\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const po = params[\'luas_panel_ornamen\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (a == null || isNaN(a)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return Math.max(0, a * 2 - kt - po);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
