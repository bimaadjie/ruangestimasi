  view_file {
    absolute_path_uri: "file:///server.ts"
    end_line: 79
    content: "/**\n * RuangRAB - Server Backend\n * Express API server with Vite middleware integration, server-side Gemini API,\n * multi-type engineering drawing reader, segment-based beam/sloof extractor,\n * and secure user authentication endpoints.\n */\n\nimport express, { Request, Response, NextFunction } from \'express\';\nimport { createServer as createViteServer } from \'vite\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport path from \'path\';\nimport fs from \'fs\';\nimport crypto from \'crypto\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst app = express();\nconst PORT = process.env.PORT ? parseInt(process.env.PORT, 10) : 3000;\nconst isProd = process.env.NODE_ENV === \'production\';\n\n// Support civil engineering high-resolution drawing PDFs & CAD image uploads (up to 50MB)\napp.use(express.json({ limit: \'50mb\' }));\napp.use(express.urlencoded({ extended: true, limit: \'50mb\' }));\n\n// Middleware to catch JSON parsing and payload size errors before they return HTML\napp.use((err: any, req: Request, res: Response, next: NextFunction): void => {\n  if (err) {\n    console.error(\'[RuangRAB Server Middleware Error]:\', err);\n    res.setHeader(\'Content-Type\', \'application/json\');\n    if (err.type === \'entity.too.large\') {\n      res.status(413).json({\n        success: false,\n        error: \'Ukuran file dokumen terlalu besar. Harap unggah file di bawah 15 MB.\',\n      });\n      return;\n    }\n    res.status(err.status || 400).json({\n      success: false,\n      error: err.message || \'Format data permintaan tidak valid.\',\n    });\n    return;\n  }\n  next();\n});\n\n// =========================================================\n// PENYIMPANAN AKUN PENGGUNA SERVER (DENGAN SCRYPT HASHING)\n// =========================================================\ninterface ServerUserRecord {\n  uid: string;\n  fullName: string;\n  email: string;\n  userType: \'Student\' | \'Estimator\' | \'Other\';\n  salt: string;\n  passwordHash: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\nconst DATA_DIR = path.resolve(process.cwd(), \'data\');\nconst USERS_FILE = path.join(DATA_DIR, \'users_store.json\');\n\nfunction loadServerUsers(): ServerUserRecord[] {\n  try {\n    if (!fs.existsSync(USERS_FILE)) return [];\n    const raw = fs.readFileSync(USERS_FILE, \'utf-8\');\n    const parsed = JSON.parse(raw);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    return [];\n  }\n}\n\nfunction saveServerUsers(users: ServerUserRecord[]): void {\n  try {\n    if (!fs.existsSync(DATA_DIR)) {\n      fs.mkdirSync(DATA_DIR, { recursive: true });\n    }\n    fs.writeFileSync(USERS_FILE, JSON.stringify(users, null, 2), \'utf-8\');"
    num_lines: 600
    num_bytes: 22448
    line_range_bytes: 2578
  }
}
