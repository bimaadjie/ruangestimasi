            }
            lines {
              text: "    excelFormula: \'=(I87/0.15)*((K87+M87)*2)*T87\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    verificationStatus: \'Belum Diisi\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
