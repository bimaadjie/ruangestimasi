            }
            lines {
              text: " * Katalog Pekerjaan Konstruksi Standar RuangEstimasi (Sumber Referensi: RAB Gedung USC)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * ATURAN UTAMA TEMPLATE STANDAR GLOBAL:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * 1. Menggunakan struktur lengkap katalog pekerjaan Gedung USC:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *    - Kelompok Umum & Pondasi (Persiapan, Tanah & Urugan, Pondasi Batu Kali Type A & B,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *      Pondasi Footplat Type A & B, Bore Pile, Lantai Kerja, Kolom Pedestal K1 & K2,"
