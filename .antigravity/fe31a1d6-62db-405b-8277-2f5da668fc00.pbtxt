    end_line: 945
    content: "import React, { useState, useRef } from \'react\';\nimport {\n  X,\n  Upload,\n  Sparkles,\n  Check,\n  AlertCircle,\n  Loader2,\n  ArrowRight,\n  RotateCcw,\n  CheckCircle2,\n  Ruler,\n  Layers,\n  Plus,\n  Pencil,\n  AlertTriangle,\n  FileCheck2,\n} from \'lucide-react\';\nimport {\n  AIAutoTakeoffSummary,\n  AIExtractionItem,\n  DrawingScale,\n  DrawingUnit,\n  FloorItem,\n  ProjectWorkItem,\n} from \'../types\';\nimport { formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface AIAssistantModalProps {\n  isOpen: boolean;\n  floors: FloorItem[];\n  currentFloorId: string;\n  onClose: () => void;\n  onAutoTakeoff: (\n    items: AIExtractionItem[],\n    targetFloorId: string,\n    sourceDocument: string,\n    meta?: {\n      documentSummary?: string;\n      drawingType?: \'arsitektur_denah\' | \'struktur_denah\' | \'potongan_detail\' | \'lainnya\';\n      identifiedFloor?: string;\n      identifiedScale?: string;\n      forceIncludeRejected?: boolean;\n    }\n  ) => {\n    summary: AIAutoTakeoffSummary;\n    affectedWorks: ProjectWorkItem[];\n  };\n  onAddRecommendationWork: (catalogId: string, floorId: string, reason: string) => void;\n  onApproveDraftWork: (workId: string) => void;\n  onApproveAllReadyDrafts: () => void;\n  onOpenWorkDetail: (work: ProjectWorkItem) => void;\n  existingWorks: ProjectWorkItem[];\n}\n\nexport const AIAssistantModal: React.FC<AIAssistantModalProps> = ({\n  isOpen,\n  floors,\n  currentFloorId,\n  onClose,\n  onAutoTakeoff,\n  onAddRecommendationWork,\n  onApproveDraftWork,\n  onApproveAllReadyDrafts,\n  onOpenWorkDetail,\n  existingWorks,\n}) => {\n  if (!isOpen) return null;\n\n  // Tahap 1: Pengaturan dokumen sebelum analisis\n  const [selectedUnit, setSelectedUnit] = useState<DrawingUnit>(\'cm\');\n  const [selectedScale, setSelectedScale] = useState<DrawingScale>(\'1:100\');\n  const [customScaleDenom, setCustomScaleDenom] = useState<number>(125);\n  const [selectedFloorId, setSelectedFloorId] = useState<string>(\n    currentFloorId || floors.find((f) => f.id === \'fl-1\')?.id || floors[0]?.id || \'fl-1\'\n  );\n\n  // File upload state\n  const [selectedFile, setSelectedFile] = useState<File | null>(null);\n  const [fileError, setFileError] = useState<string | null>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  // Analysis process state\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [analysisError, setAnalysisError] = useState<string | null>(null);\n  const [isServerBusy, setIsServerBusy] = useState<boolean>(false);\n  const [modelUsedInfo, setModelUsedInfo] = useState<string | null>(null);\n\n  // Results state\n  const [takeoffSummary, setTakeoffSummary] = useState<AIAutoTakeoffSummary | null>(null);\n  const [extractions, setExtractions] = useState<AIExtractionItem[]>([]);\n  const [selectedItemIds, setSelectedItemIds] = useState<Record<string, boolean>>({});\n  const [resultTab, setResultTab] = useState<\'drafts\' | \'dimensions\' | \'recommendations\'>(\'drafts\');\n  const [addedRecIds, setAddedRecIds] = useState<Record<string, boolean>>({});\n\n  // Helper konversi dimensi matematika murni (tanpa perkalian skala)\n  const computeConvertedValue = (\n    rawVal: number,\n    unit: DrawingUnit,\n    detectedUnit?: string\n  ): { value: number; convertedUnit: string } => {\n    if (rawVal == null || isNaN(rawVal)) return { value: 0, convertedUnit: \'m\' };\n    const cleanDetected = (detectedUnit || \'\').toLowerCase().trim();\n    if (cleanDetected === \'m\302\262\' || cleanDetected === \'m2\') {\n      return { value: Number(rawVal.toFixed(4)), convertedUnit: \'m\302\262\' };\n    }\n    if (cleanDetected === \'unit\' || cleanDetected === \'titik\' || cleanDetected === \'buah\') {\n      return { value: Number(rawVal), convertedUnit: cleanDetected };\n    }\n    if (unit === \'mm\') return { value: Number((rawVal / 1000).toFixed(4)), convertedUnit: \'m\' };\n    if (unit === \'cm\') return { value: Number((rawVal / 100).toFixed(4)), convertedUnit: \'m\' };\n    return { value: Number(rawVal.toFixed(4)), convertedUnit: \'m\' };\n  };\n\n  // Otomatis update nilai konversi & draf kalkulator jika pengguna mengganti satuan tanpa memanggil Gemini lagi\n  const handleUnitSettingChange = (newUnit: DrawingUnit) => {\n    setSelectedUnit(newUnit);\n    if (extractions.length > 0 && selectedFile) {\n      const updatedItems = extractions.map((item) => {\n        const { value, convertedUnit } = computeConvertedValue(\n          item.rawExtractedValue,\n          newUnit,\n          item.explicitUnitOnDrawing\n        );\n        return {\n          ...item,\n          rawUnit: newUnit,\n          convertedValue: item.userCorrection !== undefined ? item.userCorrection : value,\n          convertedUnit,\n        };\n      });\n      setExtractions(updatedItems);\n\n      const res = onAutoTakeoff(updatedItems, selectedFloorId, selectedFile.name, {\n        documentSummary: takeoffSummary?.documentSummary,\n        drawingType: takeoffSummary?.drawingType,\n        identifiedFloor: takeoffSummary?.identifiedFloor,\n        identifiedScale: takeoffSummary?.identifiedScale,\n      });\n      setTakeoffSummary(res.summary);\n    }\n  };\n\n  const handleFileSelect = (file: File) => {\n    setFileError(null);\n    setAnalysisError(null);\n    setIsServerBusy(false);\n\n    const validTypes = [\'application/pdf\', \'image/png\', \'image/jpeg\', \'image/jpg\', \'image/webp\'];\n    if (!validTypes.includes(file.type) && !file.name.match(/\\.(pdf|png|jpe?g|webp)$/i)) {\n      setFileError(\'Format file tidak didukung. Harap unggah file PDF, JPG, atau PNG.\');\n      return;\n    }\n\n    if (file.size > 15 * 1024 * 1024) {\n      setFileError(\'Ukuran file melebihi batas maksimal 15 MB.\');\n      return;\n    }\n\n    setSelectedFile(file);\n  };\n\n  const runAnalysisWithBase64 = async (base64Data: string, mimeType: string, fileName: string) => {\n    if (isLoading) return;\n    setIsLoading(true);\n    setAnalysisError(null);\n    setIsServerBusy(false);\n\n    try {\n      const targetFloorObj = floors.find((f) => f.id === selectedFloorId);\n      const scaleText =\n        selectedScale === \'custom\'\n          ? `1:${customScaleDenom}`\n          : selectedScale === \'unknown\'\n          ? \'Tidak Diketahui\'\n          : selectedScale;\n\n      const response = await fetch(\'/api/gemini/extract-dimensions\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          fileBase64: base64Data,\n          mimeType,\n          fileName,\n          floorName: targetFloorObj ? targetFloorObj.name : \'Lantai 1\',\n          unitSetting: selectedUnit,\n          scaleSetting: scaleText,\n        }),\n      });\n\n      const contentType = response.headers.get(\'content-type\') || \'\';\n      let resJson: any = null;\n\n      if (contentType.includes(\'application/json\')) {\n        try {\n          resJson = await response.json();\n        } catch (jsonErr) {\n          console.error(\'[RuangRAB] Gagal parsing JSON respons:\', jsonErr);\n        }\n      } else {\n        const rawText = await response.text();\n        console.error(\n          \'[RuangRAB] Server mengembalikan respons bukan JSON (status \' +\n            response.status +\n            \'):\',\n          rawText.slice(0, 300)\n        );\n      }\n\n      if (!response.ok || !resJson || !resJson.success) {\n        if (response.status === 503 || resJson?.isBusy) {\n          setIsServerBusy(true);\n          setAnalysisError(\n            \'Server AI sedang sibuk (503). Dokumen belum berhasil dianalisis. Silakan coba kembali beberapa saat lagi.\'\n          );\n        } else if (response.status === 413) {\n          setAnalysisError(\n            \'Ukuran file dokumen terlalu besar. Harap unggah file yang lebih ringkas (di bawah 15 MB).\'\n          );\n        } else if (resJson?.error) {\n          setAnalysisError(resJson.error);\n        } else {\n          setAnalysisError(\n            `Koneksi server gagal (Kode status: ${response.status}). Periksa koneksi atau coba beberapa saat lagi.`\n          );\n        }\n        return;\n      }\n\n      const rawData = resJson.data;\n      setModelUsedInfo(resJson.modelUsed || \'gemini-3.8-flash\');\n\n      if (Array.isArray(rawData.items) && rawData.items.length > 0) {\n        const initialSelected: Record<string, boolean> = {};\n        const parsedItems: AIExtractionItem[] = rawData.items.map((item: any, idx: number) => {\n          const id = `ai-item-${Date.now()}-${idx}`;\n          const rawVal = Number(item.rawExtractedValue) || 0;\n          const explicitUnit = item.detectedUnit;\n          const { value: converted, convertedUnit } = computeConvertedValue(\n            rawVal,\n            selectedUnit,\n            explicitUnit\n          );\n          initialSelected[id] = true;\n\n          return {\n            id,\n            targetCategory: item.targetCategory || \'Arsitektural\',\n            suggestedWorkName: item.suggestedWorkName || \'Pekerjaan Terdeteksi\',\n            catalogId: item.catalogId,\n            parameterId: item.parameterId,\n            parameterName: item.parameterName || \'Dimensi\',\n            rawExtractedValue: rawVal,\n            rawUnit: selectedUnit,\n            explicitUnitOnDrawing: explicitUnit,\n            convertedValue: converted,\n            convertedUnit,\n            confidence: item.confidence ?? 0.95,\n            sourceDocument: fileName,\n            pageOrLocation: item.pageOrLocation || \'Denah\',\n            notes: item.notes || \'Angka dimensi tertulis pada gambar.\',\n            status: \'approved\',\n          };\n        });\n\n        setExtractions(parsedItems);\n        setSelectedItemIds(initialSelected);\n\n        // Tahap 3 & 4: Langsung jalankan Auto Quantity Takeoff ke Kalkulator sebagai Draf AI!\n        const takeoffResult = onAutoTakeoff(parsedItems, selectedFloorId, fileName, {\n          documentSummary: rawData.documentSummary || `Analisis ${fileName}`,\n          drawingType: rawData.drawingType || \'arsitektur_denah\',\n          identifiedFloor: rawData.identifiedFloor || targetFloorObj?.name || \'Lantai 1\',\n          identifiedScale: rawData.identifiedScale || scaleText,\n        });\n\n        setTakeoffSummary(takeoffResult.summary);\n        setResultTab(\'drafts\');\n      } else {\n        setExtractions([]);\n        setAnalysisError(\'Tidak ditemukan angka dimensi tertulis yang jelas pada gambar ini.\');\n      }\n    } catch (err: unknown) {\n      const msg = err instanceof Error ? err.message : String(err);\n      setAnalysisError(msg);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleAnalyze = async () => {\n    if (!selectedFile) {\n      setFileError(\'Silakan pilih file gambar denah atau PDF terlebih dahulu.\');\n      return;\n    }\n\n    const reader = new FileReader();\n    reader.readAsDataURL(selectedFile);\n    reader.onload = async () => {\n      const base64Data = reader.result as string;\n      await runAnalysisWithBase64(\n        base64Data,\n        selectedFile.type || \'application/pdf\',\n        selectedFile.name\n      );\n    };\n  };\n\n  const handleLoadSampleFloorPlan = async () => {\n    if (isLoading) return;\n    setFileError(null);\n    setAnalysisError(null);\n    try {\n      setIsLoading(true);\n      const res = await fetch(\'/assets/aistudio/rencana_1-Model_2ceb7bed.pdf\');\n      if (!res.ok) throw new Error(\'File contoh denah tidak ditemukan.\');\n      const blob = await res.blob();\n      const sampleFile = new File([blob], \'rencana 1-Model.pdf\', { type: \'application/pdf\' });\n      setSelectedFile(sampleFile);\n\n      const reader = new FileReader();\n      reader.readAsDataURL(sampleFile);\n      reader.onload = async () => {\n        setIsLoading(false);\n        const base64Data = reader.result as string;\n        await runAnalysisWithBase64(base64Data, \'application/pdf\', \'rencana 1-Model.pdf\');\n      };\n    } catch (err: unknown) {\n      setIsLoading(false);\n      setFileError(err instanceof Error ? err.message : \'Gagal memuat contoh PDF.\');\n    }\n  };\n\n  const handleEditConvertedValue = (id: string, newConvertedVal: string) => {\n    const val = Number(newConvertedVal);\n    const updated = extractions.map((item) =>\n      item.id === id\n        ? {\n            ...item,\n            convertedValue: isNaN(val) ? item.convertedValue : val,\n            userCorrection: isNaN(val) ? undefined : val,\n            status: \'approved\' as const,\n          }\n        : item\n    );\n    setExtractions(updated);\n\n    if (selectedFile) {\n      const res = onAutoTakeoff(\n        updated.filter((i) => selectedItemIds[i.id] && i.status !== \'rejected\'),\n        selectedFloorId,\n        selectedFile.name,\n        {\n          documentSummary: takeoffSummary?.documentSummary,\n          drawingType: takeoffSummary?.drawingType,\n          identifiedFloor: takeoffSummary?.identifiedFloor,\n          identifiedScale: takeoffSummary?.identifiedScale,\n        }\n      );\n      setTakeoffSummary(res.summary);\n    }\n  };\n\n  const handleStatusChange = (id: string, status: \'approved\' | \'rejected\') => {\n    const updated = extractions.map((item) => (item.id === id ? { ...item, status } : item));\n    setExtractions(updated);\n  };\n\n  // Daftar pekerjaan AI pada lantai tujuan saat ini\n  const currentFloorAiWorks = existingWorks.filter(\n    (w) => w.isActive && w.floorId === selectedFloorId && w.origin === \'ai\'\n  );\n  const currentFloorName =\n    floors.find((f) => f.id === selectedFloorId)?.name || selectedFloorId;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-5 bg-slate-900/50 backdrop-blur-xs\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-4xl max-h-[92vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-blue-50/70 to-white shrink-0\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold shadow-xs\">\n              <Sparkles className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-sm font-bold text-slate-900\">\n                  Auto Quantity Takeoff \342\200\224 Asisten AI Pembaca Gambar Teknik\n                </h3>\n                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-700\">\n                  Integrasi Langsung Kalkulator\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500\">\n                Mengekstrak dimensi gambar teknik dan otomatis menyusun draf pekerjaan beserta parameter volume di kalkulator.\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Scrollable Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-5 text-xs flex-1\">\n          {/* TAHAP 1: PENGATURAN DOKUMEN */}\n          <div className=\"p-4 bg-slate-50/80 rounded-2xl border border-slate-200 space-y-4\">\n            <div className=\"flex items-center justify-between pb-2 border-b border-slate-200/80\">\n              <div className=\"flex items-center gap-2\">\n                <Ruler className=\"w-4 h-4 text-blue-600\" />\n                <h4 className=\"font-bold text-slate-900 text-xs\">\n                  Tahap 1 \342\200\224 Pengaturan Satuan Dimensi, Skala, &amp; Lantai Tujuan\n                </h4>\n              </div>\n              <span className=\"text-[11px] text-slate-500\">\n                Konversi otomatis ke meter (m) tanpa perkalian skala\n              </span>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n              {/* 1. Satuan Dimensi Gambar */}\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">\n                  Satuan Dimensi Gambar *\n                </label>\n                <div className=\"flex items-center gap-1.5 bg-white p-1 rounded-xl border border-slate-200\">\n                  {([\'mm\', \'cm\', \'m\'] as DrawingUnit[]).map((unit) => (\n                    <button\n                      key={unit}\n                      type=\"button\"\n                      onClick={() => handleUnitSettingChange(unit)}\n                      className={`flex-1 py-1.5 rounded-lg font-bold text-xs transition ${\n                        selectedUnit === unit\n                          ? \'bg-blue-600 text-white shadow-2xs\'\n                          : \'text-slate-600 hover:bg-slate-100\'\n                      }`}\n                    >\n                      {unit.toUpperCase()}\n                    </button>\n                  ))}\n                </div>\n                <p className=\"text-[10px] text-slate-500 mt-1.5 leading-tight\">\n                  Contoh: angka <strong>600</strong> pada satuan <strong>cm</strong> otomatis dikonversi menjadi <strong>6,00 m</strong>.\n                </p>\n              </div>\n\n              {/* 2. Skala Gambar */}\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">Skala Gambar</label>\n                <select\n                  value={selectedScale}\n                  onChange={(e) => setSelectedScale(e.target.value as DrawingScale)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-slate-200 bg-white font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                >\n                  <option value=\"1:20\">1:20 (Detail)</option>\n                  <option value=\"1:50\">1:50 (Denah / Potongan)</option>\n                  <option value=\"1:75\">1:75</option>\n                  <option value=\"1:100\">1:100 (Standar Denah)</option>\n                  <option value=\"1:150\">1:150</option>\n                  <option value=\"1:200\">1:200</option>\n                  <option value=\"custom\">Lainnya...</option>\n                  <option value=\"unknown\">Tidak Diketahui</option>\n                </select>\n\n                {selectedScale === \'custom\' && (\n                  <div className=\"flex items-center gap-1.5 mt-2\">\n                    <span className=\"font-bold text-slate-700\">1 :</span>\n                    <input\n                      type=\"number\"\n                      placeholder=\"125\"\n                      value={customScaleDenom}\n                      onChange={(e) => setCustomScaleDenom(Number(e.target.value) || 100)}\n                      className=\"w-full px-2 py-1 rounded-lg border border-slate-300 font-bold text-slate-900\"\n                    />\n                  </div>\n                )}\n              </div>\n\n              {/* 3. Lantai Tujuan */}\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1\">Lantai Tujuan *</label>\n                <select\n                  value={selectedFloorId}\n                  onChange={(e) => setSelectedFloorId(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-slate-200 bg-white font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                >\n                  {floors.map((f) => (\n                    <option key={f.id} value={f.id}>\n                      {f.name} {f.elevation ? `(${f.elevation})` : \'\'}\n                    </option>\n                  ))}\n                </select>\n                <p className=\"text-[10px] text-slate-500 mt-1.5 leading-tight\">\n                  Draf pekerjaan hasil AI akan ditempatkan pada lantai ini.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* TAHAP 2: UNGGAH DOKUMEN & ANALISIS AI */}\n          <div className=\"p-4 bg-white rounded-2xl border border-slate-200 space-y-3\">\n            <div className=\"flex flex-wrap items-center justify-between gap-2\">\n              <label className=\"font-bold text-slate-800 block\">\n                Tahap 2 \342\200\224 Unggah File Gambar Kerja (PDF / JPG / PNG)\n              </label>\n              <button\n                type=\"button\"\n                onClick={handleLoadSampleFloorPlan}\n                disabled={isLoading}\n                className=\"text-[11px] font-semibold text-blue-600 hover:text-blue-800 underline\"\n              >\n                Gunakan File Uji Denah Lantai 1 (rencana 1-Model.pdf)\n              </button>\n            </div>\n\n            <div\n              onClick={() => fileInputRef.current?.click()}\n              className=\"border-2 border-dashed border-blue-200 hover:border-blue-400 bg-blue-50/20 hover:bg-blue-50/40 rounded-xl p-4 text-center cursor-pointer transition flex items-center justify-center gap-3\"\n            >\n              <input\n                ref={fileInputRef}\n                type=\"file\"\n                accept=\".pdf,image/png,image/jpeg,image/jpg,image/webp\"\n                className=\"hidden\"\n                onChange={(e) => e.target.files?.[0] && handleFileSelect(e.target.files[0])}\n              />\n              <div className=\"w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0\">\n                <Upload className=\"w-5 h-5\" />\n              </div>\n              <div className=\"text-left text-xs min-w-0 flex-1\">\n                <span className=\"font-semibold text-slate-900 block truncate\">\n                  {selectedFile\n                    ? selectedFile.name\n                    : \'Klik untuk memilih file denah / potongan konstruksi\'}\n                </span>\n                <span className=\"text-[11px] text-slate-400 block\">\n                  {selectedFile\n                    ? `${(selectedFile.size / (1024 * 1024)).toFixed(2)} MB \302\267 Siap dianalisis`\n                    : \'Format didukung: PDF, JPG, JPEG, PNG (maks. 15 MB)\'}\n                </span>\n              </div>\n              {selectedFile && (\n                <span className=\"px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 shrink-0 flex items-center gap-1\">\n                  <Check className=\"w-3 h-3\" /> Berkas Siap\n                </span>\n              )}\n            </div>\n\n            {fileError && (\n              <div className=\"p-2.5 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 text-xs flex items-center gap-2\">\n                <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                <span>{fileError}</span>\n              </div>\n            )}\n\n            <div className=\"pt-1 flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n              <span className=\"text-[11px] text-slate-500\">\n                AI membaca dimensi tertulis, mencocokkan katalog pekerjaan, dan membuat draf pekerjaan secara otomatis.\n              </span>\n              <button\n                onClick={handleAnalyze}\n                disabled={!selectedFile || isLoading}\n                className=\"px-6 py-2.5 font-bold text-xs text-white bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 disabled:cursor-not-allowed rounded-xl transition shadow-xs flex items-center justify-center gap-2 shrink-0\"\n              >\n                {isLoading ? (\n                  <>\n                    <Loader2 className=\"w-4 h-4 animate-spin\" />\n                    <span>Menganalisis &amp; Menyusun Draf Pekerjaan...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4\" />\n                    <span>Mulai Analisis AI</span>\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n\n          {/* ERROR & BUSY HANDLING */}\n          {analysisError && (\n            <div className=\"p-4 bg-amber-50 border border-amber-200 rounded-2xl text-amber-900 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <div className=\"flex items-start gap-2.5\">\n                <AlertCircle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n                <div>\n                  <span className=\"font-bold block\">Status Layanan AI:</span>\n                  <p className=\"mt-0.5 leading-relaxed text-slate-700\">{analysisError}</p>\n                </div>\n              </div>\n\n              {isServerBusy && (\n                <button\n                  onClick={handleAnalyze}\n                  disabled={isLoading}\n                  className=\"px-3.5 py-1.5 bg-white border border-amber-300 text-amber-900 font-bold rounded-xl hover:bg-amber-100/70 transition shrink-0 flex items-center gap-1.5 shadow-2xs self-end sm:self-auto\"\n                >\n                  <RotateCcw className=\"w-3.5 h-3.5\" />\n                  <span>Coba Lagi</span>\n                </button>\n              )}\n            </div>\n          )}\n\n          {/* TAHAP 3\342\200\2235: RINGKASAN AUTO QUANTITY TAKEOFF */}\n          {takeoffSummary && (\n            <div className=\"space-y-4\">\n              {/* Banner Ringkasan Hasil Otomatis */}\n              <div className=\"p-4 bg-gradient-to-r from-emerald-50 via-blue-50/70 to-indigo-50/60 border border-blue-200 rounded-2xl space-y-2\">\n                <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                    <span className=\"font-bold text-slate-900 text-xs\">\n                      Analisis selesai. Ditemukan {takeoffSummary.extractedCount} dimensi, dibuat{\' \'}\n                      {takeoffSummary.createdDraftWorksCount} draf pekerjaan baru\n                      {takeoffSummary.updatedExistingWorksCount > 0\n                        ? ` (dan diperbarui ${takeoffSummary.updatedExistingWorksCount} pekerjaan)`\n                        : \'\'}{\' \'}\n                      pada {currentFloorName}, serta {takeoffSummary.incompleteWorksCount} pekerjaan\n                      memerlukan parameter tambahan.\n                    </span>\n                  </div>\n                  {modelUsedInfo && (\n                    <span className=\"text-[10px] font-mono text-blue-700 bg-white px-2 py-0.5 rounded border border-blue-100\">\n                      {modelUsedInfo}\n                    </span>\n                  )}\n                </div>\n\n                <p className=\"text-[11px] text-slate-600\">\n                  {takeoffSummary.documentSummary} \302\267 Skala: <strong>{takeoffSummary.identifiedScale}</strong>\n                </p>\n              </div>\n\n              {/* Sub-Navigation Tabs for Results */}\n              <div className=\"flex items-center gap-2 border-b border-slate-200 pb-2\">\n                <button\n                  onClick={() => setResultTab(\'drafts\')}\n                  className={`px-3.5 py-1.5 rounded-lg text-xs font-bold transition ${\n                    resultTab === \'drafts\'\n                      ? \'bg-blue-600 text-white shadow-2xs\'\n                      : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n                  }`}\n                >\n                  Draf Pekerjaan Kalkulator ({currentFloorAiWorks.length})\n                </button>\n                <button\n                  onClick={() => setResultTab(\'dimensions\')}\n                  className={`px-3.5 py-1.5 rounded-lg text-xs font-bold transition ${\n                    resultTab === \'dimensions\'\n                      ? \'bg-blue-600 text-white shadow-2xs\'\n                      : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n                  }`}\n                >\n                  Tabel Dimensi Terbaca ({extractions.length})\n                </button>\n                <button\n                  onClick={() => setResultTab(\'recommendations\')}\n                  className={`px-3.5 py-1.5 rounded-lg text-xs font-bold transition ${\n                    resultTab === \'recommendations\'\n                      ? \'bg-blue-600 text-white shadow-2xs\'\n                      : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n                  }`}\n                >\n                  Rekomendasi Lanjutan ({takeoffSummary.recommendations.length})\n                </button>\n              </div>\n\n              {/* TAB 1: DRAF PEKERJAAN OTOMATIS DI KALKULATOR */}\n              {resultTab === \'drafts\' && (\n                <div className=\"space-y-2.5\">\n                  {currentFloorAiWorks.map((work) => {\n                    const isDraft = work.aiVerificationStatus === \'draft\';\n                    const isIncomplete = work.calculatedVolume === null;\n                    const hasConflict = work.parameters.some((p) => Boolean(p.conflict));\n\n                    return (\n                      <div\n                        key={work.id}\n                        className={`p-3.5 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${\n                          hasConflict\n                            ? \'bg-rose-50/40 border-rose-200\'\n                            : isIncomplete\n                            ? \'bg-amber-50/40 border-amber-200\'\n                            : isDraft\n                            ? \'bg-blue-50/20 border-blue-200\'\n                            : \'bg-emerald-50/20 border-emerald-200\'\n                        }`}\n                      >\n                        <div className=\"space-y-1 min-w-0 flex-1\">\n                          <div className=\"flex flex-wrap items-center gap-2\">\n                            <span className=\"font-bold text-slate-900\">{work.name}</span>\n                            <span className=\"text-[10px] font-semibold px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-700\">\n                              {work.category}\n                            </span>\n                            {isDraft ? (\n                              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-800\">\n                                Draf AI \342\200\224 Perlu Verifikasi\n                              </span>\n                            ) : (\n                              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800\">\n                                Terverifikasi\n                              </span>\n                            )}\n                            {isIncomplete && (\n                              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800\">\n                                Belum Lengkap\n                              </span>\n                            )}\n                          </div>\n\n                          <div className=\"text-[11px] text-slate-600 font-mono\">\n                            {work.parameters\n                              .map(\n                                (p) =>\n                                  `${p.label || p.name}: ${\n                                    p.value !== null && p.value !== \'\'\n                                      ? `${p.value} ${p.unit}`\n                                      : \'KOSONG (wajib diisi)\'\n                                  }`\n                              )\n                              .join(\' \302\267 \')}\n                          </div>\n\n                          {work.statusMessage && (\n                            <p\n                              className={`text-[11px] ${\n                                isIncomplete ? \'text-amber-800 font-medium\' : \'text-slate-500\'\n                              }`}\n                            >\n                              {work.statusMessage}\n                            </p>\n                          )}\n                        </div>\n\n                        <div className=\"flex items-center gap-2 shrink-0 self-end sm:self-center\">\n                          <div className=\"text-right mr-2\">\n                            <span className=\"text-[10px] text-slate-400 block\">Volume Draf</span>\n                            <span className=\"font-mono font-bold text-sm text-slate-900\">\n                              {work.calculatedVolume !== null\n                                ? `${formatIndonesianNumber(work.calculatedVolume)} ${work.unit}`\n                                : \'Menunggu Parameter\'}\n                            </span>\n                          </div>\n\n                          <button\n                            type=\"button\"\n                            onClick={() => onOpenWorkDetail(work)}\n                            className=\"inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs transition\"\n                          >\n                            <Pencil className=\"w-3 h-3\" />\n                            <span>{isIncomplete ? \'Lengkapi\' : \'Edit\'}</span>\n                          </button>\n\n                          {isDraft && !isIncomplete && !hasConflict && (\n                            <button\n                              type=\"button\"\n                              onClick={() => onApproveDraftWork(work.id)}\n                              className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition\"\n                            >\n                              <Check className=\"w-3.5 h-3.5\" />\n                              <span>Setujui</span>\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                  {currentFloorAiWorks.length === 0 && (\n                    <div className=\"p-6 text-center text-slate-500 bg-slate-50 rounded-xl border border-slate-200\">\n                      Belum ada draf pekerjaan AI pada lantai ini.\n                    </div>\n                  )}\n                </div>\n              )}\n\n              {/* TAB 2: TABEL DIMENSI TERBACA */}\n              {resultTab === \'dimensions\' && (\n                <div className=\"border border-slate-200 rounded-xl overflow-hidden shadow-2xs\">\n                  <table className=\"w-full text-left text-xs border-collapse\">\n                    <thead>\n                      <tr className=\"bg-slate-50 text-slate-700 font-bold border-b border-slate-200\">\n                        <th className=\"py-2.5 px-3\">Parameter &amp; Pekerjaan Terkait</th>\n                        <th className=\"py-2.5 px-3 text-right\">Nilai Tertulis</th>\n                        <th className=\"py-2.5 px-2 text-center\">Satuan Gambar</th>\n                        <th className=\"py-2.5 px-3 text-right w-36\">Nilai Konversi</th>\n                        <th className=\"py-2.5 px-3\">Lokasi / Grid As</th>\n                      </tr>\n                    </thead>\n                    <tbody className=\"divide-y divide-slate-100\">\n                      {extractions.map((item) => (\n                        <tr key={item.id} className=\"hover:bg-slate-50/60\">\n                          <td className=\"py-2.5 px-3\">\n                            <span className=\"font-bold text-slate-900 block\">\n                              {item.parameterName}\n                            </span>\n                            <span className=\"text-[10px] text-slate-500 block\">\n                              {item.suggestedWorkName} ({item.targetCategory})\n                            </span>\n                          </td>\n                          <td className=\"py-2.5 px-3 text-right font-mono font-semibold text-slate-800\">\n                            {item.rawExtractedValue}\n                          </td>\n                          <td className=\"py-2.5 px-2 text-center font-medium text-slate-500\">\n                            {item.explicitUnitOnDrawing || item.rawUnit}\n                          </td>\n                          <td className=\"py-2.5 px-3 text-right\">\n                            <div className=\"flex items-center justify-end gap-1\">\n                              <input\n                                type=\"number\"\n                                step=\"any\"\n                                value={\n                                  item.userCorrection !== undefined\n                                    ? item.userCorrection\n                                    : item.convertedValue\n                                }\n                                onChange={(e) =>\n                                  handleEditConvertedValue(item.id, e.target.value)\n                                }\n                                className=\"w-20 px-2 py-1 text-right text-xs font-mono font-bold border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                              />\n                              <span className=\"text-slate-600 font-semibold w-6 text-left\">\n                                {item.convertedUnit}\n                              </span>\n                            </div>\n                          </td>\n                          <td className=\"py-2.5 px-3\">\n                            <span className=\"text-[11px] font-mono text-slate-700 block\">\n                              {item.pageOrLocation || \'-\'}\n                            </span>\n                            <span className=\"text-[10px] text-slate-400 block line-clamp-1\">\n                              {item.notes}\n                            </span>\n                          </td>\n                        </tr>\n                      ))}\n                    </tbody>\n                  </table>\n                </div>\n              )}\n\n              {/* TAB 3: REKOMENDASI PEKERJAAN LANJUTAN */}\n              {resultTab === \'recommendations\' && (\n                <div className=\"space-y-2.5\">\n                  <p className=\"text-[11px] text-slate-500\">\n                    Pekerjaan berikut merupakan pekerjaan ikutan/lanjutan yang lazim menyertai elemen pada gambar, namun tidak dimasukkan otomatis agar daftar pekerjaan tetap bersih:\n                  </p>\n                  {takeoffSummary.recommendations.map((rec) => {\n                    const isAdded = Boolean(addedRecIds[rec.catalogId]);\n                    return (\n                      <div\n                        key={rec.catalogId}\n                        className=\"p-3.5 rounded-xl border border-slate-200 bg-slate-50/60 flex items-center justify-between gap-3\"\n                      >\n                        <div>\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"font-bold text-slate-900\">{rec.name}</span>\n                            <span className=\"text-[10px] px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-600 font-semibold\">\n                              {rec.category}\n                            </span>\n                          </div>\n                          <p className=\"text-[11px] text-slate-500 mt-0.5\">{rec.reason}</p>\n                        </div>\n\n                        <button\n                          type=\"button\"\n                          disabled={isAdded}\n                          onClick={() => {\n                            onAddRecommendationWork(rec.catalogId, selectedFloorId, rec.reason);\n                            setAddedRecIds((prev) => ({ ...prev, [rec.catalogId]: true }));\n                          }}\n                          className={`inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold shrink-0 transition ${\n                            isAdded\n                              ? \'bg-emerald-100 text-emerald-800 cursor-default\'\n                              : \'bg-blue-600 hover:bg-blue-700 text-white shadow-2xs\'\n                          }`}\n                        >\n                          {isAdded ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5\" />\n                              <span>Ditambahkan</span>\n                            </>\n                          ) : (\n                            <>\n                              <Plus className=\"w-3.5 h-3.5\" />\n                              <span>Tambah ke Draf</span>\n                            </>\n                          )}\n                        </button>\n                      </div>\n                    );\n                  })}\n\n                  {takeoffSummary.recommendations.length === 0 && (\n                    <div className=\"p-6 text-center text-slate-500 bg-slate-50 rounded-xl border border-slate-200\">\n                      Tidak ada rekomendasi pekerjaan tambahan untuk gambar ini.\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 bg-slate-50/50 shrink-0\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition\"\n          >\n            Tutup\n          </button>\n\n          <div className=\"flex items-center gap-2.5\">\n            {currentFloorAiWorks.some(\n              (w) => w.aiVerificationStatus === \'draft\' && w.calculatedVolume !== null\n            ) && (\n              <button\n                type=\"button\"\n                onClick={onApproveAllReadyDrafts}\n                className=\"inline-flex items-center gap-1.5 px-4 py-2.5 text-xs font-bold text-emerald-800 bg-emerald-100 hover:bg-emerald-200 rounded-xl transition\"\n              >\n                <FileCheck2 className=\"w-4 h-4\" />\n                <span>Setujui Semua Draf yang Lengkap</span>\n              </button>\n            )}\n\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition shadow-xs\"\n            >\n              <span>Lihat Pekerjaan Hasil AI di Kalkulator</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n"
    num_lines: 946
    num_bytes: 41971
    line_range_bytes: 41971
  }
}
