      thinking_signature: "\022\233\n\n\230\n\001i\024}\023\356\031f\322m\312K\021\304\030=\226\004>N\367\262\313W\300\337\224{`A\030\352E\226\017\"Z\311K\207\003\203\262 \223\235\356\266\375\006~v\275E\364\240\241t\322O\377\363\304/\026En\344\266\266\222\241\236*\312\352\364ILA\210\aD>\226\325M\271@\221K\231\217t\346\234U\336\rZ+\263\027\262\233g\306\356\362\343\a\244\367\f\201\331\207f\v^\322\317\025\355\030;\2124SN\251\206_\205\317\036\v\3623\024\213\262o\232\317\275\336a:\323l\206\327ei5m\361%9 \241\276\320\362\272\005\'4zK\305T\355(\327u\021J\234\355\027\202y5\036\020\311;\021P<\352\"\243\251.[&\371\034\nl,\372\024>\300\262b\002\362~\341$>\325-b\362\246\327}\265aai\356\3440 \005\331W\016\023\322P+\032x\343\210\317\a\237Jd%\270]c\204^Q\225~\233]]\b\235qnL\225~\036\300\275(\226\362\000\026&\273\367\002\307e\237\205\212\360-\n\314-\217=h~\352,t\201\333\v \203\027\207\2539\230=\020\225V\b\b5\277\332D\313\032\v\271\2659\027fV\204\247HT{\021z\\\353B\350<\231>Q\017\202s0E\223\372\034l\317\034\362q\347X\256\216\216\347\n\\\366\026y\351\264\303\356t--;\356\230\307v\323\0178\261\307I\026\360\265\003*\024I\356\216\264Zs\351?\vA\221\225\220*\253\213\324\217:\np\\\332 \2245\276\236Qb\375\023\317c\006\214i91\267\363xf\333\273QN\372\332Vh\357j\312Z\344\251\035w\227$5\305\300n\276\252/W\032\372\336\306\251vlK\247@\276\220\254\316\235\232a\353\0004\372\202[\271\372\374\276\315 ?H#\303\2257j\370\333\\+#as\331\344\330-\232\205\241\202\337\0207\366\210\2530\250\344\002\001\227~\317\\\206\266\372ID\274\274u5\232\252P\376(\246\272\273\272!a\307\360\332\225\006\366\214\f7\'J\337\021\277\b\333\316Jd\316O$\033\026u8X\336\304E\311\207@\310PC\377\303\030\337s\321\270\344\267\377`\t\316\263\261<\a\243\237j\370\351\003K\364:\307^S\017\231\374~\006\002\317\024ZO\023\317\331{\233\374\362<r\360\264\354\033\344\325\324X\201\b\205\203}U\367\356o\254:1\245A\202\036\037\363FB\230\035-\351[u\267@\374\035G\003\235\240\344\340\255\003vg\026\326\245\253Y\330py\303\217J\240X\243V\320*k\317\371>\365&\2104{ \235tq\246\3139\0169x\334\321\235\a\344\261B\333_\t\03783\212\342\236\2616\304*.;\b\330}\217\231\004\332\266\213\032\332>\a\226d\241\247\3126?\b\365\317\361\372B\003\244\205\016Y\275,\230\033\277\342Un\336G\3775\234W\317r\343\232:\352t.\004^6\032\316\v\3416wQA\272\344\207\335\316\3669\247\231\002\357\275\214\231\034.n\256\023c\3254Sl^Z\235\252\364\254\205\356\234\232\254\334\212,\243\\e\307\356\272.\020\001^\001\320\350\207.\345\027\360i\337G\a\257\0247\177\022\355\243\276\240\361\352|\255\nj\035\034r\030\256\250\3115\334\226\312\036\377\v\302$\204\241#\354\034\232\356\3322\264H\314P\330\000c\351!\232\027\354\251\2111X]\337\3062\360\r\002Ss\355\023\272\332\322V\213\205\032\250\224\241\361\323\372\206PS\037A\310\225`#\225\322\227\346\370\221\311\357.\241\000%}\"\036\225\332\342\027x\202;\005s\303b\371\331\253\265\315\226\301\304\243?_\330\3262\263$\2371\023w\321#\353\216\022\355\332S\266E\035\346\310.\254\314B$\361\237\205\017\210\317\327\205\354\207\265G\2566\372\314\222\271y\336\200_\264\r\001dRCMP=\334\002.d\274\361T\352\023\250W6[\231p\257/\225(\214Mr\202\237\037\252\027\327\230~<\203s@\367\330L;\375\376]\265\006q\366Y\204\215w\271\032\'@|\325\026\277c\204\025i\350EA|\363\203\316\r\220\245\322\221M\331\245\355\361YA\024\324-\271\227z\316Z!\333\275\275\265\244n\252J\323\242\210\347\021\006\201\256\320\230\303X\224\376r-^=\354\025\324\364g+k\237\263\030\342r\273\205\221\232\027T\2764\316*\252\340%\326\005L]\001S\362A_\nf\363T\227\245\"\236-Oh\270g\241\366\362Rd\004\345\374\a\235\001\310\235\3218\347\036\026\001X\224\214\215}\033\023\0356\\\027;\310\373d\353\241\352\031|\315\016\004\261|\360\271\202\335\343\351\255\002\345:\272i\262\261\245\003\235f]\023\347\321E\217\246n\222\362\372\237DLA\260\036X\222.E\205r\264l\375\236-\356Lx\004z\034\321\234\304\023M"
