        target_content: "      const response = await fetch(\'/api/gemini/extract-dimensions\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          fileBase64: base64Data,\n          mimeType,\n          fileName,\n          floorName: targetFloorObj ? targetFloorObj.name : \'Lantai 1\',\n          unitSetting: selectedUnit,\n          scaleSetting: scaleText,\n        }),\n      });\n\n      const resJson = await response.json();\n\n      if (!response.ok || !resJson.success) {\n        if (response.status === 503 || resJson.isBusy) {\n          setIsServerBusy(true);\n          setAnalysisError(\n            \'Server AI sedang sibuk. Dokumen belum berhasil dianalisis. Silakan coba kembali beberapa saat lagi.\'\n          );\n        } else {\n          setAnalysisError(resJson.error || \'Gagal membaca dokumen.\');\n        }\n        return;\n      }"
        replacement_content: "      const response = await fetch(\'/api/gemini/extract-dimensions\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          fileBase64: base64Data,\n          mimeType,\n          fileName,\n          floorName: targetFloorObj ? targetFloorObj.name : \'Lantai 1\',\n          unitSetting: selectedUnit,\n          scaleSetting: scaleText,\n        }),\n      });\n\n      const contentType = response.headers.get(\'content-type\') || \'\';\n      let resJson: any = null;\n\n      if (contentType.includes(\'application/json\')) {\n        try {\n          resJson = await response.json();\n        } catch (jsonErr) {\n          console.error(\'[RuangRAB] Gagal parsing JSON respons:\', jsonErr);\n        }\n      } else {\n        const rawText = await response.text();\n        console.error(\n          \'[RuangRAB] Server mengembalikan respons bukan JSON (status \' +\n            response.status +\n            \'):\',\n          rawText.slice(0, 300)\n        );\n      }\n\n      if (!response.ok || !resJson || !resJson.success) {\n        if (response.status === 503 || resJson?.isBusy) {\n          setIsServerBusy(true);\n          setAnalysisError(\n            \'Server AI sedang sibuk (503). Dokumen belum berhasil dianalisis. Silakan coba kembali beberapa saat lagi.\'\n          );\n        } else if (response.status === 413) {\n          setAnalysisError(\n            \'Ukuran file dokumen terlalu besar. Harap unggah file yang lebih ringkas (di bawah 15 MB).\'\n          );\n        } else if (resJson?.error) {\n          setAnalysisError(resJson.error);\n        } else {\n          setAnalysisError(\n            `Koneksi server gagal (Kode status: ${response.status}). Periksa koneksi atau coba beberapa saat lagi.`\n          );\n        }\n        return;\n      }"
