            }
            lines {
              text: "    defaultUnit: \'m\302\263\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'[(Lebar Alas + Lebar Atas)/2 \303\227 Lebar Alas \303\227 Tebal Limas \303\227 Jml] + [Lebar Alas\302\262 \303\227 Tebal Alas \303\227 Jml]\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelSheet: \'Volume Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelCell: \'U37\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelFormula: \'=SUM(U35:U36)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_alas\', name: \'lebar_alas\', label: \'Lebar Sisi Alas Tapak\', placeholder: \'Masukkan lebar alas (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_atas\', name: \'lebar_atas\', label: \'Lebar Sisi Atas Limas\', placeholder: \'Masukkan lebar atas (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tebal_limas\', name: \'tebal_limas\', label: \'Tebal Bagian Miring Limas\', placeholder: \'Masukkan tebal limas (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tebal_alas\', name: \'tebal_alas\', label: \'Tebal Blok Alas Bawah\', placeholder: \'Masukkan tebal alas (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Pondasi\', placeholder: \'Masukkan jumlah titik\', value: null, unit: \'titik\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const ia = params[\'lebar_alas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const ja = params[\'lebar_atas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t1 = params[\'tebal_limas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t2 = params[\'tebal_alas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const jml = params[\'jumlah_titik\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (ia == null || ja == null || t1 == null || t2 == null || jml == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vBagian1 = ((ia + ja) / 2) * ia * t1 * jml;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vBagian2 = ia * ia * t2 * jml;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return vBagian1 + vBagian2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
