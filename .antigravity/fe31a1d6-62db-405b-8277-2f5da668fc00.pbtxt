            }
            lines {
              text: "    subCategory: \'IV. Struktur Kolom\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    floorRule: \'per_lantai\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    description: \'Pembesian sengkang/begel kolom struktur K1.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    defaultUnit: \'kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    formulaDisplay: \'2 \303\227 (Lebar + Tebal) \303\227 (Tinggi / Jarak Begel) \303\227 Jumlah Titik \303\227 Berat Jenis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excelSheet: \'Volume Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excelCell: \'U73\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excelFormula: \'=(I73+K73)*2*(M73/0.15)*O73*T73\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    verificationStatus: \'Belum Diisi\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'lebar\', name: \'lebar\', label: \'Lebar Penampang Kolom\', placeholder: \'Masukkan lebar kolom (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'tebal\', name: \'tebal\', label: \'Tebal Penampang Kolom\', placeholder: \'Masukkan tebal kolom (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Kolom\', placeholder: \'Masukkan tinggi kolom (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'jarak_begel\', name: \'jarak_begel\', label: \'Jarak Begel / Sengkang\', placeholder: \'Masukkan jarak begel (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'jumlah\', name: \'jumlah\', label: \'Jumlah Titik Kolom\', placeholder: \'Masukkan jumlah titik kolom\', value: null, unit: \'titik\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per Meter\', placeholder: \'Masukkan berat jenis besi (kg/m)\', value: null, unit: \'kg/m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
