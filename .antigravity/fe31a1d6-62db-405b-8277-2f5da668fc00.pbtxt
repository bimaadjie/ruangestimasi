      original_chunk {
        target_content: "import React from \'react\';\nimport {\n  LayoutDashboard,\n  FolderKanban,\n  Layers,\n  Calculator,\n  FileSpreadsheet,\n  Download,\n  Lightbulb,\n  Sparkles,\n} from \'lucide-react\';\n\nexport type NavTab = \'dashboard\' | \'proyek\' | \'lantai\' | \'kalkulator\' | \'rekap\' | \'ai\' | \'ekspor\';\n\ninterface SidebarProps {\n  activeTab: NavTab;\n  onSelectTab: (tab: NavTab) => void;\n  onOpenAI: () => void;\n  onExportExcel: () => void;\n  onOpenFloors: () => void;\n  onOpenProjects: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activeTab,\n  onSelectTab,\n  onOpenAI,\n  onExportExcel,\n  onOpenFloors,\n  onOpenProjects,\n}) => {\n  const navItems = [\n    { id: \'dashboard\' as NavTab, label: \'Beranda\', icon: LayoutDashboard },\n    { id: \'proyek\' as NavTab, label: \'Proyek\', icon: FolderKanban, action: onOpenProjects },\n    { id: \'lantai\' as NavTab, label: \'Lantai\', icon: Layers, action: onOpenFloors },\n    { id: \'kalkulator\' as NavTab, label: \'Pekerjaan\', icon: Calculator },\n    { id: \'rekap\' as NavTab, label: \'Hasil Volume\', icon: FileSpreadsheet },\n    { id: \'ai\' as NavTab, label: \'Asisten AI\', icon: Sparkles, action: onOpenAI },\n    { id: \'ekspor\' as NavTab, label: \'Ekspor Excel\', icon: Download, action: onExportExcel },\n  ];\n\n  return (\n    <aside className=\"w-64 bg-white border-r border-slate-200 flex flex-col justify-between shrink-0 h-screen sticky top-0\">\n      <div>\n        {/* Brand Header */}\n        <div className=\"px-6 py-5 border-b border-slate-100 flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-lg bg-blue-700 text-white flex items-center justify-center font-bold shadow-sm\">\n            <svg\n              className=\"w-5 h-5 text-white\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n            >\n              <rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\" ry=\"2\" />\n              <path d=\"M9 22v-4h6v4\" />\n              <path d=\"M8 6h.01\" />\n              <path d=\"M16 6h.01\" />\n              <path d=\"M8 10h.01\" />\n              <path d=\"M16 10h.01\" />\n              <path d=\"M8 14h.01\" />\n              <path d=\"M16 14h.01\" />\n            </svg>\n          </div>\n          <div>\n            <h1 className=\"text-base font-bold text-slate-900 leading-tight\">Kalkulator Volume</h1>\n            <p className=\"text-xs text-slate-500 font-medium\">RuangRAB Konstruksi</p>\n          </div>\n        </div>\n\n        {/* Navigation Items */}\n        <nav className=\"p-3 space-y-1\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                onClick={() => {\n                  onSelectTab(item.id);\n                  if (item.action) item.action();\n                }}\n                className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all ${\n                  isActive\n                    ? \'bg-blue-50 text-blue-700 font-semibold\'\n                    : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n                }`}\n              >\n                <Icon className={`w-4 h-4 ${isActive ? \'text-blue-600\' : \'text-slate-400\'}`} />\n                <span className=\"truncate\">{item.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Bottom Tips Widget */}\n      <div className=\"p-4 m-3 bg-amber-50/70 border border-amber-200/60 rounded-xl text-xs text-slate-700\">\n        <div className=\"flex items-start gap-2\">\n          <Lightbulb className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n          <div>\n            <span className=\"font-semibold text-amber-900\">Tips Estimator</span>\n            <p className=\"mt-1 text-slate-600 leading-relaxed\">\n              Pastikan semua parameter terisi dengan benar agar hasil perhitungan sesuai dengan rumus pada file Excel.\n            </p>\n          </div>\n        </div>\n      </div>\n    </aside>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport {\n  LayoutDashboard,\n  FolderKanban,\n  Layers,\n  Calculator,\n  FileSpreadsheet,\n  Download,\n  Lightbulb,\n  Sparkles,\n  ChevronLeft,\n  ChevronRight,\n  X,\n} from \'lucide-react\';\n\nexport type NavTab = \'dashboard\' | \'proyek\' | \'lantai\' | \'kalkulator\' | \'rekap\' | \'ai\' | \'ekspor\';\n\ninterface SidebarProps {\n  activeTab: NavTab;\n  onSelectTab: (tab: NavTab) => void;\n  onOpenAI: () => void;\n  onExportExcel: () => void;\n  onOpenFloors: () => void;\n  onOpenProjects: () => void;\n  isCollapsed: boolean;\n  onToggleCollapse: () => void;\n  isMobileOpen: boolean;\n  onCloseMobile: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activeTab,\n  onSelectTab,\n  onOpenAI,\n  onExportExcel,\n  onOpenFloors,\n  onOpenProjects,\n  isCollapsed,\n  onToggleCollapse,\n  isMobileOpen,\n  onCloseMobile,\n}) => {\n  const navItems = [\n    { id: \'dashboard\' as NavTab, label: \'Beranda\', icon: LayoutDashboard },\n    { id: \'proyek\' as NavTab, label: \'Proyek\', icon: FolderKanban, action: onOpenProjects },\n    { id: \'lantai\' as NavTab, label: \'Lantai\', icon: Layers, action: onOpenFloors },\n    { id: \'kalkulator\' as NavTab, label: \'Pekerjaan\', icon: Calculator },\n    { id: \'rekap\' as NavTab, label: \'Hasil Volume\', icon: FileSpreadsheet },\n    { id: \'ai\' as NavTab, label: \'Asisten AI\', icon: Sparkles, action: onOpenAI },\n    { id: \'ekspor\' as NavTab, label: \'Ekspor Excel\', icon: Download, action: onExportExcel },\n  ];\n\n  const handleNavClick = (item: (typeof navItems)[number]) => {\n    onSelectTab(item.id);\n    if (item.action) item.action();\n    onCloseMobile();\n  };\n\n  const renderBrandIcon = () => (\n    <div className=\"w-9 h-9 rounded-lg bg-blue-700 text-white flex items-center justify-center font-bold shadow-sm shrink-0\">\n      <svg\n        className=\"w-5 h-5 text-white\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        strokeWidth=\"2\"\n        strokeLinecap=\"round\"\n        strokeLinejoin=\"round\"\n      >\n        <rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\" ry=\"2\" />\n        <path d=\"M9 22v-4h6v4\" />\n        <path d=\"M8 6h.01\" />\n        <path d=\"M16 6h.01\" />\n        <path d=\"M8 10h.01\" />\n        <path d=\"M16 10h.01\" />\n        <path d=\"M8 14h.01\" />\n        <path d=\"M16 14h.01\" />\n      </svg>\n    </div>\n  );\n\n  return (\n    <>\n      {/* Desktop Sidebar (Collapsible w-64 <-> w-20) */}\n      <aside\n        className={`hidden md:flex flex-col justify-between bg-white border-r border-slate-200 shrink-0 h-screen sticky top-0 transition-all duration-200 ease-in-out ${\n          isCollapsed ? \'w-20\' : \'w-64\'\n        }`}\n      >\n        <div>\n          {/* Brand Header + Collapse Button */}\n          <div\n            className={`py-5 border-b border-slate-100 flex items-center ${\n              isCollapsed ? \'px-3 justify-center flex-col gap-2\' : \'px-5 justify-between gap-2\'\n            }`}\n          >\n            <div className=\"flex items-center gap-3 min-w-0\">\n              {renderBrandIcon()}\n              {!isCollapsed && (\n                <div className=\"min-w-0\">\n                  <h1 className=\"text-base font-bold text-slate-900 leading-tight truncate\">\n                    Kalkulator Volume\n                  </h1>\n                  <p className=\"text-xs text-slate-500 font-medium truncate\">RuangRAB Konstruksi</p>\n                </div>\n              )}\n            </div>\n\n            <button\n              onClick={onToggleCollapse}\n              title={isCollapsed ? \'Buka Sidebar\' : \'Ciutkan Sidebar\'}\n              aria-label={isCollapsed ? \'Buka Sidebar\' : \'Ciutkan Sidebar\'}\n              className=\"p-1.5 rounded-lg text-slate-400 hover:text-blue-700 hover:bg-blue-50 border border-transparent hover:border-blue-100 transition shrink-0\"\n            >\n              {isCollapsed ? (\n                <ChevronRight className=\"w-4 h-4\" />\n              ) : (\n                <ChevronLeft className=\"w-4 h-4\" />\n              )}\n            </button>\n          </div>\n\n          {/* Navigation Items */}\n          <nav className=\"p-3 space-y-1\">\n            {navItems.map((item) => {\n              const Icon = item.icon;\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => handleNavClick(item)}\n                  title={isCollapsed ? item.label : undefined}\n                  className={`w-full flex items-center rounded-lg text-sm font-medium transition-all duration-150 ${\n                    isCollapsed ? \'justify-center px-2 py-3\' : \'gap-3 px-3.5 py-2.5\'\n                  } ${\n                    isActive\n                      ? \'bg-blue-50 text-blue-700 font-semibold shadow-2xs\'\n                      : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n                  }`}\n                >\n                  <Icon\n                    className={`w-4 h-4 shrink-0 ${\n                      isActive ? \'text-blue-600\' : \'text-slate-400\'\n                    }`}\n                  />\n                  {!isCollapsed && <span className=\"truncate\">{item.label}</span>}\n                </button>\n              );\n            })}\n          </nav>\n        </div>\n\n        {/* Bottom Tips Widget / Collapse Footer */}\n        <div className=\"p-3\">\n          {isCollapsed ? (\n            <div className=\"flex flex-col items-center gap-2\">\n              <div\n                className=\"w-10 h-10 rounded-xl bg-amber-50 border border-amber-200/60 flex items-center justify-center text-amber-600\"\n                title=\"Tips Estimator: Pastikan semua parameter dimensi terisi lengkap dan terverifikasi agar perhitungan volume akurat.\"\n              >\n                <Lightbulb className=\"w-4 h-4\" />\n              </div>\n              <button\n                onClick={onToggleCollapse}\n                title=\"Lebarkan Sidebar\"\n                className=\"w-10 h-9 rounded-lg border border-slate-200 text-slate-500 hover:text-blue-600 hover:bg-slate-50 flex items-center justify-center transition\"\n              >\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          ) : (\n            <div className=\"p-3.5 bg-amber-50/70 border border-amber-200/60 rounded-xl text-xs text-slate-700\">\n              <div className=\"flex items-start gap-2\">\n                <Lightbulb className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n                <div>\n                  <span className=\"font-semibold text-amber-900\">Tips Estimator</span>\n                  <p className=\"mt-1 text-slate-600 leading-relaxed\">\n                    Pastikan semua parameter dimensi terisi lengkap dan terverifikasi agar hasil perhitungan volume akurat.\n                  </p>\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n      </aside>\n\n      {/* Mobile Drawer Overlay & Sidebar */}\n      <div\n        className={`fixed inset-0 z-50 md:hidden transition-opacity duration-200 ${\n          isMobileOpen ? \'opacity-100 pointer-events-auto\' : \'opacity-0 pointer-events-none\'\n        }`}\n      >\n        {/* Backdrop */}\n        <div\n          onClick={onCloseMobile}\n          className=\"fixed inset-0 bg-slate-900/50 backdrop-blur-xs\"\n        />\n\n        {/* Drawer Panel */}\n        <aside\n          className={`fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-white shadow-2xl border-r border-slate-200 flex flex-col justify-between z-10 transform transition-transform duration-200 ease-in-out ${\n            isMobileOpen ? \'translate-x-0\' : \'-translate-x-full\'\n          }`}\n        >\n          <div>\n            <div className=\"px-5 py-4 border-b border-slate-100 flex items-center justify-between gap-3\">\n              <div className=\"flex items-center gap-3\">\n                {renderBrandIcon()}\n                <div>\n                  <h1 className=\"text-base font-bold text-slate-900 leading-tight\">\n                    Kalkulator Volume\n                  </h1>\n                  <p className=\"text-xs text-slate-500 font-medium\">RuangRAB Konstruksi</p>\n                </div>\n              </div>\n              <button\n                onClick={onCloseMobile}\n                className=\"p-2 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition\"\n                aria-label=\"Tutup Menu\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <nav className=\"p-3 space-y-1\">\n              {navItems.map((item) => {\n                const Icon = item.icon;\n                const isActive = activeTab === item.id;\n                return (\n                  <button\n                    key={item.id}\n                    onClick={() => handleNavClick(item)}\n                    className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all ${\n                      isActive\n                        ? \'bg-blue-50 text-blue-700 font-semibold\'\n                        : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n                    }`}\n                  >\n                    <Icon className={`w-4 h-4 ${isActive ? \'text-blue-600\' : \'text-slate-400\'}`} />\n                    <span className=\"truncate\">{item.label}</span>\n                  </button>\n                );\n              })}\n            </nav>\n          </div>\n\n          <div className=\"p-4 m-3 bg-amber-50/70 border border-amber-200/60 rounded-xl text-xs text-slate-700\">\n            <div className=\"flex items-start gap-2\">\n              <Lightbulb className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-semibold text-amber-900\">Tips Estimator</span>\n                <p className=\"mt-1 text-slate-600 leading-relaxed\">\n                  Pastikan semua parameter dimensi terisi lengkap dan terverifikasi agar hasil perhitungan volume akurat.\n                </p>\n              </div>\n            </div>\n          </div>\n        </aside>\n      </div>\n    </>\n  );\n};\n"
