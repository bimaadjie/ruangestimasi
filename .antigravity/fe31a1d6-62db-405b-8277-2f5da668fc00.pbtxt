            lines {
              text: "    const userPrompt = `"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Dokumen yang dianalisis: ${fileName || \'Dokumen Gambar Teknik\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Target Lantai: ${floorName || \'Lantai 1\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Satuan dimensi default pilihan pengguna: ${chosenUnit}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Skala pilihan pengguna: ${chosenScale}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "Analisis dokumen ini secara menyeluruh:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "1. Identifikasi semua jenis gambar pada setiap halaman/bagian ke dalam \"detectedRegions\" (misal Denah Sloof, Tabel Dimensi dan Penulangan, Denah Arsitektur, Denah Kolom, Denah Balok, dll)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "2. Jika terdapat Denah Sloof atau Denah Balok, identifikasi setiap jalur segmen berdasarkan grid (As A-H, As 1-8, dsb.) ke dalam array \"segments\", hitung panjang setiap segmen dalam meter, dan jumlahkan total panjangnya."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "3. Jika terdapat Tabel Dimensi / Potongan Penulangan (misal S.1 dengan l = 40, t = 60), ekstrak lebar dan tinggi penampangnya dan hubungkan dengan kode elemen yang sama pada denah."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "4. Kembalikan seluruh parameter yang teridentifikasi ke dalam \"items\" beserta nomor halaman, jenis gambar, kode elemen, dan lokasi grid."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "${cleanPageSelection !== \'all\' ? `Fokus Halaman: ${cleanPageSelection}` : \'Analisis seluruh halaman yang tersedia dalam dokumen.\'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Langkah analisis wajib:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. Klasifikasikan setiap halaman dan bagian gambar ke dalam \"detectedRegions\" menggunakan salah satu dari 16 jenis gambar standar."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. Jika terdapat Denah sloof atau Denah balok, identifikasi setiap segmen berdasarkan grid/as ke dalam array \"segments\", konversikan ke meter, hindari duplikasi titik pertemuan grid, dan jumlahkan total panjang per kode elemen (misal S.1 / S1 / B1 / B2)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. Jika terdapat Tabel dimensi atau schedule / Detail penulangan, cocokkan kode elemen (K1, B1, S1, S.1, dll.) dan ambil ukuran penampangnya (lebar, tinggi, tebal)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. Kembalikan seluruh parameter yang teridentifikasi ke dalam \"items\" lengkap dengan \"pageNumber\", \"drawingType\", \"drawingTitle\", \"identifiedFloor\", \"gridLocation\", \"elementCode\", \"sourceInfo\", dan \"verificationBadge\"."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
