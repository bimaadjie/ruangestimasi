    command_line: "npx tsx -e \'\nimport {\n  createNewProject,\n  createDefaultWorksForFloor,\n  createProjectWorkFromCatalog,\n  applyAutoQuantityTakeoff,\n  getAllCatalogItems,\n} from \"./src/services/projectStorage\";\nimport { recalculateAllProjectWorks, computeProjectSummaries } from \"./src/services/calculationEngine\";\nimport fs from \"fs\";\n\nfunction assert(cond: boolean, msg: string) {\n  if (!cond) {\n    console.error(\"FAIL:\", msg);\n    process.exit(1);\n  } else {\n    console.log(\"PASS:\", msg);\n  }\n}\n\nasync function runTests() {\n  // 1. Check UI & HTML files have RuangEstimasi and no visible RuangRAB\n  const html = fs.readFileSync(\"index.html\", \"utf-8\");\n  assert(html.includes(\"RuangEstimasi\"), \"index.html contains RuangEstimasi\");\n  assert(!html.includes(\"RuangRAB\"), \"index.html does not contain RuangRAB\");\n\n  const authPage = fs.readFileSync(\"src/components/AuthPage.tsx\", \"utf-8\");\n  assert(authPage.includes(\"RuangEstimasi\"), \"AuthPage.tsx contains RuangEstimasi\");\n  assert(!authPage.includes(\"RuangRAB\"), \"AuthPage.tsx does not contain RuangRAB\");\n\n  const sidebar = fs.readFileSync(\"src/components/Sidebar.tsx\", \"utf-8\");\n  assert(sidebar.includes(\"RuangEstimasi\"), \"Sidebar.tsx contains RuangEstimasi\");\n  assert(!sidebar.includes(\"RuangRAB\"), \"Sidebar.tsx does not contain RuangRAB\");\n\n  // 2. Create New Project -> Default works automatically created per floor\n  const projectA = createNewProject(\"Proyek A - Gedung Kantor\", 2, \"Jakarta\", \"user-test-1\");\n  assert(projectA.floors.length === 3, \"Proyek A has 3 floor groups (Umum & Pondasi, Lantai 1, Lantai 2)\");\n  assert(projectA.works.length > 30, `Proyek A automatically populated with ${projectA.works.length} standard works`);\n\n  const umumWorks = projectA.works.filter(w => w.floorId === \"fl-umum\");\n  const lt1Works = projectA.works.filter(w => w.floorId === \"fl-1\");\n  const lt2Works = projectA.works.filter(w => w.floorId === \"fl-2\");\n  assert(umumWorks.length >= 15, `Umum & Pondasi has ${umumWorks.length} default works`);\n  assert(lt1Works.length >= 20, `Lantai 1 has ${lt1Works.length} default works`);\n  assert(lt2Works.length >= 20, `Lantai 2 has ${lt2Works.length} default works`);\n\n  // 3 & 4. All default works have empty parameters (value === null) and no calculatedVolume (null) and status \"Belum Diisi\"\n  const recalculatedA = recalculateAllProjectWorks(projectA.works);\n  const allParamsNull = recalculatedA.every(w => w.parameters.every(p => p.value === null));\n  const allVolumesNull = recalculatedA.every(w => w.calculatedVolume === null);\n  const allStatusBelumDiisi = recalculatedA.every(w => w.status === \"Belum Diisi\");\n  assert(allParamsNull, \"All parameters in default project works are empty (null) \342\200\224 zero USC dimensions carried over\");\n  assert(allVolumesNull, \"All default project works have calculatedVolume === null (\342\200\224)\");\n  assert(allStatusBelumDiisi, \"All default project works have status === Belum Diisi\");\n\n  // 5. Incomplete / empty works do not produce final volume in project summary\n  const summaryEmpty = computeProjectSummaries(recalculatedA);\n  assert(summaryEmpty.totalBetonM3 === 0 && summaryEmpty.totalLuasM2 === 0 && summaryEmpty.totalPanjangM === 0, \"Empty default works produce 0 final verified volume\");\n\n  // 6 & 8. Multi-delete works in Project A does not affect Project B or global catalog\n  const projectB = createNewProject(\"Proyek B - Rumah 2 Lantai\", 2, \"Bandung\", \"user-test-1\");\n  const initialCountA = projectA.works.length;\n  const initialCountB = projectB.works.length;\n  const idsToDelete = projectA.works.slice(0, 5).map(w => w.id);\n  projectA.works = projectA.works.filter(w => !idsToDelete.includes(w.id));\n  assert(projectA.works.length === initialCountA - 5, \"Multi-delete removed 5 works from Proyek A\");\n  assert(projectB.works.length === initialCountB, \"Deleting works in Proyek A did not affect Proyek B\");\n  assert(getAllCatalogItems().length >= 49, \"Global catalog templates remain intact after deleting project works\");\n\n  // 7. Re-adding deleted work from catalog\n  const reAdded = createProjectWorkFromCatalog(\"prep-pembersihan-lahan\", \"fl-umum\");\n  assert(reAdded !== null && reAdded.parameters.every(p => p.value === null), \"Re-added work from catalog has empty parameters\");\n  projectA.works.unshift(reAdded!);\n\n  // 8. Adding a new floor (Lantai 3) automatically populates standard floor works\n  const fl3Works = createDefaultWorksForFloor(\"fl-3\", 3);\n  assert(fl3Works.length >= 20 && fl3Works.some(w => w.catalogId === \"str-plat-lantai-beton\"), `New Lantai 3 automatically gets ${fl3Works.length} standard works including Plat Lantai`);\n\n  // 9. AI Auto Quantity Takeoff updates existing default work (e.g. Sloof S1 on fl-umum) without creating a duplicate work\n  const sloofCountBefore = projectB.works.filter(w => w.catalogId === \"str-sloof-beton\").length;\n  assert(sloofCountBefore === 1, \"Proyek B initially has 1 default Sloof S1 work on Umum & Pondasi\");\n\n  const aiResult = applyAutoQuantityTakeoff(\n    projectB,\n    [\n      {\n        id: \"ai-1\",\n        elementName: \"Sloof S1 (40x60 cm)\",\n        elementCode: \"S.1\",\n        category: \"sloof\",\n        drawingType: \"Denah Sloof\",\n        catalogId: \"str-sloof-beton\",\n        parameterId: \"panjang_total\",\n        rawExtractedValue: 360,\n        detectedUnit: \"m\",\n        convertedValueMeters: 360,\n        confidence: \"tinggi\",\n      },\n      {\n        id: \"ai-2\",\n        elementName: \"Sloof S1 (40x60 cm)\",\n        elementCode: \"S.1\",\n        category: \"sloof\",\n        drawingType: \"Tabel Dimensi dan Penulangan\",\n        catalogId: \"str-sloof-beton\",\n        parameterId: \"lebar\",\n        rawExtractedValue: 40,\n        detectedUnit: \"cm\",\n        convertedValueMeters: 0.4,\n        confidence: \"tinggi\",\n      },\n      {\n        id: \"ai-3\",\n        elementName: \"Sloof S1 (40x60 cm)\",\n        elementCode: \"S.1\",\n        category: \"sloof\",\n        drawingType: \"Tabel Dimensi dan Penulangan\",\n        catalogId: \"str-sloof-beton\",\n        parameterId: \"tinggi\",\n        rawExtractedValue: 60,\n        detectedUnit: \"cm\",\n        convertedValueMeters: 0.6,\n        confidence: \"tinggi\",\n      },\n    ],\n    \"fl-1\",\n    \"Gedung USC A4-16.pdf\"\n  );\n\n  const sloofWorksAfter = aiResult.updatedProject.works.filter(w => w.catalogId === \"str-sloof-beton\");\n  assert(sloofWorksAfter.length === 1, \"AI updated the existing default Sloof S1 work without creating a duplicate\");\n  const updatedSloof = recalculateAllProjectWorks(sloofWorksAfter)[0];\n  assert(updatedSloof.calculatedVolume === 86.4, `Updated Sloof S1 calculated volume is 86.4 m\302\263 (got ${updatedSloof.calculatedVolume})`);\n  assert(updatedSloof.status === \"Perlu Verifikasi\", `Updated Sloof S1 status is Perlu Verifikasi (got ${updatedSloof.status})`);\n\n  console.log(\"ALL VERIFICATION TESTS PASSED SUCCESSFULLY!\");\n}\n\nrunTests();\n\'"
    proposed_command_line: "npx tsx -e \'\nimport {\n  createNewProject,\n  createDefaultWorksForFloor,\n  createProjectWorkFromCatalog,\n  applyAutoQuantityTakeoff,\n  getAllCatalogItems,\n} from \"./src/services/projectStorage\";\nimport { recalculateAllProjectWorks, computeProjectSummaries } from \"./src/services/calculationEngine\";\nimport fs from \"fs\";\n\nfunction assert(cond: boolean, msg: string) {\n  if (!cond) {\n    console.error(\"FAIL:\", msg);\n    process.exit(1);\n  } else {\n    console.log(\"PASS:\", msg);\n  }\n}\n\nasync function runTests() {\n  // 1. Check UI & HTML files have RuangEstimasi and no visible RuangRAB\n  const html = fs.readFileSync(\"index.html\", \"utf-8\");\n  assert(html.includes(\"RuangEstimasi\"), \"index.html contains RuangEstimasi\");\n  assert(!html.includes(\"RuangRAB\"), \"index.html does not contain RuangRAB\");\n\n  const authPage = fs.readFileSync(\"src/components/AuthPage.tsx\", \"utf-8\");\n  assert(authPage.includes(\"RuangEstimasi\"), \"AuthPage.tsx contains RuangEstimasi\");\n  assert(!authPage.includes(\"RuangRAB\"), \"AuthPage.tsx does not contain RuangRAB\");\n\n  const sidebar = fs.readFileSync(\"src/components/Sidebar.tsx\", \"utf-8\");\n  assert(sidebar.includes(\"RuangEstimasi\"), \"Sidebar.tsx contains RuangEstimasi\");\n  assert(!sidebar.includes(\"RuangRAB\"), \"Sidebar.tsx does not contain RuangRAB\");\n\n  // 2. Create New Project -> Default works automatically created per floor\n  const projectA = createNewProject(\"Proyek A - Gedung Kantor\", 2, \"Jakarta\", \"user-test-1\");\n  assert(projectA.floors.length === 3, \"Proyek A has 3 floor groups (Umum & Pondasi, Lantai 1, Lantai 2)\");\n  assert(projectA.works.length > 30, `Proyek A automatically populated with ${projectA.works.length} standard works`);\n\n  const umumWorks = projectA.works.filter(w => w.floorId === \"fl-umum\");\n  const lt1Works = projectA.works.filter(w => w.floorId === \"fl-1\");\n  const lt2Works = projectA.works.filter(w => w.floorId === \"fl-2\");\n  assert(umumWorks.length >= 15, `Umum & Pondasi has ${umumWorks.length} default works`);\n  assert(lt1Works.length >= 20, `Lantai 1 has ${lt1Works.length} default works`);\n  assert(lt2Works.length >= 20, `Lantai 2 has ${lt2Works.length} default works`);\n\n  // 3 & 4. All default works have empty parameters (value === null) and no calculatedVolume (null) and status \"Belum Diisi\"\n  const recalculatedA = recalculateAllProjectWorks(projectA.works);\n  const allParamsNull = recalculatedA.every(w => w.parameters.every(p => p.value === null));\n  const allVolumesNull = recalculatedA.every(w => w.calculatedVolume === null);\n  const allStatusBelumDiisi = recalculatedA.every(w => w.status === \"Belum Diisi\");\n  assert(allParamsNull, \"All parameters in default project works are empty (null) \342\200\224 zero USC dimensions carried over\");\n  assert(allVolumesNull, \"All default project works have calculatedVolume === null (\342\200\224)\");\n  assert(allStatusBelumDiisi, \"All default project works have status === Belum Diisi\");\n\n  // 5. Incomplete / empty works do not produce final volume in project summary\n  const summaryEmpty = computeProjectSummaries(recalculatedA);\n  assert(summaryEmpty.totalBetonM3 === 0 && summaryEmpty.totalLuasM2 === 0 && summaryEmpty.totalPanjangM === 0, \"Empty default works produce 0 final verified volume\");\n\n  // 6 & 8. Multi-delete works in Project A does not affect Project B or global catalog\n  const projectB = createNewProject(\"Proyek B - Rumah 2 Lantai\", 2, \"Bandung\", \"user-test-1\");\n  const initialCountA = projectA.works.length;\n  const initialCountB = projectB.works.length;\n  const idsToDelete = projectA.works.slice(0, 5).map(w => w.id);\n  projectA.works = projectA.works.filter(w => !idsToDelete.includes(w.id));\n  assert(projectA.works.length === initialCountA - 5, \"Multi-delete removed 5 works from Proyek A\");\n  assert(projectB.works.length === initialCountB, \"Deleting works in Proyek A did not affect Proyek B\");\n  assert(getAllCatalogItems().length >= 49, \"Global catalog templates remain intact after deleting project works\");\n\n  // 7. Re-adding deleted work from catalog\n  const reAdded = createProjectWorkFromCatalog(\"prep-pembersihan-lahan\", \"fl-umum\");\n  assert(reAdded !== null && reAdded.parameters.every(p => p.value === null), \"Re-added work from catalog has empty parameters\");\n  projectA.works.unshift(reAdded!);\n\n  // 8. Adding a new floor (Lantai 3) automatically populates standard floor works\n  const fl3Works = createDefaultWorksForFloor(\"fl-3\", 3);\n  assert(fl3Works.length >= 20 && fl3Works.some(w => w.catalogId === \"str-plat-lantai-beton\"), `New Lantai 3 automatically gets ${fl3Works.length} standard works including Plat Lantai`);\n\n  // 9. AI Auto Quantity Takeoff updates existing default work (e.g. Sloof S1 on fl-umum) without creating a duplicate work\n  const sloofCountBefore = projectB.works.filter(w => w.catalogId === \"str-sloof-beton\").length;\n  assert(sloofCountBefore === 1, \"Proyek B initially has 1 default Sloof S1 work on Umum & Pondasi\");\n\n  const aiResult = applyAutoQuantityTakeoff(\n    projectB,\n    [\n      {\n        id: \"ai-1\",\n        elementName: \"Sloof S1 (40x60 cm)\",\n        elementCode: \"S.1\",\n        category: \"sloof\",\n        drawingType: \"Denah Sloof\",\n        catalogId: \"str-sloof-beton\",\n        parameterId: \"panjang_total\",\n        rawExtractedValue: 360,\n        detectedUnit: \"m\",\n        convertedValueMeters: 360,\n        confidence: \"tinggi\",\n      },\n      {\n        id: \"ai-2\",\n        elementName: \"Sloof S1 (40x60 cm)\",\n        elementCode: \"S.1\",\n        category: \"sloof\",\n        drawingType: \"Tabel Dimensi dan Penulangan\",\n        catalogId: \"str-sloof-beton\",\n        parameterId: \"lebar\",\n        rawExtractedValue: 40,\n        detectedUnit: \"cm\",\n        convertedValueMeters: 0.4,\n        confidence: \"tinggi\",\n      },\n      {\n        id: \"ai-3\",\n        elementName: \"Sloof S1 (40x60 cm)\",\n        elementCode: \"S.1\",\n        category: \"sloof\",\n        drawingType: \"Tabel Dimensi dan Penulangan\",\n        catalogId: \"str-sloof-beton\",\n        parameterId: \"tinggi\",\n        rawExtractedValue: 60,\n        detectedUnit: \"cm\",\n        convertedValueMeters: 0.6,\n        confidence: \"tinggi\",\n      },\n    ],\n    \"fl-1\",\n    \"Gedung USC A4-16.pdf\"\n  );\n\n  const sloofWorksAfter = aiResult.updatedProject.works.filter(w => w.catalogId === \"str-sloof-beton\");\n  assert(sloofWorksAfter.length === 1, \"AI updated the existing default Sloof S1 work without creating a duplicate\");\n  const updatedSloof = recalculateAllProjectWorks(sloofWorksAfter)[0];\n  assert(updatedSloof.calculatedVolume === 86.4, `Updated Sloof S1 calculated volume is 86.4 m\302\263 (got ${updatedSloof.calculatedVolume})`);\n  assert(updatedSloof.status === \"Perlu Verifikasi\", `Updated Sloof S1 status is Perlu Verifikasi (got ${updatedSloof.status})`);\n\n  console.log(\"ALL VERIFICATION TESTS PASSED SUCCESSFULLY!\");\n}\n\nrunTests();\n\'"
    shell_name: "bash"
  }
}
