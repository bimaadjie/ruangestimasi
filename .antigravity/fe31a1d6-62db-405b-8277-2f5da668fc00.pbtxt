            lines {
              text: "      { id: \'lampu_led_12w\', name: \'lampu_led_12w\', label: \'Lampu LED 12 Watt\', value: 0, unit: \'bh\', required: false, excelCellRef: \'G38\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lampu_led_7w\', name: \'lampu_led_7w\', label: \'Lampu LED 7 Watt\', value: 0, unit: \'bh\', required: false, excelCellRef: \'G39\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lampu_led_4w\', name: \'lampu_led_4w\', label: \'Lampu LED 4 Watt\', value: 0, unit: \'bh\', required: false, excelCellRef: \'G40\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lampu_tl_40w\', name: \'lampu_tl_40w\', label: \'Lampu TL 2\303\22740 Watt\', value: 0, unit: \'bh\', required: false, excelCellRef: \'G41\' },"
