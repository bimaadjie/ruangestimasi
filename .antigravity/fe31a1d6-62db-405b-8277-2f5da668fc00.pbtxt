            lines {
              text: "    id: \'mep-titik-lampu\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    code: \'MEP-ELC-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    name: \'Pemasangan Titik Lampu & Instalasi Penerangan\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    category: \'MEP\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    subCategory: \'Pekerjaan Kelistrikan\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    floorRule: \'per_lantai\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    description: \'Pemasangan titik instalasi penerangan dan armatur lampu.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    defaultUnit: \'titik\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'Penjumlahan Seluruh Titik Lampu\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelSheet: \'Volume Persiapan Dll\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelCell: \'G34\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lampu_led_12w\', name: \'lampu_led_12w\', label: \'Jumlah Lampu Utama (Tipe A)\', placeholder: \'Masukkan jumlah titik\', value: null, unit: \'bh\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lampu_led_7w\', name: \'lampu_led_7w\', label: \'Jumlah Lampu Downlight (Tipe B)\', placeholder: \'Masukkan jumlah titik (opsional)\', value: 0, unit: \'bh\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lampu_led_4w\', name: \'lampu_led_4w\', label: \'Jumlah Lampu Taman / Sorot (Tipe C)\', placeholder: \'Masukkan jumlah titik (opsional)\', value: 0, unit: \'bh\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lampu_tl_40w\', name: \'lampu_tl_40w\', label: \'Jumlah Lampu TL / Batten (Tipe D)\', placeholder: \'Masukkan jumlah titik (opsional)\', value: 0, unit: \'bh\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const l1 = params[\'lampu_led_12w\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const l2 = params[\'lampu_led_7w\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const l3 = params[\'lampu_led_4w\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const l4 = params[\'lampu_tl_40w\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (l1 == null && l2 === 0 && l3 === 0 && l4 === 0) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return (l1 || 0) + l2 + l3 + l4;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
