      thinking_signature: "\022\273\002\n\270\002\001i\024}\023H\265y\372\366m\311\362`\f\351\334r\336H\221=\333\216\031\"\260\310\356\270\321B\330\370`\2030\377q\217`\355\234\321u\005\2471H\270\340b\2617~\021\344j\325>\346\365ez\237\340\020x\351\006Y\217\237?l\210Y\3413|\306\021\311hMs\225M\276\265=_\202K\033\036\031\345b~n\017>=\270\002\214\2761?\233\311\016\325g\364\177\2378w\324\n\233\370\206\242\251\016\202I\367\363\373\327\347\036w\271\374\r\270C\355g)\233\221\000\226[X*\340:\214U\313U\347\375R\346kH\024\004\242e&>\"\231\334Q,\272\262\317\252\202\300\362a@\321\355*`\376\227\357\207\355\205\177j!e\f\202h\256\b {\250\035H\276\317+\356\260y&\254ve\224\r}\376(\025\371\355Kijie\375\371f\363\326\363\331\327\n1\275O4i\2151\361\277\363\342\271\026\005*\260c\220Q:@\256\335BS\0234\330\316]\201\350\036\346\337\273{2\336\244\346 \"\303\306HNn\325y\037\302\252B\n\343*\201e\225m\347\305\242\374\246Dh/\361\337\310"
