              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'antrede\', name: \'antrede\', label: \'Lebar Pijakan / Antrede\', value: 0.27, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'optrede\', name: \'optrede\', label: \'Tinggi Tanjakan / Optrede\', value: 0.16, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jumlah_anak_tangga\', name: \'jumlah_anak_tangga\', label: \'Jumlah Anak Tangga\', value: 24, unit: \'bh\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', value: 1.4, unit: \'m\', required: true, excelCellRef: \'K114\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Pelat Bordes\', value: 2.85, unit: \'m\302\262\', required: false, excelCellRef: \'I119\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tebal_bordes\', name: \'tebal_bordes\', label: \'Tebal Pelat Bordes\', value: 0.12, unit: \'m\', required: false, excelCellRef: \'M119\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const a = params[\'antrede\'] ?? 0.27;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const o = params[\'optrede\'] ?? 0.16;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const n = params[\'jumlah_anak_tangga\'] || 24;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const w = params[\'lebar_tangga\'] || 1.4;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const lb = params[\'luas_bordes\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const tb = params[\'tebal_bordes\'] || 0.12;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vAnakTangga = 0.5 * a * o * n * w;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vBordes = lb * tb;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return vAnakTangga + vBordes;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
