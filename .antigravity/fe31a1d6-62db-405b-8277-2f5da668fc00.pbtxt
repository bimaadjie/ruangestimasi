      thinking_signature: "\022\314\b\n\311\b\001i\024}\023\337\373\372\276\370\306\235\023\203\262\245\273\272\037\371\304[U\244\366M#5\026\247\212~N(\271\037\327q\262r&\333\262+\026\303\000d$/+m\031\270\355,\235\264\274\211M\227\035D~\311\274vt\302MpfG\276b\307\023e\316=\230a\352>\022\2624\030\275\356M\242\255\233O\'4\320\2573\036X\'\325\265z4\'\202i\251\031\237\247C\245\224r\205m\350z\343\365\254\'\237X\021\221X\350\245\217^\264\344\027s\373\341h~:\216\307\372\241`\335\310\017tP \330*\034\r\004\021n\216\255I\177[\222\325\270]#\021\27293o\354\220\372\250\270\231:C\344\t\225<\217\031\317\2130\232sl7\375\017F\355#%\341yf\256F_\342\026\324\310\367$\361\352KZ\022f\376PK\204u\205\306}\b\366K\225\260\324\374xB\325S\300\"\307\351\243\367XI\2650\344<\360\310n\v\305\231\363\306\320I\212\005]\353\225YP\255l\375\217\360\270\263\tf\244\264\030+\352\r\271\001Yp\360\203HE!Q\366>\355\273\032\220\3120\345?\267[\263\357\250iU\211\a\002\250\255\356\335J\330\302\351\025\327)8\253\244\233\204T\263\317\3704\302\347C \303\301\321L\020F\261\350-E\370\311T\263\246{H\374o\032\227\305L\372\276\237\005\355\213\367-BJ\215\324hw\240v\242\242\213\266\204\"\250\244\270X\017\371%d,7DH\244+\216\254\237q\311\360\034\\\316JaP\316\262>\225\360\330\350\207#h\361H)\365j}&2d\322\370\272\312\243\345`\206k\t#\202\3620\224F\217\257_\020j\251\214Pt\243f\316\313\225\001eBl\315w\304\211\344\327/\027\247\a\214\310\254\314c\262O\377\260\315\017e\n\201\t\374S>^\306\212j\317R\322\256\357DY\024\220\305\253F.\3209\017\r\246b\253\327\034\257s\335Cp\f7[\2729Xd\025\023;HnU\005\311v\314Rd\345\351QG5*\277\310\216\034\232\237_\230\024\270\214\005\374\304\210\275\3460\361\265\031\264A\341e\317\016\273\006\245\234/\0376~\371\275\241\334\3341c\025\254\027\350B\315\365\270KA\200>\237\326\207\235\237\fc\254\260\364\225\331HH\033QR\366Y\267\3140\205.\266\005E$1\r\231k\347yC\204=\343\277~u\275\340\003@)\204\345q,\2619\202\217N\275\375\261\347\272w@\f\000\354,\222O\030G\210\242\t\020\005\277\t!\226.}\035\262`\265\256+!\220-\025