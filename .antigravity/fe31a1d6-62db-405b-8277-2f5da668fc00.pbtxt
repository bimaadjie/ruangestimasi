    command_line: "npx tsx -e \"\nimport { USC_STANDARD_TEMPLATE, USC_CATALOG_VERSION } from \'./src/data/uscCatalog\';\nimport {\n  getGlobalUscTemplate,\n  createNewProject,\n  migrateProjectToFullUscTemplate,\n  applyAutoQuantityTakeoff,\n  createCustomProjectWork,\n} from \'./src/services/projectStorage\';\nimport { recalculateAllProjectWorks } from \'./src/services/calculationEngine\';\n\nconsole.log(\'=== VERIFIKASI 10 POIN PENGUJIAN RUANGESTIMASI ===\');\nconsole.log(\'Catalog Version:\', USC_CATALOG_VERSION);\nconsole.log(\'Total USC Catalog Items:\', USC_STANDARD_TEMPLATE.length);\n\n// 1. Template standar menggunakan katalog pekerjaan USC lengkap\nconst categories = new Set(USC_STANDARD_TEMPLATE.map(c => c.category));\nconsole.log(\'1. Kategori dalam Template USC:\', Array.from(categories));\nif (USC_STANDARD_TEMPLATE.length < 80 || categories.size < 4) {\n  throw new Error(\'Test 1 gagal: Katalog USC tidak lengkap\');\n}\n\n// 2. Semua kelompok lantai dan pekerjaan USC tampil kembali\nconst pTest = createNewProject(\'Proyek Uji 3 Lantai\', 3, \'user-1\');\nconst workCountsByFloor = pTest.floors.map(f => ({\n  floor: f.name,\n  count: pTest.works.filter(w => w.floorId === f.id).length,\n}));\nconsole.log(\'2. Kelompok Lantai & Jumlah Pekerjaan Standar USC:\', workCountsByFloor);\nif (pTest.floors.length !== 4 || workCountsByFloor.some(f => f.count < 20)) {\n  throw new Error(\'Test 2 gagal: Kelompok lantai atau pekerjaan tidak lengkap\');\n}\n\n// 3. Seluruh dimensi dan volume proyek baru kosong\nconst anyNonNullParam = pTest.works.some(w => w.parameters.some(p => p.value !== null));\nconst anyNonNullVol = pTest.works.some(w => w.calculatedVolume !== null);\nconsole.log(\'3. Ada parameter berisi nilai demo USC?\', anyNonNullParam, \'| Ada volume terisi?\', anyNonNullVol);\nif (anyNonNullParam || anyNonNullVol) {\n  throw new Error(\'Test 3 gagal: Masih ada nilai demo USC pada proyek baru\');\n}\n\n// 4. Semua pekerjaan proyek baru berstatus Belum Diisi\nconst allBelumDiisi = pTest.works.every(w => w.status === \'Belum Diisi\');\nconsole.log(\'4. Semua pekerjaan proyek baru berstatus Belum Diisi?\', allBelumDiisi);\nif (!allBelumDiisi) {\n  throw new Error(\'Test 4 gagal: Status awal bukan Belum Diisi\');\n}\n\n// 5. Rumus asli katalog USC tetap berfungsi\nconst sampleWork = pTest.works.find(w => w.catalogId === \'str-kolom-k1-beton\')!;\nconst filledParams = sampleWork.parameters.map(p => ({\n  ...p,\n  value: p.id === \'lebar\' ? 0.4 : p.id === \'panjang\' ? 0.4 : p.id === \'tinggi\' ? 4.0 : 10,\n}));\nconst [recalcSample] = recalculateAllProjectWorks([{ ...sampleWork, parameters: filledParams }]);\nconsole.log(\'5. Uji Rumus Asli USC (Kolom K1 0.4x0.4x4.0 x 10 bh):\', {\n  volume: recalcSample.calculatedVolume,\n  status: recalcSample.status,\n});\nif (recalcSample.calculatedVolume !== 6.4 || recalcSample.status !== \'Terverifikasi\') {\n  throw new Error(\'Test 5 gagal: Rumus asli USC tidak berfungsi sebagaimana mestinya\');\n}\n\n// 6 & 7. Proyek yang dibuat pengguna & pekerjaan kustom tidak hilang saat migrasi\nconst legacyUserProject = {\n  id: \'proj-user-existing\',\n  userId: \'user-1\',\n  name: \'Rumah 2 lantai\',\n  location: \'Semarang\',\n  floorCount: 2,\n  createdAt: \'2026-10-28\',\n  updatedAt: new Date().toISOString(),\n  catalogVersion: \'1.0.0-old\',\n  floors: [\n    { id: \'fl-umum\', name: \'Umum & Pondasi\', elevation: \'\302\261 0.00\', level: 0 },\n    { id: \'fl-1\', name: \'Lantai 1\', elevation: \'+ 0.00 m\', level: 1 },\n    { id: \'fl-2\', name: \'Lantai 2\', elevation: \'+ 4.00 m\', level: 2 },\n  ],\n  works: [\n    {\n      ...recalcSample,\n      id: \'user-filled-k1\',\n      floorId: \'fl-1\',\n    },\n    createCustomProjectWork({\n      name: \'Pekerjaan Kolam Renang Kustom\',\n      category: \'Pekerjaan Arsitektural\',\n      floorId: \'fl-1\',\n      unit: \'m3\',\n      calculationMethod: \'custom_2d_area_thick\',\n      parameters: [\n        { id: \'luas\', label: \'Luas\', unit: \'m2\', value: 24 },\n        { id: \'tebal\', label: \'Kedalaman\', unit: \'m\', value: 1.5 },\n        { id: \'jumlah\', label: \'Jumlah\', unit: \'bh\', value: 1 },\n      ],\n    }),\n  ],\n};\nconst migration = migrateProjectToFullUscTemplate(legacyUserProject as any, \'user-1\');\nconst migratedProj = migration.project;\nconst preservedK1 = migratedProj.works.find(w => w.id === \'user-filled-k1\');\nconst preservedCustom = migratedProj.works.find(w => w.name === \'Pekerjaan Kolam Renang Kustom\');\nconsole.log(\'6 & 7. Migrasi Proyek Lama -> Total pekerjaan setelah pulih USC:\', migratedProj.works.length, \'| K1 user utuh (vol=6.4):\', preservedK1?.calculatedVolume === 6.4, \'| Pekerjaan Kustom utuh:\', Boolean(preservedCustom));\nif (!preservedK1 || preservedK1.calculatedVolume !== 6.4 || !preservedCustom || migratedProj.works.length < 150) {\n  throw new Error(\'Test 6/7 gagal: Data proyek pengguna atau pekerjaan kustom hilang saat migrasi\');\n}\n\n// 8 & 9. Proyek A dan Proyek B terpisah & tidak memengaruhi satu sama lain atau template global\nconst proyekA = createNewProject(\'Proyek A\', 2, \'user-1\');\nconst proyekB = createNewProject(\'Proyek B\', 2, \'user-1\');\nproyekA.works[0].parameters[0].value = 999;\nproyekA.works[0].calculatedVolume = 999;\nconst deletedCatalogId = proyekA.works[1].catalogId;\nproyekA.works.splice(1, 1);\n\nconst globalTemplate = getGlobalUscTemplate();\nconst bFirstParamVal = proyekB.works[0].parameters[0].value;\nconst bStillHasDeleted = proyekB.works.some(w => w.catalogId === deletedCatalogId);\nconst globalUnchanged = globalTemplate.every(item => item.parameters.every(p => p.value === null));\nconsole.log(\'8 & 9. Isolasi Proyek A vs Proyek B & Template Global -> B param[0]:\', bFirstParamVal, \'| B masih punya item yg dihapus di A:\', bStillHasDeleted, \'| Global Template tetap null:\', globalUnchanged);\nif (bFirstParamVal !== null || !bStillHasDeleted || !globalUnchanged) {\n  throw new Error(\'Test 8/9 gagal: Perubahan di Proyek A bocor ke Proyek B atau Template Global\');\n}\n\n// 10. Asisten AI dan input manual tetap berfungsi dengan daftar pekerjaan USC\nconst aiRes = applyAutoQuantityTakeoff(\n  proyekB,\n  [\n    {\n      id: \'ai-1\',\n      elementName: \'Kolom Struktur K1 40x40\',\n      category: \'Pekerjaan Struktural\',\n      catalogId: \'str-kolom-k1-beton\',\n      recommendedFloorLevel: 1,\n      confidence: \'Tinggi\',\n      sourceLocation: \'Denah Lantai 1 Grid A-D\',\n      identificationReason: \'Terbaca 12 titik Kolom K1 40/40 pada denah struktur\',\n      extractedParameters: { lebar: 0.4, panjang: 0.4, tinggi: 4.0, jumlah: 12 },\n      missingParameters: [],\n      notes: \'Dimensi tertulis jelas\',\n    },\n  ],\n  \'fl-1\',\n  \'Denah_Struktur_Lt1.pdf\'\n);\nconst updatedAiWork = aiRes.updatedProject.works.find(\n  w => w.floorId === \'fl-1\' && w.catalogId === \'str-kolom-k1-beton\'\n);\nconsole.log(\'10. Asisten AI Auto Takeoff pada Pekerjaan USC -> Volume terhitung:\', updatedAiWork?.calculatedVolume, \'| Status:\', updatedAiWork?.status);\nif (updatedAiWork?.calculatedVolume !== 7.68) {\n  throw new Error(\'Test 10 gagal: Asisten AI tidak terhubung ke pekerjaan USC\');\n}\n\nconsole.log(\'=== SELURUH 10 POIN PENGUJIAN LULUS 100% ===\');\n\""
