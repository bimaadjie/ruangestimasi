            }
            lines {
              text: "    floorRule: \'fondasi_saja\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    description: \'Pengurugan kembali sisa volume galian tanah di sisi pondasi.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    defaultUnit: \'m\302\263\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'Volume Galian Total \303\267 3\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelSheet: \'Volume Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelCell: \'U22 (Formula =U16/3)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelFormula: \'=U16/3\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationNotes: \'Sesuai standar teknis USC: volume urug kembali diasumsikan 1/3 volume galian.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'volume_galian\', name: \'volume_galian\', label: \'Volume Galian Tanah Total\', value: null, unit: \'m\302\263\', required: true, excelCellRef: \'U16\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const v = params[\'volume_galian\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (v == null || isNaN(v)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return v / 3;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'str-urugan-pasir-bawah-pondasi\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    code: \'STR-TNH-04\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    name: \'Pengurugan Pasir Bawah Pondasi (Tebal 5 cm)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    category: \'Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    subCategory: \'Pekerjaan Tanah dan Urugan\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    floorRule: \'fondasi_saja\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    description: \'Lapisan pasir urug padat di bawah pasangan batu belah atau footplat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    defaultUnit: \'m\302\263\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'Panjang \303\227 Lebar \303\227 Tebal Pasir (0.05 m)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelSheet: \'Volume Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelCell: \'U26 (Formula =M26*K26*I26)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelFormula: \'=M26*K26*I26\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationNotes: \'M26 = tebal urugan pasir (0.05m).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'panjang\', name: \'panjang\', label: \'Panjang Pondasi (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I26\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar\', name: \'lebar\', label: \'Lebar Lapisan (L)\', value: null, unit: \'m\', required: true, excelCellRef: \'K26\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tebal\', name: \'tebal\', label: \'Tebal Pasir (T)\', value: 0.05, unit: \'m\', required: true, excelCellRef: \'M26\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const p = params[\'panjang\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const l = params[\'lebar\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t = params[\'tebal\'] ?? 0.05;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (p == null || l == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return p * l * t;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'str-pasangan-batu-belah-1sp6pp\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    code: \'STR-PON-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    name: \'Pemasangan Pondasi Batu Belah 1SP : 6PP\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    category: \'Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    subCategory: \'Pekerjaan Pondasi\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    floorRule: \'fondasi_saja\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    description: \'Pondasi batu kali/belah penampang trapesium.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    defaultUnit: \'m\302\263\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'Tinggi \303\227 0.5 \303\227 (Lebar Atas + Lebar Bawah) \303\227 Panjang Total\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelSheet: \'Volume Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelCell: \'U32 (Formula =I32*(1/2*(K32+M32))*S32)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelFormula: \'=I32*(1/2*(K32+M32))*S32\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationNotes: \'Rumus penampang trapesium pondasi batu kali.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Pondasi (T)\', value: null, unit: \'m\', required: true, excelCellRef: \'I32\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_atas\', name: \'lebar_atas\', label: \'Lebar Atas Pondasi (La)\', value: null, unit: \'m\', required: true, excelCellRef: \'K32\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_bawah\', name: \'lebar_bawah\', label: \'Lebar Bawah Pondasi (Lb)\', value: null, unit: \'m\', required: true, excelCellRef: \'M32\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total (S)\', value: null, unit: \'m\', required: true, excelCellRef: \'S32\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t = params[\'tinggi\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const la = params[\'lebar_atas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const lb = params[\'lebar_bawah\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const s = params[\'panjang_total\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (t == null || la == null || lb == null || s == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return t * (0.5 * (la + lb)) * s;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'str-pondasi-footplat-beton\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    code: \'STR-PON-02\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    name: \'Pondasi Footplat - Beton K-350\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    category: \'Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    subCategory: \'Pekerjaan Pondasi\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    floorRule: \'fondasi_saja\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    description: \'Volume beton telapak footplat (bagian limas trapesium + bagian balok bawah).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    defaultUnit: \'m\302\263\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'[(I + J)/2 \303\227 K \303\227 T1 \303\227 Jml] + [I \303\227 K \303\227 T2 \303\227 Jml]\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelSheet: \'Volume Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelCell: \'U37 (Formula =SUM(U35:U36))\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelFormula: \'=SUM(U35:U36)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationNotes: \'Terdiri dari Bagian 1 (kemiringan limas) dan Bagian 2 (persegi tebal telapak).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_alas\', name: \'lebar_alas\', label: \'Dimensi Alas (P & L)\', value: null, unit: \'m\', required: true, excelCellRef: \'I35\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_atas\', name: \'lebar_atas\', label: \'Dimensi Atas Limas (J)\', value: null, unit: \'m\', required: true, excelCellRef: \'J35\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tebal_limas\', name: \'tebal_limas\', label: \'Tebal Kemiringan Limas (T1)\', value: null, unit: \'m\', required: true, excelCellRef: \'M35\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tebal_alas\', name: \'tebal_alas\', label: \'Tebal Blok Bawah (T2)\', value: null, unit: \'m\', required: true, excelCellRef: \'M36\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Pondasi (Jml)\', value: null, unit: \'titik\', required: true, excelCellRef: \'O35\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const ia = params[\'lebar_alas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const ja = params[\'lebar_atas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t1 = params[\'tebal_limas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t2 = params[\'tebal_alas\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const jml = params[\'jumlah_titik\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (ia == null || ja == null || t1 == null || t2 == null || jml == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vBagian1 = ((ia + ja) / 2) * ia * t1 * jml;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vBagian2 = ia * ia * t2 * jml;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return vBagian1 + vBagian2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'str-pondasi-footplat-tulangan\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    code: \'STR-PON-03\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    name: \'Pondasi Footplat - Pembesian Tulangan D19\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    category: \'Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    subCategory: \'Pekerjaan Pondasi\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    floorRule: \'fondasi_saja\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    description: \'Berat besi tulangan anyaman atas dan bawah footplat D19 jarak 150 mm.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    defaultUnit: \'kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'2 \303\227 [(Panjang / Jarak) \303\227 Jml \303\227 Berat Jenis \303\227 (Panjang + 2\303\227Kait)]\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelSheet: \'Volume Struktural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelCell: \'U38 & U39 (Formula =(I38/0.15)*O38*T38*(((K38-0.08)+(M38-0.08)*2)))\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelFormula: \'=(I38/0.15)*O38*T38*(((K38-0.08)+(M38-0.08)*2))\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationNotes: \'Dihitung untuk tulangan atas dan bawah (faktor 2\303\227). BJ D19 = 2.23 kg/m.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'panjang_bentang\', name: \'panjang_bentang\', label: \'Panjang Bentang Telapak (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I38\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tinggi_tekukan\', name: \'tinggi_tekukan\', label: \'Tinggi Tekukan Kait (M)\', value: null, unit: \'m\', required: true, excelCellRef: \'M38\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Pondasi\', value: null, unit: \'titik\', required: true, excelCellRef: \'O38\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jarak_sengkang\', name: \'jarak_sengkang\', label: \'Jarak Antar Tulangan\', value: 0.15, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per meter (BJ)\', value: 2.23, unit: \'kg/m\', required: true, excelCellRef: \'T38\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const p = params[\'panjang_bentang\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const m = params[\'tinggi_tekukan\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const n = params[\'jumlah_titik\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const s = params[\'jarak_sengkang\'] || 0.15;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const bj = params[\'berat_jenis\'] || 2.23;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (p == null || m == null || n == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Rumus Excel USC: (p / s) * n * bj * ((p - 0.08) + (m - 0.08)*2)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const satuLapis = (p / s) * n * bj * ((p - 0.08) + (m - 0.08) * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return satuLapis * 2; // Atas & Bawah"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
