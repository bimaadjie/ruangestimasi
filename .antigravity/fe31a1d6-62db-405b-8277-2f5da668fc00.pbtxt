    content: "/**\n * RuangRAB - Type Definitions\n * Quantity Takeoff & Konstruksi Volume Calculator\n */\n\nexport type WorkCategory = \'Persiapan Dll\' | \'Struktural\' | \'Arsitektural\' | \'MEP\';\n\nexport type CalculationStatus =\n  | \'Lengkap\'\n  | \'Belum Lengkap\'\n  | \'Perlu Input\'\n  | \'Draf AI \342\200\224 Perlu Verifikasi\'\n  | \'Perlu Verifikasi\'\n  | \'Rumus Perlu Dikonfigurasi\'\n  | \'Rumus Belum Dipetakan\'\n  | \'Kesalahan Perhitungan\'\n  | \'Tidak Digunakan\';\n\nexport type ParameterType = \'number\' | \'text\' | \'select\';\n\nexport type DrawingUnit = \'mm\' | \'cm\' | \'m\';\n\nexport type DrawingScale =\n  | \'1:20\'\n  | \'1:50\'\n  | \'1:75\'\n  | \'1:100\'\n  | \'1:150\'\n  | \'1:200\'\n  | \'custom\'\n  | \'unknown\';\n\nexport interface ParameterConflict {\n  newValue: number;\n  rawExtractedValue: number;\n  rawUnit: DrawingUnit;\n  sourceDocument: string;\n  pageOrLocation?: string;\n}\n\nexport interface ParameterItem {\n  id: string;\n  name: string;\n  label: string;\n  value: number | string | null;\n  unit: string;\n  type?: ParameterType;\n  required?: boolean;\n  source?: \'manual\' | \'ai\' | \'derived\' | \'reference\';\n  sourceDocument?: string;\n  pageOrLocation?: string;\n  rawExtractedValue?: number;\n  rawUnit?: DrawingUnit;\n  isVerified?: boolean;\n  conflict?: ParameterConflict | null;\n  notes?: string;\n  excelCellRef?: string; // Disimpan secara internal, tidak ditampilkan di UI\n}\n\nexport interface WorkComponent {\n  id: string;\n  name: string; // e.g., \"Bagian 1\", \"Balok B1\", \"Dinding Depan\"\n  parameters: Record<string, number | null>;\n  formulaText?: string;\n  computedVolume?: number | null;\n}\n\nexport interface CatalogWorkItem {\n  id: string;\n  code?: string;\n  name: string;\n  category: WorkCategory;\n  subCategory?: string;\n  floorRule: \'umum\' | \'per_lantai\' | \'atap_saja\' | \'fondasi_saja\';\n  description: string;\n  defaultUnit: string;\n  formulaDisplay: string;\n  customFormula?: string;\n  isCustomCatalog?: boolean;\n  excelSheet: string; // Internal metadata\n  excelCell: string; // Internal metadata\n  excelFormula?: string; // Internal metadata\n  parameters: ParameterItem[];\n  defaultComponents?: WorkComponent[];\n  calculationMethod: (params: Record<string, number>, components?: WorkComponent[]) => number | null;\n  verificationStatus: CalculationStatus;\n  verificationNotes?: string;\n  hasExternalRef?: boolean;\n}\n\nexport interface ProjectWorkItem {\n  id: string;\n  catalogId?: string;\n  dedupKey?: string; // Kunci stabil pencegahan duplikasi (floorId + catalogId + elementLocation)\n  name: string;\n  category: WorkCategory;\n  subCategory?: string;\n  floorId: string; // \"fl-umum\" atau floorId\n  elementLocation?: string; // Lokasi / As / Ruang dari gambar\n  unit: string;\n  formulaDisplay: string;\n  parameters: ParameterItem[];\n  components: WorkComponent[];\n  calculatedVolume: number | null;\n  status: CalculationStatus;\n  statusMessage?: string;\n  origin?: \'manual\' | \'ai\';\n  aiVerificationStatus?: \'draft\' | \'verified\' | \'rejected\';\n  sourceDocument?: string;\n  identificationReason?: string;\n  excelSheet?: string; // Internal metadata\n  excelCell?: string; // Internal metadata\n  excelFormula?: string; // Internal metadata\n  customFormula?: string;\n  notes?: string;\n  isActive: boolean;\n  lastUpdated?: string;\n}\n\nexport interface FloorItem {\n  id: string;\n  name: string; // e.g. \"Lantai 1\", \"Lantai 2\", \"Lantai 3\", \"Rooftop\", \"Basement\", \"Umum\"\n  level: number; // 0 for umum/pondasi, 1 for Lantai 1, etc.\n  elevation?: string; // e.g. \"+ 0.00 m\", \"+ 4.00 m\"\n  description?: string;\n}\n\nexport interface ProjectData {\n  id: string;\n  name: string;\n  location?: string;\n  description?: string;\n  createdAt: string;\n  updatedAt: string;\n  floorCount: number;\n  floors: FloorItem[];\n  works: ProjectWorkItem[];\n  rejectedDraftKeys?: string[]; // Daftar dedupKey draf AI yang pernah ditolak/dihapus pengguna\n  catalogVersion: string;\n}\n\nexport interface AIExtractionItem {\n  id: string;\n  targetCategory: string;\n  suggestedWorkName: string;\n  catalogId?: string; // ID template katalog yang cocok\n  parameterId?: string; // ID parameter pada katalog (panjang, lebar, tinggi, luas_lantai, dll)\n  parameterName: string;\n  rawExtractedValue: number; // Nilai angka dimensi tertulis pada gambar (misal 300, 600, 1270)\n  rawUnit: DrawingUnit; // Satuan dimensi gambar (mm, cm, m)\n  explicitUnitOnDrawing?: string; // Jika pada gambar tertulis satuan eksplisit berbeda\n  convertedValue: number; // Nilai hasil konversi standar kalkulator (misal 3.00 m)\n  convertedUnit: string; // Satuan kalkulator (m, m\302\262, m\302\263, unit, buah)\n  confidence: number; // 0 to 1\n  sourceDocument: string;\n  pageOrLocation?: string;\n  notes?: string;\n  userCorrection?: number;\n  status: \'pending\' | \'approved\' | \'rejected\' | \'applied\';\n  targetWorkId?: string;\n  targetParamId?: string;\n  isRecommendationOnly?: boolean; // True jika hanya rekomendasi lanjutan (bukan terdeteksi eksplisit)\n}\n\nexport interface AIAutoTakeoffSummary {\n  documentSummary: string;\n  drawingType: \'arsitektur_denah\' | \'struktur_denah\' | \'potongan_detail\' | \'lainnya\';\n  identifiedFloor: string;\n  identifiedScale: string;\n  extractedCount: number;\n  createdDraftWorksCount: number;\n  updatedExistingWorksCount: number;\n  incompleteWorksCount: number;\n  conflictCount: number;\n  recommendations: {\n    catalogId: string;\n    name: string;\n    category: WorkCategory;\n    reason: string;\n  }[];\n}\n"
    num_lines: 182
