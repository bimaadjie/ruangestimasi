              text: "                className=\"px-4 py-2 font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-xs transition cursor-pointer\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Hapus {selectedWorkIds.size} Pekerjaan"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </button>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      )}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    </div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
          }
        }
        absolute_uri: "file:///src/components/WorkTable.tsx"
      }
    }
    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  Plus,\n  ChevronDown,\n  ChevronRight,\n  MoreVertical,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Copy,\n  Trash2,\n  Layers,\n  Sparkles,\n  Check,\n  Pencil,\n  AlertTriangle,\n  FileText,\n  X,\n} from \'lucide-react\';\nimport { FloorItem, ProjectWorkItem, WorkCategory } from \'../types\';\nimport { formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface WorkTableProps {\n  works: ProjectWorkItem[];\n  floors: FloorItem[];\n  onOpenWorkDetail: (work: ProjectWorkItem) => void;\n  onOpenAddWork: (floorId?: string) => void;\n  onDeleteWork: (workId: string) => void;\n  onDuplicateWork: (work: ProjectWorkItem) => void;\n  onToggleActive: (workId: string) => void;\n  onApproveDraftWork?: (workId: string) => void;\n  onApproveAllReadyDrafts?: () => void;\n  activeStatusFilter?: \'all\' | \'ai_draft\' | \'incomplete\';\n  onStatusFilterChange?: (filter: \'all\' | \'ai_draft\' | \'incomplete\') => void;\n}\n\nexport const WorkTable: React.FC<WorkTableProps> = ({\n  works,\n  floors,\n  onOpenWorkDetail,\n  onOpenAddWork,\n  onDeleteWork,\n  onDuplicateWork,\n  onToggleActive,\n  onApproveDraftWork,\n  onApproveAllReadyDrafts,\n  activeStatusFilter = \'all\',\n  onStatusFilterChange,\n}) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'Semua\');\n  const [localStatusFilter, setLocalStatusFilter] = useState<\'all\' | \'ai_draft\' | \'incomplete\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [collapsedFloors, setCollapsedFloors] = useState<Record<string, boolean>>({});\n  const [openActionMenuId, setOpenActionMenuId] = useState<string | null>(null);\n  const [workToDelete, setWorkToDelete] = useState<ProjectWorkItem | null>(null);\n\n  const effectiveStatusFilter = onStatusFilterChange ? activeStatusFilter : localStatusFilter;\n  const setStatusFilter = (val: \'all\' | \'ai_draft\' | \'incomplete\') => {\n    if (onStatusFilterChange) {\n      onStatusFilterChange(val);\n    } else {\n      setLocalStatusFilter(val);\n    }\n  };\n\n  const categories: string[] = [\'Semua\', \'Persiapan Dll\', \'Struktural\', \'Arsitektural\', \'MEP\'];\n\n  const toggleFloorCollapse = (floorId: string) => {\n    setCollapsedFloors((prev) => ({\n      ...prev,\n      [floorId]: !prev[floorId],\n    }));\n  };\n\n  // Hitung statistik Draf AI aktif\n  const activeDraftWorks = works.filter(\n    (w) => w.isActive && w.origin === \'ai\' && w.aiVerificationStatus === \'draft\'\n  );\n  const readyDraftWorks = activeDraftWorks.filter((w) => w.calculatedVolume !== null);\n  const incompleteDraftWorks = activeDraftWorks.filter((w) => w.calculatedVolume === null);\n\n  // Filter works by category, status filter, and search text\n  const filteredWorks = works.filter((w) => {\n    const matchCategory = selectedCategory === \'Semua\' || w.category === selectedCategory;\n    const isAiDraft = w.origin === \'ai\' && w.aiVerificationStatus === \'draft\';\n    const isIncomplete =\n      w.status === \'Belum Lengkap\' || w.status === \'Perlu Input\' || w.calculatedVolume === null;\n\n    const matchStatus =\n      effectiveStatusFilter === \'all\' ||\n      (effectiveStatusFilter === \'ai_draft\' && isAiDraft) ||\n      (effectiveStatusFilter === \'incomplete\' && isIncomplete);\n\n    const matchSearch =\n      searchQuery.trim() === \'\' ||\n      w.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (w.formulaDisplay && w.formulaDisplay.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (w.elementLocation && w.elementLocation.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (w.sourceDocument && w.sourceDocument.toLowerCase().includes(searchQuery.toLowerCase()));\n    return matchCategory && matchStatus && matchSearch;\n  });\n\n  // Group works by floor\n  const worksByFloor: Record<string, ProjectWorkItem[]> = {};\n  for (const floor of floors) {\n    worksByFloor[floor.id] = [];\n  }\n\n  for (const work of filteredWorks) {\n    if (!worksByFloor[work.floorId]) {\n      worksByFloor[work.floorId] = [];\n    }\n    worksByFloor[work.floorId].push(work);\n  }\n\n  // Helper status badge\n  const renderStatusBadge = (work: ProjectWorkItem) => {\n    const hasConflict = work.parameters.some((p) => Boolean(p.conflict));\n    if (hasConflict) {\n      return (\n        <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200\">\n          <AlertTriangle className=\"w-3 h-3 text-rose-600 shrink-0\" />\n          Konflik Ukuran\n        </span>\n      );\n    }\n\n    switch (work.status) {\n      case \'Lengkap\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200\">\n            <CheckCircle2 className=\"w-3 h-3 text-emerald-600 shrink-0\" />\n            Terverifikasi\n          </span>\n        );\n      case \'Draf AI \342\200\224 Perlu Verifikasi\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200\">\n            <Sparkles className=\"w-3 h-3 text-blue-600 shrink-0\" />\n            Draf AI\n          </span>\n        );\n      case \'Belum Lengkap\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-300\">\n            <AlertCircle className=\"w-3 h-3 text-amber-600 shrink-0\" />\n            Belum Lengkap\n          </span>\n        );\n      case \'Perlu Input\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200\">\n            <Clock className=\"w-3 h-3 text-amber-600 shrink-0\" />\n            Perlu Input\n          </span>\n        );\n      case \'Perlu Verifikasi\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200\">\n            <AlertCircle className=\"w-3 h-3 text-indigo-600 shrink-0\" />\n            Perlu Verifikasi\n          </span>\n        );\n      default:\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200\">\n            {work.status}\n          </span>\n        );\n    }\n  };\n\n  const getCategoryBadgeClass = (cat: WorkCategory) => {\n    switch (cat) {\n      case \'Persiapan Dll\':\n        return \'bg-blue-50 text-blue-700 border-blue-100\';\n      case \'Struktural\':\n        return \'bg-indigo-50 text-indigo-700 border-indigo-100\';\n      case \'Arsitektural\':\n        return \'bg-teal-50 text-teal-700 border-teal-100\';\n      case \'MEP\':\n        return \'bg-purple-50 text-purple-700 border-purple-100\';\n      default:\n        return \'bg-slate-50 text-slate-700 border-slate-100\';\n    }\n  };\n\n  return (\n    <div\n      id=\"work-table-container\"\n      className=\"bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden scroll-mt-6\"\n    >\n      {/* AI Draft Banner when unverified AI works exist */}\n      {activeDraftWorks.length > 0 && (\n        <div className=\"px-5 py-3.5 bg-gradient-to-r from-blue-50 via-indigo-50/70 to-blue-50 border-b border-blue-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex items-start gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-2xs\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <h4 className=\"text-xs font-bold text-blue-950\">\n                  {activeDraftWorks.length} Draf Pekerjaan Hasil Analisis AI Menunggu Verifikasi\n                </h4>\n                {readyDraftWorks.length > 0 && (\n                  <span className=\"px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-100 text-emerald-800\">\n                    {readyDraftWorks.length} Siap Disetujui\n                  </span>\n                )}\n                {incompleteDraftWorks.length > 0 && (\n                  <span className=\"px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800\">\n                    {incompleteDraftWorks.length} Belum Lengkap\n                  </span>\n                )}\n              </div>\n              <p className=\"text-[11px] text-slate-600 mt-0.5\">\n                Volume draf AI baru akan masuk ke total rekap bangunan setelah Anda menyetujuinya.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 shrink-0 self-end sm:self-center\">\n            {readyDraftWorks.length > 0 && onApproveAllReadyDrafts && (\n              <button\n                type=\"button\"\n                onClick={onApproveAllReadyDrafts}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl transition shadow-2xs cursor-pointer\"\n              >\n                <Check className=\"w-3.5 h-3.5\" />\n                <span>Setujui Semua yang Lengkap ({readyDraftWorks.length})</span>\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Top Filter and Search Bar */}\n      <div className=\"p-5 border-b border-slate-100\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900 leading-tight\">\n              Daftar Pekerjaan &amp; Volume\n            </h3>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Kelola parameter, verifikasi rumus volume teknis, dan setujui draf AI per kelompok lantai.\n            </p>\n          </div>\n\n          {/* Search Box */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"relative w-full sm:w-64\">\n              <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n              <input\n                type=\"text\"\n                placeholder=\"Cari pekerjaan atau lokasi...\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                className=\"w-full pl-9 pr-3 py-1.5 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Filter Tabs (Category + Status Quick Filter) */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 mt-4\">\n          <div className=\"flex items-center gap-2 overflow-x-auto pb-1\">\n            {categories.map((cat) => {\n              const isSelected = selectedCategory === cat;\n              return (\n                <button\n                  key={cat}\n                  onClick={() => setSelectedCategory(cat)}\n                  className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all shrink-0 cursor-pointer ${\n                    isSelected\n                      ? \'bg-blue-600 text-white shadow-2xs\'\n                      : \'bg-slate-100/80 text-slate-600 hover:bg-slate-200/70 hover:text-slate-900\'\n                  }`}\n                >\n                  {cat}\n                </button>\n              );\n            })}\n          </div>\n\n          <div className=\"flex items-center gap-1.5 text-xs\">\n            <button\n              onClick={() => setStatusFilter(\'all\')}\n              className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${\n                effectiveStatusFilter === \'all\'\n                  ? \'bg-slate-800 text-white\'\n                  : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n              }`}\n            >\n              Semua Status\n            </button>\n            {activeDraftWorks.length > 0 && (\n              <button\n                onClick={() =>\n                  setStatusFilter(effectiveStatusFilter === \'ai_draft\' ? \'all\' : \'ai_draft\')\n                }\n                className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold transition cursor-pointer ${\n                  effectiveStatusFilter === \'ai_draft\'\n                    ? \'bg-blue-600 text-white\'\n                    : \'bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100\'\n                }`}\n              >\n                <Sparkles className=\"w-3 h-3\" />\n                Draf AI ({activeDraftWorks.length})\n              </button>\n            )}\n            <button\n              onClick={() =>\n                setStatusFilter(effectiveStatusFilter === \'incomplete\' ? \'all\' : \'incomplete\')\n              }\n              className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${\n                effectiveStatusFilter === \'incomplete\'\n                  ? \'bg-amber-600 text-white\'\n                  : \'bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100\'\n              }`}\n            >\n              Perlu Input / Belum Lengkap\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Grouped Table View with horizontal scroll protection */}\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full min-w-[780px] text-left text-xs border-collapse\">\n          <thead>\n            <tr className=\"bg-slate-50/80 text-slate-600 font-semibold border-b border-slate-200/80 select-none\">\n              <th className=\"py-3 px-4 w-12 text-center\">No</th>\n              <th className=\"py-3 px-4 min-w-[220px]\">Pekerjaan</th>\n              <th className=\"py-3 px-3 w-28\">Kategori</th>\n              <th className=\"py-3 px-4 min-w-[180px]\">Parameter / Rumus</th>\n              <th className=\"py-3 px-3 w-16 text-center\">Satuan</th>\n              <th className=\"py-3 px-4 w-28 text-right\">Volume</th>\n              <th className=\"py-3 px-4 w-36 text-center\">Status</th>\n              <th className=\"py-3 px-4 w-40 text-right\">Aksi</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {floors.map((floor) => {\n              const floorWorks = worksByFloor[floor.id] || [];\n              const isCollapsed = collapsedFloors[floor.id] ?? false;\n\n              if (\n                floorWorks.length === 0 &&\n                (selectedCategory !== \'Semua\' || effectiveStatusFilter !== \'all\' || searchQuery.trim() !== \'\')\n              ) {\n                return null;\n              }\n\n              return (\n                <React.Fragment key={floor.id}>\n                  {/* Floor Group Header Accordion with Dedicated \"+ Tambah Pekerjaan\" Button for this Floor */}\n                  <tr className=\"bg-slate-100/75 border-t border-slate-200/90 select-none\">\n                    <td colSpan={8} className=\"py-2.5 px-4 font-bold text-slate-800\">\n                      <div className=\"flex items-center justify-between gap-3\">\n                        {/* Floor Toggle Title */}\n                        <div\n                          onClick={() => toggleFloorCollapse(floor.id)}\n                          className=\"flex items-center gap-2 cursor-pointer hover:text-blue-700 transition flex-1\"\n                        >\n                          {isCollapsed ? (\n                            <ChevronRight className=\"w-4 h-4 text-slate-500\" />\n                          ) : (\n                            <ChevronDown className=\"w-4 h-4 text-slate-500\" />\n                          )}\n                          <Layers className=\"w-3.5 h-3.5 text-blue-600\" />\n                          <span className=\"font-bold text-slate-900\">{floor.name}</span>\n                          {floor.elevation && (\n                            <span className=\"text-[11px] text-slate-500 font-mono font-normal\">\n                              ({floor.elevation})\n                            </span>\n                          )}\n                          <span className=\"text-[11px] font-semibold text-slate-500 bg-white border border-slate-200 rounded-md px-2 py-0.5 shadow-2xs ml-1\">\n                            {floorWorks.length} pekerjaan\n                          </span>\n                        </div>\n\n                        {/* Dedicated \"+ Tambah Pekerjaan\" in this Floor Header */}\n                        <button\n                          type=\"button\"\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            onOpenAddWork(floor.id);\n                          }}\n                          className=\"inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-bold text-blue-700 bg-white hover:bg-blue-50 border border-blue-200 rounded-lg transition shadow-2xs shrink-0 cursor-pointer\"\n                          title={`Tambah pekerjaan ke ${floor.name}`}\n                        >\n                          <Plus className=\"w-3.5 h-3.5\" />\n                          <span>+ Tambah Pekerjaan ({floor.name})</span>\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n\n                  {/* Floor Work Rows */}\n                  {!isCollapsed &&\n                    floorWorks.map((work, idx) => {\n                      const isAiDraft =\n                        work.origin === \'ai\' && work.aiVerificationStatus === \'draft\';\n                      const hasConflict = work.parameters.some((p) => Boolean(p.conflict));\n\n                      return (\n                        <tr\n                          key={work.id}\n                          className={`hover:bg-blue-50/30 transition-colors group ${\n                            !work.isActive\n                              ? \'opacity-50 bg-slate-50/50\'\n                              : isAiDraft\n                              ? \'bg-blue-50/15\'\n                              : \'\'\n                          }`}\n                        >\n                          {/* No */}\n                          <td className=\"py-3 px-4 text-center text-slate-400 font-medium font-mono\">\n                            {idx + 1}\n                          </td>\n\n                          {/* Pekerjaan */}\n                          <td className=\"py-3 px-4\">\n                            <div className=\"flex items-start gap-2\">\n                              <div className=\"min-w-0 flex-1\">\n                                <button\n                                  onClick={() => onOpenWorkDetail(work)}\n                                  className=\"text-left font-semibold text-slate-900 hover:text-blue-600 block transition focus:outline-none cursor-pointer\"\n                                >\n                                  {work.name}\n                                </button>\n\n                                {/* Sub-info: AI Source, Location, or Missing Parameter Hint */}\n                                <div className=\"flex flex-wrap items-center gap-1.5 mt-1\">\n                                  {work.origin === \'ai\' && (\n                                    <span className=\"inline-flex items-center gap-1 text-[10px] font-medium text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100\">\n                                      <FileText className=\"w-2.5 h-2.5\" />\n                                      {work.sourceDocument || \'Gambar AI\'}\n                                    </span>\n                                  )}\n                                  {work.elementLocation && (\n                                    <span className=\"text-[10px] text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded\">\n                                      Lokasi: {work.elementLocation}\n                                    </span>\n                                  )}\n                                </div>\n\n                                {(work.status === \'Belum Lengkap\' ||\n                                  work.status === \'Perlu Input\' ||\n                                  hasConflict) &&\n                                  work.statusMessage && (\n                                    <p\n                                      className={`text-[10px] mt-1 leading-snug ${\n                                        hasConflict ? \'text-rose-600 font-medium\' : \'text-amber-700\'\n                                      }`}\n                                    >\n                                      {work.statusMessage}\n                                    </p>\n                                  )}\n                              </div>\n                            </div>\n                          </td>\n\n                          {/* Kategori */}\n                          <td className=\"py-3 px-3\">\n                            <span\n                              className={`inline-block px-2 py-0.5 text-[10px] font-semibold rounded-md border ${getCategoryBadgeClass(\n                                work.category\n                              )}`}\n                            >\n                              {work.category}\n                            </span>\n                          </td>\n\n                          {/* Parameter / Rumus */}\n                          <td className=\"py-3 px-4\">\n                            <span className=\"font-mono text-[11px] text-slate-700 block truncate max-w-xs\">\n                              {work.formulaDisplay}\n                            </span>\n                            <div className=\"flex flex-wrap items-center gap-1.5 mt-1 text-[10px] text-slate-500\">\n                              {work.parameters.slice(0, 3).map((p) => (\n                                <span\n                                  key={p.id}\n                                  className={`px-1.5 py-0.5 rounded ${\n                                    p.value !== null\n                                      ? p.source === \'ai\'\n                                        ? \'bg-blue-50 text-blue-700 font-medium\'\n                                        : \'bg-slate-100 text-slate-700\'\n                                      : \'bg-amber-50 text-amber-800 font-medium border border-amber-200\'\n                                  }`}\n                                >\n                                  {p.label || p.name}:{\' \'}\n                                  {p.value !== null ? `${p.value} ${p.unit}` : \'(kosong)\'}\n                                </span>\n                              ))}\n                              {work.parameters.length > 3 && (\n                                <span className=\"text-slate-400\">\n                                  +{work.parameters.length - 3} lainnya\n                                </span>\n                              )}\n                            </div>\n                          </td>\n\n                          {/* Satuan */}\n                          <td className=\"py-3 px-3 text-center font-mono text-slate-700 font-semibold\">\n                            {work.unit}\n                          </td>\n\n                          {/* Volume */}\n                          <td className=\"py-3 px-4 text-right\">\n                            {work.calculatedVolume !== null ? (\n                              <div>\n                                <span className=\"font-bold text-slate-900 font-mono text-xs\">\n                                  {formatIndonesianNumber(work.calculatedVolume)}\n                                </span>\n                                {isAiDraft && (\n                                  <span className=\"text-[10px] text-blue-600 block font-medium\">\n                                    (Draf)\n                                  </span>\n                                )}\n                              </div>\n                            ) : (\n                              <span className=\"text-slate-400 font-mono\">-</span>\n                            )}\n                          </td>\n\n                          {/* Status */}\n                          <td className=\"py-3 px-4 text-center\">{renderStatusBadge(work)}</td>\n\n                          {/* Aksi (Direct Edit, Approve, Delete + More Menu) */}\n                          <td className=\"py-3 px-4 text-right relative\">\n                            <div className=\"inline-flex items-center justify-end gap-1\">\n                              {isAiDraft &&\n                                work.calculatedVolume !== null &&\n                                !hasConflict &&\n                                onApproveDraftWork && (\n                                  <button\n                                    onClick={() => onApproveDraftWork(work.id)}\n                                    title=\"Setujui Draf Pekerjaan AI\"\n                                    className=\"inline-flex items-center gap-1 px-2 py-1 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-semibold transition shadow-2xs cursor-pointer\"\n                                  >\n                                    <Check className=\"w-3 h-3\" />\n                                    <span>Setujui</span>\n                                  </button>\n                                )}\n\n                              <button\n                                onClick={() => onOpenWorkDetail(work)}\n                                title=\"Edit Parameter & Rumus Pekerjaan\"\n                                className=\"inline-flex items-center gap-1 px-2 py-1 rounded-md border border-slate-200 bg-white hover:bg-blue-50 hover:border-blue-200 text-slate-700 hover:text-blue-700 text-[11px] font-medium transition cursor-pointer\"\n                              >\n                                <Pencil className=\"w-3 h-3\" />\n                                <span>Edit</span>\n                              </button>\n\n                              <button\n                                onClick={() => setWorkToDelete(work)}\n                                title=\"Hapus Pekerjaan dari Kalkulator\"\n                                className=\"p-1.5 rounded-md border border-slate-200 bg-white hover:bg-rose-50 hover:border-rose-200 text-slate-400 hover:text-rose-600 transition cursor-pointer\"\n                              >\n                                <Trash2 className=\"w-3.5 h-3.5\" />\n                              </button>\n\n                              <div className=\"relative inline-block text-left\">\n                                <button\n                                  onClick={(e) => {\n                                    e.stopPropagation();\n                                    setOpenActionMenuId(\n                                      openActionMenuId === work.id ? null : work.id\n                                    );\n                                  }}\n                                  className=\"p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-700 transition cursor-pointer\"\n                                  title=\"Menu Lainnya\"\n                                >\n                                  <MoreVertical className=\"w-4 h-4\" />\n                                </button>\n\n                                {openActionMenuId === work.id && (\n                                  <div\n                                    onClick={(e) => e.stopPropagation()}\n                                    className=\"absolute right-0 top-full mt-1 w-44 bg-white border border-slate-200 rounded-xl shadow-lg z-30 py-1 text-xs\"\n                                  >\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        onDuplicateWork(work);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600 flex items-center gap-2 transition\"\n                                    >\n                                      <Copy className=\"w-3.5 h-3.5 text-slate-400\" />\n                                      <span>Duplikasi Pekerjaan</span>\n                                    </button>\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        onToggleActive(work.id);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition\"\n                                    >\n                                      <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n                                      <span>{work.isActive ? \'Nonaktifkan\' : \'Aktifkan\'}</span>\n                                    </button>\n                                    <div className=\"h-px bg-slate-100 my-1\" />\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        setWorkToDelete(work);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition\"\n                                    >\n                                      <Trash2 className=\"w-3.5 h-3.5\" />\n                                      <span>Hapus Pekerjaan</span>\n                                    </button>\n                                  </div>\n                                )}\n                              </div>\n                            </div>\n                          </td>\n                        </tr>\n                      );\n                    })}\n\n                  {/* Bottom Floor Row: Quick \"+ Tambah Pekerjaan di [Nama Lantai]\" */}\n                  {!isCollapsed && (\n                    <tr className=\"bg-slate-50/30 hover:bg-slate-50/70 border-b border-slate-200/60\">\n                      <td colSpan={8} className=\"py-2 px-4 text-center\">\n                        <button\n                          type=\"button\"\n                          onClick={() => onOpenAddWork(floor.id)}\n                          className=\"inline-flex items-center gap-1.5 text-xs text-blue-600 hover:text-blue-800 font-semibold py-1 px-3 rounded-lg hover:bg-blue-50 transition cursor-pointer\"\n                        >\n                          <Plus className=\"w-3.5 h-3.5\" />\n                          <span>+ Tambah Pekerjaan di {floor.name}</span>\n                        </button>\n                      </td>\n                    </tr>\n                  )}\n                </React.Fragment>\n              );\n            })}\n          </tbody>\n        </table>\n      </div>\n\n      {filteredWorks.length === 0 && (\n        <div className=\"p-12 text-center text-xs text-slate-500\">\n          <p className=\"font-semibold text-slate-700\">Tidak ada pekerjaan yang cocok.</p>\n          <p className=\"mt-1\">Coba sesuaikan kata kunci pencarian atau ubah filter kategori/status.</p>\n        </div>\n      )}\n\n      {/* Confirmation Modal for deleting work */}\n      {workToDelete && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in duration-150\">\n          <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-md p-5 space-y-4\">\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-10 h-10 rounded-xl bg-rose-50 text-rose-600 border border-rose-100 flex items-center justify-center shrink-0\">\n                <Trash2 className=\"w-5 h-5\" />\n              </div>\n              <div className=\"min-w-0 flex-1\">\n                <h4 className=\"text-sm font-bold text-slate-900 leading-tight\">\n                  Hapus Pekerjaan dari Kalkulator?\n                </h4>\n                <p className=\"text-xs text-slate-600 mt-1.5 leading-relaxed\">\n                  Pekerjaan <strong>\"{workToDelete.name}\"</strong> akan dihapus dari kalkulator proyek aktif. Template katalog asli tetap tersimpan dan tidak terhapus.\n                </p>\n                {workToDelete.origin === \'ai\' && (\n                  <p className=\"text-[11px] text-blue-700 bg-blue-50 border border-blue-100 rounded-lg p-2 mt-2\">\n                    Catatan: Draf AI ini ditandai telah dihapus sehingga analisis ulang dokumen yang sama tidak akan membuatnya kembali secara otomatis.\n                  </p>\n                )}\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-slate-100 text-xs\">\n              <button\n                type=\"button\"\n                onClick={() => setWorkToDelete(null)}\n                className=\"px-4 py-2 font-semibold text-slate-600 hover:text-slate-900 rounded-xl transition cursor-pointer\"\n              >\n                Batal\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  onDeleteWork(workToDelete.id);\n                  setWorkToDelete(null);\n                }}\n                className=\"px-4 py-2 font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-xs transition cursor-pointer\"\n              >\n                Hapus Pekerjaan\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  Plus,\n  ChevronDown,\n  ChevronRight,\n  MoreVertical,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Copy,\n  Trash2,\n  Layers,\n  Sparkles,\n  Check,\n  Pencil,\n  AlertTriangle,\n  FileText,\n  RotateCcw,\n  CheckSquare,\n  Square,\n  Info,\n} from \'lucide-react\';\nimport { FloorItem, ProjectWorkItem, WorkCategory } from \'../types\';\nimport { formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface WorkTableProps {\n  works: ProjectWorkItem[];\n  floors: FloorItem[];\n  onOpenWorkDetail: (work: ProjectWorkItem) => void;\n  onOpenAddWork: (floorId?: string) => void;\n  onDeleteWork: (workId: string) => void;\n  onDeleteMultipleWorks?: (workIds: string[]) => void;\n  onRestoreDeletedWorks?: () => void;\n  recentlyDeletedCount?: number;\n  onRestoreStandardFloorWorks?: (floorId: string) => void;\n  onDuplicateWork: (work: ProjectWorkItem) => void;\n  onToggleActive: (workId: string) => void;\n  onApproveDraftWork?: (workId: string) => void;\n  onApproveAllReadyDrafts?: () => void;\n  activeStatusFilter?: \'all\' | \'ai_draft\' | \'incomplete\';\n  onStatusFilterChange?: (filter: \'all\' | \'ai_draft\' | \'incomplete\') => void;\n}\n\nexport const WorkTable: React.FC<WorkTableProps> = ({\n  works,\n  floors,\n  onOpenWorkDetail,\n  onOpenAddWork,\n  onDeleteWork,\n  onDeleteMultipleWorks,\n  onRestoreDeletedWorks,\n  recentlyDeletedCount = 0,\n  onRestoreStandardFloorWorks,\n  onDuplicateWork,\n  onToggleActive,\n  onApproveDraftWork,\n  onApproveAllReadyDrafts,\n  activeStatusFilter = \'all\',\n  onStatusFilterChange,\n}) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'Semua\');\n  const [localStatusFilter, setLocalStatusFilter] = useState<\n    \'all\' | \'belum_diisi\' | \'tidak_lengkap\' | \'perlu_verifikasi\' | \'terverifikasi\'\n  >(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [collapsedFloors, setCollapsedFloors] = useState<Record<string, boolean>>({});\n  const [openActionMenuId, setOpenActionMenuId] = useState<string | null>(null);\n  const [workToDelete, setWorkToDelete] = useState<ProjectWorkItem | null>(null);\n\n  // Multi-select checkboxes for bulk deletion\n  const [selectedWorkIds, setSelectedWorkIds] = useState<Set<string>>(new Set());\n  const [showBulkDeleteConfirm, setShowBulkDeleteConfirm] = useState<boolean>(false);\n\n  const categories: string[] = [\'Semua\', \'Persiapan Dll\', \'Struktural\', \'Arsitektural\', \'MEP\'];\n\n  const toggleFloorCollapse = (floorId: string) => {\n    setCollapsedFloors((prev) => ({\n      ...prev,\n      [floorId]: !prev[floorId],\n    }));\n  };\n\n  const toggleSelectWork = (workId: string) => {\n    setSelectedWorkIds((prev) => {\n      const next = new Set(prev);\n      if (next.has(workId)) {\n        next.delete(workId);\n      } else {\n        next.add(workId);\n      }\n      return next;\n    });\n  };\n\n  const toggleSelectFloorWorks = (floorWorks: ProjectWorkItem[]) => {\n    if (floorWorks.length === 0) return;\n    const allSelected = floorWorks.every((w) => selectedWorkIds.has(w.id));\n    setSelectedWorkIds((prev) => {\n      const next = new Set(prev);\n      if (allSelected) {\n        floorWorks.forEach((w) => next.delete(w.id));\n      } else {\n        floorWorks.forEach((w) => next.add(w.id));\n      }\n      return next;\n    });\n  };\n\n  // Hitung statistik Draf AI aktif\n  const activeDraftWorks = works.filter(\n    (w) =>\n      w.isActive &&\n      (w.aiVerificationStatus === \'draft\' ||\n        w.status === \'Perlu Verifikasi\' ||\n        w.status === \'Draf AI \342\200\224 Perlu Verifikasi\')\n  );\n  const readyDraftWorks = activeDraftWorks.filter((w) => w.calculatedVolume !== null);\n  const incompleteDraftWorks = activeDraftWorks.filter((w) => w.calculatedVolume === null);\n\n  // Filter works by category, status filter, and search text\n  const filteredWorks = works.filter((w) => {\n    const matchCategory = selectedCategory === \'Semua\' || w.category === selectedCategory;\n\n    const isBelumDiisi = w.status === \'Belum Diisi\' || w.status === \'Perlu Input\';\n    const isTidakLengkap = w.status === \'Tidak Lengkap\' || w.status === \'Belum Lengkap\';\n    const isPerluVerifikasi =\n      w.status === \'Perlu Verifikasi\' ||\n      w.status === \'Draf AI \342\200\224 Perlu Verifikasi\' ||\n      w.aiVerificationStatus === \'draft\' ||\n      w.parameters.some((p) => Boolean(p.conflict));\n    const isTerverifikasi =\n      (w.status === \'Terverifikasi\' || w.status === \'Lengkap\') &&\n      w.calculatedVolume !== null &&\n      w.aiVerificationStatus !== \'draft\';\n\n    let matchStatus = true;\n    if (localStatusFilter === \'belum_diisi\') {\n      matchStatus = isBelumDiisi;\n    } else if (localStatusFilter === \'tidak_lengkap\') {\n      matchStatus = isTidakLengkap;\n    } else if (localStatusFilter === \'perlu_verifikasi\') {\n      matchStatus = isPerluVerifikasi;\n    } else if (localStatusFilter === \'terverifikasi\') {\n      matchStatus = isTerverifikasi;\n    } else if (activeStatusFilter === \'ai_draft\') {\n      matchStatus = isPerluVerifikasi;\n    } else if (activeStatusFilter === \'incomplete\') {\n      matchStatus = isBelumDiisi || isTidakLengkap;\n    }\n\n    const matchSearch =\n      searchQuery.trim() === \'\' ||\n      w.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (w.formulaDisplay && w.formulaDisplay.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (w.elementLocation && w.elementLocation.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (w.sourceDocument && w.sourceDocument.toLowerCase().includes(searchQuery.toLowerCase()));\n    return matchCategory && matchStatus && matchSearch;\n  });\n\n  // Group works by floor\n  const worksByFloor: Record<string, ProjectWorkItem[]> = {};\n  for (const floor of floors) {\n    worksByFloor[floor.id] = [];\n  }\n\n  for (const work of filteredWorks) {\n    if (!worksByFloor[work.floorId]) {\n      worksByFloor[work.floorId] = [];\n    }\n    worksByFloor[work.floorId].push(work);\n  }\n\n  // Helper status badge\n  const renderStatusBadge = (work: ProjectWorkItem) => {\n    const hasConflict = work.parameters.some((p) => Boolean(p.conflict));\n    if (hasConflict) {\n      return (\n        <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200\">\n          <AlertTriangle className=\"w-3 h-3 text-rose-600 shrink-0\" />\n          Perlu Verifikasi (Konflik)\n        </span>\n      );\n    }\n\n    switch (work.status) {\n      case \'Terverifikasi\':\n      case \'Lengkap\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200\">\n            <CheckCircle2 className=\"w-3 h-3 text-emerald-600 shrink-0\" />\n            Terverifikasi\n          </span>\n        );\n      case \'Perlu Verifikasi\':\n      case \'Draf AI \342\200\224 Perlu Verifikasi\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200\">\n            <Sparkles className=\"w-3 h-3 text-blue-600 shrink-0\" />\n            Perlu Verifikasi\n          </span>\n        );\n      case \'Tidak Lengkap\':\n      case \'Belum Lengkap\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-300\">\n            <AlertCircle className=\"w-3 h-3 text-amber-600 shrink-0\" />\n            Tidak Lengkap\n          </span>\n        );\n      case \'Belum Diisi\':\n      case \'Perlu Input\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200\">\n            <Clock className=\"w-3 h-3 text-slate-500 shrink-0\" />\n            Belum Diisi\n          </span>\n        );\n      default:\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200\">\n            {work.status}\n          </span>\n        );\n    }\n  };\n\n  const getCategoryBadgeClass = (cat: WorkCategory) => {\n    switch (cat) {\n      case \'Persiapan Dll\':\n        return \'bg-blue-50 text-blue-700 border-blue-100\';\n      case \'Struktural\':\n        return \'bg-indigo-50 text-indigo-700 border-indigo-100\';\n      case \'Arsitektural\':\n        return \'bg-teal-50 text-teal-700 border-teal-100\';\n      case \'MEP\':\n        return \'bg-purple-50 text-purple-700 border-purple-100\';\n      default:\n        return \'bg-slate-50 text-slate-700 border-slate-100\';\n    }\n  };\n\n  return (\n    <div\n      id=\"work-table-container\"\n      className=\"bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden scroll-mt-6\"\n    >\n      {/* Guidance Banner for Default Works */}\n      <div className=\"px-5 py-3 bg-blue-50/70 border-b border-blue-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs\">\n        <div className=\"flex items-start gap-2.5 text-blue-950\">\n          <Info className=\"w-4 h-4 text-blue-600 shrink-0 mt-0.5\" />\n          <p className=\"leading-relaxed\">\n            Daftar pekerjaan standar telah disiapkan untuk membantu proses estimasi. Silakan hapus pekerjaan yang tidak diperlukan dan lengkapi parameter sesuai gambar proyek Anda.\n          </p>\n        </div>\n\n        {recentlyDeletedCount > 0 && onRestoreDeletedWorks && (\n          <button\n            type=\"button\"\n            onClick={onRestoreDeletedWorks}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-blue-50 text-blue-700 border border-blue-200 font-bold text-[11px] transition shrink-0 shadow-2xs cursor-pointer\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            <span>Pulihkan Pekerjaan Terhapus ({recentlyDeletedCount})</span>\n          </button>\n        )}\n      </div>\n\n      {/* AI Draft Banner when unverified AI works exist */}\n      {activeDraftWorks.length > 0 && (\n        <div className=\"px-5 py-3.5 bg-gradient-to-r from-blue-50 via-indigo-50/70 to-blue-50 border-b border-blue-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex items-start gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-2xs\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <h4 className=\"text-xs font-bold text-blue-950\">\n                  {activeDraftWorks.length} Pekerjaan Hasil Analisis AI Menunggu Verifikasi\n                </h4>\n                {readyDraftWorks.length > 0 && (\n                  <span className=\"px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-100 text-emerald-800\">\n                    {readyDraftWorks.length} Siap Disetujui\n                  </span>\n                )}\n                {incompleteDraftWorks.length > 0 && (\n                  <span className=\"px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800\">\n                    {incompleteDraftWorks.length} Tidak Lengkap\n                  </span>\n                )}\n              </div>\n              <p className=\"text-[11px] text-slate-600 mt-0.5\">\n                Volume hasil AI baru akan masuk ke total rekap bangunan setelah Anda menyetujuinya.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 shrink-0 self-end sm:self-center\">\n            {readyDraftWorks.length > 0 && onApproveAllReadyDrafts && (\n              <button\n                type=\"button\"\n                onClick={onApproveAllReadyDrafts}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl transition shadow-2xs cursor-pointer\"\n              >\n                <Check className=\"w-3.5 h-3.5\" />\n                <span>Setujui Semua yang Lengkap ({readyDraftWorks.length})</span>\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Bulk Selection Action Bar */}\n      {selectedWorkIds.size > 0 && (\n        <div className=\"px-5 py-3 bg-rose-50/80 border-b border-rose-200 flex flex-wrap items-center justify-between gap-3 text-xs animate-in fade-in duration-150\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"w-6 h-6 rounded-full bg-rose-600 text-white font-bold flex items-center justify-center text-[11px]\">\n              {selectedWorkIds.size}\n            </span>\n            <span className=\"font-bold text-rose-950\">\n              {selectedWorkIds.size} pekerjaan dipilih pada proyek ini\n            </span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => setSelectedWorkIds(new Set())}\n              className=\"px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-slate-900 font-semibold transition cursor-pointer\"\n            >\n              Batalkan Pilihan\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setShowBulkDeleteConfirm(true)}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-bold shadow-2xs transition cursor-pointer\"\n            >\n              <Trash2 className=\"w-3.5 h-3.5\" />\n              <span>Hapus Pekerjaan Terpilih ({selectedWorkIds.size})</span>\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Top Filter and Search Bar */}\n      <div className=\"p-5 border-b border-slate-100\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900 leading-tight\">\n              Daftar Pekerjaan &amp; Volume\n            </h3>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Kelola parameter, verifikasi rumus volume teknis, atau hapus pekerjaan yang tidak diperlukan per lantai.\n            </p>\n          </div>\n\n          {/* Search Box */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"relative w-full sm:w-64\">\n              <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n              <input\n                type=\"text\"\n                placeholder=\"Cari pekerjaan atau lokasi...\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                className=\"w-full pl-9 pr-3 py-1.5 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Filter Tabs (Category + Status Quick Filter) */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 mt-4\">\n          <div className=\"flex items-center gap-2 overflow-x-auto pb-1\">\n            {categories.map((cat) => {\n              const isSelected = selectedCategory === cat;\n              return (\n                <button\n                  key={cat}\n                  onClick={() => setSelectedCategory(cat)}\n                  className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all shrink-0 cursor-pointer ${\n                    isSelected\n                      ? \'bg-blue-600 text-white shadow-2xs\'\n                      : \'bg-slate-100/80 text-slate-600 hover:bg-slate-200/70 hover:text-slate-900\'\n                  }`}\n                >\n                  {cat}\n                </button>\n              );\n            })}\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-1.5 text-xs\">\n            <button\n              onClick={() => {\n                setLocalStatusFilter(\'all\');\n                if (onStatusFilterChange) onStatusFilterChange(\'all\');\n              }}\n              className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${\n                localStatusFilter === \'all\'\n                  ? \'bg-slate-800 text-white\'\n                  : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n              }`}\n            >\n              Semua Status\n            </button>\n            <button\n              onClick={() =>\n                setLocalStatusFilter(localStatusFilter === \'belum_diisi\' ? \'all\' : \'belum_diisi\')\n              }\n              className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${\n                localStatusFilter === \'belum_diisi\'\n                  ? \'bg-slate-700 text-white\'\n                  : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n              }`}\n            >\n              Belum Diisi\n            </button>\n            <button\n              onClick={() =>\n                setLocalStatusFilter(\n                  localStatusFilter === \'tidak_lengkap\' ? \'all\' : \'tidak_lengkap\'\n                )\n              }\n              className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${\n                localStatusFilter === \'tidak_lengkap\'\n                  ? \'bg-amber-600 text-white\'\n                  : \'bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100\'\n              }`}\n            >\n              Tidak Lengkap\n            </button>\n            <button\n              onClick={() =>\n                setLocalStatusFilter(\n                  localStatusFilter === \'perlu_verifikasi\' ? \'all\' : \'perlu_verifikasi\'\n                )\n              }\n              className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold transition cursor-pointer ${\n                localStatusFilter === \'perlu_verifikasi\'\n                  ? \'bg-blue-600 text-white\'\n                  : \'bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100\'\n              }`}\n            >\n              <Sparkles className=\"w-3 h-3\" />\n              Perlu Verifikasi ({activeDraftWorks.length})\n            </button>\n            <button\n              onClick={() =>\n                setLocalStatusFilter(\n                  localStatusFilter === \'terverifikasi\' ? \'all\' : \'terverifikasi\'\n                )\n              }\n              className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${\n                localStatusFilter === \'terverifikasi\'\n                  ? \'bg-emerald-600 text-white\'\n                  : \'bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100\'\n              }`}\n            >\n              Terverifikasi\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Grouped Table View with horizontal scroll protection */}\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full min-w-[820px] text-left text-xs border-collapse\">\n          <thead>\n            <tr className=\"bg-slate-50/80 text-slate-600 font-semibold border-b border-slate-200/80 select-none\">\n              <th className=\"py-3 px-3 w-10 text-center\">Pilih</th>\n              <th className=\"py-3 px-3 w-10 text-center\">No</th>\n              <th className=\"py-3 px-4 min-w-[210px]\">Pekerjaan</th>\n              <th className=\"py-3 px-3 w-28\">Kategori</th>\n              <th className=\"py-3 px-4 min-w-[180px]\">Parameter / Rumus</th>\n              <th className=\"py-3 px-3 w-16 text-center\">Satuan</th>\n              <th className=\"py-3 px-4 w-28 text-right\">Volume</th>\n              <th className=\"py-3 px-4 w-36 text-center\">Status</th>\n              <th className=\"py-3 px-4 w-40 text-right\">Aksi</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {floors.map((floor) => {\n              const floorWorks = worksByFloor[floor.id] || [];\n              const isCollapsed = collapsedFloors[floor.id] ?? false;\n\n              if (\n                floorWorks.length === 0 &&\n                (selectedCategory !== \'Semua\' ||\n                  localStatusFilter !== \'all\' ||\n                  searchQuery.trim() !== \'\')\n              ) {\n                return null;\n              }\n\n              const allFloorSelected =\n                floorWorks.length > 0 && floorWorks.every((w) => selectedWorkIds.has(w.id));\n\n              return (\n                <React.Fragment key={floor.id}>\n                  {/* Floor Group Header Accordion with Dedicated \"+ Tambah Pekerjaan\" Button for this Floor */}\n                  <tr className=\"bg-slate-100/75 border-t border-slate-200/90 select-none\">\n                    <td colSpan={9} className=\"py-2.5 px-4 font-bold text-slate-800\">\n                      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n                        <div className=\"flex items-center gap-2.5 flex-1 min-w-0\">\n                          {/* Select all works in this floor */}\n                          {floorWorks.length > 0 && (\n                            <button\n                              type=\"button\"\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                toggleSelectFloorWorks(floorWorks);\n                              }}\n                              title={`Pilih semua pekerjaan di ${floor.name}`}\n                              className=\"text-slate-500 hover:text-blue-600 transition cursor-pointer\"\n                            >\n                              {allFloorSelected ? (\n                                <CheckSquare className=\"w-4 h-4 text-blue-600\" />\n                              ) : (\n                                <Square className=\"w-4 h-4\" />\n                              )}\n                            </button>\n                          )}\n\n                          {/* Floor Toggle Title */}\n                          <div\n                            onClick={() => toggleFloorCollapse(floor.id)}\n                            className=\"flex items-center gap-2 cursor-pointer hover:text-blue-700 transition flex-1 min-w-0\"\n                          >\n                            {isCollapsed ? (\n                              <ChevronRight className=\"w-4 h-4 text-slate-500 shrink-0\" />\n                            ) : (\n                              <ChevronDown className=\"w-4 h-4 text-slate-500 shrink-0\" />\n                            )}\n                            <Layers className=\"w-3.5 h-3.5 text-blue-600 shrink-0\" />\n                            <span className=\"font-bold text-slate-900 truncate\">{floor.name}</span>\n                            {floor.elevation && (\n                              <span className=\"text-[11px] text-slate-500 font-mono font-normal shrink-0\">\n                                ({floor.elevation})\n                              </span>\n                            )}\n                            <span className=\"text-[11px] font-semibold text-slate-500 bg-white border border-slate-200 rounded-md px-2 py-0.5 shadow-2xs ml-1 shrink-0\">\n                              {floorWorks.length} pekerjaan\n                            </span>\n                          </div>\n                        </div>\n\n                        <div className=\"flex items-center gap-2 shrink-0\">\n                          {onRestoreStandardFloorWorks && (\n                            <button\n                              type=\"button\"\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                onRestoreStandardFloorWorks(floor.id);\n                              }}\n                              className=\"inline-flex items-center gap-1 px-2.5 py-1 text-[11px] font-semibold text-slate-600 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg transition shadow-2xs cursor-pointer\"\n                              title={`Kembalikan daftar pekerjaan standar yang belum ada di ${floor.name}`}\n                            >\n                              <RotateCcw className=\"w-3 h-3 text-slate-500\" />\n                              <span className=\"hidden sm:inline\">Muat Pekerjaan Standar</span>\n                            </button>\n                          )}\n\n                          {/* Dedicated \"+ Tambah Pekerjaan\" in this Floor Header */}\n                          <button\n                            type=\"button\"\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              onOpenAddWork(floor.id);\n                            }}\n                            className=\"inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-bold text-blue-700 bg-white hover:bg-blue-50 border border-blue-200 rounded-lg transition shadow-2xs shrink-0 cursor-pointer\"\n                            title={`Tambah pekerjaan ke ${floor.name}`}\n                          >\n                            <Plus className=\"w-3.5 h-3.5\" />\n                            <span>+ Tambah Pekerjaan ({floor.name})</span>\n                          </button>\n                        </div>\n                      </div>\n                    </td>\n                  </tr>\n\n                  {/* Floor Work Rows */}\n                  {!isCollapsed &&\n                    floorWorks.map((work, idx) => {\n                      const isAiDraft =\n                        work.aiVerificationStatus === \'draft\' ||\n                        work.status === \'Perlu Verifikasi\' ||\n                        work.status === \'Draf AI \342\200\224 Perlu Verifikasi\';\n                      const hasConflict = work.parameters.some((p) => Boolean(p.conflict));\n                      const isSelected = selectedWorkIds.has(work.id);\n                      const filledParams = work.parameters.filter(\n                        (p) => p.value !== null && p.value !== \'\'\n                      );\n\n                      return (\n                        <tr\n                          key={work.id}\n                          className={`hover:bg-blue-50/30 transition-colors group ${\n                            !work.isActive\n                              ? \'opacity-50 bg-slate-50/50\'\n                              : isSelected\n                              ? \'bg-blue-50/40\'\n                              : isAiDraft\n                              ? \'bg-blue-50/15\'\n                              : \'\'\n                          }`}\n                        >\n                          {/* Checkbox */}\n                          <td className=\"py-3 px-3 text-center\">\n                            <button\n                              type=\"button\"\n                              onClick={() => toggleSelectWork(work.id)}\n                              className=\"text-slate-400 hover:text-blue-600 transition cursor-pointer\"\n                              title=\"Pilih pekerjaan\"\n                            >\n                              {isSelected ? (\n                                <CheckSquare className=\"w-4 h-4 text-blue-600\" />\n                              ) : (\n                                <Square className=\"w-4 h-4\" />\n                              )}\n                            </button>\n                          </td>\n\n                          {/* No */}\n                          <td className=\"py-3 px-3 text-center text-slate-400 font-medium font-mono\">\n                            {idx + 1}\n                          </td>\n\n                          {/* Pekerjaan */}\n                          <td className=\"py-3 px-4\">\n                            <div className=\"flex items-start gap-2\">\n                              <div className=\"min-w-0 flex-1\">\n                                <button\n                                  onClick={() => onOpenWorkDetail(work)}\n                                  className=\"text-left font-semibold text-slate-900 hover:text-blue-600 block transition focus:outline-none cursor-pointer\"\n                                >\n                                  {work.name}\n                                </button>\n\n                                {/* Sub-info: AI Source, Location, or Missing Parameter Hint */}\n                                <div className=\"flex flex-wrap items-center gap-1.5 mt-1\">\n                                  {work.origin === \'ai\' && (\n                                    <span className=\"inline-flex items-center gap-1 text-[10px] font-medium text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100\">\n                                      <FileText className=\"w-2.5 h-2.5\" />\n                                      {work.sourceDocument || \'Gambar AI\'}\n                                    </span>\n                                  )}\n                                  {work.elementLocation && (\n                                    <span className=\"text-[10px] text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded\">\n                                      Lokasi: {work.elementLocation}\n                                    </span>\n                                  )}\n                                </div>\n\n                                {(work.status === \'Tidak Lengkap\' ||\n                                  work.status === \'Belum Lengkap\' ||\n                                  hasConflict) &&\n                                  work.statusMessage && (\n                                    <p\n                                      className={`text-[10px] mt-1 leading-snug ${\n                                        hasConflict ? \'text-rose-600 font-medium\' : \'text-amber-700\'\n                                      }`}\n                                    >\n                                      {work.statusMessage}\n                                    </p>\n                                  )}\n                              </div>\n                            </div>\n                          </td>\n\n                          {/* Kategori */}\n                          <td className=\"py-3 px-3\">\n                            <span\n                              className={`inline-block px-2 py-0.5 text-[10px] font-semibold rounded-md border ${getCategoryBadgeClass(\n                                work.category\n                              )}`}\n                            >\n                              {work.category}\n                            </span>\n                          </td>\n\n                          {/* Parameter / Rumus */}\n                          <td className=\"py-3 px-4\">\n                            <span className=\"font-mono text-[11px] text-slate-700 block truncate max-w-xs\">\n                              {work.formulaDisplay}\n                            </span>\n                            {filledParams.length === 0 ? (\n                              <span className=\"inline-block mt-1 px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-500 border border-slate-200\">\n                                Parameter: Kosong\n                              </span>\n                            ) : (\n                              <div className=\"flex flex-wrap items-center gap-1.5 mt-1 text-[10px] text-slate-500\">\n                                {work.parameters.slice(0, 3).map((p) => (\n                                  <span\n                                    key={p.id}\n                                    className={`px-1.5 py-0.5 rounded ${\n                                      p.value !== null\n                                        ? p.source === \'ai\'\n                                          ? \'bg-blue-50 text-blue-700 font-medium\'\n                                          : \'bg-slate-100 text-slate-700\'\n                                        : \'bg-amber-50 text-amber-800 font-medium border border-amber-200\'\n                                    }`}\n                                  >\n                                    {p.label || p.name}:{\' \'}\n                                    {p.value !== null ? `${p.value} ${p.unit}` : \'Kosong\'}\n                                  </span>\n                                ))}\n                                {work.parameters.length > 3 && (\n                                  <span className=\"text-slate-400\">\n                                    +{work.parameters.length - 3} lainnya\n                                  </span>\n                                )}\n                              </div>\n                            )}\n                          </td>\n\n                          {/* Satuan */}\n                          <td className=\"py-3 px-3 text-center font-mono text-slate-700 font-semibold\">\n                            {work.unit}\n                          </td>\n\n                          {/* Volume */}\n                          <td className=\"py-3 px-4 text-right\">\n                            {work.calculatedVolume !== null ? (\n                              <div>\n                                <span className=\"font-bold text-slate-900 font-mono text-xs\">\n                                  {formatIndonesianNumber(work.calculatedVolume)}\n                                </span>\n                                {isAiDraft && (\n                                  <span className=\"text-[10px] text-blue-600 block font-medium\">\n                                    (Perlu Verifikasi)\n                                  </span>\n                                )}\n                              </div>\n                            ) : (\n                              <span className=\"text-slate-400 font-mono\">\342\200\224</span>\n                            )}\n                          </td>\n\n                          {/* Status */}\n                          <td className=\"py-3 px-4 text-center\">{renderStatusBadge(work)}</td>\n\n                          {/* Aksi (Direct Edit, Approve, Delete + More Menu) */}\n                          <td className=\"py-3 px-4 text-right relative\">\n                            <div className=\"inline-flex items-center justify-end gap-1\">\n                              {isAiDraft &&\n                                work.calculatedVolume !== null &&\n                                !hasConflict &&\n                                onApproveDraftWork && (\n                                  <button\n                                    onClick={() => onApproveDraftWork(work.id)}\n                                    title=\"Setujui Pekerjaan AI\"\n                                    className=\"inline-flex items-center gap-1 px-2 py-1 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-semibold transition shadow-2xs cursor-pointer\"\n                                  >\n                                    <Check className=\"w-3 h-3\" />\n                                    <span>Setujui</span>\n                                  </button>\n                                )}\n\n                              <button\n                                onClick={() => onOpenWorkDetail(work)}\n                                title=\"Edit Nama, Parameter & Rumus Pekerjaan\"\n                                className=\"inline-flex items-center gap-1 px-2 py-1 rounded-md border border-slate-200 bg-white hover:bg-blue-50 hover:border-blue-200 text-slate-700 hover:text-blue-700 text-[11px] font-medium transition cursor-pointer\"\n                              >\n                                <Pencil className=\"w-3 h-3\" />\n                                <span>Edit</span>\n                              </button>\n\n                              <button\n                                onClick={() => setWorkToDelete(work)}\n                                title=\"Hapus Pekerjaan dari Kalkulator\"\n                                className=\"p-1.5 rounded-md border border-slate-200 bg-white hover:bg-rose-50 hover:border-rose-200 text-slate-400 hover:text-rose-600 transition cursor-pointer\"\n                              >\n                                <Trash2 className=\"w-3.5 h-3.5\" />\n                              </button>\n\n                              <div className=\"relative inline-block text-left\">\n                                <button\n                                  onClick={(e) => {\n                                    e.stopPropagation();\n                                    setOpenActionMenuId(\n                                      openActionMenuId === work.id ? null : work.id\n                                    );\n                                  }}\n                                  className=\"p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-700 transition cursor-pointer\"\n                                  title=\"Menu Lainnya\"\n                                >\n                                  <MoreVertical className=\"w-4 h-4\" />\n                                </button>\n\n                                {openActionMenuId === work.id && (\n                                  <div\n                                    onClick={(e) => e.stopPropagation()}\n                                    className=\"absolute right-0 top-full mt-1 w-44 bg-white border border-slate-200 rounded-xl shadow-lg z-30 py-1 text-xs\"\n                                  >\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        onDuplicateWork(work);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600 flex items-center gap-2 transition\"\n                                    >\n                                      <Copy className=\"w-3.5 h-3.5 text-slate-400\" />\n                                      <span>Duplikasi Pekerjaan</span>\n                                    </button>\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        onToggleActive(work.id);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition\"\n                                    >\n                                      <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n                                      <span>{work.isActive ? \'Nonaktifkan\' : \'Aktifkan\'}</span>\n                                    </button>\n                                    <div className=\"h-px bg-slate-100 my-1\" />\n                                    <button\n                                      onClick={() => {\n                                        setOpenActionMenuId(null);\n                                        setWorkToDelete(work);\n                                      }}\n                                      className=\"w-full text-left px-3 py-2 text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition\"\n                                    >\n                                      <Trash2 className=\"w-3.5 h-3.5\" />\n                                      <span>Hapus Pekerjaan</span>\n                                    </button>\n                                  </div>\n                                )}\n                              </div>\n                            </div>\n                          </td>\n                        </tr>\n                      );\n                    })}\n\n                  {/* Bottom Floor Row: Quick \"+ Tambah Pekerjaan di [Nama Lantai]\" */}\n                  {!isCollapsed && (\n                    <tr className=\"bg-slate-50/30 hover:bg-slate-50/70 border-b border-slate-200/60\">\n                      <td colSpan={9} className=\"py-2 px-4 text-center\">\n                        <button\n                          type=\"button\"\n                          onClick={() => onOpenAddWork(floor.id)}\n                          className=\"inline-flex items-center gap-1.5 text-xs text-blue-600 hover:text-blue-800 font-semibold py-1 px-3 rounded-lg hover:bg-blue-50 transition cursor-pointer\"\n                        >\n                          <Plus className=\"w-3.5 h-3.5\" />\n                          <span>+ Tambah Pekerjaan di {floor.name}</span>\n                        </button>\n                      </td>\n                    </tr>\n                  )}\n                </React.Fragment>\n              );\n            })}\n          </tbody>\n        </table>\n      </div>\n\n      {filteredWorks.length === 0 && (\n        <div className=\"p-12 text-center text-xs text-slate-500\">\n          <p className=\"font-semibold text-slate-700\">Tidak ada pekerjaan yang cocok.</p>\n          <p className=\"mt-1\">Coba sesuaikan kata kunci pencarian atau ubah filter kategori/status.</p>\n        </div>\n      )}\n\n      {/* Confirmation Modal for deleting a single work */}\n      {workToDelete && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in duration-150\">\n          <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-md p-5 space-y-4\">\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-10 h-10 rounded-xl bg-rose-50 text-rose-600 border border-rose-100 flex items-center justify-center shrink-0\">\n                <Trash2 className=\"w-5 h-5\" />\n              </div>\n              <div className=\"min-w-0 flex-1\">\n                <h4 className=\"text-sm font-bold text-slate-900 leading-tight\">\n                  Hapus Pekerjaan dari Proyek Ini?\n                </h4>\n                <p className=\"text-xs text-slate-600 mt-1.5 leading-relaxed\">\n                  Pekerjaan <strong>\"{workToDelete.name}\"</strong> akan dihapus dari kalkulator proyek aktif. Template di katalog umum dan proyek lain tidak akan terpengaruh.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-slate-100 text-xs\">\n              <button\n                type=\"button\"\n                onClick={() => setWorkToDelete(null)}\n                className=\"px-4 py-2 font-semibold text-slate-600 hover:text-slate-900 rounded-xl transition cursor-pointer\"\n              >\n                Batal\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  onDeleteWork(workToDelete.id);\n                  setSelectedWorkIds((prev) => {\n                    const next = new Set(prev);\n                    next.delete(workToDelete.id);\n                    return next;\n                  });\n                  setWorkToDelete(null);\n                }}\n                className=\"px-4 py-2 font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-xs transition cursor-pointer\"\n              >\n                Hapus Pekerjaan\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Confirmation Modal for Bulk Deletion */}\n      {showBulkDeleteConfirm && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in duration-150\">\n          <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-md p-5 space-y-4\">\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-10 h-10 rounded-xl bg-rose-50 text-rose-600 border border-rose-100 flex items-center justify-center shrink-0\">\n                <Trash2 className=\"w-5 h-5\" />\n              </div>\n              <div className=\"min-w-0 flex-1\">\n                <h4 className=\"text-sm font-bold text-slate-900 leading-tight\">\n                  Hapus {selectedWorkIds.size} Pekerjaan Terpilih?\n                </h4>\n                <p className=\"text-xs text-slate-600 mt-1.5 leading-relaxed\">\n                  Sebanyak <strong>{selectedWorkIds.size} pekerjaan</strong> yang dipilih akan dihapus dari proyek aktif ini. Anda tetap dapat memulihkannya atau menambahkannya kembali dari katalog kapan saja.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-slate-100 text-xs\">\n              <button\n                type=\"button\"\n                onClick={() => setShowBulkDeleteConfirm(false)}\n                className=\"px-4 py-2 font-semibold text-slate-600 hover:text-slate-900 rounded-xl transition cursor-pointer\"\n              >\n                Batal\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  const ids = Array.from(selectedWorkIds);\n                  if (onDeleteMultipleWorks) {\n                    onDeleteMultipleWorks(ids);\n                  } else {\n                    ids.forEach((id) => onDeleteWork(id));\n                  }\n                  setSelectedWorkIds(new Set());\n                  setShowBulkDeleteConfirm(false);\n                }}\n                className=\"px-4 py-2 font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-xs transition cursor-pointer\"\n              >\n                Hapus {selectedWorkIds.size} Pekerjaan\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        start_line: 1
        end_line: 701
      }
