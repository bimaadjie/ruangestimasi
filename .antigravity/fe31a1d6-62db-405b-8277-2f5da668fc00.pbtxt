            }
            lines {
              text: "      if (p == null || m == null || n == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // Rumus Excel USC: (p / s) * n * bj * ((p - 0.08) + (m - 0.08)*2)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const s = params[\'jarak_sengkang\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const bj = params[\'berat_jenis\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (p == null || m == null || n == null || s == null || bj == null || s <= 0) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const satuLapis = (p / s) * n * bj * ((p - 0.08) + (m - 0.08) * 2);"
