      thinking_signature: "\022\303\t\n\300\t\001i\024}\023Rm\034h\006\370\263\203\215\032\263\365\241\375\202\032DF\200\n\341\357\023\326\344\350\033\350\333\377\251\356\030\273\303/\a\312Y\003\366Ww{\301^\255\\l\317\263\342\004n\246~`\355\035t\354\346>4qc\3431\023\213\177r\221kz\365\307a\231,\342pD \350\352\361S_OS\236\201\021\311\230\235\314K\302u\241\313\260#3Z\213W\3262\342o\031\324v\\\1770\032\243\367\320\300D\355l !\225\032\322\356\345\256\033\222\310$kr\277\273\244\3012\313\253\353]%\002\303\320\b\004k.v\216\317\222\263\031\350\033\276\t\006\201\273\255\311E\267\021\221 \352bR8\335\376\024\252\022\222D\254;\220\203\317\223\211\232K\333\223\rLf3\016P\004^67\260\366gl\355\244%D\265\343F!\a0\033\001\265\2666\030\206\244S\225\300\022\374\231\333\026\bP\302\202v\021\351\331\334\270\261~\005\376<9j\347\272\305tcF\202\aWD\246\201>&\313~\315\353<\".\336\342\363\t\277\200\030\275\350\347\225\371\270s\024\337\355r\367\221\034\330\354\265Y\365\312x\326\220\203,\352\327Q\245\003W\253\370g\0048jhn\205\322\202\220\325\321\a\277\023D\325P\006\324\225hH\243\367YD\203(\263X\320\256h\aL\261\2539+\326N4c\200\331ha\"DS\351<a\271\201y\244\001\240\217\254a\234\337)\331TK\315\241!?\206`\305(\270\031\361h\253\t\f\353\336W\320`\024o\215\275\366\302\244\2279x\200\221\252\243\0321\303\035T\025\355\352!r\336z\0303o*\237\201\3608\317m:\276\234\237\267\024\336\307\030\233\343\"\207e[\tP\253\325\372\210D\233\024r\232\364$`\253V\211\370\235\346w`\245g2\017W\210C\253\177\2644\240\307;\337\304\037w<&\3029\253W\317\261\330k\236\016\271\r\372\320f8c\257l\033V\242\322I\327\a/F\257\256\307W\245\344\335\025\332\230\311\230\240\306\004\2051\377\311v\177\215\f\304\025\247\030\003\320k\264\347\005];\r6Y\236e\367\344\274H[\323\341\275b\341\207h/9\316\237\\\277\3752G\210\256\211P1=\016\315#\354U\331\203\213}\357\210f\363Y\r\235\267MMt\250\315\277\276\03118\345\201\224\016\275@\025\221{\320iSJ\v\030;^\222\216\366\375\354\"\232@<\322\341\332e\273>\272\034\320\325\263\330\252J\312\202@\254\354\363\\2\341\006*0\247\"n\227s\227\340\256\250\267WD\212v\300\225\302,b\3736\035\202Xi>H\331\276\314\244\n\0368B\021\030\275i\v\235w&P\035\217Tu\265\277\245\301k@L\275#\211\001\311\r\027\354\030F\t\363\2104i5\247\242y\350\005\316\375\354\245\226+4X\032\340l\352\024\000\242\342\253\362s+\005\033\377\220w(\315\n\2473\206\340\006?\275\2109\241\273\021\237\337\000\366\003u[\245\222P\213\024\244,\023)\001\3113 \344 `\235(\270\315\372\351\223@\356J\363\347\240\320y\221\231\243\344\t\234\341\330\374`t\364J&\207\223\320-\211*7\245I\342\305y|\215\000\240d\337\033mw\215\366\2078\n\322\344\375\340\202\352\246*\201\303\303gR\276\3671N\332\247\3213bT\245nks\266\334\247\205r\036o\246\365\324\206\314P\244\350\200\361\340+\227\375\003\337\200u\251\374[x\275D\226K\323|\323\305\306\r\rV\002\336\v++\214\332+W\346\242\230\216\343\356w>o\201I)rL\241\bE_\233P\321\031C}\377b\236\374\357\tm\274\235\345\177\222\277\241W\277u\342\306b\264\3245\235\330\321\254k\235[\032\222\366hj\330\341\032\234$\262\267\342Gsy\365]:\302d\251\234\325\335Z+e\030\312\210\340A\273!\000\226h\026\372\211\2306\251\205\352\360\352\307y\367q\241\305\263\263\354~r[0\364\225\003\336h<\377\362\350<t&;\266\377H\v`\016\320h\314\207\003\252\375\001\254\3220L[\235\242\332yv\001\347\374\by.\354\244*Ra+\240\321\310D\234#\306\270m$ r\223~\331\020m\246\230\341&\372~\226#\242\310\256~\204\021\023+i\257\224\276;\252\037\341\006\345\274qY9\331\034qr\310\000\241\342[\216;\300\211a\302Q-ys0\253V\020\227U?dy\302 \215\3048\232\016\267\221\357n\264\006\364\330\233>K\343S\377\341\254\206\302_\226"
