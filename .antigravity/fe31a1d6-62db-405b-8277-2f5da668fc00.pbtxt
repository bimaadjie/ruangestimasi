            }
            lines {
              text: "    defaultUnit: \'kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'Panjang Total \303\227 Jumlah Batang \303\227 Berat Jenis\',"
