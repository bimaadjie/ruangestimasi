            }
            lines {
              text: "    subCategory: \'A. Pekerjaan Pasangan Dinding dan Plesteran\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    floorRule: \'per_lantai\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    description: \'Pasangan dinding bata ringan dihitung dari panjang keliling dikali tinggi dinding dikurangi bukaan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    defaultUnit: \'m\302\262\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    formulaDisplay: \'(Panjang Keliling Dinding \303\227 Tinggi Dinding) \342\210\222 Luas Bukaan\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelSheet: \'Volume Arsitektural\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelCell: \'U31\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    excelFormula: \'=M16*I16-SUM(U17:U29)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    verificationStatus: \'Belum Diisi\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'panjang_keliling\', name: \'panjang_keliling\', label: \'Panjang Total Garis Dinding\', placeholder: \'Masukkan total panjang dinding (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tinggi_dinding\', name: \'tinggi_dinding\', label: \'Tinggi Dinding\', placeholder: \'Masukkan tinggi bersih dinding (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan Pintu / Jendela\', placeholder: \'Masukkan luas bukaan jika ada (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan Pintu / Jendela\', placeholder: \'Masukkan luas bukaan jika ada (m\302\262)\', value: null, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const p = params[\'panjang_keliling\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t = params[\'tinggi_dinding\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const b = params[\'luas_bukaan\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (p == null || isNaN(p) || t == null || isNaN(t)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return Math.max(0, p * t - b);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
