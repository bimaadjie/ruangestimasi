            lines {
              text: "      { id: \'lebar_pijakan\', name: \'lebar_pijakan\', label: \'Lebar Pijakan (Antrede)\', placeholder: \'Contoh: 0.30 (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', placeholder: \'Masukkan lebar tangga (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jumlah_trap\', name: \'jumlah_trap\', label: \'Jumlah Trap Anak Tangga\', placeholder: \'Masukkan jumlah trap (buah)\', value: null, unit: \'buah\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Bordes Tangga\', placeholder: \'Masukkan luas bordes (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
