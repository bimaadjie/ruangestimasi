    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst pdfBytes = fs.readFileSync(\"public/assets/aistudio/rencana_1-Model_2ceb7bed.pdf\");\nconst base64 = pdfBytes.toString(\"base64\");\n\nfetch(\"http://localhost:3000/api/gemini/extract-dimensions\", {\n  method: \"POST\",\n  headers: { \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({\n    fileBase64: base64,\n    mimeType: \"application/pdf\",\n    fileName: \"rencana_1-Model.pdf\",\n    floorName: \"Lantai 1\",\n    unitSetting: \"cm\",\n    scaleSetting: \"1:100\"\n  })\n}).then(async r => {\n  console.log(\"Response status:\", r.status);\n  const data = await r.json();\n  console.log(\"Success:\", data.success, \"Model used:\", data.modelUsed);\n  if (data.data) {\n    console.log(\"Summary:\", data.data.documentSummary);\n    console.log(\"Identified floor:\", data.data.identifiedFloor);\n    console.log(\"Items:\", data.data.items?.length);\n    for (const item of (data.data.items || []).slice(0, 5)) {\n      console.log(`- ${item.parameterName} (${item.suggestedWorkName}): raw=${item.rawExtractedValue} ${item.detectedUnit || \"cm\"} | as=${item.pageOrLocation}`);\n    }\n  } else {\n    console.log(\"Error:\", data);\n  }\n}).catch(e => console.error(\"Fetch error:\", e.message));\n\'"
