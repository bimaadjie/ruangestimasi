    content: "      { id: \'jumlah_batang\', name: \'jumlah_batang\', label: \'Jumlah Batang Besi\', placeholder: \'Masukkan jumlah batang (btg)\', value: null, unit: \'btg\', required: true },\n      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per Meter\', placeholder: \'Contoh: 2.23 atau 2.98 (kg/m)\', value: null, unit: \'kg/m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const q = params[\'jumlah_batang\'];\n      const bj = params[\'berat_jenis\'];\n      if (p == null || q == null || bj == null) return null;\n      return p * q * bj;\n    },\n  },\n  {\n    id: \'str-balok-b1-bekisting\',\n    code: \'STR-BLK-10\',\n    name: \'Balok B1 - Bekisting\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok\',\n    floorRule: \'per_lantai\',\n    description: \'Bekisting 2 sisi samping dan 1 sisi bawah balok struktur.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Panjang \303\227 Tinggi \303\227 2) + (Panjang \303\227 Lebar)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U89\',\n    excelFormula: \'=(I89*M89*Q89)+(I89*K89*1)\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Balok\', placeholder: \'Masukkan panjang total balok (m)\', value: null, unit: \'m\', required: true },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Penampang Balok\', placeholder: \'Masukkan lebar balok (m)\', value: null, unit: \'m\', required: true },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Penampang Balok\', placeholder: \'Masukkan tinggi balok (m)\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const l = params[\'lebar\'];\n      const t = params[\'tinggi\'];\n      if (p == null || l == null || t == null) return null;\n      return p * t * 2 + p * l;\n    },\n  },\n\n  // ==========================================\n  // VI. PEKERJAAN STRUKTURAL - PELAT, TANGGA, ATAP\n  // ==========================================\n  {\n    id: \'str-pelat-lantai-beton\',\n    code: \'STR-PLT-01\',\n    name: \'Plat Lantai Beton Bertulang\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Pelat Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Volume beton pelat lantai setelah dikurangi luas bukaan/void.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'((Panjang Pelat \303\227 Lebar Pelat) \342\210\222 Luas Void) \303\227 Tebal Pelat\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U124\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_bangunan\', name: \'panjang_bangunan\', label: \'Panjang Pelat Lantai\', placeholder: \'Masukkan panjang pelat (m)\', value: null, unit: \'m\', required: true },\n      { id: \'lebar_bangunan\', name: \'lebar_bangunan\', label: \'Lebar Pelat Lantai\', placeholder: \'Masukkan lebar pelat (m)\', value: null, unit: \'m\', required: true },\n      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan / Void\', placeholder: \'Masukkan luas void jika ada (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },\n      { id: \'tebal_pelat\', name: \'tebal_pelat\', label: \'Tebal Pelat Lantai\', placeholder: \'Contoh: 0.12 (m)\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_bangunan\'];\n      const l = params[\'lebar_bangunan\'];\n      const voidArea = params[\'luas_bukaan\'] || 0;\n      const t = params[\'tebal_pelat\'];\n      if (p == null || l == null || t == null) return null;\n      const luasBersih = Math.max(0, p * l - voidArea);\n      return luasBersih * t;\n    },\n  },\n  {\n    id: \'str-pelat-lantai-bekisting\',\n    code: \'STR-PLT-02\',\n    name: \'Plat Lantai - Bekisting Bawah\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Pelat Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Bekisting bawah pelat lantai berdasarkan luas bersih lantai.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Panjang Pelat \303\227 Lebar Pelat) \342\210\222 Luas Void/Bukaan\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U133\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_bangunan\', name: \'panjang_bangunan\', label: \'Panjang Pelat Lantai\', placeholder: \'Masukkan panjang pelat (m)\', value: null, unit: \'m\', required: true },\n      { id: \'lebar_bangunan\', name: \'lebar_bangunan\', label: \'Lebar Pelat Lantai\', placeholder: \'Masukkan lebar pelat (m)\', value: null, unit: \'m\', required: true },\n      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan / Void\', placeholder: \'Masukkan luas void jika ada (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_bangunan\'];\n      const l = params[\'lebar_bangunan\'];\n      const voidArea = params[\'luas_bukaan\'] || 0;\n      if (p == null || l == null) return null;\n      return Math.max(0, p * l - voidArea);\n    },\n  },\n  {\n    id: \'str-plat-tangga-beton\',\n    code: \'STR-TGG-01\',\n    name: \'Plat Tangga & Bordes Beton\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Tangga\',\n    floorRule: \'per_lantai\',\n    description: \'Volume beton pelat miring tangga dan pelat bordes.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'(Panjang Miring \303\227 Lebar Tangga \303\227 Tebal Plat) + (Luas Bordes \303\227 Tebal Bordes)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U114\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_miring\', name: \'panjang_miring\', label: \'Panjang Miring Tangga\', placeholder: \'Masukkan panjang miring tangga (m)\', value: null, unit: \'m\', required: true },\n      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', placeholder: \'Masukkan lebar tangga (m)\', value: null, unit: \'m\', required: true },\n      { id: \'tebal_plat\', name: \'tebal_plat\', label: \'Tebal Plat Tangga\', placeholder: \'Masukkan tebal plat tangga (m)\', value: null, unit: \'m\', required: true },\n      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Pelat Bordes\', placeholder: \'Masukkan luas bordes (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },\n      { id: \'tebal_bordes\', name: \'tebal_bordes\', label: \'Tebal Pelat Bordes\', placeholder: \'Masukkan tebal bordes (m)\', value: 0.12, unit: \'m\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const pm = params[\'panjang_miring\'];\n      const l = params[\'lebar_tangga\'];\n      const tp = params[\'tebal_plat\'];\n      const lb = params[\'luas_bordes\'] || 0;\n      const tb = params[\'tebal_bordes\'] || 0.12;\n      if (pm == null || l == null || tp == null) return null;\n      return pm * l * tp + lb * tb;\n    },\n  },\n  {\n    id: \'str-tangga-beton\',\n    code: \'STR-TGG-02\',\n    name: \'Anak Tangga & Bordes Beton\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Tangga\',\n    floorRule: \'per_lantai\',\n    description: \'Volume beton anak tangga (optrede/antrede) dan pelat bordes.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'[(0.5 \303\227 Antrede \303\227 Optrede) \303\227 Jml Anak Tangga \303\227 Lebar] + (Luas Bordes \303\227 Tebal Bordes)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U114\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'antrede\', name: \'antrede\', label: \'Lebar Pijakan (Antrede)\', placeholder: \'Contoh: 0.27 atau 0.30 (m)\', value: null, unit: \'m\', required: true },\n      { id: \'optrede\', name: \'optrede\', label: \'Tinggi Tanjakan (Optrede)\', placeholder: \'Contoh: 0.16 atau 0.18 (m)\', value: null, unit: \'m\', required: true },\n      { id: \'jumlah_anak_tangga\', name: \'jumlah_anak_tangga\', label: \'Jumlah Anak Tangga\', placeholder: \'Masukkan jumlah trap (bh)\', value: null, unit: \'bh\', required: true },\n      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', placeholder: \'Masukkan lebar tangga (m)\', value: null, unit: \'m\', required: true },\n      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Pelat Bordes\', placeholder: \'Masukkan luas bordes (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },\n      { id: \'tebal_bordes\', name: \'tebal_bordes\', label: \'Tebal Pelat Bordes\', placeholder: \'Contoh: 0.12 (m)\', value: 0.12, unit: \'m\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'antrede\'];\n      const o = params[\'optrede\'];\n      const n = params[\'jumlah_anak_tangga\'];\n      const w = params[\'lebar_tangga\'];\n      const lb = params[\'luas_bordes\'] || 0;\n      const tb = params[\'tebal_bordes\'] || 0.12;\n      if (a == null || o == null || n == null || w == null) return null;\n      const vAnakTangga = 0.5 * a * o * n * w;\n      const vBordes = lb * tb;\n      return vAnakTangga + vBordes;\n    },\n  },\n  {\n    id: \'str-atap-baja-ringan\',\n    code: \'STR-ATP-01\',\n    name: \'Pemasangan Rangka Atap Baja Ringan\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Atap dan Penutup Atap\',\n    floorRule: \'atap_saja\',\n    description: \'Rangka kuda-kuda dan reng baja ringan.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Panjang Bidang Atap \303\227 Lebar Kemiringan Atap\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U329\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_atap\', name: \'panjang_atap\', label: \'Panjang Bidang Atap\', placeholder: \'Masukkan panjang atap (m)\', value: null, unit: \'m\', required: true },\n      { id: \'lebar_atap\', name: \'lebar_atap\', label: \'Lebar Kemiringan Atap\', placeholder: \'Masukkan lebar miring atap (m)\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_atap\'];\n      const l = params[\'lebar_atap\'];\n      if (p == null || l == null) return null;\n      return p * l;\n    },\n  },\n  {\n    id: \'str-atap-penutup-alderon\',\n    code: \'STR-ATP-02\',\n    name: \'Pemasangan Penutup Atap\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Atap dan Penutup Atap\',\n    floorRule: \'atap_saja\',\n    description: \'Pemasangan penutup atap sesuai luas bidang miring atap.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Bidang Penutup Atap\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U330\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'luas_bidang\', name: \'luas_bidang\', label: \'Luas Bidang Penutup Atap\', placeholder: \'Masukkan luas bidang atap (m\302\262)\', value: null, unit: \'m\302\262\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_bidang\'];\n      if (a == null || isNaN(a)) return null;\n      return a;\n    },\n  },\n\n  // ==========================================\n  // VII. PEKERJAAN ARSITEKTURAL\n  // ==========================================\n  {\n    id: \'ars-dinding-bata-hebel\',\n    code: \'ARS-DND-01\',\n    name: \'Pemasangan Dinding Bata Ringan (Hebel)\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pasangan Dinding dan Plesteran\',\n    floorRule: \'per_lantai\',\n    description: \'Pasangan dinding bata ringan dihitung dari panjang keliling dikali tinggi dinding dikurangi bukaan.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Panjang Keliling Dinding \303\227 Tinggi Dinding) \342\210\222 Luas Bukaan\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U31\',\n    excelFormula: \'=M16*I16-SUM(U17:U29)\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_keliling\', name: \'panjang_keliling\', label: \'Panjang Total Garis Dinding\', placeholder: \'Masukkan total panjang dinding (m)\', value: null, unit: \'m\', required: true },\n      { id: \'tinggi_dinding\', name: \'tinggi_dinding\', label: \'Tinggi Dinding\', placeholder: \'Masukkan tinggi bersih dinding (m)\', value: null, unit: \'m\', required: true },\n      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan Pintu / Jendela\', placeholder: \'Masukkan luas bukaan jika ada (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_keliling\'];\n      const t = params[\'tinggi_dinding\'];\n      const b = params[\'luas_bukaan\'] || 0;\n      if (p == null || isNaN(p) || t == null || isNaN(t)) return null;\n      return Math.max(0, p * t - b);\n    },\n  },\n  {\n    id: \'ars-plesteran-acian-15mm\',\n    code: \'ARS-DND-02\',\n    name: \'Plesteran & Acian Dinding\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pasangan Dinding dan Plesteran\',\n    floorRule: \'per_lantai\',\n    description: \'Plesteran dan acian dua sisi permukaan dinding bata.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Luas Bersih Dinding \303\227 2 Sisi) \342\210\222 Luas Keramik Dinding \342\210\222 Luas Panel\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U33\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'luas_dinding_bersih\', name: \'luas_dinding_bersih\', label: \'Luas Dinding Bata Bersih\', placeholder: \'Masukkan luas bersih dinding (m\302\262)\', value: null, unit: \'m\302\262\', required: true },\n      { id: \'luas_keramik_toilet\', name: \'luas_keramik_toilet\', label: \'Pengurangan Area Keramik Dinding\', placeholder: \'Masukkan luas keramik dinding (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },\n      { id: \'luas_panel_ornamen\', name: \'luas_panel_ornamen\', label: \'Pengurangan Area Panel / Ornamen\', placeholder: \'Masukkan luas panel (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_dinding_bersih\'];\n      const kt = params[\'luas_keramik_toilet\'] || 0;\n      const po = params[\'luas_panel_ornamen\'] || 0;\n      if (a == null || isNaN(a)) return null;\n      return Math.max(0, a * 2 - kt - po);\n    },\n  },\n  {\n    id: \'ars-keramik-dinding-toilet\',\n    code: \'ARS-DND-03\',\n    name: \'Pemasangan Keramik Dinding Toilet / KM\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pasangan Dinding dan Plesteran\',\n    floorRule: \'per_lantai\',\n    description: \'Pasangan keramik dinding area basah toilet/kamar mandi.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Keliling Dinding Toilet \303\227 Tinggi Pasangan Keramik\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U35\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'keliling_toilet\', name: \'keliling_toilet\', label: \'Total Keliling Dinding Toilet\', placeholder: \'Masukkan keliling toilet (m)\', value: null, unit: \'m\', required: true },\n      { id: \'tinggi_keramik\', name: \'tinggi_keramik\', label: \'Tinggi Pasangan Keramik\', placeholder: \'Contoh: 2.0 (m)\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'keliling_toilet\'];\n      const t = params[\'tinggi_keramik\'];\n      if (p == null || t == null || isNaN(p) || isNaN(t)) return null;\n      return p * t;\n    },\n  },\n  {\n    id: \'ars-homogenous-tile-60x60\',\n    code: \'ARS-LNT-01\',\n    name: \'Pemasangan Penutup Lantai Utama (Homogenous Tile / Keramik)\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Penutup Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Pemasangan penutup lantai ruang utama berdasarkan luas bersih ruangan.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Bersih Lantai Ruangan\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U41\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'luas_lantai\', name: \'luas_lantai\', label: \'Luas Bersih Lantai Utama\', placeholder: \'Masukkan luas lantai (m\302\262)\', value: null, unit: \'m\302\262\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_lantai\'];\n      if (a == null || isNaN(a)) return null;\n      return a;\n    },\n  },\n  {\n    id: \'ars-keramik-toilet-antislip\',\n    code: \'ARS-LNT-02\',\n    name: \'Pemasangan Keramik Lantai Toilet / KM\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Penutup Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Pemasangan keramik lantai anti-slip pada area kamar mandi/WC.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Total Luas Lantai Toilet\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U42\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'luas_total_toilet\', name: \'luas_total_toilet\', label: \'Total Luas Lantai Toilet / KM\', placeholder: \'Masukkan luas lantai toilet (m\302\262)\', value: null, unit: \'m\302\262\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_total_toilet\'];\n      if (a == null || isNaN(a)) return null;\n      return a;\n    },\n  },\n  {\n    id: \'ars-keramik-tangga\',\n    code: \'ARS-LNT-03\',\n    name: \'Pemasangan Penutup Lantai Tangga & Bordes\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Penutup Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Penutup lantai pijakan anak tangga dan bordes.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Lebar Pijakan \303\227 Lebar Tangga \303\227 Jumlah Trap) + Luas Bordes\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U44\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'lebar_pijakan\', name: \'lebar_pijakan\', label: \'Lebar Pijakan (Antrede)\', placeholder: \'Contoh: 0.30 (m)\', value: null, unit: \'m\', required: true },\n      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', placeholder: \'Masukkan lebar tangga (m)\', value: null, unit: \'m\', required: true },\n      { id: \'jumlah_trap\', name: \'jumlah_trap\', label: \'Jumlah Trap Anak Tangga\', placeholder: \'Masukkan jumlah trap (buah)\', value: null, unit: \'buah\', required: true },\n      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Bordes Tangga\', placeholder: \'Masukkan luas bordes (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'lebar_pijakan\'];\n      const w = params[\'lebar_tangga\'];\n      const n = params[\'jumlah_trap\'];\n      const b = params[\'luas_bordes\'] || 0;\n      if (a == null || w == null || n == null) return null;\n      return a * w * n + b;\n    },\n  },\n  {\n    id: \'ars-plafond-gypsum\',\n    code: \'ARS-PLF-01\',\n    name: \'Pemasangan Plafond Gypsum & Rangka Hollow\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Plafond\',\n    floorRule: \'per_lantai\',\n    description: \'Pemasangan langit-langit plafond beserta rangka penggantung.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Bersih Langit-langit Ruangan\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U54\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'luas_plafond\', name: \'luas_plafond\', label: \'Luas Bersih Plafond\', placeholder: \'Masukkan luas plafond (m\302\262)\', value: null, unit: \'m\302\262\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_plafond\'];\n      if (a == null || isNaN(a)) return null;\n      return a;\n    },\n  },\n  {\n    id: \'ars-list-gypsum\',\n    code: \'ARS-PLF-02\',\n    name: \'Pemasangan List Profil Plafond\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Plafond\',\n    floorRule: \'per_lantai\',\n    description: \'List profil tepi pertemuan dinding dan plafon.\',\n    defaultUnit: \'m\\\'\',\n    formulaDisplay: \'Panjang Total Keliling Plafond\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U55\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_keliling\', name: \'panjang_keliling\', label: \'Panjang Total List Plafond\', placeholder: \'Masukkan panjang keliling (m)\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const l = params[\'panjang_keliling\'];\n      if (l == null || isNaN(l)) return null;\n      return l;\n    },\n  },\n  {\n    id: \'ars-pengecatan-dinding-interior\',\n    code: \'ARS-CAT-01\',\n    name: \'Pengecatan Dinding Interior\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pengecatan\',\n    floorRule: \'per_lantai\',\n    description: \'Pengecatan permukaan dinding dalam ruangan.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Bersih Dinding Interior\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U49\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'luas_dinding\', name: \'luas_dinding\', label: \'Luas Dinding Interior\', placeholder: \'Masukkan luas dinding dalam (m\302\262)\', value: null, unit: \'m\302\262\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_dinding\'];\n      if (a == null || isNaN(a)) return null;\n      return a;\n    },\n  },\n  {\n    id: \'ars-pengecatan-dinding-eksterior\',\n    code: \'ARS-CAT-02\',\n    name: \'Pengecatan Dinding Eksterior\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pengecatan\',\n    floorRule: \'per_lantai\',\n    description: \'Pengecatan dinding tampak luar tahan cuaca.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Panjang Dinding Luar \303\227 Tinggi Dinding\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U48\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_dinding_luar\', name: \'panjang_dinding_luar\', label: \'Panjang Dinding Luar\', placeholder: \'Masukkan panjang dinding luar (m)\', value: null, unit: \'m\', required: true },\n      { id: \'tinggi_dinding\', name: \'tinggi_dinding\', label: \'Tinggi Dinding Luar\', placeholder: \'Masukkan tinggi dinding (m)\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_dinding_luar\'];\n      const t = params[\'tinggi_dinding\'];\n      if (p == null || t == null || isNaN(p) || isNaN(t)) return null;\n      return p * t;\n    },\n  },\n  {\n    id: \'ars-pintu-p1-lengkap\',\n    code: \'ARS-PNT-01\',\n    name: \'Pemasangan Pintu Tipe P1 Lengkap\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pintu dan Jendela\',\n    floorRule: \'per_lantai\',\n    description: \'Unit pintu utama lengkap dengan kusen, daun pintu, dan aksesoris.\',\n    defaultUnit: \'unit\',\n    formulaDisplay: \'Jumlah Unit Pintu P1\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'O58\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'jumlah_unit\', name: \'jumlah_unit\', label: \'Jumlah Unit Pintu P1\', placeholder: \'Masukkan jumlah unit\', value: null, unit: \'unit\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const n = params[\'jumlah_unit\'];\n      if (n == null || isNaN(n)) return null;\n      return n;\n    },\n  },\n  {\n    id: \'ars-pintu-p2-lengkap\',\n    code: \'ARS-PNT-02\',\n    name: \'Pemasangan Pintu Tipe P2 Lengkap\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pintu dan Jendela\',\n    floorRule: \'per_lantai\',\n    description: \'Unit pintu ruangan lengkap dengan kusen, daun pintu, dan aksesoris.\',\n    defaultUnit: \'unit\',\n    formulaDisplay: \'Jumlah Unit Pintu P2\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'O69\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'jumlah_unit\', name: \'jumlah_unit\', label: \'Jumlah Unit Pintu P2\', placeholder: \'Masukkan jumlah unit\', value: null, unit: \'unit\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const n = params[\'jumlah_unit\'];\n      if (n == null || isNaN(n)) return null;\n      return n;\n    },\n  },\n  {\n    id: \'ars-jendela-j1-lengkap\',\n    code: \'ARS-JND-01\',\n    name: \'Pemasangan Jendela Tipe J1 Lengkap\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pintu dan Jendela\',\n    floorRule: \'per_lantai\',\n    description: \'Unit jendela lengkap kusen, kaca, dan aksesoris.\',\n    defaultUnit: \'unit\',\n    formulaDisplay: \'Jumlah Unit Jendela J1\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'O102\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'jumlah_unit\', name: \'jumlah_unit\', label: \'Jumlah Unit Jendela J1\', placeholder: \'Masukkan jumlah unit\', value: null, unit: \'unit\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const n = params[\'jumlah_unit\'];\n      if (n == null || isNaN(n)) return null;\n      return n;\n    },\n  },\n  {\n    id: \'ars-jendela-j3-lengkap\',\n    code: \'ARS-JND-02\',\n    name: \'Pemasangan Jendela Tipe J2 / J3 Lengkap\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pintu dan Jendela\',\n    floorRule: \'per_lantai\',\n    description: \'Unit jendela ruangan lengkap kusen, kaca, dan aksesoris.\',\n    defaultUnit: \'unit\',\n    formulaDisplay: \'Jumlah Unit Jendela\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'O124\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'jumlah_unit\', name: \'jumlah_unit\', label: \'Jumlah Unit Jendela\', placeholder: \'Masukkan jumlah unit\', value: null, unit: \'unit\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const n = params[\'jumlah_unit\'];\n      if (n == null || isNaN(n)) return null;\n      return n;\n    },\n  },\n\n  // ==========================================\n  // VIII. PEKERJAAN MEP (KELISTRIKAN & SANITASI)\n  // ==========================================\n  {\n    id: \'mep-titik-lampu\',\n    code: \'MEP-ELC-01\',\n    name: \'Pemasangan Titik Lampu & Instalasi Penerangan\',\n    category: \'MEP\',\n    subCategory: \'Pekerjaan Kelistrikan\',\n    floorRule: \'per_lantai\',\n    description: \'Pemasangan titik instalasi penerangan dan armatur lampu.\',\n    defaultUnit: \'titik\',\n    formulaDisplay: \'Penjumlahan Seluruh Titik Lampu\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'G34\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'lampu_led_12w\', name: \'lampu_led_12w\', label: \'Jumlah Lampu Utama (Tipe A)\', placeholder: \'Masukkan jumlah titik\', value: null, unit: \'bh\', required: true },\n      { id: \'lampu_led_7w\', name: \'lampu_led_7w\', label: \'Jumlah Lampu Downlight (Tipe B)\', placeholder: \'Masukkan jumlah titik (opsional)\', value: 0, unit: \'bh\', required: false },\n      { id: \'lampu_led_4w\', name: \'lampu_led_4w\', label: \'Jumlah Lampu Taman / Sorot (Tipe C)\', placeholder: \'Masukkan jumlah titik (opsional)\', value: 0, unit: \'bh\', required: false },\n      { id: \'lampu_tl_40w\', name: \'lampu_tl_40w\', label: \'Jumlah Lampu TL / Batten (Tipe D)\', placeholder: \'Masukkan jumlah titik (opsional)\', value: 0, unit: \'bh\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const l1 = params[\'lampu_led_12w\'];\n      const l2 = params[\'lampu_led_7w\'] || 0;\n      const l3 = params[\'lampu_led_4w\'] || 0;\n      const l4 = params[\'lampu_tl_40w\'] || 0;\n      if (l1 == null && l2 === 0 && l3 === 0 && l4 === 0) return null;\n      return (l1 || 0) + l2 + l3 + l4;\n    },\n  },\n  {\n    id: \'mep-stop-kontak\',\n    code: \'MEP-ELC-02\',\n    name: \'Pemasangan Stop Kontak Dinding\',\n    category: \'MEP\',\n    subCategory: \'Pekerjaan Kelistrikan\',\n    floorRule: \'per_lantai\',\n    description: \'Pemasangan titik instalasi dan stop kontak dinding.\',\n    defaultUnit: \'titik\',\n    formulaDisplay: \'Jumlah Titik Stop Kontak\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'G35\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Stop Kontak\', placeholder: \'Masukkan jumlah titik\', value: null, unit: \'titik\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const n = params[\'jumlah_titik\'];\n      if (n == null || isNaN(n)) return null;\n      return n;\n    },\n  },\n  {\n    id: \'mep-sanitasi-kran-air\',\n    code: \'MEP-SAN-01\',\n    name: \'Pemasangan Kran Air Bersih\',\n    category: \'MEP\',\n    subCategory: \'Pekerjaan Sanitasi\',\n    floorRule: \'per_lantai\',\n    description: \'Pemasangan unit kran air bersih pada area sanitasi.\',\n    defaultUnit: \'buah\',\n    formulaDisplay: \'Jumlah Buah Kran Air\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'G50\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'jumlah_kran\', name: \'jumlah_kran\', label: \'Jumlah Kran Air\', placeholder: \'Masukkan jumlah buah\', value: null, unit: \'buah\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const n = params[\'jumlah_kran\'];\n      if (n == null || isNaN(n)) return null;\n      return n;\n    },\n  },\n  {\n    id: \'mep-pipa-pvc-air-bersih\',\n    code: \'MEP-SAN-02\',\n    name: \'Pemasangan Pipa PVC Air Bersih\',\n    category: \'MEP\',\n    subCategory: \'Pekerjaan Sanitasi\',\n    floorRule: \'per_lantai\',\n    description: \'Instalasi jaringan pipa distribusi air bersih.\',\n    defaultUnit: \'m\',\n    formulaDisplay: \'Panjang Total Jalur Pipa\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'G58\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_pipa\', name: \'panjang_pipa\', label: \'Panjang Jalur Pipa Air Bersih\', placeholder: \'Masukkan panjang pipa (m)\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_pipa\'];\n      if (p == null || isNaN(p)) return null;\n      return p;\n    },\n  },\n  {\n    id: \'mep-pipa-pvc-air-kotor-4in\',\n    code: \'MEP-SAN-03\',\n    name: \'Pemasangan Pipa PVC Air Kotor & Limbah\',\n    category: \'MEP\',\n    subCategory: \'Pekerjaan Sanitasi\',\n    floorRule: \'per_lantai\',\n    description: \'Instalasi pipa pembuangan air kotor dan limbah.\',\n    defaultUnit: \'m\',\n    formulaDisplay: \'Panjang Total Jalur Pipa\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'G60\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang_pipa\', name: \'panjang_pipa\', label: \'Panjang Jalur Pipa Air Kotor\', placeholder: \'Masukkan panjang pipa (m)\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_pipa\'];\n      if (p == null || isNaN(p)) return null;\n      return p;\n    },\n  },\n  {\n    id: \'mep-septic-tank-biotank\',\n    code: \'MEP-SAN-04\',\n    name: \'Pemasangan Bio Septic Tank & Resapan\',\n    category: \'MEP\',\n    subCategory: \'Pekerjaan Sanitasi\',\n    floorRule: \'umum\',\n    description: \'Pemasangan unit bio septic tank dan sumur resapan.\',\n    defaultUnit: \'unit\',\n    formulaDisplay: \'Jumlah Unit Septic Tank\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'G52\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'jumlah_unit\', name: \'jumlah_unit\', label: \'Jumlah Unit Biotank\', placeholder: \'Masukkan jumlah unit\', value: null, unit: \'unit\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const n = params[\'jumlah_unit\'];\n      if (n == null || isNaN(n)) return null;\n      return n;\n    },\n  },\n];\n"
