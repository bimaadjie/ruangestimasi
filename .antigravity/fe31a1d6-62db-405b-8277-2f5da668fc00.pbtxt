      thinking_signature: "\022\355\r\n\352\r\001i\024}\023\312P[\273\246\037#80\277\312\344\347M\210\364\331A\215\016\366\354\221\33377\005jZ\262C\376\214X^X\236\372\311-\323\315\251\267\035\261\266\036\232\273\301{\214v\fw\a\2623+\363\006\201A\372s\323nk\f\222m:>\030H\247aK\226\034v\342\225\264m\311\341\225\2753\201\322\374\215gM2\334\365\315F\372\244D.\3653\205-o\262\f\004\247(J\020!u\230\035\034\324Us\364w$e(\244n$\240\370\017s\315g\311\333\352d|~\320p\2433Y\351\320\306U\022\354\246\201@9\000\037j\240\b\025\033\321\260*\270n\016\275#!zvA\314\361)^w\325C\301\364\030\315\362\032S%\304\214\221S\205\252?\023hl\250\263\200m\247\325\213I\366D\237av\300\265\231\bY\250\332\002+C4\355\016/\034oc\f\211N\233\037\301E\331\354\230\r\rn\222u\317C\267\032&\263\261\'\226I\302\305\276\t\227\356\345\221\222KX\275\216}p!3\361\3414\205=#\221i^o(\227#\037\347\022\306\341\245\033-\224\302n \261\232/Jy7v\367\362\273\302\351\356\343VP\264\344\336\\1o\321\251\"\346\205>\367\263\310Zp\377\202*OG\3514\206\255\250\352\343Ybo\305\231ij\215\350\266\t\301q\253p_\215\333\251\377\027\216K\b*\255\265/\023\200\325\270/jq1\303\362g\021\034m\000\361\323N\261m\v\211/b)~\225\345`v$g\346\351\275S_\033\t\347\3066[\247\254\210QR\275\216\353R\201\376m\244\376\240\017\351M\350\363\f\360\201\270\302\030e\364&\215b\006\363P\326\231\267\026\037\257\357\377p\325\254v\303\361\325m\031F\204PF\265$Q\250\226\301|\354\000+\320\3558C@\021yR8+\225\375\323\026:\371\326\304\206B\004I\240hM\233\247\350\355E~uK\333\254\327\340\367^\002j+\237)\361\001\273G\255\362\252x\203\254\263\272\214<\300{%\271&l1\331\361\3018\262\267\362n\005\242#\351\tE7\017\030C\363\363;\241\v49J\257x\344\337XV$\036\353\213\006X\031\270\nq\375\231\001\261\335\221\243\177\341d\301\357\325\213\341wwc\t\367\"\203\272\232$?\237\315\262@\342v\341P\230Ex\305!\0311MQ\301\275nQ\306\366\340\233\327>f=\032s\034+\366\253+\251\232A\232\277\032\200\024,\v\335\266\300\325\376\237\354N\271\\\31778\255\347z\336\230d\020k\365\273\241\227\257\023\216\304\201\340V@rz\3118\333\366\021cOh\036t\247\350+\177kY/:\304\206\216\245^\350\252\234\'\254\277\326\263\244\300\356H5\032TwrO\036F\017\366&\n\005\324f\365x\325H;\214\366\361,\202\200\345\204\230\300\350q\274\324\021}~\320\003W&1\311\222z\274xY\242\335\234\226Gr\205Z\232E\034\326\033\031\306\367\322\024\336\036\035\3474jAG\364\364\346Ijy\0369\n\277\252Kxj\251\376S\237\305+,\025\214B\016\375\241\227\373\343v\240\323HiPV\217\375E\371\341i_\220\327\031lt)D\376\206-o\316\370\361%\323\206\267+mY{\304S\334\032(:n\376\216\001\241\2341\300\235\036\025\375\244\231\303e\360\234\302\215\352\241k\256\341\236\3565\327\273\326\3430\307J\334j\313\366\n\371W\315\203\306dG\204\371\342j\324\245V\022\004*{\265m\300J\366\rB\354o\331A\370\325@\211\177~j\265\272\215+G\3224\371\211W\207Y\330\362\346P\252mv\202\305+\345E\"\372\005\266\310\t\350\363\377bU[J\210\002,\227\255n\210\003\270\016}\244>>O\3110g\213=/m(\337\256\332!\016c\307\315%8\325\306W\340\223\202\250\331\024$=\025O\363\211\202]\005\244\247\311\352\261\230\3425M\215\234\231r\266z\361\217\003\016\357R\253\204Jsc>\265\025\212)\264\217*\025L\303p;\207\306\253\321\230\313E\005\305\315\306\335`\024\001\026\210\201/\252`\276\304b\350\216\223\246bJ6\342\212\022ap~-\365g\2538\262\216\252\207\035n\267\326\ad\3345\356\r\340%\324\005k\366\366\307Wo\310\336a\354s\322\252\304S\2443h\224\216\334c\370\361\241\366\247\241,\266\374\"\t,I\255\023\203\242A\"\353\210\245\243\"h\201\023J\347\322\022\035m\371\221~\377\217\246p\354l`\263\207r\2564\2249\213\347\221}Wxh\365\240Mo\341)T\240\221\213\250\366L\035\230\301\303\001\334.k_>\020\274\\F\"h\205\227(JS\237\370r-\a(\035\257\222,\365L\273.\033\273\241&S\373\261\031\237\223K\001q\221;\234\344\317L\250\fe\305A\337B*\001\225+\361\302(\212D\305\237\352\021T\363\246~3@; \237\212gf\263\266\002\r\233_\216l\r\230*\350\214~\350lx\311\320\306\354\260\257\207pU\000\240[\273\256\223U\307\030R%n\211=\306Y\242qf\277we\006;<\251\365\323\213b\n\241\307m\270\002\005`>\027\345g\341\336\b\337\343\025\'\355\2110^\341\342[\357\247\377\221S\302\"r\333\372\002\332<\331\201\222\242\230>\212\nJ\325[iJ\267\257\315\024[\240\207B\223\377\332\260+1-\351\034\000Yv\332\340X!\303|\204\027\204\034\363\305\317\365\031\033&\354\207\246r\302\324\276\317n\300\247\302\370-\260\224\343\252s\267o\270\343\310G\274\300\216\344>\254\030\311\004VS\177\374@\215de}\031R\262I\376\003\311\353K\230(\b-.\2571\006\240\367Mp|\267Qb\377\314\nP\247j\302Y\332\005\317\337YRxN!\212F\372\031\223z\231\337\342eJ5\370K,\241\002(\332P4\232\017\350\320\343\346q\366\"\301\177a\317\261\347\306n:\320*\274\036\254eI\256_aUjC\251\235P\214s%R\215\241]\022\377\361}\267m\255\271d/T\365]\303x\237\267\344Y\" \214\344`En\330\371^ g\234\225\327\223\243\020 |H\037L\377\300\351{R\032d{\\\016$\323J\303\341\3445(e\033\267\357\035\237R\231 \332\311\204\264\336\022\357-\000{\261C\006\244\2251\225\242y\363\301L\331~\177\306wO;f\310$(W\201\257\363\362\312 P\321\215\264\311\226{@X0|U\002\262\362{\317\0062zm\267\220\233w7m]\0308 D\323\223\312\256Y\225T\330\301\230\0216."
