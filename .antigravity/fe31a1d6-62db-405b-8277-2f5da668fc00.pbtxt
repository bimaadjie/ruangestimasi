              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    - \"Terbaca Jelas\" (jika angka tertulis jelas pada satu bagian gambar)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    - \"Hasil Penggabungan\" (jika merupakan total penjumlahan segmen atau penggabungan denah + tabel dimensi/schedule)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    - \"Perlu Verifikasi\" (jika angka kurang tajam atau butuh pemeriksaan manual estimator)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "====================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "C. ATURAN SATUAN DAN SKALA"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "====================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Utamakan angka dimensi yang tertulis jelas pada gambar."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- JANGAN PERNAH mengalikan dimensi tertulis dua kali dengan skala!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Gunakan skala hanya sebagai konteks atau pemeriksaan proporsi jika diperlukan."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Perhatikan apakah angka pada gambar tertulis dalam meter (misal \"6.00\", \"3.60\", \"3.00\", \"12.00\" -> detectedUnit: \"m\") atau dalam cm/mm (misal \"40\", \"60\", \"600\", \"300\" -> detectedUnit: \"${chosenUnit}\")."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Jika angka tidak terbaca jelas, jangan menebak nilai secara acak."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "====================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "D. PERHITUNGAN PANJANG TOTAL BALOK DAN SLOOF (\"segments\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "====================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Untuk pekerjaan seperti balok (B1, B2, B3, RB, dll.) dan sloof (S1, S2, S3, S.1, dll.):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- JANGAN mengambil satu angka bentang saja sebagai panjang total jika terdapat beberapa segmen!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- JANGAN PERNAH menggunakan keliling luar bangunan sebagai panjang sloof atau balok!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Hitung panjang total dari penjumlahan seluruh segmen yang teridentifikasi pada denah balok atau denah sloof:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. Identifikasi kode elemen, misalnya \"B1\", \"B2\", \"S1\", \"S.1\", atau \"S2\"."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. Identifikasi setiap segmen berdasarkan grid/as atau bentang yang tertulis:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     Contoh:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - Segmen A\342\200\223B (Grid 1): 3.00 m"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - Segmen B\342\200\223C (Grid 1): 4.00 m"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - Segmen C\342\200\223D (Grid 1): 3.50 m"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  3. Konversi setiap segmen ke meter pada \"lengthMeters\" dan kalikan dengan \"count\" (jumlah jalur identik) menjadi \"subtotalMeters\"."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  4. Hindari penghitungan ganda pada titik pertemuan grid."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  5. Jumlahkan seluruh segmen yang termasuk kode elemen yang sama pada lantai tersebut menjadi nilai parameter \"panjang_total\" pada pekerjaan terkait di dalam \"items\" (dengan verificationBadge: \"Hasil Penggabungan\")."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "====================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "E. PENCOCOKAN TABEL DIMENSI DAN DETAIL STRUKTUR"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "====================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Jika gambar memiliki tabel/schedule (\"Tabel dimensi atau schedule\") atau detail struktur (\"Detail penulangan\" / \"Detail konstruksi\"):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Cocokkan kode elemen pada denah (K1, K2, B1, B2, S1, S.1, S2) dengan kode pada tabel."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Ambil ukuran penampang (\"lebar\", \"tinggi\", \"tebal\") dari tabel dimensi atau detail struktur."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Ambil panjang total (dari penjumlahan segmen) atau jumlah elemen dari denah."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Ambil tinggi kolom atau elevasi dari gambar potongan jika tersedia."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- JANGAN memakai dimensi milik B2 untuk B1 atau S2 untuk S1!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Jika ukuran penampang belum ditemukan pada gambar, jangan mengarang nilainya."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "====================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "F. PEMETAAN KE KATALOG STANDAR USC RUANGESTIMASI (\"catalogId\" & \"parameterId\")"
