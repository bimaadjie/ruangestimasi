            }
            lines {
              text: "    excelFormula: \'=(I38/0.15)*O38*T38*(((K38-0.08)+(M38-0.08)*2))\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    verificationStatus: \'Lengkap\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'panjang_bentang\', name: \'panjang_bentang\', label: \'Panjang Bentang Telapak\', placeholder: \'Masukkan panjang bentang (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tinggi_tekukan\', name: \'tinggi_tekukan\', label: \'Tinggi Tekukan Kait\', placeholder: \'Masukkan tinggi kait (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Pondasi\', placeholder: \'Masukkan jumlah titik\', value: null, unit: \'titik\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jarak_sengkang\', name: \'jarak_sengkang\', label: \'Jarak Antar Tulangan\', placeholder: \'Contoh: 0.15 (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per Meter\', placeholder: \'Contoh: 2.23 (kg/m)\', value: null, unit: \'kg/m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const p = params[\'panjang_bentang\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const m = params[\'tinggi_tekukan\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const n = params[\'jumlah_titik\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const s = params[\'jarak_sengkang\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const bj = params[\'berat_jenis\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (p == null || m == null || n == null || s == null || bj == null || s <= 0) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const satuLapis = (p / s) * n * bj * ((p - 0.08) + (m - 0.08) * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return satuLapis * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
