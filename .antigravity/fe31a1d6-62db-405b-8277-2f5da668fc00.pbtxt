            }
            lines {
              text: "      const a = params[\'lebar_pijakan\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const w = params[\'lebar_tangga\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const n = params[\'jumlah_trap\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const b = params[\'luas_bordes\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (a == null || w == null || n == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return a * w * n + b;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
