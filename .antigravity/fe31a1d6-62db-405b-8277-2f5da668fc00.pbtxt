    replacement_infos {
      original_chunk {
        target_content: "            <div>\n              <h1 className=\"text-xl font-bold tracking-tight text-white\">RuangRAB</h1>\n              <p className=\"text-xs text-blue-200\">\n                AI Quantity Takeoff &amp; Kalkulator Volume Konstruksi\n              </p>\n            </div>\n          </div>\n\n          <div className=\"mt-10 sm:mt-14 max-w-lg space-y-4\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 border border-blue-300/30 text-blue-100\">\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              Platform Perhitungan Volume Konstruksi Terintegrasi\n            </span>\n            <h2 className=\"text-2xl sm:text-4xl font-bold leading-tight tracking-tight\">\n              Hitung Volume Pekerjaan Konstruksi Lebih Cepat &amp; Akurat\n            </h2>\n            <p className=\"text-sm text-blue-100/90 leading-relaxed\">\n              Kelola proyek per lantai, baca berbagai jenis gambar teknik (Denah Arsitektur, Kolom, Balok, Sloof, Pondasi, hingga Tabel Penulangan) dengan Asisten AI, dan ekspor rekapitulasi volume ke Excel.\n            </p>\n          </div>\n\n          {/* Feature Highlights */}\n          <div className=\"mt-8 space-y-3.5 max-w-md text-xs\">\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <Sparkles className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  AI Pembaca Multi-Jenis Gambar Teknik &amp; Segmen Struktur\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Deteksi otomatis denah arsitektur, denah sloof/balok/kolom, tabel dimensi penulangan, serta penjumlahan segmen per grid.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <Layers className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  Manajemen Proyek &amp; Kelompok Lantai Terisolasi per Akun\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Setiap pengguna memiliki ruang kerja proyek sendiri dengan katalog pekerjaan standar maupun kustom.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <FileSpreadsheet className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  Rumus Matematika Terverifikasi &amp; Ekspor Excel (.xlsx)\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Seluruh volume dihitung menggunakan rumus teknik sipil yang transparan dan siap diekspor.\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"relative z-10 mt-10 pt-6 border-t border-white/15 flex items-center justify-between text-xs text-blue-200\">\n          <span>RuangRAB Platform</span>\n          <span>Student \302\267 Estimator \302\267 Professional</span>\n        </div>\n      </div>\n\n      {/* Right Authentication Form Panel */}\n      <div className=\"flex-1 flex items-center justify-center p-6 sm:p-10 lg:p-12\">\n        <div className=\"w-full max-w-md bg-white rounded-2xl border border-slate-200/90 shadow-xl p-6 sm:p-8 space-y-6\">\n          {/* Top Mode Tabs */}\n          {mode !== \'forgot\' ? (\n            <div className=\"grid grid-cols-2 p-1 bg-slate-100 rounded-xl border border-slate-200/70\">\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signin\')}\n                className={`py-2.5 text-xs font-bold rounded-lg transition cursor-pointer ${\n                  mode === \'signin\'\n                    ? \'bg-blue-600 text-white shadow-xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                Sign In (Masuk)\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signup\')}\n                className={`py-2.5 text-xs font-bold rounded-lg transition cursor-pointer ${\n                  mode === \'signup\'\n                    ? \'bg-blue-600 text-white shadow-xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                Create Account (Daftar)\n              </button>\n            </div>\n          ) : (\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n              <div className=\"flex items-center gap-2\">\n                <KeyRound className=\"w-4 h-4 text-blue-600\" />\n                <h3 className=\"text-sm font-bold text-slate-900\">Pemulihan Password Akun</h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signin\')}\n                className=\"text-xs font-semibold text-blue-600 hover:underline cursor-pointer\"\n              >\n                Kembali ke Sign In\n              </button>\n            </div>\n          )}\n\n          {/* Header Text */}\n          <div>\n            <h2 className=\"text-xl font-bold text-slate-900\">\n              {mode === \'signin\'\n                ? \'Masuk ke RuangRAB\'\n                : mode === \'signup\'\n                ? \'Buat Akun RuangRAB Baru\'\n                : \'Reset Password Anda\'}\n            </h2>"
        replacement_content: "            <div>\n              <h1 className=\"text-xl font-bold tracking-tight text-white\">RuangEstimasi</h1>\n              <p className=\"text-xs text-blue-200\">\n                Platform AI Quantity Takeoff &amp; Kalkulator Volume Konstruksi\n              </p>\n            </div>\n          </div>\n\n          <div className=\"mt-10 sm:mt-14 max-w-lg space-y-4\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 border border-blue-300/30 text-blue-100\">\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              Platform AI Quantity Takeoff Konstruksi\n            </span>\n            <h2 className=\"text-2xl sm:text-4xl font-bold leading-tight tracking-tight\">\n              Hitung Volume Pekerjaan Konstruksi Lebih Cepat &amp; Akurat\n            </h2>\n            <p className=\"text-sm text-blue-100/90 leading-relaxed\">\n              RuangEstimasi \342\200\224 Platform AI Quantity Takeoff untuk membantu membaca gambar teknik, menghitung volume pekerjaan konstruksi, dan mengelola estimasi kuantitas proyek.\n            </p>\n          </div>\n\n          {/* Feature Highlights */}\n          <div className=\"mt-8 space-y-3.5 max-w-md text-xs\">\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <Sparkles className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  AI Pembaca Multi-Jenis Gambar Teknik &amp; Segmen Struktur\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Deteksi otomatis denah arsitektur, denah sloof/balok/kolom, tabel dimensi penulangan, serta penjumlahan segmen per grid.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <Layers className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  Manajemen Proyek &amp; Kelompok Lantai Terisolasi per Akun\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Setiap proyek baru otomatis dilengkapi daftar pekerjaan standar per lantai yang siap disesuaikan dengan gambar proyek Anda.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <FileSpreadsheet className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  Rumus Matematika Terverifikasi &amp; Ekspor Excel (.xlsx)\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Seluruh volume dihitung menggunakan rumus teknik sipil yang transparan dan siap diekspor.\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"relative z-10 mt-10 pt-6 border-t border-white/15 flex items-center justify-between text-xs text-blue-200\">\n          <span>RuangEstimasi Platform</span>\n          <span>Student \302\267 Estimator \302\267 Professional</span>\n        </div>\n      </div>\n\n      {/* Right Authentication Form Panel */}\n      <div className=\"flex-1 flex items-center justify-center p-6 sm:p-10 lg:p-12\">\n        <div className=\"w-full max-w-md bg-white rounded-2xl border border-slate-200/90 shadow-xl p-6 sm:p-8 space-y-6\">\n          {/* Top Mode Tabs */}\n          {mode !== \'forgot\' ? (\n            <div className=\"grid grid-cols-2 p-1 bg-slate-100 rounded-xl border border-slate-200/70\">\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signin\')}\n                className={`py-2.5 text-xs font-bold rounded-lg transition cursor-pointer ${\n                  mode === \'signin\'\n                    ? \'bg-blue-600 text-white shadow-xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                Sign In (Masuk)\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signup\')}\n                className={`py-2.5 text-xs font-bold rounded-lg transition cursor-pointer ${\n                  mode === \'signup\'\n                    ? \'bg-blue-600 text-white shadow-xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                Create Account (Daftar)\n              </button>\n            </div>\n          ) : (\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n              <div className=\"flex items-center gap-2\">\n                <KeyRound className=\"w-4 h-4 text-blue-600\" />\n                <h3 className=\"text-sm font-bold text-slate-900\">Pemulihan Password Akun</h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signin\')}\n                className=\"text-xs font-semibold text-blue-600 hover:underline cursor-pointer\"\n              >\n                Kembali ke Sign In\n              </button>\n            </div>\n          )}\n\n          {/* Header Text */}\n          <div>\n            <h2 className=\"text-xl font-bold text-slate-900\">\n              {mode === \'signin\'\n                ? \'Masuk ke RuangEstimasi\'\n                : mode === \'signup\'\n                ? \'Buat Akun RuangEstimasi Baru\'\n                : \'Reset Password Anda\'}\n            </h2>"
        start_line: 215
