  view_file {
    absolute_path_uri: "file:///src/components/ActionCards.tsx"
    end_line: 103
    content: "import React, { useRef } from \'react\';\nimport { UploadCloud, FileEdit, ArrowRight, Upload } from \'lucide-react\';\n\ninterface ActionCardsProps {\n  onUploadFile: (file: File) => void;\n  onOpenManualForm: () => void;\n}\n\nexport const ActionCards: React.FC<ActionCardsProps> = ({\n  onUploadFile,\n  onOpenManualForm,\n}) => {\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const handleDragOver = (e: React.DragEvent) => {\n    e.preventDefault();\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    if (e.dataTransfer.files && e.dataTransfer.files[0]) {\n      onUploadFile(e.dataTransfer.files[0]);\n    }\n  };\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      onUploadFile(e.target.files[0]);\n    }\n  };\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-5 mb-7\">\n      {/* Card 1: Unggah Gambar / PDF */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 p-5 shadow-xs flex flex-col justify-between hover:border-slate-300 transition\">\n        <div>\n          <div className=\"flex items-center gap-3 mb-2\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-xs\">\n              <UploadCloud className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900 leading-tight\">Unggah Gambar / PDF</h3>\n              <p className=\"text-xs text-slate-500\">\n                Upload file gambar denah, potongan, atau PDF untuk dibaca AI.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Drag & Drop Zone */}\n        <div\n          onDragOver={handleDragOver}\n          onDrop={handleDrop}\n          onClick={() => fileInputRef.current?.click()}\n          className=\"mt-3.5 border-2 border-dashed border-blue-200 hover:border-blue-400 bg-blue-50/30 hover:bg-blue-50/60 rounded-xl p-4 text-center cursor-pointer transition flex flex-col items-center justify-center gap-1.5\"\n        >\n          <input\n            ref={fileInputRef}\n            type=\"file\"\n            accept=\".pdf,image/png,image/jpeg,image/webp\"\n            className=\"hidden\"\n            onChange={handleFileChange}\n          />\n          <div className=\"flex items-center gap-2 text-xs font-semibold text-blue-700\">\n            <Upload className=\"w-4 h-4 text-blue-600\" />\n            <span>Klik untuk mengunggah atau drag & drop</span>\n          </div>\n          <span className=\"text-[11px] text-slate-500\">\n            Format: PDF, JPG, PNG (maks. 10 MB)\n          </span>\n        </div>\n      </div>\n\n      {/* Card 2: Input Manual */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 p-5 shadow-xs flex flex-col justify-between hover:border-slate-300 transition\">\n        <div>\n          <div className=\"flex items-center gap-3 mb-2\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-xs\">\n              <FileEdit className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900 leading-tight\">Input Manual</h3>\n              <p className=\"text-xs text-slate-500\">\n                Isi data bangunan dan parameter secara manual.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Manual Form Action Button */}\n        <div className=\"mt-3.5\">\n          <button\n            onClick={onOpenManualForm}\n            className=\"w-full py-3 px-4 rounded-xl border border-blue-200 hover:border-blue-400 bg-white hover:bg-blue-50/50 text-blue-700 font-semibold text-xs transition flex items-center justify-center gap-2 shadow-2xs\"\n          >\n            <span>Buka Form Input</span>\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 104
    num_bytes: 3917
    line_range_bytes: 3917
  }
}
