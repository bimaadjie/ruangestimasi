    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst data = JSON.parse(fs.readFileSync(\'public/assets/aistudio/katalog_volume_usc_639e973f.json\', \'utf8\'));\nconst s1 = data.sheets.find(s => s.name === \'Volume Persiapan Dll\');\nconsole.log(\'=== Volume Persiapan Dll ===\');\nfor (const r of s1.rows) {\n  const txt = r.cells.map(c => c.cell + \':\' + c.value).join(\' | \');\n  if (r.cells.some(c => [\'A\',\'B\'].includes(c.cell.replace(/[0-9]/g,\'\')) || (c.cell.startsWith(\'E\') && typeof c.value === \'string\' && ![\'Panjang\',\'Lebar\',\'Tinggi\',\'Volume\',\'Tebal\',\'Jumlah\'].includes(c.value.trim())))) {\n    console.log(\'R\' + r.row + \': \' + txt);\n  }\n}\nconst s2 = data.sheets.find(s => s.name === \'Volume Struktural\');\nconsole.log(\'=== Volume Struktural (Rows 1-425) ===\');\nfor (const r of s2.rows) {\n  if (r.row > 425) break;\n  const cells = {};\n  r.cells.forEach(c => cells[c.cell.replace(/[0-9]/g,\'\')] = c.value);\n  if (cells.A || cells.B || cells.C || (cells.D && typeof cells.D === \'string\' && (cells.D.toUpperCase() === cells.D || cells.C !== undefined || cells.U !== undefined))) {\n    console.log(\'R\' + r.row + \':\', [cells.A, cells.B, cells.C, cells.D, cells.U, cells.V].filter(Boolean).join(\' | \'));\n  }\n}\n\""
    proposed_command_line: "node -e \"\nconst fs = require(\'fs\');\nconst data = JSON.parse(fs.readFileSync(\'public/assets/aistudio/katalog_volume_usc_639e973f.json\', \'utf8\'));\nconst s1 = data.sheets.find(s => s.name === \'Volume Persiapan Dll\');\nconsole.log(\'=== Volume Persiapan Dll ===\');\nfor (const r of s1.rows) {\n  const txt = r.cells.map(c => c.cell + \':\' + c.value).join(\' | \');\n  if (r.cells.some(c => [\'A\',\'B\'].includes(c.cell.replace(/[0-9]/g,\'\')) || (c.cell.startsWith(\'E\') && typeof c.value === \'string\' && ![\'Panjang\',\'Lebar\',\'Tinggi\',\'Volume\',\'Tebal\',\'Jumlah\'].includes(c.value.trim())))) {\n    console.log(\'R\' + r.row + \': \' + txt);\n  }\n}\nconst s2 = data.sheets.find(s => s.name === \'Volume Struktural\');\nconsole.log(\'=== Volume Struktural (Rows 1-425) ===\');\nfor (const r of s2.rows) {\n  if (r.row > 425) break;\n  const cells = {};\n  r.cells.forEach(c => cells[c.cell.replace(/[0-9]/g,\'\')] = c.value);\n  if (cells.A || cells.B || cells.C || (cells.D && typeof cells.D === \'string\' && (cells.D.toUpperCase() === cells.D || cells.C !== undefined || cells.U !== undefined))) {\n    console.log(\'R\' + r.row + \':\', [cells.A, cells.B, cells.C, cells.D, cells.U, cells.V].filter(Boolean).join(\' | \'));\n  }\n}\n\""
    shell_name: "bash"
  }
}
