    content: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>RuangRAB \342\200\224 AI Quantity Takeoff &amp; Kalkulator Volume Konstruksi</title>\n    <meta name=\"description\" content=\"Aplikasi kalkulator volume dan quantity takeoff konstruksi cerdas berbasis data katalog gedung USC dengan integrasi AI pembaca gambar teknik.\" />\n    <meta property=\"og:title\" content=\"RuangRAB \342\200\224 AI Quantity Takeoff &amp; Kalkulator Volume Konstruksi\" />\n    <meta property=\"og:description\" content=\"Aplikasi kalkulator volume dan quantity takeoff konstruksi cerdas berbasis data katalog gedung USC dengan integrasi AI pembaca gambar teknik.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n"
