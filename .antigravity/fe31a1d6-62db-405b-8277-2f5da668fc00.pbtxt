    replacement_infos {
      original_chunk {
        target_content: "  // Terapkan setiap pembaruan katalog ke pekerjaan proyek\n  for (const [catalogId, paramUpdates] of catalogUpdates.entries()) {\n    // Jika sloof atau pondasi dan targetFloorId bukan lantai umum, tetap gunakan lantai yang dipilih pengguna agar mudah ditemukan\n    const dedupKey = `${targetFloorId}::${catalogId}`;\n\n    if (rejectedKeys.has(dedupKey) && !meta?.forceIncludeRejected) {\n      continue;\n    }\n\n    const segsForCat = catalogSegments.get(catalogId);\n    const elemCode = catalogElementCode.get(catalogId);\n\n    const existingWork = updatedWorks.find(\n      (w) =>\n        w.isActive &&\n        (w.dedupKey === dedupKey ||\n          (w.floorId === targetFloorId &&\n            w.catalogId === catalogId &&\n            (w.origin === \'ai\' || w.parameters.some((p) => p.required && p.value === null))))\n    );\n\n    if (existingWork) {\n      let workModified = false;\n      if (segsForCat && segsForCat.length > 0) {\n        existingWork.segments = segsForCat;\n        workModified = true;\n      }\n      if (elemCode) {\n        existingWork.elementCode = elemCode;\n      }\n\n      for (const upd of paramUpdates) {\n        const param = existingWork.parameters.find((p) => p.id === upd.parameterId);\n        if (!param) continue;\n\n        const currentVal =\n          param.value !== null && param.value !== \'\' && !isNaN(Number(param.value))\n            ? Number(param.value)\n            : null;\n\n        if (currentVal === null) {\n          param.value = upd.convertedValue;\n          param.source = \'ai\';\n          param.sourceDocument = sourceDocument;\n          param.pageOrLocation = upd.pageOrLocation;\n          param.drawingType = upd.drawingType;\n          param.pageNumber = upd.pageNumber;\n          param.rawExtractedValue = upd.rawExtractedValue;\n          param.rawUnit = upd.rawUnit;\n          param.isVerified = false;\n          param.conflict = null;\n          workModified = true;\n        } else if (Math.abs(currentVal - upd.convertedValue) < 0.001) {\n          param.sourceDocument = param.sourceDocument || sourceDocument;\n          param.pageOrLocation = param.pageOrLocation || upd.pageOrLocation;\n          param.drawingType = param.drawingType || upd.drawingType;\n          param.pageNumber = param.pageNumber || upd.pageNumber;\n          param.rawExtractedValue = param.rawExtractedValue ?? upd.rawExtractedValue;\n          param.rawUnit = param.rawUnit ?? upd.rawUnit;\n        } else {\n          const isSameUnverifiedDoc =\n            existingWork.origin === \'ai\' &&\n            existingWork.aiVerificationStatus === \'draft\' &&\n            !param.isVerified &&\n            param.sourceDocument === sourceDocument;\n\n          if (isSameUnverifiedDoc) {\n            param.value = upd.convertedValue;\n            param.rawExtractedValue = upd.rawExtractedValue;\n            param.rawUnit = upd.rawUnit;\n            param.pageOrLocation = upd.pageOrLocation;\n            param.drawingType = upd.drawingType;\n            param.pageNumber = upd.pageNumber;\n            param.conflict = null;\n            workModified = true;\n          } else {\n            param.conflict = {\n              newValue: upd.convertedValue,\n              rawExtractedValue: upd.rawExtractedValue,\n              rawUnit: upd.rawUnit,\n              sourceDocument,\n              pageOrLocation: upd.pageOrLocation,\n            };\n            conflictCount++;\n            workModified = true;\n          }\n        }\n      }\n\n      if (workModified) {\n        existingWork.dedupKey = existingWork.dedupKey || dedupKey;\n        existingWork.lastUpdated = new Date().toISOString();\n        updatedExistingWorksCount++;\n        affectedWorkIds.add(existingWork.id);\n      }\n    } else {\n      const initialValues: Record<string, number | null> = {};\n\n      if (catalogId === \'ars-dinding-bata-hebel\') {\n        const hasHeightInUpdates = paramUpdates.some((u) => u.parameterId === \'tinggi_dinding\');\n        if (!hasHeightInUpdates) {\n          initialValues[\'tinggi_dinding\'] = null;\n        }\n      }\n\n      for (const upd of paramUpdates) {\n        initialValues[upd.parameterId] = upd.convertedValue;\n      }\n\n      const firstUpdate = paramUpdates[0];\n      const newWork = createProjectWorkFromCatalog(catalogId, targetFloorId, initialValues, {\n        origin: \'ai\',\n        aiVerificationStatus: \'draft\',\n        sourceDocument,\n        identificationReason: firstUpdate?.reason || \'Teridentifikasi dari analisis gambar AI\',\n        dedupKey,\n        elementLocation: firstUpdate?.pageOrLocation,\n        elementCode: elemCode,\n        segments: segsForCat,\n      });\n\n      if (newWork) {\n        for (const upd of paramUpdates) {\n          const p = newWork.parameters.find((param) => param.id === upd.parameterId);\n          if (p) {\n            p.source = \'ai\';\n            p.sourceDocument = sourceDocument;\n            p.pageOrLocation = upd.pageOrLocation;\n            p.drawingType = upd.drawingType;\n            p.pageNumber = upd.pageNumber;\n            p.rawExtractedValue = upd.rawExtractedValue;\n            p.rawUnit = upd.rawUnit;\n            p.isVerified = false;\n          }\n        }\n\n        updatedWorks.push(newWork);\n        createdDraftWorksCount++;\n        affectedWorkIds.add(newWork.id);\n      }\n    }\n  }\n\n  const recalculated = recalculateAllProjectWorks(updatedWorks);\n\n  const incompleteWorksCount = recalculated.filter(\n    (w) =>\n      w.isActive &&\n      w.origin === \'ai\' &&\n      w.aiVerificationStatus === \'draft\' &&\n      w.calculatedVolume === null\n  ).length;\n\n  // Susun daftar Rekomendasi Pekerjaan Lanjutan sesuai jenis gambar yang diunggah\n  const recommendations: AIAutoTakeoffSummary[\'recommendations\'] = [];\n  const hasSloof = recalculated.some(\n    (w) =>\n      w.isActive &&\n      w.floorId === targetFloorId &&\n      (w.catalogId === \'str-sloof-beton\' ||\n        w.catalogId === \'str-sloof-s2\' ||\n        w.catalogId === \'str-sloof-s3\')\n  );\n  const hasWall = recalculated.some(\n    (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-dinding-bata-hebel\'\n  );\n  const hasToilet = recalculated.some(\n    (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-keramik-toilet-antislip\'\n  );\n\n  if (hasSloof) {\n    if (\n      !recalculated.some(\n        (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'str-sloof-bekisting\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'str-sloof-bekisting\',\n        name: \'Sloof - Bekisting Samping\',\n        category: \'Struktural\',\n        reason:\n          \'Rekomendasi pekerjaan bekisting dua sisi samping sloof mengikuti panjang total dan tinggi penampang sloof yang terdeteksi.\',\n      });\n    }\n    if (\n      !recalculated.some(\n        (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'str-sloof-tulangan\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'str-sloof-tulangan\',\n        name: \'Sloof - Pembesian Tulangan Pokok\',\n        category: \'Struktural\',\n        reason:\n          \'Rekomendasi pekerjaan pembesian tulangan memanjang sloof sesuai tabel penulangan sloof.\',\n      });\n    }\n  }\n\n  if (hasWall) {\n    if (\n      !recalculated.some(\n        (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-plesteran-acian-15mm\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'ars-plesteran-acian-15mm\',\n        name: \'Plesteran & Acian Dinding\',\n        category: \'Arsitektural\',\n        reason:\n          \'Rekomendasi lanjutan karena terdeteksi pasangan dinding bata ringan pada lantai ini (2 \303\227 luas dinding bersih).\',\n      });\n    }\n    if (\n      !recalculated.some(\n        (w) =>\n          w.isActive &&\n          w.floorId === targetFloorId &&\n          w.catalogId === \'ars-pengecatan-dinding-interior\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'ars-pengecatan-dinding-interior\',\n        name: \'Pengecatan Dinding Interior\',\n        category: \'Arsitektural\',\n        reason: \'Rekomendasi pekerjaan finishing cat dinding setelah pekerjaan plesteran dan acian.\',\n      });\n    }\n  }\n\n  if (\n    hasToilet &&\n    !recalculated.some(\n      (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-keramik-dinding-toilet\'\n    )\n  ) {\n    recommendations.push({\n      catalogId: \'ars-keramik-dinding-toilet\',\n      name: \'Pemasangan Keramik Dinding Toilet / KM\',\n      category: \'Arsitektural\',\n      reason: \'Rekomendasi pelapis dinding area basah karena terdeteksi ruang KM/WC pada denah.\',\n    });\n  }\n\n  const updatedProject: ProjectData = {\n    ...project,\n    works: recalculated,\n    updatedAt: new Date().toISOString(),\n  };\n\n  const summary: AIAutoTakeoffSummary = {\n    documentSummary: meta?.documentSummary || `Analisis dokumen ${sourceDocument}`,\n    drawingType: meta?.drawingType || \'arsitektur_denah\',\n    detectedRegions: meta?.detectedRegions,\n    segments: meta?.segments,\n    identifiedFloor: meta?.identifiedFloor || targetFloorId,\n    identifiedScale: meta?.identifiedScale || \'1:100\',\n    extractedCount: extractionItems.length,\n    createdDraftWorksCount,\n    updatedExistingWorksCount,\n    incompleteWorksCount,\n    conflictCount,\n    recommendations,\n  };\n\n  return {\n    updatedProject,\n    summary,\n    affectedWorkIds: Array.from(affectedWorkIds),\n  };\n}\n\n/**\n * Proyek Default Bersih Tanpa Data Demo Gedung USC\n * Digunakan untuk pengguna baru atau saat membuat template awal.\n */\nexport function createDefaultUscProject(ownerUid?: string): ProjectData {\n  return createNewProject(\'Proyek Baru\', 2, \'\', ownerUid);\n}\n\n/**\n * Buat proyek baru kosong (tanpa nilai dimensi bawaan USC)\n */\nexport function createNewProject(\n  name: string = \'Proyek Baru\',\n  floorCount: number = 2,\n  location: string = \'\',\n  ownerUid?: string\n): ProjectData {\n  const floors: FloorItem[] = [\n    {\n      id: \'fl-umum\',\n      name: \'Umum & Pondasi\',\n      level: 0,\n      elevation: \'\302\261 0.00 m\',\n      description: \'Pekerjaan persiapan, tanah, pondasi, dan sloof\',\n    },\n  ];\n\n  for (let i = 1; i <= floorCount; i++) {\n    floors.push({\n      id: `fl-${i}`,\n      name: `Lantai ${i}`,\n      level: i,\n      elevation: `+ ${(i - 1) * 4}.00 m`,\n      description: `Elevasi lantai tingkat ${i}`,\n    });\n  }\n\n  return {\n    id: `proj-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\n    ownerUid,\n    name: name.trim() || \'Proyek Baru\',\n    location: location.trim(),\n    description: `Kalkulator volume pekerjaan konstruksi (${floorCount} lantai).`,\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    floorCount,\n    floors,\n    works: [],\n    rejectedDraftKeys: [],\n    catalogVersion: USC_CATALOG_VERSION,\n  };\n}\n\n/**\n * Sinkronisasi proyek milik pengguna ke Cloud Firestore jika pengguna login melalui Firebase Auth\n */\nexport async function syncProjectsToFirestore(userId: string, projects: ProjectData[]): Promise<void> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return;\n  for (const proj of projects) {\n    const path = `users/${userId}/projects/${proj.id}`;\n    try {\n      await setDoc(\n        doc(db, \'users\', userId, \'projects\', proj.id),\n        {\n          id: proj.id,\n          ownerUid: userId,\n          name: proj.name,\n          location: proj.location || \'\',\n          description: proj.description || \'\',\n          floorCount: proj.floorCount,\n          floors: proj.floors,\n          works: JSON.parse(JSON.stringify(proj.works || [])),\n          rejectedDraftKeys: proj.rejectedDraftKeys || [],\n          catalogVersion: proj.catalogVersion || USC_CATALOG_VERSION,\n          createdAt: proj.createdAt,\n          updatedAt: proj.updatedAt,\n        },\n        { merge: true }\n      );\n    } catch (err) {\n      handleFirestoreError(err, OperationType.WRITE, path);\n    }\n  }\n}\n\nexport async function deleteProjectFromFirestore(userId: string, projectId: string): Promise<void> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return;\n  const path = `users/${userId}/projects/${projectId}`;\n  try {\n    await deleteDoc(doc(db, \'users\', userId, \'projects\', projectId));\n  } catch (err) {\n    handleFirestoreError(err, OperationType.DELETE, path);\n  }\n}\n\nexport async function fetchProjectsFromFirestore(userId: string): Promise<ProjectData[] | null> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return null;\n  const path = `users/${userId}/projects`;\n  try {\n    const snap = await getDocs(collection(db, \'users\', userId, \'projects\'));\n    if (snap.empty) return [];\n    const loaded: ProjectData[] = [];\n    snap.forEach((docSnap) => {\n      const data = docSnap.data() as ProjectData;\n      loaded.push({\n        ...data,\n        works: recalculateAllProjectWorks(data.works || []),\n      });\n    });\n    return loaded;\n  } catch (err) {\n    handleFirestoreError(err, OperationType.LIST, path);\n    return null;\n  }\n}\n\n/**\n * Muat semua proyek milik pengguna tertentu dari penyimpanan terisolasi.\n * Jika akun baru belum memiliki proyek, migrasikan proyek lokal kustom yang sudah ada (bukan demo USC)\n * atau buat \"Proyek Baru\" kosong.\n */\nexport function loadAllProjects(userId: string = \'default\'): ProjectData[] {\n  const userKey = `${STORAGE_PREFIX_USER_PROJECTS}${userId}`;\n  try {\n    const rawUser = localStorage.getItem(userKey);\n    if (rawUser) {\n      const parsed: ProjectData[] = JSON.parse(rawUser);\n      if (Array.isArray(parsed) && parsed.length > 0) {\n        return parsed.map((p) => ({\n          ...p,\n          works: recalculateAllProjectWorks(p.works || []),\n        }));\n      }\n    }\n\n    // Cek apakah ada proyek di penyimpanan legacy yang dibuat oleh pengguna (misal \"Rumah 2 lantai\" dll, bukan demo Gedung USC bawaan)\n    const legacyRaw = localStorage.getItem(LEGACY_STORAGE_KEY_PROJECTS);\n    if (legacyRaw) {\n      const legacyParsed: ProjectData[] = JSON.parse(legacyRaw);\n      if (Array.isArray(legacyParsed) && legacyParsed.length > 0) {\n        const nonDemoProjects = legacyParsed.filter(\n          (p) => p.id !== \'proj-gedung-usc\' && p.name !== \'Gedung USC\'\n        );\n        if (nonDemoProjects.length > 0) {\n          const migrated = nonDemoProjects.map((p) => ({\n            ...p,\n            ownerUid: userId,\n            works: recalculateAllProjectWorks(p.works || []),\n          }));\n          saveAllProjects(migrated, userId);\n          setActiveProjectId(migrated[0].id, userId);\n          return migrated;\n        }\n      }\n    }\n\n    // Buat proyek baru bersih tanpa data Gedung USC\n    const freshProject = createNewProject(\'Proyek Baru\', 2, \'\', userId);\n    saveAllProjects([freshProject], userId);\n    setActiveProjectId(freshProject.id, userId);\n    return [freshProject];\n  } catch (err) {\n    console.error(\'Gagal memuat proyek pengguna, membuat proyek baru:\', err);\n    const freshProject = createNewProject(\'Proyek Baru\', 2, \'\', userId);\n    return [freshProject];\n  }\n}\n\n/**\n * Simpan seluruh daftar proyek pengguna ke LocalStorage (dan sinkronkan ke Firestore jika aktif)\n */\nexport function saveAllProjects(projects: ProjectData[], userId: string = \'default\'): boolean {\n  const userKey = `${STORAGE_PREFIX_USER_PROJECTS}${userId}`;\n  try {\n    localStorage.setItem(userKey, JSON.stringify(projects));\n    if (auth.currentUser && auth.currentUser.uid === userId) {\n      syncProjectsToFirestore(userId, projects).catch((e) =>\n        console.warn(\'Sinkronisasi Firestore tertunda:\', e)\n      );\n    }\n    return true;\n  } catch (err) {\n    console.error(\'Gagal menyimpan proyek ke LocalStorage:\', err);\n    return false;\n  }\n}\n\n/**\n * Dapatkan ID proyek aktif untuk pengguna\n */\nexport function getActiveProjectId(userId: string = \'default\'): string {\n  try {\n    return localStorage.getItem(`${STORAGE_PREFIX_ACTIVE_PROJECT}${userId}`) || \'\';\n  } catch {\n    return \'\';\n  }\n}\n\n/**\n * Set ID proyek aktif untuk pengguna\n */\nexport function setActiveProjectId(id: string, userId: string = \'default\'): void {\n  try {\n    localStorage.setItem(`${STORAGE_PREFIX_ACTIVE_PROJECT}${userId}`, id);\n  } catch (err) {\n    console.error(\'Gagal menyimpan ID proyek aktif:\', err);\n  }\n}"
        replacement_content: "  // Terapkan setiap pembaruan katalog ke pekerjaan proyek\n  const allCatalog = getAllCatalogItems();\n  for (const [catalogId, paramUpdates] of catalogUpdates.entries()) {\n    const catEntry = allCatalog.find((c) => c.id === catalogId);\n    const dedupKey = `${targetFloorId}::${catalogId}`;\n\n    if (rejectedKeys.has(dedupKey) && !meta?.forceIncludeRejected) {\n      continue;\n    }\n\n    const segsForCat = catalogSegments.get(catalogId);\n    const elemCode = catalogElementCode.get(catalogId);\n\n    // Cari pekerjaan yang sudah ada pada lantai tujuan (termasuk pekerjaan standar default yang belum diisi)\n    let existingWork = updatedWorks.find(\n      (w) =>\n        w.isActive &&\n        (w.dedupKey === dedupKey ||\n          (w.floorId === targetFloorId && w.catalogId === catalogId))\n    );\n\n    // Jika tidak ditemukan di targetFloorId, dan pekerjaan merupakan kategori Umum/Pondasi (seperti Sloof atau Pembersihan Lahan),\n    // periksa juga di kelompok Umum & Pondasi (fl-umum) agar tidak membuat duplikasi lintas lantai\n    if (\n      !existingWork &&\n      targetFloorId !== \'fl-umum\' &&\n      (catEntry?.floorRule === \'umum\' || catEntry?.floorRule === \'fondasi_saja\')\n    ) {\n      existingWork = updatedWorks.find(\n        (w) => w.isActive && w.floorId === \'fl-umum\' && w.catalogId === catalogId\n      );\n    }\n\n    if (existingWork) {\n      // Cek apakah pekerjaan ini sebelumnya masih berupa template kosong bawaan\n      const hadManualFilledParams =\n        existingWork.origin === \'manual\' &&\n        existingWork.parameters.some(\n          (p) => p.value !== null && p.value !== \'\' && p.source === \'manual\'\n        );\n\n      let workModified = false;\n      if (segsForCat && segsForCat.length > 0) {\n        existingWork.segments = segsForCat;\n        workModified = true;\n      }\n      if (elemCode) {\n        existingWork.elementCode = elemCode;\n      }\n\n      for (const upd of paramUpdates) {\n        const param = existingWork.parameters.find((p) => p.id === upd.parameterId);\n        if (!param) continue;\n\n        const currentVal =\n          param.value !== null && param.value !== \'\' && !isNaN(Number(param.value))\n            ? Number(param.value)\n            : null;\n\n        if (currentVal === null) {\n          param.value = upd.convertedValue;\n          param.source = \'ai\';\n          param.sourceDocument = sourceDocument;\n          param.pageOrLocation = upd.pageOrLocation;\n          param.drawingType = upd.drawingType;\n          param.pageNumber = upd.pageNumber;\n          param.rawExtractedValue = upd.rawExtractedValue;\n          param.rawUnit = upd.rawUnit;\n          param.isVerified = false;\n          param.conflict = null;\n          workModified = true;\n        } else if (Math.abs(currentVal - upd.convertedValue) < 0.001) {\n          param.sourceDocument = param.sourceDocument || sourceDocument;\n          param.pageOrLocation = param.pageOrLocation || upd.pageOrLocation;\n          param.drawingType = param.drawingType || upd.drawingType;\n          param.pageNumber = param.pageNumber || upd.pageNumber;\n          param.rawExtractedValue = param.rawExtractedValue ?? upd.rawExtractedValue;\n          param.rawUnit = param.rawUnit ?? upd.rawUnit;\n        } else {\n          const isSameUnverifiedDoc =\n            existingWork.origin === \'ai\' &&\n            existingWork.aiVerificationStatus === \'draft\' &&\n            !param.isVerified &&\n            param.sourceDocument === sourceDocument;\n\n          if (isSameUnverifiedDoc) {\n            param.value = upd.convertedValue;\n            param.rawExtractedValue = upd.rawExtractedValue;\n            param.rawUnit = upd.rawUnit;\n            param.pageOrLocation = upd.pageOrLocation;\n            param.drawingType = upd.drawingType;\n            param.pageNumber = upd.pageNumber;\n            param.conflict = null;\n            workModified = true;\n          } else {\n            param.conflict = {\n              newValue: upd.convertedValue,\n              rawExtractedValue: upd.rawExtractedValue,\n              rawUnit: upd.rawUnit,\n              sourceDocument,\n              pageOrLocation: upd.pageOrLocation,\n            };\n            conflictCount++;\n            workModified = true;\n          }\n        }\n      }\n\n      if (workModified) {\n        const firstUpdate = paramUpdates[0];\n        if (!hadManualFilledParams) {\n          existingWork.origin = \'ai\';\n          existingWork.aiVerificationStatus = \'draft\';\n          existingWork.sourceDocument = sourceDocument;\n          existingWork.identificationReason =\n            firstUpdate?.reason || \'Teridentifikasi dari analisis gambar AI\';\n          existingWork.elementLocation =\n            existingWork.elementLocation || firstUpdate?.pageOrLocation;\n        }\n        existingWork.dedupKey = existingWork.dedupKey || `${existingWork.floorId}::${catalogId}`;\n        existingWork.lastUpdated = new Date().toISOString();\n        updatedExistingWorksCount++;\n        affectedWorkIds.add(existingWork.id);\n      }\n    } else {\n      const initialValues: Record<string, number | null> = {};\n\n      if (catalogId === \'ars-dinding-bata-hebel\') {\n        const hasHeightInUpdates = paramUpdates.some((u) => u.parameterId === \'tinggi_dinding\');\n        if (!hasHeightInUpdates) {\n          initialValues[\'tinggi_dinding\'] = null;\n        }\n      }\n\n      for (const upd of paramUpdates) {\n        initialValues[upd.parameterId] = upd.convertedValue;\n      }\n\n      const firstUpdate = paramUpdates[0];\n      const newWork = createProjectWorkFromCatalog(catalogId, targetFloorId, initialValues, {\n        origin: \'ai\',\n        aiVerificationStatus: \'draft\',\n        sourceDocument,\n        identificationReason: firstUpdate?.reason || \'Teridentifikasi dari analisis gambar AI\',\n        dedupKey,\n        elementLocation: firstUpdate?.pageOrLocation,\n        elementCode: elemCode,\n        segments: segsForCat,\n      });\n\n      if (newWork) {\n        for (const upd of paramUpdates) {\n          const p = newWork.parameters.find((param) => param.id === upd.parameterId);\n          if (p) {\n            p.source = \'ai\';\n            p.sourceDocument = sourceDocument;\n            p.pageOrLocation = upd.pageOrLocation;\n            p.drawingType = upd.drawingType;\n            p.pageNumber = upd.pageNumber;\n            p.rawExtractedValue = upd.rawExtractedValue;\n            p.rawUnit = upd.rawUnit;\n            p.isVerified = false;\n          }\n        }\n\n        updatedWorks.push(newWork);\n        createdDraftWorksCount++;\n        affectedWorkIds.add(newWork.id);\n      }\n    }\n  }\n\n  const recalculated = recalculateAllProjectWorks(updatedWorks);\n\n  const incompleteWorksCount = recalculated.filter(\n    (w) =>\n      w.isActive &&\n      w.origin === \'ai\' &&\n      w.aiVerificationStatus === \'draft\' &&\n      w.calculatedVolume === null\n  ).length;\n\n  // Susun daftar Rekomendasi Pekerjaan Lanjutan sesuai jenis gambar yang diunggah\n  const recommendations: AIAutoTakeoffSummary[\'recommendations\'] = [];\n  const hasSloof = recalculated.some(\n    (w) =>\n      w.isActive &&\n      (w.floorId === targetFloorId || w.floorId === \'fl-umum\') &&\n      (w.catalogId === \'str-sloof-beton\' ||\n        w.catalogId === \'str-sloof-s2\' ||\n        w.catalogId === \'str-sloof-s3\') &&\n      w.parameters.some((p) => p.value !== null)\n  );\n  const hasWall = recalculated.some(\n    (w) =>\n      w.isActive &&\n      w.floorId === targetFloorId &&\n      w.catalogId === \'ars-dinding-bata-hebel\' &&\n      w.parameters.some((p) => p.value !== null)\n  );\n  const hasToilet = recalculated.some(\n    (w) =>\n      w.isActive &&\n      w.floorId === targetFloorId &&\n      w.catalogId === \'ars-keramik-toilet-antislip\' &&\n      w.parameters.some((p) => p.value !== null)\n  );\n\n  if (hasSloof) {\n    if (\n      !recalculated.some(\n        (w) =>\n          w.isActive &&\n          (w.floorId === targetFloorId || w.floorId === \'fl-umum\') &&\n          w.catalogId === \'str-sloof-bekisting\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'str-sloof-bekisting\',\n        name: \'Sloof - Bekisting Samping\',\n        category: \'Struktural\',\n        reason:\n          \'Rekomendasi pekerjaan bekisting dua sisi samping sloof mengikuti panjang total dan tinggi penampang sloof yang terdeteksi.\',\n      });\n    }\n    if (\n      !recalculated.some(\n        (w) =>\n          w.isActive &&\n          (w.floorId === targetFloorId || w.floorId === \'fl-umum\') &&\n          w.catalogId === \'str-sloof-tulangan\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'str-sloof-tulangan\',\n        name: \'Sloof - Pembesian Tulangan Pokok\',\n        category: \'Struktural\',\n        reason:\n          \'Rekomendasi pekerjaan pembesian tulangan memanjang sloof sesuai tabel penulangan sloof.\',\n      });\n    }\n  }\n\n  if (hasWall) {\n    if (\n      !recalculated.some(\n        (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-plesteran-acian-15mm\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'ars-plesteran-acian-15mm\',\n        name: \'Plesteran & Acian Dinding\',\n        category: \'Arsitektural\',\n        reason:\n          \'Rekomendasi lanjutan karena terdeteksi pasangan dinding bata ringan pada lantai ini (2 \303\227 luas dinding bersih).\',\n      });\n    }\n    if (\n      !recalculated.some(\n        (w) =>\n          w.isActive &&\n          w.floorId === targetFloorId &&\n          w.catalogId === \'ars-pengecatan-dinding-interior\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'ars-pengecatan-dinding-interior\',\n        name: \'Pengecatan Dinding Interior\',\n        category: \'Arsitektural\',\n        reason: \'Rekomendasi pekerjaan finishing cat dinding setelah pekerjaan plesteran dan acian.\',\n      });\n    }\n  }\n\n  if (\n    hasToilet &&\n    !recalculated.some(\n      (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-keramik-dinding-toilet\'\n    )\n  ) {\n    recommendations.push({\n      catalogId: \'ars-keramik-dinding-toilet\',\n      name: \'Pemasangan Keramik Dinding Toilet / KM\',\n      category: \'Arsitektural\',\n      reason: \'Rekomendasi pelapis dinding area basah karena terdeteksi ruang KM/WC pada denah.\',\n    });\n  }\n\n  const updatedProject: ProjectData = {\n    ...project,\n    works: recalculated,\n    updatedAt: new Date().toISOString(),\n  };\n\n  const summary: AIAutoTakeoffSummary = {\n    documentSummary: meta?.documentSummary || `Analisis dokumen ${sourceDocument}`,\n    drawingType: meta?.drawingType || \'arsitektur_denah\',\n    detectedRegions: meta?.detectedRegions,\n    segments: meta?.segments,\n    identifiedFloor: meta?.identifiedFloor || targetFloorId,\n    identifiedScale: meta?.identifiedScale || \'1:100\',\n    extractedCount: extractionItems.length,\n    createdDraftWorksCount,\n    updatedExistingWorksCount,\n    incompleteWorksCount,\n    conflictCount,\n    recommendations,\n  };\n\n  return {\n    updatedProject,\n    summary,\n    affectedWorkIds: Array.from(affectedWorkIds),\n  };\n}\n\n/**\n * Proyek Default Bersih Tanpa Data Demo Gedung USC\n * Menyediakan daftar pekerjaan konstruksi standar dengan parameter kosong.\n */\nexport function createDefaultUscProject(ownerUid?: string): ProjectData {\n  return createNewProject(\'Proyek Baru\', 2, \'\', ownerUid);\n}\n\n/**\n * Buat proyek baru lengkap dengan daftar pekerjaan standar per kelompok lantai\n * (Tanpa isian dimensi, jumlah, atau volume dari proyek demo USC)\n */\nexport function createNewProject(\n  name: string = \'Proyek Baru\',\n  floorCount: number = 2,\n  location: string = \'\',\n  ownerUid?: string\n): ProjectData {\n  const floors: FloorItem[] = [\n    {\n      id: \'fl-umum\',\n      name: \'Umum & Pondasi\',\n      level: 0,\n      elevation: \'\302\261 0.00 m\',\n      description: \'Pekerjaan persiapan, tanah, pondasi, dan sloof\',\n    },\n  ];\n\n  for (let i = 1; i <= floorCount; i++) {\n    floors.push({\n      id: `fl-${i}`,\n      name: `Lantai ${i}`,\n      level: i,\n      elevation: `+ ${(i - 1) * 4}.00 m`,\n      description: `Elevasi lantai tingkat ${i}`,\n    });\n  }\n\n  // Sediakan daftar pekerjaan standar (template kosong) untuk setiap lantai\n  const defaultWorks: ProjectWorkItem[] = [];\n  for (const floor of floors) {\n    const floorWorks = createDefaultWorksForFloor(floor.id, floor.level);\n    defaultWorks.push(...floorWorks);\n  }\n\n  return {\n    id: `proj-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\n    ownerUid,\n    name: name.trim() || \'Proyek Baru\',\n    location: location.trim(),\n    description: `Kalkulator volume pekerjaan konstruksi (${floorCount} lantai).`,\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    floorCount,\n    floors,\n    works: recalculateAllProjectWorks(defaultWorks),\n    rejectedDraftKeys: [],\n    catalogVersion: USC_CATALOG_VERSION,\n  };\n}\n\n/**\n * Sinkronisasi proyek milik pengguna ke Cloud Firestore jika pengguna login melalui Firebase Auth\n */\nexport async function syncProjectsToFirestore(userId: string, projects: ProjectData[]): Promise<void> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return;\n  for (const proj of projects) {\n    const path = `users/${userId}/projects/${proj.id}`;\n    try {\n      await setDoc(\n        doc(db, \'users\', userId, \'projects\', proj.id),\n        {\n          id: proj.id,\n          ownerUid: userId,\n          name: proj.name,\n          location: proj.location || \'\',\n          description: proj.description || \'\',\n          floorCount: proj.floorCount,\n          floors: proj.floors,\n          works: JSON.parse(JSON.stringify(proj.works || [])),\n          rejectedDraftKeys: proj.rejectedDraftKeys || [],\n          catalogVersion: proj.catalogVersion || USC_CATALOG_VERSION,\n          createdAt: proj.createdAt,\n          updatedAt: proj.updatedAt,\n        },\n        { merge: true }\n      );\n    } catch (err) {\n      handleFirestoreError(err, OperationType.WRITE, path);\n    }\n  }\n}\n\nexport async function deleteProjectFromFirestore(userId: string, projectId: string): Promise<void> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return;\n  const path = `users/${userId}/projects/${projectId}`;\n  try {\n    await deleteDoc(doc(db, \'users\', userId, \'projects\', projectId));\n  } catch (err) {\n    handleFirestoreError(err, OperationType.DELETE, path);\n  }\n}\n\nexport async function fetchProjectsFromFirestore(userId: string): Promise<ProjectData[] | null> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return null;\n  const path = `users/${userId}/projects`;\n  try {\n    const snap = await getDocs(collection(db, \'users\', userId, \'projects\'));\n    if (snap.empty) return [];\n    const loaded: ProjectData[] = [];\n    snap.forEach((docSnap) => {\n      const data = docSnap.data() as ProjectData;\n      loaded.push({\n        ...data,\n        works: recalculateAllProjectWorks(data.works || []),\n      });\n    });\n    return loaded;\n  } catch (err) {\n    handleFirestoreError(err, OperationType.LIST, path);\n    return null;\n  }\n}\n\n/**\n * Muat semua proyek milik pengguna tertentu dari penyimpanan terisolasi.\n */\nexport function loadAllProjects(userId: string = \'default\'): ProjectData[] {\n  const userKey = `${STORAGE_PREFIX_USER_PROJECTS}${userId}`;\n  try {\n    const rawUser = localStorage.getItem(userKey);\n    if (rawUser) {\n      const parsed: ProjectData[] = JSON.parse(rawUser);\n      if (Array.isArray(parsed) && parsed.length > 0) {\n        return parsed.map((p) => {\n          // Jika proyek baru dari versi sebelumnya masih memiliki 0 pekerjaan sama sekali,\n          // sediakan daftar pekerjaan standar per lantai\n          let projectWorks = p.works || [];\n          if (projectWorks.length === 0 && Array.isArray(p.floors)) {\n            for (const fl of p.floors) {\n              projectWorks.push(...createDefaultWorksForFloor(fl.id, fl.level));\n            }\n          }\n          return {\n            ...p,\n            works: recalculateAllProjectWorks(projectWorks),\n          };\n        });\n      }\n    }\n\n    // Cek apakah ada proyek di penyimpanan legacy yang dibuat oleh pengguna (bukan demo Gedung USC bawaan)\n    const legacyRaw = localStorage.getItem(LEGACY_STORAGE_KEY_PROJECTS);\n    if (legacyRaw) {\n      const legacyParsed: ProjectData[] = JSON.parse(legacyRaw);\n      if (Array.isArray(legacyParsed) && legacyParsed.length > 0) {\n        const nonDemoProjects = legacyParsed.filter(\n          (p) => p.id !== \'proj-gedung-usc\' && p.name !== \'Gedung USC\'\n        );\n        if (nonDemoProjects.length > 0) {\n          const migrated = nonDemoProjects.map((p) => {\n            let projectWorks = p.works || [];\n            if (projectWorks.length === 0 && Array.isArray(p.floors)) {\n              for (const fl of p.floors) {\n                projectWorks.push(...createDefaultWorksForFloor(fl.id, fl.level));\n              }\n            }\n            return {\n              ...p,\n              ownerUid: userId,\n              works: recalculateAllProjectWorks(projectWorks),\n            };\n          });\n          saveAllProjects(migrated, userId);\n          setActiveProjectId(migrated[0].id, userId);\n          return migrated;\n        }\n      }\n    }\n\n    // Buat proyek baru dengan daftar pekerjaan konstruksi standar (tanpa dimensi Gedung USC)\n    const freshProject = createNewProject(\'Proyek Baru\', 2, \'\', userId);\n    saveAllProjects([freshProject], userId);\n    setActiveProjectId(freshProject.id, userId);\n    return [freshProject];\n  } catch (err) {\n    console.error(\'Gagal memuat proyek pengguna, membuat proyek baru:\', err);\n    const freshProject = createNewProject(\'Proyek Baru\', 2, \'\', userId);\n    return [freshProject];\n  }\n}\n\n/**\n * Simpan seluruh daftar proyek pengguna ke LocalStorage (dan sinkronkan ke Firestore jika aktif)\n */\nexport function saveAllProjects(projects: ProjectData[], userId: string = \'default\'): boolean {\n  const userKey = `${STORAGE_PREFIX_USER_PROJECTS}${userId}`;\n  try {\n    localStorage.setItem(userKey, JSON.stringify(projects));\n    if (auth.currentUser && auth.currentUser.uid === userId) {\n      syncProjectsToFirestore(userId, projects).catch((e) =>\n        console.warn(\'Sinkronisasi Firestore tertunda:\', e)\n      );\n    }\n    return true;\n  } catch (err) {\n    console.error(\'Gagal menyimpan proyek ke LocalStorage:\', err);\n    return false;\n  }\n}\n\n/**\n * Dapatkan ID proyek aktif untuk pengguna\n */\nexport function getActiveProjectId(userId: string = \'default\'): string {\n  try {\n    return localStorage.getItem(`${STORAGE_PREFIX_ACTIVE_PROJECT}${userId}`) || \'\';\n  } catch {\n    return \'\';\n  }\n}\n\n/**\n * Set ID proyek aktif untuk pengguna\n */\nexport function setActiveProjectId(id: string, userId: string = \'default\'): void {\n  try {\n    localStorage.setItem(`${STORAGE_PREFIX_ACTIVE_PROJECT}${userId}`, id);\n  } catch (err) {\n    console.error(\'Gagal menyimpan ID proyek aktif:\', err);\n  }\n}"
