    }
    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst pdfBytes = fs.readFileSync(\"public/assets/aistudio/rencana_1-Model_2ceb7bed.pdf\");\nconst base64 = pdfBytes.toString(\"base64\");\n\nconsole.log(\"Sending request to /api/gemini/extract-dimensions...\");\nconst start = Date.now();\n\nfetch(\"http://localhost:3000/api/gemini/extract-dimensions\", {\n  method: \"POST\",\n  headers: { \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({\n    fileBase64: base64,\n    mimeType: \"application/pdf\",\n    fileName: \"rencana_1-Model_2ceb7bed.pdf\",\n    floorName: \"Lantai 1\",\n    unitSetting: \"cm\",\n    scaleSetting: \"1:100\"\n  })\n}).then(async res => {\n  const elapsed = ((Date.now() - start) / 1000).toFixed(1);\n  console.log(`Response received in ${elapsed}s! Status:`, res.status);\n  const data = await res.json();\n  console.log(\"Response:\", JSON.stringify({\n    success: data.success,\n    modelUsed: data.modelUsed,\n    summary: data.data?.documentSummary,\n    floor: data.data?.identifiedFloor,\n    scale: data.data?.identifiedScale,\n    itemsCount: data.data?.items?.length,\n    sampleItems: data.data?.items?.slice(0, 4)\n  }, null, 2));\n}).catch(err => {\n  console.error(\"Error:\", err.message);\n});\n\'"
