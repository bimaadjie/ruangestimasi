            }
            lines {
              text: "      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', value: 1.4, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'jumlah_trap\', name: \'jumlah_trap\', label: \'Jumlah Trap Anak Tangga\', value: 24, unit: \'buah\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Bordes Tangga\', value: 3.42, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
