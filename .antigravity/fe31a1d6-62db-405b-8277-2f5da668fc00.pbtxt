            lines {
              text: "      { id: \'panjang_atap\', name: \'panjang_atap\', label: \'Panjang Bidang Atap\', placeholder: \'Masukkan panjang atap (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_atap\', name: \'lebar_atap\', label: \'Lebar Kemiringan Atap\', placeholder: \'Masukkan lebar miring atap (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const p = params[\'panjang_atap\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const l = params[\'lebar_atap\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (p == null || l == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return p * l;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
