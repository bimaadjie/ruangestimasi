            }
            lines {
              text: "      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan / Void\', placeholder: \'Masukkan luas void jika ada (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
