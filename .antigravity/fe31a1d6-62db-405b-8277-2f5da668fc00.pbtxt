ificationStatus: \'Lengkap\',\n    verificationNotes: \'Penjumlahan lampu LED 12W, 7W, 4W, dan lampu TL 2x40W.\',\n    parameters: [\n      { id: \'lampu_led_12w\', name: \'lampu_led_12w\', label: \'Lampu LED 12 Watt\', value: 0, unit: \'bh\', required: false, excelCellRef: \'G38\' },\n      { id: \'lampu_led_7w\', name: \'lampu_led_7w\', label: \'Lampu LED 7 Watt\', value: 0, unit: \'bh\', required: false, excelCellRef: \'G39\' },\n      { id: \'lampu_led_4w\', name: \'lampu_led_4w\', label: \'Lampu LED 4 Watt\', value: 0, unit: \'bh\', required: false, excelCellRef: \'G40\' },\n      { id: \'lampu_tl_40w\', name: \'lampu_tl_40w\', label: \'Lampu TL 2\303\22740 Watt\', value: 0, unit: \'bh\', required: false, excelCellRef: \'G41\' },\n    ],\n    calculationMethod: (params) => {\n      const l1 = params[\'lampu_led_12w\'] || 0;\n      const l2 = params[\'lampu_led_7w\'] || 0;\n      const l3 = params[\'lampu_led_4w\'] || 0;\n      const l4 = params[\'lampu_tl_40w\'] || 0;\n      return l1 + l2 + l3 + l4;\n    },\n  },\n  {\n    id: \'mep-stop-kontak\',\n    code: \'MEP-ELC-02\',\n    name: \'Pemasangan Stop Kontak Dinding\',\n    category: \'MEP\',\n    subCategory: \'Pekerjaan Kelistrikan\',\n    floorRule: \'per_lantai\',\n    description: \'Pemasangan stop kontak daya 1 fasa standar SNI.\',\n    defaultUnit: \'titik\',\n    formulaDisplay: \'Jumlah Titik Stop Kontak\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'G35\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Data tersimpan sel G35.\',\n    parameters: [\n      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Stop Kontak\', value: null, unit: \'titik\', required: true, excelCellRef: \'G35\' },\n    ],\n    calculationMethod: (params) => {\n      const n = params[\'jumlah_titik\'];\n      if (n == null || isNaN(n)) return null;\n      return n;\n    },\n  },\n  {\n    id: \'mep-sanitasi-kran-air\',\n    code: \'MEP-SAN-01\',\n    name: \'Pemasangan Kran