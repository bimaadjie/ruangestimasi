  view_file {
    absolute_path_uri: "file:///src/components/AuthPage.tsx"
    end_line: 667
    content: "/**\n * RuangRAB \342\200\224 Halaman Autentikasi Pengguna (Sign In & Create Account)\n * Menyediakan pendaftaran akun baru (Nama, Email, Password, Konfirmasi Password, Jenis Pengguna: Student / Estimator / Other),\n * masuk akun dengan Email/Password atau Google, validasi, tampil/sembunyikan password, dan fitur lupa password.\n */\n\nimport React, { useState } from \'react\';\nimport {\n  Building2,\n  Eye,\n  EyeOff,\n  Lock,\n  Mail,\n  User,\n  Briefcase,\n  GraduationCap,\n  Users,\n  ArrowRight,\n  AlertCircle,\n  CheckCircle2,\n  Sparkles,\n  Layers,\n  FileSpreadsheet,\n  KeyRound,\n} from \'lucide-react\';\nimport { UserAccountType, UserProfile } from \'../types\';\nimport {\n  registerUserAccount,\n  signInWithEmail,\n  signInWithGoogleAccount,\n  requestPasswordReset,\n  validateEmailFormat,\n} from \'../services/authService\';\n\ninterface AuthPageProps {\n  onAuthenticated: (user: UserProfile) => void;\n}\n\nexport const AuthPage: React.FC<AuthPageProps> = ({ onAuthenticated }) => {\n  const [mode, setMode] = useState<\'signin\' | \'signup\' | \'forgot\'>(\'signin\');\n\n  // Form fields\n  const [fullName, setFullName] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [confirmPassword, setConfirmPassword] = useState(\'\');\n  const [userType, setUserType] = useState<UserAccountType>(\'Estimator\');\n  const [newResetPassword, setNewResetPassword] = useState(\'\');\n\n  // UI states\n  const [showPassword, setShowPassword] = useState(false);\n  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [successMsg, setSuccessMsg] = useState<string | null>(null);\n\n  const switchMode = (nextMode: \'signin\' | \'signup\' | \'forgot\') => {\n    setMode(nextMode);\n    setErrorMsg(null);\n    setSuccessMsg(null);\n  };\n\n  const handleSignInSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n\n    if (!validateEmailFormat(email)) {\n      setErrorMsg(\'Format alamat email tidak valid. Contoh: nama@email.com\');\n      return;\n    }\n    if (!password) {\n      setErrorMsg(\'Silakan masukkan password akun Anda.\');\n      return;\n    }\n\n    setIsLoading(true);\n    try {\n      const profile = await signInWithEmail(email, password);\n      onAuthenticated(profile);\n    } catch (err: unknown) {\n      setErrorMsg(err instanceof Error ? err.message : \'Gagal masuk ke akun.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleSignUpSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n\n    if (!fullName.trim() || fullName.trim().length < 2) {\n      setErrorMsg(\'Nama lengkap wajib diisi (minimal 2 karakter).\');\n      return;\n    }\n    if (!validateEmailFormat(email)) {\n      setErrorMsg(\'Format alamat email tidak valid. Contoh: nama@email.com\');\n      return;\n    }\n    if (password.length < 6) {\n      setErrorMsg(\'Password minimal harus terdiri dari 6 karakter.\');\n      return;\n    }\n    if (password !== confirmPassword) {\n      setErrorMsg(\'Konfirmasi password tidak cocok dengan password yang dimasukkan.\');\n      return;\n    }\n\n    setIsLoading(true);\n    try {\n      const profile = await registerUserAccount({\n        fullName,\n        email,\n        password,\n        userType,\n      });\n      onAuthenticated(profile);\n    } catch (err: unknown) {\n      setErrorMsg(err instanceof Error ? err.message : \'Gagal mendaftarkan akun baru.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleForgotSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n\n    if (!validateEmailFormat(email)) {\n      setErrorMsg(\'Masukkan alamat email akun yang terdaftar.\');\n      return;\n    }\n    if (newResetPassword && newResetPassword.length < 6) {\n      setErrorMsg(\'Password baru minimal harus terdiri dari 6 karakter.\');\n      return;\n    }\n\n    setIsLoading(true);\n    try {\n      const res = await requestPasswordReset(email, newResetPassword || undefined);\n      setSuccessMsg(res.message);\n      if (newResetPassword) {\n        setTimeout(() => {\n          setPassword(newResetPassword);\n          setNewResetPassword(\'\');\n          setMode(\'signin\');\n        }, 1400);\n      }\n    } catch (err: unknown) {\n      setErrorMsg(err instanceof Error ? err.message : \'Gagal memproses pemulihan password.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleGoogleSignIn = async () => {\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setIsLoading(true);\n    try {\n      const profile = await signInWithGoogleAccount(userType);\n      onAuthenticated(profile);\n    } catch (err: unknown) {\n      setErrorMsg(err instanceof Error ? err.message : \'Gagal masuk dengan Google.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const userTypeOptions: {\n    id: UserAccountType;\n    title: string;\n    desc: string;\n    icon: React.ReactNode;\n  }[] = [\n    {\n      id: \'Student\',\n      title: \'Student\',\n      desc: \'Mahasiswa atau pelajar teknik sipil & arsitektur\',\n      icon: <GraduationCap className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'Estimator\',\n      title: \'Estimator\',\n      desc: \'Quantity surveyor, estimator, atau praktisi volume\',\n      icon: <Briefcase className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'Other\',\n      title: \'Other\',\n      desc: \'Pengguna umum, pemilik bangunan, atau kategori lain\',\n      icon: <Users className=\"w-4 h-4\" />,\n    },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-[#F7F9FC] text-slate-800 flex flex-col lg:flex-row\">\n      {/* Left Brand & Engineering Overview Panel */}\n      <div className=\"lg:w-5/12 xl:w-1/2 bg-gradient-to-br from-[#102A56] via-[#173B73] to-[#1E4E96] text-white p-8 sm:p-12 flex flex-col justify-between relative overflow-hidden\">\n        <div\n          className=\"absolute inset-0 pointer-events-none opacity-10\"\n          style={{\n            backgroundImage: `radial-gradient(#ffffff 1px, transparent 1px)`,\n            backgroundSize: \'20px 20px\',\n          }}\n        />\n\n        <div className=\"relative z-10\">\n          {/* Brand Logo */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-11 h-11 rounded-2xl bg-blue-500/30 border border-blue-300/30 flex items-center justify-center shadow-lg\">\n              <Building2 className=\"w-6 h-6 text-white\" />\n            </div>\n            <div>\n              <h1 className=\"text-xl font-bold tracking-tight text-white\">RuangRAB</h1>\n              <p className=\"text-xs text-blue-200\">\n                AI Quantity Takeoff &amp; Kalkulator Volume Konstruksi\n              </p>\n            </div>\n          </div>\n\n          <div className=\"mt-10 sm:mt-14 max-w-lg space-y-4\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 border border-blue-300/30 text-blue-100\">\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              Platform Perhitungan Volume Konstruksi Terintegrasi\n            </span>\n            <h2 className=\"text-2xl sm:text-4xl font-bold leading-tight tracking-tight\">\n              Hitung Volume Pekerjaan Konstruksi Lebih Cepat &amp; Akurat\n            </h2>\n            <p className=\"text-sm text-blue-100/90 leading-relaxed\">\n              Kelola proyek per lantai, baca berbagai jenis gambar teknik (Denah Arsitektur, Kolom, Balok, Sloof, Pondasi, hingga Tabel Penulangan) dengan Asisten AI, dan ekspor rekapitulasi volume ke Excel.\n            </p>\n          </div>\n\n          {/* Feature Highlights */}\n          <div className=\"mt-8 space-y-3.5 max-w-md text-xs\">\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <Sparkles className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  AI Pembaca Multi-Jenis Gambar Teknik &amp; Segmen Struktur\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Deteksi otomatis denah arsitektur, denah sloof/balok/kolom, tabel dimensi penulangan, serta penjumlahan segmen per grid.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <Layers className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  Manajemen Proyek &amp; Kelompok Lantai Terisolasi per Akun\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Setiap pengguna memiliki ruang kerja proyek sendiri dengan katalog pekerjaan standar maupun kustom.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs\">\n              <FileSpreadsheet className=\"w-4 h-4 text-blue-300 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white block\">\n                  Rumus Matematika Terverifikasi &amp; Ekspor Excel (.xlsx)\n                </span>\n                <span className=\"text-blue-100/80 block mt-0.5\">\n                  Seluruh volume dihitung menggunakan rumus teknik sipil yang transparan dan siap diekspor.\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"relative z-10 mt-10 pt-6 border-t border-white/15 flex items-center justify-between text-xs text-blue-200\">\n          <span>RuangRAB Platform</span>\n          <span>Student \302\267 Estimator \302\267 Professional</span>\n        </div>\n      </div>\n\n      {/* Right Authentication Form Panel */}\n      <div className=\"flex-1 flex items-center justify-center p-6 sm:p-10 lg:p-12\">\n        <div className=\"w-full max-w-md bg-white rounded-2xl border border-slate-200/90 shadow-xl p-6 sm:p-8 space-y-6\">\n          {/* Top Mode Tabs */}\n          {mode !== \'forgot\' ? (\n            <div className=\"grid grid-cols-2 p-1 bg-slate-100 rounded-xl border border-slate-200/70\">\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signin\')}\n                className={`py-2.5 text-xs font-bold rounded-lg transition cursor-pointer ${\n                  mode === \'signin\'\n                    ? \'bg-blue-600 text-white shadow-xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                Sign In (Masuk)\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signup\')}\n                className={`py-2.5 text-xs font-bold rounded-lg transition cursor-pointer ${\n                  mode === \'signup\'\n                    ? \'bg-blue-600 text-white shadow-xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                Create Account (Daftar)\n              </button>\n            </div>\n          ) : (\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n              <div className=\"flex items-center gap-2\">\n                <KeyRound className=\"w-4 h-4 text-blue-600\" />\n                <h3 className=\"text-sm font-bold text-slate-900\">Pemulihan Password Akun</h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => switchMode(\'signin\')}\n                className=\"text-xs font-semibold text-blue-600 hover:underline cursor-pointer\"\n              >\n                Kembali ke Sign In\n              </button>\n            </div>\n          )}\n\n          {/* Header Text */}\n          <div>\n            <h2 className=\"text-xl font-bold text-slate-900\">\n              {mode === \'signin\'\n                ? \'Masuk ke RuangRAB\'\n                : mode === \'signup\'\n                ? \'Buat Akun RuangRAB Baru\'\n                : \'Reset Password Anda\'}\n            </h2>\n            <p className=\"text-xs text-slate-500 mt-1\">\n              {mode === \'signin\'\n                ? \'Masukkan email dan password Anda untuk mengakses dashboard proyek.\'\n                : mode === \'signup\'\n                ? \'Lengkapi data diri dan pilih kategori pengguna untuk mulai menghitung volume proyek.\'\n                : \'Masukkan alamat email terdaftar dan password baru untuk memulihkan akses akun Anda.\'}\n            </p>\n          </div>\n\n          {/* Alerts */}\n          {errorMsg && (\n            <div className=\"p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-start gap-2.5\">\n              <AlertCircle className=\"w-4 h-4 text-rose-600 shrink-0 mt-0.5\" />\n              <span>{errorMsg}</span>\n            </div>\n          )}\n\n          {successMsg && (\n            <div className=\"p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-start gap-2.5\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />\n              <span>{successMsg}</span>\n            </div>\n          )}\n\n          {/* SIGN IN FORM */}\n          {mode === \'signin\' && (\n            <form onSubmit={handleSignInSubmit} className=\"space-y-4 text-xs\">\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1.5\">\n                  Alamat Email <span className=\"text-rose-500\">*</span>\n                </label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                  <input\n                    type=\"email\"\n                    required\n                    placeholder=\"nama@email.com\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    className=\"w-full pl-10 pr-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <label className=\"font-bold text-slate-800\">\n                    Password <span className=\"text-rose-500\">*</span>\n                  </label>\n                  <button\n                    type=\"button\"\n                    onClick={() => switchMode(\'forgot\')}\n                    className=\"text-[11px] font-semibold text-blue-600 hover:text-blue-800 hover:underline cursor-pointer\"\n                  >\n                    Lupa password?\n                  </button>\n                </div>\n                <div className=\"relative\">\n                  <Lock className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                  <input\n                    type={showPassword ? \'text\' : \'password\'}\n                    required\n                    placeholder=\"Masukkan password Anda\"\n                    value={password}\n                    onChange={(e) => setPassword(e.target.value)}\n                    className=\"w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowPassword(!showPassword)}\n                    className=\"absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 p-1 cursor-pointer\"\n                    title={showPassword ? \'Sembunyikan Password\' : \'Tampilkan Password\'}\n                  >\n                    {showPassword ? <EyeOff className=\"w-4 h-4\" /> : <Eye className=\"w-4 h-4\" />}\n                  </button>\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={isLoading}\n                className=\"w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 text-white font-bold text-xs transition flex items-center justify-center gap-2 shadow-sm cursor-pointer\"\n              >\n                <span>{isLoading ? \'Memproses...\' : \'Sign In ke Dashboard\'}</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </form>\n          )}\n\n          {/* CREATE ACCOUNT / SIGN UP FORM */}\n          {mode === \'signup\' && (\n            <form onSubmit={handleSignUpSubmit} className=\"space-y-4 text-xs\">\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1.5\">\n                  Nama Lengkap <span className=\"text-rose-500\">*</span>\n                </label>\n                <div className=\"relative\">\n                  <User className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"Masukkan nama lengkap Anda\"\n                    value={fullName}\n                    onChange={(e) => setFullName(e.target.value)}\n                    className=\"w-full pl-10 pr-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1.5\">\n                  Alamat Email <span className=\"text-rose-500\">*</span>\n                </label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                  <input\n                    type=\"email\"\n                    required\n                    placeholder=\"nama@email.com\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    className=\"w-full pl-10 pr-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\"\n                  />\n                </div>\n              </div>\n\n              {/* Jenis Pengguna: Student, Estimator, Other */}\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1.5\">\n                  Jenis Pengguna <span className=\"text-rose-500\">*</span>\n                </label>\n                <div className=\"grid grid-cols-1 gap-2\">\n                  {userTypeOptions.map((opt) => {\n                    const selected = userType === opt.id;\n                    return (\n                      <div\n                        key={opt.id}\n                        onClick={() => setUserType(opt.id)}\n                        className={`p-3 rounded-xl border transition cursor-pointer flex items-center gap-3 ${\n                          selected\n                            ? \'border-blue-600 bg-blue-50/70 ring-1 ring-blue-500\'\n                            : \'border-slate-200 hover:border-slate-300 bg-white\'\n                        }`}\n                      >\n                        <div\n                          className={`w-8 h-8 rounded-lg flex items-center justify-center shrink-0 ${\n                            selected ? \'bg-blue-600 text-white\' : \'bg-slate-100 text-slate-600\'\n                          }`}\n                        >\n                          {opt.icon}\n                        </div>\n                        <div className=\"min-w-0 flex-1\">\n                          <span className=\"font-bold text-slate-900 block\">{opt.title}</span>\n                          <span className=\"text-[11px] text-slate-500 block\">{opt.desc}</span>\n                        </div>\n                        <div\n                          className={`w-4 h-4 rounded-full border flex items-center justify-center ${\n                            selected ? \'border-blue-600 bg-blue-600\' : \'border-slate-300\'\n                          }`}\n                        >\n                          {selected && <div className=\"w-1.5 h-1.5 rounded-full bg-white\" />}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"font-bold text-slate-800 block mb-1.5\">\n                    Password <span className=\"text-rose-500\">*</span>\n                  </label>\n                  <div className=\"relative\">\n                    <Lock className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n                    <input\n                      type={showPassword ? \'text\' : \'password\'}\n                      required\n                      placeholder=\"Min. 6 karakter\"\n                      value={password}\n                      onChange={(e) => setPassword(e.target.value)}\n                      className=\"w-full pl-9 pr-9 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\"\n                    />\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowPassword(!showPassword)}\n                      className=\"absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 cursor-pointer\"\n                    >\n                      {showPassword ? <EyeOff className=\"w-3.5 h-3.5\" /> : <Eye className=\"w-3.5 h-3.5\" />}\n                    </button>\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"font-bold text-slate-800 block mb-1.5\">\n                    Konfirmasi Password <span className=\"text-rose-500\">*</span>\n                  </label>\n                  <div className=\"relative\">\n                    <Lock className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n                    <input\n                      type={showConfirmPassword ? \'text\' : \'password\'}\n                      required\n                      placeholder=\"Ulangi password\"\n                      value={confirmPassword}\n                      onChange={(e) => setConfirmPassword(e.target.value)}\n                      className=\"w-full pl-9 pr-9 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\"\n                    />\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowConfirmPassword(!showConfirmPassword)}\n                      className=\"absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 cursor-pointer\"\n                    >\n                      {showConfirmPassword ? (\n                        <EyeOff className=\"w-3.5 h-3.5\" />\n                      ) : (\n                        <Eye className=\"w-3.5 h-3.5\" />\n                      )}\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={isLoading}\n                className=\"w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 text-white font-bold text-xs transition flex items-center justify-center gap-2 shadow-sm cursor-pointer\"\n              >\n                <span>{isLoading ? \'Mendaftarkan Akun...\' : \'Create Account & Masuk\'}</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </form>\n          )}\n\n          {/* FORGOT PASSWORD FORM */}\n          {mode === \'forgot\' && (\n            <form onSubmit={handleForgotSubmit} className=\"space-y-4 text-xs\">\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1.5\">\n                  Alamat Email Terdaftar <span className=\"text-rose-500\">*</span>\n                </label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                  <input\n                    type=\"email\"\n                    required\n                    placeholder=\"nama@email.com\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    className=\"w-full pl-10 pr-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"font-bold text-slate-800 block mb-1.5\">\n                  Password Baru (Opsional untuk Reset Langsung)\n                </label>\n                <div className=\"relative\">\n                  <Lock className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                  <input\n                    type={showPassword ? \'text\' : \'password\'}\n                    placeholder=\"Masukkan password baru minimal 6 karakter\"\n                    value={newResetPassword}\n                    onChange={(e) => setNewResetPassword(e.target.value)}\n                    className=\"w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowPassword(!showPassword)}\n                    className=\"absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 cursor-pointer\"\n                  >\n                    {showPassword ? <EyeOff className=\"w-4 h-4\" /> : <Eye className=\"w-4 h-4\" />}\n                  </button>\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={isLoading}\n                className=\"w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 text-white font-bold text-xs transition flex items-center justify-center gap-2 shadow-sm cursor-pointer\"\n              >\n                <span>{isLoading ? \'Memproses...\' : \'Reset Password Sekarang\'}</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </form>\n          )}\n\n          {/* Divider & Google Sign-In */}\n          {mode !== \'forgot\' && (\n            <>\n              <div className=\"relative flex py-1 items-center\">\n                <div className=\"flex-grow border-t border-slate-200\" />\n                <span className=\"flex-shrink mx-3 text-[11px] text-slate-400 font-medium\">\n                  atau lanjutkan dengan\n                </span>\n                <div className=\"flex-grow border-t border-slate-200\" />\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={handleGoogleSignIn}\n                disabled={isLoading}\n                className=\"w-full py-2.5 px-4 rounded-xl border border-slate-300 hover:bg-slate-50 bg-white text-slate-700 font-bold text-xs transition flex items-center justify-center gap-2.5 shadow-2xs cursor-pointer\"\n              >\n                <svg className=\"w-4 h-4\" viewBox=\"0 0 24 24\">\n                  <path\n                    fill=\"#4285F4\"\n                    d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n                  />\n                  <path\n                    fill=\"#34A853\"\n                    d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n                  />\n                  <path\n                    fill=\"#FBBC05\"\n                    d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\n                  />\n                  <path\n                    fill=\"#EA4335\"\n                    d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\n                  />\n                </svg>\n                <span>Masuk dengan Akun Google</span>\n              </button>\n            </>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 668
    num_bytes: 28424
    line_range_bytes: 28424
  }
}
