    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst data = JSON.parse(fs.readFileSync(\"public/assets/aistudio/katalog_volume_usc_639e973f.json\", \"utf8\"));\nconst arsi = data.sheets.find(s => s.name === \"Volume Arsitektural\");\nfor (const row of arsi.rows) {\n  const d = row.cells.find(c => c.cell.startsWith(\"D\"))?.value;\n  const b = row.cells.find(c => c.cell.startsWith(\"B\"))?.value;\n  if (d && (d.includes(\"ARSITEKTUR LANTAI\") || d.includes(\"PEKERJAAN\"))) {\n    console.log(`[Arsi Row ${row.row}] B:`, b, \"D:\", d);\n  }\n}\n\'"
    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nconst data = JSON.parse(fs.readFileSync(\"public/assets/aistudio/katalog_volume_usc_639e973f.json\", \"utf8\"));\nconst arsi = data.sheets.find(s => s.name === \"Volume Arsitektural\");\nfor (const row of arsi.rows) {\n  const d = row.cells.find(c => c.cell.startsWith(\"D\"))?.value;\n  const b = row.cells.find(c => c.cell.startsWith(\"B\"))?.value;\n  if (d && (d.includes(\"ARSITEKTUR LANTAI\") || d.includes(\"PEKERJAAN\"))) {\n    console.log(`[Arsi Row ${row.row}] B:`, b, \"D:\", d);\n  }\n}\n\'"
