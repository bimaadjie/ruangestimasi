            }
            lines {
              text: " *      Sloof S1/S2/S3/Kustom, MEP Umum & Landscape)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *    - Kelompok Pekerjaan Lantai 1, Lantai 2, dan Lantai Lainnya (Struktural Kolom K1/K2/K3/Praktis/Kustom,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
