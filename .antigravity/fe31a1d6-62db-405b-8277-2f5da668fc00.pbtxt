            }
            lines {
              text: "      const tb = params[\'tebal_bordes\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (a == null || o == null || n == null || w == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const vAnakTangga = 0.5 * a * o * n * w;"
