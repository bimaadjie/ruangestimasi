            lines {
              text: "    formulaDisplay: \'2 \303\227 [(Panjang / Jarak) \303\227 Jml \303\227 Berat Jenis \303\227 (Panjang + 2\303\227Kait)]\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
