  view_file {
    absolute_path_uri: "file:///src/data/uscCatalog.ts"
    end_line: 1357
    content: "/**\n * Katalog Pekerjaan Standar RuangRAB\n * Sumber: Pemetaan workbook asli \'RAB Gedung USC.xlsx\' (katalog_volume_usc.json)\n * Sheet sumber:\n *  1. \'Volume Persiapan Dll\' (162 sel)\n *  2. \'Volume Struktural\' (4.721 sel)\n *  3. \'Volume Arsitektural\' (2.713 sel)\n */\n\nimport { CatalogWorkItem, WorkComponent } from \'../types\';\n\nexport const USC_CATALOG_VERSION = \'1.0.0-USC-2026\';\n\nexport const CATALOG_WORK_ITEMS: CatalogWorkItem[] = [\n  // ==========================================\n  // I. PEKERJAAN PERSIAPAN & UMUM\n  // ==========================================\n  {\n    id: \'prep-pembersihan-lahan\',\n    code: \'PER-01\',\n    name: \'Pembersihan Lahan\',\n    category: \'Persiapan Dll\',\n    subCategory: \'Pekerjaan Persiapan\',\n    floorRule: \'umum\',\n    description: \'Pembersihan dan perataan lahan proyek sebelum memulai pekerjaan pondasi.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Panjang \303\227 Lebar\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'J8 (Formula =G9*G10)\',\n    excelFormula: \'=G9*G10\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Rumus terverifikasi langsung dari sel G12 workbook USC.\',\n    parameters: [\n      { id: \'panjang\', name: \'panjang\', label: \'Panjang Lahan (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'G9\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Lahan (L)\', value: null, unit: \'m\', required: true, excelCellRef: \'G10\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang\'];\n      const l = params[\'lebar\'];\n      if (p == null || l == null || isNaN(p) || isNaN(l)) return null;\n      return p * l;\n    },\n  },\n  {\n    id: \'prep-pagar-sementara\',\n    code: \'PER-02\',\n    name: \'Pemasangan Pagar Sementara Proyek\',\n    category: \'Persiapan Dll\',\n    subCategory: \'Pekerjaan Persiapan\',\n    floorRule: \'umum\',\n    description: \'Pemasangan pagar pengaman seng/spandek sementara keliling area proyek.\',\n    defaultUnit: \'m\',\n    formulaDisplay: \'2 \303\227 (Panjang + Lebar)\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'G18 (Formula =(G15+G16)*2)\',\n    excelFormula: \'=(G15+G16)*2\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Rumus keliling pagar proyek dari sel G18.\',\n    parameters: [\n      { id: \'panjang\', name: \'panjang\', label: \'Panjang Pagar (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'G15\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Pagar (L)\', value: null, unit: \'m\', required: true, excelCellRef: \'G16\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang\'];\n      const l = params[\'lebar\'];\n      if (p == null || l == null || isNaN(p) || isNaN(l)) return null;\n      return 2 * (p + l);\n    },\n  },\n  {\n    id: \'prep-bouwplank\',\n    code: \'PER-03\',\n    name: \'Pekerjaan Bouwplank & Pengukuran\',\n    category: \'Persiapan Dll\',\n    subCategory: \'Pekerjaan Persiapan\',\n    floorRule: \'umum\',\n    description: \'Pemasangan papan duga dan patok sumbu bangunan gedung.\',\n    defaultUnit: \'m\',\n    formulaDisplay: \'2 \303\227 (Panjang + Lebar)\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'J20 (Formula =(G21+G22)*2)\',\n    excelFormula: \'=(G21+G22)*2\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Rumus keliling bouwplank dari sel G24.\',\n    parameters: [\n      { id: \'panjang\', name: \'panjang\', label: \'Panjang Bangunan (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'G21\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Bangunan (L)\', value: null, unit: \'m\', required: true, excelCellRef: \'G22\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang\'];\n      const l = params[\'lebar\'];\n      if (p == null || l == null || isNaN(p) || isNaN(l)) return null;\n      return 2 * (p + l);\n    },\n  },\n  {\n    id: \'prep-gudang-alat\',\n    code: \'PER-04\',\n    name: \'Pembuatan Gudang Alat & Direksikeet\',\n    category: \'Persiapan Dll\',\n    subCategory: \'Pekerjaan Persiapan\',\n    floorRule: \'umum\',\n    description: \'Pembuatan gudang semen, perkakas dan kantor sementara di tapak.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Panjang \303\227 Lebar\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'H30 (Formula =G27*G28)\',\n    excelFormula: \'=G27*G28\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Terverifikasi dari sel G30 sheet Volume Persiapan.\',\n    parameters: [\n      { id: \'panjang\', name: \'panjang\', label: \'Panjang Gudang (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'G27\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Gudang (L)\', value: null, unit: \'m\', required: true, excelCellRef: \'G28\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang\'];\n      const l = params[\'lebar\'];\n      if (p == null || l == null || isNaN(p) || isNaN(l)) return null;\n      return p * l;\n    },\n  },\n\n  // ==========================================\n  // II. PEKERJAAN STRUKTURAL - TANAH & PONDASI\n  // ==========================================\n  {\n    id: \'str-galian-tanah-biasa-1m\',\n    code: \'STR-TNH-01\',\n    name: \'Penggalian Tanah Biasa sedalam 1 m (Pondasi Batu Belah)\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Tanah dan Urugan\',\n    floorRule: \'fondasi_saja\',\n    description: \'Galian tanah pondasi lajur batu belah penampang trapesium/persegi.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'0.5 \303\227 (Lebar Bawah + Lebar Atas) \303\227 Kedalaman \303\227 Panjang Total\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U14 (Formula =M14*(1/2*(K14+I14))*S14)\',\n    excelFormula: \'=M14*(1/2*(K14+I14))*S14\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Rumus trapesium galian: Kedalaman \303\227 rata-rata lebar galian \303\227 panjang sumbu.\',\n    parameters: [\n      { id: \'lebar_bawah\', name: \'lebar_bawah\', label: \'Lebar Bawah Galian (I)\', value: null, unit: \'m\', required: true, excelCellRef: \'I14\' },\n      { id: \'lebar_atas\', name: \'lebar_atas\', label: \'Lebar Atas Galian (K)\', value: null, unit: \'m\', required: true, excelCellRef: \'K14\' },\n      { id: \'kedalaman\', name: \'kedalaman\', label: \'Kedalaman Galian (M)\', value: null, unit: \'m\', required: true, excelCellRef: \'M14\' },\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Galian (S)\', value: null, unit: \'m\', required: true, excelCellRef: \'S14\' },\n    ],\n    calculationMethod: (params) => {\n      const lb = params[\'lebar_bawah\'];\n      const la = params[\'lebar_atas\'];\n      const t = params[\'kedalaman\'];\n      const s = params[\'panjang_total\'];\n      if (lb == null || la == null || t == null || s == null) return null;\n      return t * (0.5 * (lb + la)) * s;\n    },\n  },\n  {\n    id: \'str-galian-pondasi-footplat\',\n    code: \'STR-TNH-02\',\n    name: \'Penggalian Tanah sedalam 2\342\200\2233 m (Pondasi Footplat)\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Tanah dan Urugan\',\n    floorRule: \'fondasi_saja\',\n    description: \'Galian tanah setempat untuk titik telapak pondasi footplat.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Panjang \303\227 Lebar \303\227 Kedalaman \303\227 Jumlah Titik\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U18 (Formula =O18*M18*K18*I18)\',\n    excelFormula: \'=O18*M18*K18*I18\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Volume prisma galian per titik footplat dikalikan jumlah titik pondasi.\',\n    parameters: [\n      { id: \'panjang\', name: \'panjang\', label: \'Panjang Galian (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I18\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Galian (L)\', value: null, unit: \'m\', required: true, excelCellRef: \'K18\' },\n      { id: \'kedalaman\', name: \'kedalaman\', label: \'Kedalaman (T)\', value: null, unit: \'m\', required: true, excelCellRef: \'M18\' },\n      { id: \'jumlah\', name: \'jumlah\', label: \'Jumlah Titik (Jml)\', value: null, unit: \'titik\', required: true, excelCellRef: \'O18\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang\'];\n      const l = params[\'lebar\'];\n      const t = params[\'kedalaman\'];\n      const n = params[\'jumlah\'];\n      if (p == null || l == null || t == null || n == null) return null;\n      return p * l * t * n;\n    },\n  },\n  {\n    id: \'str-urugan-kembali-tanah\',\n    code: \'STR-TNH-03\',\n    name: \'Pengurugan Kembali Galian Tanah\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Tanah dan Urugan\',\n    floorRule: \'fondasi_saja\',\n    description: \'Pengurugan kembali sisa volume galian tanah di sisi pondasi.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Volume Galian Total \303\267 3\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U22 (Formula =U16/3)\',\n    excelFormula: \'=U16/3\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Sesuai standar teknis USC: volume urug kembali diasumsikan 1/3 volume galian.\',\n    parameters: [\n      { id: \'volume_galian\', name: \'volume_galian\', label: \'Volume Galian Tanah Total\', value: null, unit: \'m\302\263\', required: true, excelCellRef: \'U16\' },\n    ],\n    calculationMethod: (params) => {\n      const v = params[\'volume_galian\'];\n      if (v == null || isNaN(v)) return null;\n      return v / 3;\n    },\n  },\n  {\n    id: \'str-urugan-pasir-bawah-pondasi\',\n    code: \'STR-TNH-04\',\n    name: \'Pengurugan Pasir Bawah Pondasi (Tebal 5 cm)\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Tanah dan Urugan\',\n    floorRule: \'fondasi_saja\',\n    description: \'Lapisan pasir urug padat di bawah pasangan batu belah atau footplat.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Panjang \303\227 Lebar \303\227 Tebal Pasir (0.05 m)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U26 (Formula =M26*K26*I26)\',\n    excelFormula: \'=M26*K26*I26\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'M26 = tebal urugan pasir (0.05m).\',\n    parameters: [\n      { id: \'panjang\', name: \'panjang\', label: \'Panjang Pondasi (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I26\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Lapisan (L)\', value: null, unit: \'m\', required: true, excelCellRef: \'K26\' },\n      { id: \'tebal\', name: \'tebal\', label: \'Tebal Pasir (T)\', value: 0.05, unit: \'m\', required: true, excelCellRef: \'M26\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang\'];\n      const l = params[\'lebar\'];\n      const t = params[\'tebal\'] ?? 0.05;\n      if (p == null || l == null) return null;\n      return p * l * t;\n    },\n  },\n  {\n    id: \'str-pasangan-batu-belah-1sp6pp\',\n    code: \'STR-PON-01\',\n    name: \'Pemasangan Pondasi Batu Belah 1SP : 6PP\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Pondasi\',\n    floorRule: \'fondasi_saja\',\n    description: \'Pondasi batu kali/belah penampang trapesium.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Tinggi \303\227 0.5 \303\227 (Lebar Atas + Lebar Bawah) \303\227 Panjang Total\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U32 (Formula =I32*(1/2*(K32+M32))*S32)\',\n    excelFormula: \'=I32*(1/2*(K32+M32))*S32\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Rumus penampang trapesium pondasi batu kali.\',\n    parameters: [\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Pondasi (T)\', value: null, unit: \'m\', required: true, excelCellRef: \'I32\' },\n      { id: \'lebar_atas\', name: \'lebar_atas\', label: \'Lebar Atas Pondasi (La)\', value: null, unit: \'m\', required: true, excelCellRef: \'K32\' },\n      { id: \'lebar_bawah\', name: \'lebar_bawah\', label: \'Lebar Bawah Pondasi (Lb)\', value: null, unit: \'m\', required: true, excelCellRef: \'M32\' },\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total (S)\', value: null, unit: \'m\', required: true, excelCellRef: \'S32\' },\n    ],\n    calculationMethod: (params) => {\n      const t = params[\'tinggi\'];\n      const la = params[\'lebar_atas\'];\n      const lb = params[\'lebar_bawah\'];\n      const s = params[\'panjang_total\'];\n      if (t == null || la == null || lb == null || s == null) return null;\n      return t * (0.5 * (la + lb)) * s;\n    },\n  },\n  {\n    id: \'str-pondasi-footplat-beton\',\n    code: \'STR-PON-02\',\n    name: \'Pondasi Footplat - Beton K-350\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Pondasi\',\n    floorRule: \'fondasi_saja\',\n    description: \'Volume beton telapak footplat (bagian limas trapesium + bagian balok bawah).\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'[(I + J)/2 \303\227 K \303\227 T1 \303\227 Jml] + [I \303\227 K \303\227 T2 \303\227 Jml]\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U37 (Formula =SUM(U35:U36))\',\n    excelFormula: \'=SUM(U35:U36)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Terdiri dari Bagian 1 (kemiringan limas) dan Bagian 2 (persegi tebal telapak).\',\n    parameters: [\n      { id: \'lebar_alas\', name: \'lebar_alas\', label: \'Dimensi Alas (P & L)\', value: null, unit: \'m\', required: true, excelCellRef: \'I35\' },\n      { id: \'lebar_atas\', name: \'lebar_atas\', label: \'Dimensi Atas Limas (J)\', value: null, unit: \'m\', required: true, excelCellRef: \'J35\' },\n      { id: \'tebal_limas\', name: \'tebal_limas\', label: \'Tebal Kemiringan Limas (T1)\', value: null, unit: \'m\', required: true, excelCellRef: \'M35\' },\n      { id: \'tebal_alas\', name: \'tebal_alas\', label: \'Tebal Blok Bawah (T2)\', value: null, unit: \'m\', required: true, excelCellRef: \'M36\' },\n      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Pondasi (Jml)\', value: null, unit: \'titik\', required: true, excelCellRef: \'O35\' },\n    ],\n    calculationMethod: (params) => {\n      const ia = params[\'lebar_alas\'];\n      const ja = params[\'lebar_atas\'];\n      const t1 = params[\'tebal_limas\'];\n      const t2 = params[\'tebal_alas\'];\n      const jml = params[\'jumlah_titik\'];\n      if (ia == null || ja == null || t1 == null || t2 == null || jml == null) return null;\n      const vBagian1 = ((ia + ja) / 2) * ia * t1 * jml;\n      const vBagian2 = ia * ia * t2 * jml;\n      return vBagian1 + vBagian2;\n    },\n  },\n  {\n    id: \'str-pondasi-footplat-tulangan\',\n    code: \'STR-PON-03\',\n    name: \'Pondasi Footplat - Pembesian Tulangan D19\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Pondasi\',\n    floorRule: \'fondasi_saja\',\n    description: \'Berat besi tulangan anyaman atas dan bawah footplat D19 jarak 150 mm.\',\n    defaultUnit: \'kg\',\n    formulaDisplay: \'2 \303\227 [(Panjang / Jarak) \303\227 Jml \303\227 Berat Jenis \303\227 (Panjang + 2\303\227Kait)]\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U38 & U39 (Formula =(I38/0.15)*O38*T38*(((K38-0.08)+(M38-0.08)*2)))\',\n    excelFormula: \'=(I38/0.15)*O38*T38*(((K38-0.08)+(M38-0.08)*2))\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Dihitung untuk tulangan atas dan bawah (faktor 2\303\227). BJ D19 = 2.23 kg/m.\',\n    parameters: [\n      { id: \'panjang_bentang\', name: \'panjang_bentang\', label: \'Panjang Bentang Telapak (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I38\' },\n      { id: \'tinggi_tekukan\', name: \'tinggi_tekukan\', label: \'Tinggi Tekukan Kait (M)\', value: null, unit: \'m\', required: true, excelCellRef: \'M38\' },\n      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Pondasi\', value: null, unit: \'titik\', required: true, excelCellRef: \'O38\' },\n      { id: \'jarak_sengkang\', name: \'jarak_sengkang\', label: \'Jarak Antar Tulangan\', value: 0.15, unit: \'m\', required: true },\n      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per meter (BJ)\', value: 2.23, unit: \'kg/m\', required: true, excelCellRef: \'T38\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_bentang\'];\n      const m = params[\'tinggi_tekukan\'];\n      const n = params[\'jumlah_titik\'];\n      const s = params[\'jarak_sengkang\'] || 0.15;\n      const bj = params[\'berat_jenis\'] || 2.23;\n      if (p == null || m == null || n == null) return null;\n      // Rumus Excel USC: (p / s) * n * bj * ((p - 0.08) + (m - 0.08)*2)\n      const satuLapis = (p / s) * n * bj * ((p - 0.08) + (m - 0.08) * 2);\n      return satuLapis * 2; // Atas & Bawah\n    },\n  },\n  {\n    id: \'str-pondasi-footplat-bekisting\',\n    code: \'STR-PON-04\',\n    name: \'Pondasi Footplat - Bekisting 3x Pakai\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Pondasi\',\n    floorRule: \'fondasi_saja\',\n    description: \'Luas bekisting sisi tegak telapak pondasi footplat.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Keliling 4 Sisi \303\227 Tinggi Alas \303\227 Jumlah Titik\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U40 (Formula =K40*M40*Q40)\',\n    excelFormula: \'=K40*M40*Q40\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'K40 = sisi, M40 = tinggi, Q40 = 4 sisi.\',\n    parameters: [\n      { id: \'sisi\', name: \'sisi\', label: \'Panjang Sisi Telapak\', value: null, unit: \'m\', required: true, excelCellRef: \'K40\' },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Sisi Bekisting\', value: null, unit: \'m\', required: true, excelCellRef: \'M40\' },\n      { id: \'jumlah_titik\', name: \'jumlah_titik\', label: \'Jumlah Titik Pondasi\', value: null, unit: \'titik\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const s = params[\'sisi\'];\n      const t = params[\'tinggi\'];\n      const n = params[\'jumlah_titik\'] || 1;\n      if (s == null || t == null) return null;\n      return s * t * 4 * n;\n    },\n  },\n\n  // ==========================================\n  // III. PEKERJAAN STRUKTURAL - BALOK, KOLOM, PELAT\n  // ==========================================\n  {\n    id: \'str-sloof-beton\',\n    code: \'STR-SLF-01\',\n    name: \'Sloof Beton K-350 (40 x 60 cm)\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Kolom & Sloof\',\n    floorRule: \'fondasi_saja\',\n    description: \'Balok pengikat pondasi (sloof) penampang 40x60 cm mutu K-350.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Panjang Total \303\227 Lebar \303\227 Tinggi\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U65 (Formula =I65*K65*M65)\',\n    excelFormula: \'=I65*K65*M65\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'I65 = total panjang sloof, K65 = 0.4m, M65 = 0.6m.\',\n    parameters: [\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Sloof (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I65\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Sloof (L)\', value: 0.4, unit: \'m\', required: true, excelCellRef: \'K65\' },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Sloof (T)\', value: 0.6, unit: \'m\', required: true, excelCellRef: \'M65\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const l = params[\'lebar\'] ?? 0.4;\n      const t = params[\'tinggi\'] ?? 0.6;\n      if (p == null || isNaN(p)) return null;\n      return p * l * t;\n    },\n  },\n  {\n    id: \'str-sloof-tulangan\',\n    code: \'STR-SLF-02\',\n    name: \'Sloof Tulangan Pokok 10D22 Ulir\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Kolom & Sloof\',\n    floorRule: \'fondasi_saja\',\n    description: \'Pembesian tulangan longitudinal sloof 10 buah besi D22.\',\n    defaultUnit: \'kg\',\n    formulaDisplay: \'Panjang Total \303\227 Jumlah Batang (10) \303\227 Berat Jenis (2.98 kg/m)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U66 (Formula =I66*Q66*T66)\',\n    excelFormula: \'=I66*Q66*T66\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'BJ D22 ulir = 2.98 kg/m.\',\n    parameters: [\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Sloof (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I66\' },\n      { id: \'jumlah_batang\', name: \'jumlah_batang\', label: \'Jumlah Batang Besi\', value: 10, unit: \'btg\', required: true, excelCellRef: \'Q66\' },\n      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per Meter\', value: 2.98, unit: \'kg/m\', required: true, excelCellRef: \'T66\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const q = params[\'jumlah_batang\'] || 10;\n      const bj = params[\'berat_jenis\'] || 2.98;\n      if (p == null || isNaN(p)) return null;\n      return p * q * bj;\n    },\n  },\n  {\n    id: \'str-sloof-bekisting\',\n    code: \'STR-SLF-03\',\n    name: \'Sloof Bekisting 3x Pakai\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Kolom & Sloof\',\n    floorRule: \'fondasi_saja\',\n    description: \'Pemasangan bekisting kayu dua sisi samping sloof.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Panjang Total \303\227 Tinggi Sisi \303\227 2 Sisi\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U69 (Formula =I69*K69*Q69)\',\n    excelFormula: \'=I69*K69*Q69\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Q69 = 2 sisi samping.\',\n    parameters: [\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Sloof\', value: null, unit: \'m\', required: true, excelCellRef: \'I69\' },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Bekisting\', value: 0.4, unit: \'m\', required: true, excelCellRef: \'K69\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const t = params[\'tinggi\'] ?? 0.4;\n      if (p == null || isNaN(p)) return null;\n      return p * t * 2;\n    },\n  },\n  {\n    id: \'str-kolom-k1-beton\',\n    code: \'STR-KLM-01\',\n    name: \'Kolom Type K1 (50 x 50 cm) - Beton K-350\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Kolom utama ukuran 50x50 cm mutu beton K-350.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Lebar \303\227 Tebal \303\227 Tinggi Bersih \303\227 Jumlah Kolom\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U71, U135, U200, U265 (Formula =I71*K71*M71*O71)\',\n    excelFormula: \'=I71*K71*M71*O71\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Terverifikasi pada setiap elevasi lantai.\',\n    parameters: [\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Kolom (P)\', value: 0.5, unit: \'m\', required: true, excelCellRef: \'I71\' },\n      { id: \'tebal\', name: \'tebal\', label: \'Tebal Kolom (L)\', value: 0.5, unit: \'m\', required: true, excelCellRef: \'K71\' },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Kolom Bersih (T)\', value: 4.0, unit: \'m\', required: true, excelCellRef: \'M71\' },\n      { id: \'jumlah\', name: \'jumlah\', label: \'Jumlah Titik Kolom (Jml)\', value: null, unit: \'titik\', required: true, excelCellRef: \'O71\' },\n    ],\n    calculationMethod: (params) => {\n      const l = params[\'lebar\'] ?? 0.5;\n      const t = params[\'tebal\'] ?? 0.5;\n      const h = params[\'tinggi\'] ?? 4.0;\n      const n = params[\'jumlah\'];\n      if (n == null || isNaN(n)) return null;\n      return l * t * h * n;\n    },\n  },\n  {\n    id: \'str-kolom-k1-tulangan\',\n    code: \'STR-KLM-02\',\n    name: \'Kolom Type K1 - Tulangan Pokok 12D22 Ulir\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Besi tulangan memanjang kolom K1 12D22 Ulir.\',\n    defaultUnit: \'kg\',\n    formulaDisplay: \'Tinggi \303\227 Jumlah Titik \303\227 Jumlah Batang (12) \303\227 BJ (2.98 kg/m)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U72, U136, U201, U266 (Formula =T72*O72*M72*Q72)\',\n    excelFormula: \'=T72*O72*M72*Q72\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'T72 = 2.98 kg/m, Q72 = 12 btg.\',\n    parameters: [\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Kolom (M)\', value: 4.0, unit: \'m\', required: true, excelCellRef: \'M72\' },\n      { id: \'jumlah\', name: \'jumlah\', label: \'Jumlah Titik Kolom (O)\', value: null, unit: \'titik\', required: true, excelCellRef: \'O72\' },\n      { id: \'jumlah_batang\', name: \'jumlah_batang\', label: \'Jumlah Batang per Kolom\', value: 12, unit: \'btg\', required: true, excelCellRef: \'Q72\' },\n      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per Meter\', value: 2.98, unit: \'kg/m\', required: true, excelCellRef: \'T72\' },\n    ],\n    calculationMethod: (params) => {\n      const h = params[\'tinggi\'] ?? 4.0;\n      const n = params[\'jumlah\'];\n      const q = params[\'jumlah_batang\'] || 12;\n      const bj = params[\'berat_jenis\'] || 2.98;\n      if (n == null || isNaN(n)) return null;\n      return h * n * q * bj;\n    },\n  },\n  {\n    id: \'str-kolom-k1-bekisting\',\n    code: \'STR-KLM-03\',\n    name: \'Kolom Type K1 - Bekisting 3x Pakai\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Bekisting 4 sisi kolom K1.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Keliling 4 Sisi \303\227 Tinggi \303\227 Jumlah Titik\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U75, U139, U204, U269 (Formula =(I75*Q75*O75*M75)+(K75*Q75*O75*M75))\',\n    excelFormula: \'=(I75*Q75*O75*M75)+(K75*Q75*O75*M75)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'2 sisi arah X + 2 sisi arah Y.\',\n    parameters: [\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Kolom (P)\', value: 0.5, unit: \'m\', required: true },\n      { id: \'tebal\', name: \'tebal\', label: \'Tebal Kolom (L)\', value: 0.5, unit: \'m\', required: true },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Bersih (T)\', value: 4.0, unit: \'m\', required: true },\n      { id: \'jumlah\', name: \'jumlah\', label: \'Jumlah Titik Kolom\', value: null, unit: \'titik\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const l = params[\'lebar\'] ?? 0.5;\n      const t = params[\'tebal\'] ?? 0.5;\n      const h = params[\'tinggi\'] ?? 4.0;\n      const n = params[\'jumlah\'];\n      if (n == null || isNaN(n)) return null;\n      return 2 * (l + t) * h * n;\n    },\n  },\n  {\n    id: \'str-kolom-k2-beton\',\n    code: \'STR-KLM-04\',\n    name: \'Kolom Type K2 (30 x 30 cm) - Beton K-350\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Kolom sekunder ukuran 30x30 cm mutu beton K-350.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Lebar \303\227 Tebal \303\227 Tinggi Bersih \303\227 Jumlah Kolom\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U77, U141, U206, U271 (Formula =I77*K77*M77*O77)\',\n    excelFormula: \'=I77*K77*M77*O77\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Kolom K2 30x30 cm.\',\n    parameters: [\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Kolom (P)\', value: 0.3, unit: \'m\', required: true },\n      { id: \'tebal\', name: \'tebal\', label: \'Tebal Kolom (L)\', value: 0.3, unit: \'m\', required: true },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Kolom (T)\', value: 4.0, unit: \'m\', required: true },\n      { id: \'jumlah\', name: \'jumlah\', label: \'Jumlah Titik Kolom\', value: null, unit: \'titik\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const l = params[\'lebar\'] ?? 0.3;\n      const t = params[\'tebal\'] ?? 0.3;\n      const h = params[\'tinggi\'] ?? 4.0;\n      const n = params[\'jumlah\'];\n      if (n == null || isNaN(n)) return null;\n      return l * t * h * n;\n    },\n  },\n  {\n    id: \'str-kolom-praktis\',\n    code: \'STR-KLM-05\',\n    name: \'Kolom Praktis 15 x 15 cm\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Kolom pengikat dinding bata hebel 15x15 cm.\',\n    defaultUnit: \'m\\\'\',\n    formulaDisplay: \'Tinggi Kolom Praktis \303\227 Jumlah Batang\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U82, U146, U211, U276 (Formula =M82*O82)\',\n    excelFormula: \'=M82*O82\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Satuan m\\\' panjang total.\',\n    parameters: [\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi per Kolom (M)\', value: 3.4, unit: \'m\', required: true, excelCellRef: \'M82\' },\n      { id: \'jumlah\', name: \'jumlah\', label: \'Jumlah Titik Kolom Praktis (O)\', value: null, unit: \'titik\', required: true, excelCellRef: \'O82\' },\n    ],\n    calculationMethod: (params) => {\n      const t = params[\'tinggi\'] ?? 3.4;\n      const n = params[\'jumlah\'];\n      if (n == null || isNaN(n)) return null;\n      return t * n;\n    },\n  },\n  {\n    id: \'str-balok-b1-beton\',\n    code: \'STR-BLK-01\',\n    name: \'Balok Induk Type 1 (40 x 60 cm) - Beton K-350\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Balok induk penampang 40x60 cm beton mutu K-350.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Panjang Total \303\227 Lebar (0.4m) \303\227 Tinggi (0.6m)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U85, U149, U214, U279 (Formula =I85*K85*M85)\',\n    excelFormula: \'=I85*K85*M85\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'K85 = 0.3 / 0.4m, M85 = 0.6m.\',\n    parameters: [\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Balok B1 (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I85\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Balok (L)\', value: 0.4, unit: \'m\', required: true, excelCellRef: \'K85\' },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Balok (T)\', value: 0.6, unit: \'m\', required: true, excelCellRef: \'M85\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const l = params[\'lebar\'] ?? 0.4;\n      const t = params[\'tinggi\'] ?? 0.6;\n      if (p == null || isNaN(p)) return null;\n      return p * l * t;\n    },\n  },\n  {\n    id: \'str-balok-b1-tulangan\',\n    code: \'STR-BLK-02\',\n    name: \'Balok Induk Type 1 - Tulangan Pokok 10D22 Ulir\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Besi longitudinal balok B1 10D22.\',\n    defaultUnit: \'kg\',\n    formulaDisplay: \'Panjang Total \303\227 Jumlah Batang (10) \303\227 BJ (2.23 kg/m)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U86, U150, U215, U280 (Formula =T86*Q86*I86)\',\n    excelFormula: \'=T86*Q86*I86\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'T86 = 2.23 kg/m.\',\n    parameters: [\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Balok\', value: null, unit: \'m\', required: true, excelCellRef: \'I86\' },\n      { id: \'jumlah_batang\', name: \'jumlah_batang\', label: \'Jumlah Batang\', value: 10, unit: \'btg\', required: true, excelCellRef: \'Q86\' },\n      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per Meter\', value: 2.23, unit: \'kg/m\', required: true, excelCellRef: \'T86\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const q = params[\'jumlah_batang\'] || 10;\n      const bj = params[\'berat_jenis\'] || 2.23;\n      if (p == null || isNaN(p)) return null;\n      return p * q * bj;\n    },\n  },\n  {\n    id: \'str-balok-b1-bekisting\',\n    code: \'STR-BLK-03\',\n    name: \'Balok Induk Type 1 - Bekisting 3x Pakai\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Bekisting 2 sisi samping dan 1 sisi bawah balok B1.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Panjang \303\227 Tinggi \303\227 2) + (Panjang \303\227 Lebar \303\227 1)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U89, U153, U218, U283 (Formula =(I89*M89*Q89)+(I89*K89*1))\',\n    excelFormula: \'=(I89*M89*Q89)+(I89*K89*1)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Q89 = 2 sisi samping, 1 sisi bawah.\',\n    parameters: [\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Balok\', value: null, unit: \'m\', required: true, excelCellRef: \'I89\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Balok (K)\', value: 0.4, unit: \'m\', required: true, excelCellRef: \'K89\' },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Balok (M)\', value: 0.6, unit: \'m\', required: true, excelCellRef: \'M89\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const l = params[\'lebar\'] ?? 0.4;\n      const t = params[\'tinggi\'] ?? 0.6;\n      if (p == null || isNaN(p)) return null;\n      return p * t * 2 + p * l;\n    },\n  },\n  {\n    id: \'str-balok-b2-beton\',\n    code: \'STR-BLK-04\',\n    name: \'Balok Anak Type 2 (20 x 40 cm) - Beton K-350\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Balok & Kolom\',\n    floorRule: \'per_lantai\',\n    description: \'Balok anak penampang 20x40 cm beton K-350.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'Panjang Total \303\227 Lebar (0.2m) \303\227 Tinggi (0.4m)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U91, U155, U220, U285 (Formula =I91*K91*M91)\',\n    excelFormula: \'=I91*K91*M91\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'K91 = 0.2m, M91 = 0.4m.\',\n    parameters: [\n      { id: \'panjang_total\', name: \'panjang_total\', label: \'Panjang Total Balok B2 (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I91\' },\n      { id: \'lebar\', name: \'lebar\', label: \'Lebar Balok (L)\', value: 0.2, unit: \'m\', required: true, excelCellRef: \'K91\' },\n      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Balok (T)\', value: 0.4, unit: \'m\', required: true, excelCellRef: \'M91\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_total\'];\n      const l = params[\'lebar\'] ?? 0.2;\n      const t = params[\'tinggi\'] ?? 0.4;\n      if (p == null || isNaN(p)) return null;\n      return p * l * t;\n    },\n  },\n  {\n    id: \'str-pelat-lantai-beton\',\n    code: \'STR-PLT-01\',\n    name: \'Pelat Lantai P1 (Tebal 12 cm) - Beton K-350\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Pelat Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Volume pelat lantai beton bertulang tebal 12 cm setelah dikurangi bukaan void.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'(Luas Bruto Bangunan \342\210\222 Luas Void/Bukaan) \303\227 Tebal Pelat (0.12 m)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U124, U189, U254, U313 (Formula =((I124*K124)-void)*M124)\',\n    excelFormula: \'=((I124*K124)-1.155-11.8845-7.6237-69.525)*M124\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Pengurangan void tangga, lift, dan void gedung sesuai permodelan.\',\n    parameters: [\n      { id: \'panjang_bangunan\', name: \'panjang_bangunan\', label: \'Panjang Pelat (P)\', value: 25.0, unit: \'m\', required: true, excelCellRef: \'I124\' },\n      { id: \'lebar_bangunan\', name: \'lebar_bangunan\', label: \'Lebar Pelat (L)\', value: 20.0, unit: \'m\', required: true, excelCellRef: \'K124\' },\n      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan / Void\', value: 0, unit: \'m\302\262\', required: false },\n      { id: \'tebal_pelat\', name: \'tebal_pelat\', label: \'Tebal Pelat Lantai (T)\', value: 0.12, unit: \'m\', required: true, excelCellRef: \'M124\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_bangunan\'];\n      const l = params[\'lebar_bangunan\'];\n      const voidArea = params[\'luas_bukaan\'] || 0;\n      const t = params[\'tebal_pelat\'] ?? 0.12;\n      if (p == null || l == null) return null;\n      const luasBersih = Math.max(0, p * l - voidArea);\n      return luasBersih * t;\n    },\n  },\n  {\n    id: \'str-pelat-lantai-bekisting\',\n    code: \'STR-PLT-02\',\n    name: \'Pelat Lantai - Bekisting 3x Pakai\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Pelat Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Bekisting bawah pelat lantai (luas bersih lantai setelah bukaan).\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Bruto Bangunan \342\210\222 Luas Void/Bukaan\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U133, U198, U263, U322\',\n    excelFormula: \'=((I124*K124)-1.155-11.8845-7.6237-67.98)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Luas bekisting pelat.\',\n    parameters: [\n      { id: \'panjang_bangunan\', name: \'panjang_bangunan\', label: \'Panjang Pelat (P)\', value: 25.0, unit: \'m\', required: true },\n      { id: \'lebar_bangunan\', name: \'lebar_bangunan\', label: \'Lebar Pelat (L)\', value: 20.0, unit: \'m\', required: true },\n      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan / Void\', value: 0, unit: \'m\302\262\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_bangunan\'];\n      const l = params[\'lebar_bangunan\'];\n      const voidArea = params[\'luas_bukaan\'] || 0;\n      if (p == null || l == null) return null;\n      return Math.max(0, p * l - voidArea);\n    },\n  },\n  {\n    id: \'str-tangga-beton\',\n    code: \'STR-TGG-01\',\n    name: \'Anak Tangga & Bordes - Beton K-350\',\n    category: \'Struktural\',\n    subCategory: \'Struktur Tangga\',\n    floorRule: \'per_lantai\',\n    description: \'Volume beton anak tangga segitiga (optrede/antrede) dan pelat bordes.\',\n    defaultUnit: \'m\302\263\',\n    formulaDisplay: \'[(0.5 \303\227 O \303\227 A) \303\227 Jml Anak Tangga \303\227 Lebar \303\227 Unit] + (P_bordes \303\227 L_bordes \303\227 T_bordes)\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U114 & U119 (Formula =(1/2*0.27*0.16)*12*K114*Q114*O114)\',\n    excelFormula: \'=(1/2*0.27*0.16)*12*K114*Q114*O114\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Optrede 0.16m, Antrede 0.27m, 12 anak tangga per trap.\',\n    parameters: [\n      { id: \'antrede\', name: \'antrede\', label: \'Lebar Pijakan / Antrede\', value: 0.27, unit: \'m\', required: true },\n      { id: \'optrede\', name: \'optrede\', label: \'Tinggi Tanjakan / Optrede\', value: 0.16, unit: \'m\', required: true },\n      { id: \'jumlah_anak_tangga\', name: \'jumlah_anak_tangga\', label: \'Jumlah Anak Tangga\', value: 24, unit: \'bh\', required: true },\n      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', value: 1.4, unit: \'m\', required: true, excelCellRef: \'K114\' },\n      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Pelat Bordes\', value: 2.85, unit: \'m\302\262\', required: false, excelCellRef: \'I119\' },\n      { id: \'tebal_bordes\', name: \'tebal_bordes\', label: \'Tebal Pelat Bordes\', value: 0.12, unit: \'m\', required: false, excelCellRef: \'M119\' },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'antrede\'] ?? 0.27;\n      const o = params[\'optrede\'] ?? 0.16;\n      const n = params[\'jumlah_anak_tangga\'] || 24;\n      const w = params[\'lebar_tangga\'] || 1.4;\n      const lb = params[\'luas_bordes\'] || 0;\n      const tb = params[\'tebal_bordes\'] || 0.12;\n      const vAnakTangga = 0.5 * a * o * n * w;\n      const vBordes = lb * tb;\n      return vAnakTangga + vBordes;\n    },\n  },\n  {\n    id: \'str-atap-baja-ringan\',\n    code: \'STR-ATP-01\',\n    name: \'Pemasangan Rangka Atap Baja Ringan C.75.75\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Atap dan Penutup Atap\',\n    floorRule: \'atap_saja\',\n    description: \'Rangka kuda-kuda dan usuk profil kanal C baja ringan.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Bidang Atap Miring\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U329\',\n    excelFormula: \'=U325\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Luas bidang miring atap gedung.\',\n    parameters: [\n      { id: \'panjang_atap\', name: \'panjang_atap\', label: \'Panjang Bidang Atap\', value: null, unit: \'m\', required: true },\n      { id: \'lebar_atap\', name: \'lebar_atap\', label: \'Lebar Kemiringan Atap\', value: null, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_atap\'];\n      const l = params[\'lebar_atap\'];\n      if (p == null || l == null) return null;\n      return p * l;\n    },\n  },\n  {\n    id: \'str-atap-penutup-alderon\',\n    code: \'STR-ATP-02\',\n    name: \'Pemasangan Penutup Atap Alderon\',\n    category: \'Struktural\',\n    subCategory: \'Pekerjaan Atap dan Penutup Atap\',\n    floorRule: \'atap_saja\',\n    description: \'Penutup atap lembaran UPVC gelombang Alderon.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Bidang Penutup Atap\',\n    excelSheet: \'Volume Struktural\',\n    excelCell: \'U330\',\n    excelFormula: \'=U326\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Sama dengan luas bidang penutup.\',\n    parameters: [\n      { id: \'luas_bidang\', name: \'luas_bidang\', label: \'Luas Bidang Penutup Atap\', value: null, unit: \'m\302\262\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_bidang\'];\n      if (a == null || isNaN(a)) return null;\n      return a;\n    },\n  },\n\n  // ==========================================\n  // IV. PEKERJAAN ARSITEKTURAL\n  // ==========================================\n  {\n    id: \'ars-dinding-bata-hebel\',\n    code: \'ARS-DND-01\',\n    name: \'Pemasangan Dinding Bata Ringan (Hebel)\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pasangan Dinding dan Plesteran\',\n    floorRule: \'per_lantai\',\n    description: \'Pasangan bata hebel tebal 10 cm, dihitung luas bruto dinding dikurangi bukaan pintu dan jendela.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Panjang Keliling Dinding \303\227 Tinggi Dinding) \342\210\222 Luas Bukaan\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U31, U169, U303, U437 (Formula =U16-U30)\',\n    excelFormula: \'=M16*I16-SUM(U17:U29)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'U16 = Luas bruto (Panjang \303\227 Tinggi 3.4m), U30 = Total pengurangan bukaan (P1, P2, P3, P4, J1, J2, J3, J4, BV, Rooster).\',\n    parameters: [\n      { id: \'panjang_keliling\', name: \'panjang_keliling\', label: \'Panjang Keliling Dinding (P)\', value: null, unit: \'m\', required: true, excelCellRef: \'I16\' },\n      { id: \'tinggi_dinding\', name: \'tinggi_dinding\', label: \'Tinggi Dinding (T)\', value: 3.4, unit: \'m\', required: true, excelCellRef: \'M16\' },\n      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan Pintu/Jendela\', value: 0, unit: \'m\302\262\', required: false, excelCellRef: \'U30\' },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'panjang_keliling\'];\n      const t = params[\'tinggi_dinding\'];\n      const b = params[\'luas_bukaan\'] || 0;\n      if (p == null || isNaN(p) || t == null || isNaN(t)) return null;\n      return Math.max(0, p * t - b);\n    },\n  },\n  {\n    id: \'ars-plesteran-acian-15mm\',\n    code: \'ARS-DND-02\',\n    name: \'Plesteran 1SP : 6PP (t = 15 mm) & Acian\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pasangan Dinding dan Plesteran\',\n    floorRule: \'per_lantai\',\n    description: \'Plesteran dua muka dinding dikurangi area dinding keramik toilet dan panel pelapis.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Luas Bersih Dinding \303\227 2 Muka) \342\210\222 Luas Keramik Toilet \342\210\222 Luas Panel Ornamen\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U33, U171, U305, U439 (Formula =(U31*2)-U38-U36-U35-U37)\',\n    excelFormula: \'=(U31*2)-U38-U36-U35-U37\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Formula memperhitungkan 2 sisi dinding bata dikurangi pasangan keramik/batu.\',\n    parameters: [\n      { id: \'luas_dinding_bersih\', name: \'luas_dinding_bersih\', label: \'Luas Dinding Bata Bersih\', value: null, unit: \'m\302\262\', required: true, excelCellRef: \'U31\' },\n      { id: \'luas_keramik_toilet\', name: \'luas_keramik_toilet\', label: \'Pengurangan Keramik Toilet\', value: 0, unit: \'m\302\262\', required: false, excelCellRef: \'U35\' },\n      { id: \'luas_panel_ornamen\', name: \'luas_panel_ornamen\', label: \'Pengurangan Panel Kayu/Batu\', value: 0, unit: \'m\302\262\', required: false, excelCellRef: \'U37\' },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_dinding_bersih\'];\n      const kt = params[\'luas_keramik_toilet\'] || 0;\n      const po = params[\'luas_panel_ornamen\'] || 0;\n      if (a == null || isNaN(a)) return null;\n      return Math.max(0, a * 2 - kt - po);\n    },\n  },\n  {\n    id: \'ars-keramik-dinding-toilet\',\n    code: \'ARS-DND-03\',\n    name: \'Pemasangan Keramik Dinding Toilet 25 x 40 cm\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Pasangan Dinding dan Plesteran\',\n    floorRule: \'per_lantai\',\n    description: \'Pasangan keramik dinding toilet polished warna putih.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Keliling Ruang Toilet \303\227 Tinggi Pasangan Keramik\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U35, U173, U307, U441 (Formula =((4.9*2)*2)+((13.6*2)*1))\',\n    excelFormula: \'=((4.9*2)*2)+((13.6*2)*1)+((13.65*2)*0)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Perhitungan keliling toilet dikali tinggi pasang.\',\n    parameters: [\n      { id: \'keliling_toilet\', name: \'keliling_toilet\', label: \'Total Keliling Dinding Toilet (P)\', value: null, unit: \'m\', required: true },\n      { id: \'tinggi_keramik\', name: \'tinggi_keramik\', label: \'Tinggi Pasangan Keramik (T)\', value: 2.0, unit: \'m\', required: true },\n    ],\n    calculationMethod: (params) => {\n      const p = params[\'keliling_toilet\'];\n      const t = params[\'tinggi_keramik\'] ?? 2.0;\n      if (p == null || isNaN(p)) return null;\n      return p * t;\n    },\n  },\n  {\n    id: \'ars-homogenous-tile-60x60\',\n    code: \'ARS-LNT-01\',\n    name: \'Pemasangan Homogenous Tile 60 x 60 cm\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Penutup Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Ubin granit/HT putih gloss untuk ruang kelas, hall, koridor gedung.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Ruang Lantai HT\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U42, U177, U311, U445\',\n    excelFormula: \'=((25*20)-U178-U179-U176)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Dihitung dari luas lantai dikurangi toilet, tangga, dan granit marble entrance.\',\n    parameters: [\n      { id: \'luas_lantai\', name: \'luas_lantai\', label: \'Luas Bersih Area HT\', value: null, unit: \'m\302\262\', required: true, excelCellRef: \'U42\' },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_lantai\'];\n      if (a == null || isNaN(a)) return null;\n      return a;\n    },\n  },\n  {\n    id: \'ars-keramik-toilet-antislip\',\n    code: \'ARS-LNT-02\',\n    name: \'Pemasangan Keramik Lantai Toilet 40 x 40 cm Anti-Slip\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Penutup Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Ubin keramik lantai toilet tekstur kasar anti licin.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Panjang Toilet \303\227 Lebar Toilet \303\227 Jumlah Ruang Toilet\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U43, U178, U312, U446\',\n    excelFormula: \'=((4.9*2)*2)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Luas lantai ruang toilet pria dan wanita.\',\n    parameters: [\n      { id: \'luas_total_toilet\', name: \'luas_total_toilet\', label: \'Luas Total Lantai Toilet\', value: null, unit: \'m\302\262\', required: true, excelCellRef: \'U43\' },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'luas_total_toilet\'];\n      if (a == null || isNaN(a)) return null;\n      return a;\n    },\n  },\n  {\n    id: \'ars-keramik-tangga-motif-kayu\',\n    code: \'ARS-LNT-03\',\n    name: \'Pemasangan Keramik Tangga 30 x 30 cm Motif Kayu\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Penutup Lantai\',\n    floorRule: \'per_lantai\',\n    description: \'Ubin keramik pijakan anak tangga motif kayu + "
