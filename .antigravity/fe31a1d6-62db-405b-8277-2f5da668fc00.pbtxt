    content: "/**\n * Katalog Pekerjaan Konstruksi Standar RuangRAB\n * Mendukung perhitungan volume Pekerjaan Persiapan, Struktural, Arsitektural, dan MEP.\n * Seluruh parameter dimensi menggunakan nilai awal null agar tidak mengisi ukuran secara diam-diam.\n */\n\nimport { CatalogWorkItem } from \'../types\';\n\nexport const USC_CATALOG_VERSION = \'2.0.0-STANDARD\';\n\nexport const CATALOG_WORK_ITEMS: CatalogWorkItem[] = [\n  // ==========================================\n  // I. PEKERJAAN PERSIAPAN & UMUM\n  // ==========================================\n  {\n    id: \'prep-pembersihan-lahan\',\n    code: \'PER-01\',\n    name: \'Pembersihan Lahan\',\n    category: \'Persiapan Dll\',\n    subCategory: \'Pekerjaan Persiapan\',\n    floorRule: \'umum\',\n    description: \'Pembersihan dan perataan area lahan sebelum memulai pekerjaan konstruksi.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Panjang \303\227 Lebar\',\n    excelSheet: \'Volume Persiapan Dll\',\n    excelCell: \'J8\',\n    excelFormula: \'=G9*G10\',\n    verificationStatus: \'Lengkap\',\n    parameters: [\n      { id: \'panjang\', name: \'panjang\', label: \'Panjang Lahan\', placeholder: \'Masukkan panjang lahan (m)\', value: null, unit: \'m\', required: true },"
    num_lines: 1621
