            }
            lines {
              text: "    excelCell: \'U62\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excelFormula: \'=(I62+K62)*2*(M62/0.15)*O62*T62\',"
