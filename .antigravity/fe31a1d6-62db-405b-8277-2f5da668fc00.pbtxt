  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * RuangRAB - Server Backend\n * Express API server with Vite middleware integration, server-side Gemini API,\n * multi-type engineering drawing reader, segment-based beam/sloof extractor,\n * and secure user authentication endpoints.\n */\n\nimport express, { Request, Response, NextFunction } from \'express\';\nimport { createServer as createViteServer } from \'vite\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport path from \'path\';\nimport fs from \'fs\';\nimport crypto from \'crypto\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst app = express();\nconst PORT = process.env.PORT ? parseInt(process.env.PORT, 10) : 3000;\nconst isProd = process.env.NODE_ENV === \'production\';\n\n// Support civil engineering high-resolution drawing PDFs & CAD image uploads (up to 50MB)\napp.use(express.json({ limit: \'50mb\' }));\napp.use(express.urlencoded({ extended: true, limit: \'50mb\' }));\n\n// Middleware to catch JSON parsing and payload size errors before they return HTML\napp.use((err: any, req: Request, res: Response, next: NextFunction): void => {\n  if (err) {\n    console.error(\'[RuangRAB Server Middleware Error]:\', err);\n    res.setHeader(\'Content-Type\', \'application/json\');\n    if (err.type === \'entity.too.large\') {\n      res.status(413).json({\n        success: false,\n        error: \'Ukuran file dokumen terlalu besar. Harap unggah file di bawah 15 MB.\',\n      });\n      return;\n    }\n    res.status(err.status || 400).json({\n      success: false,\n      error: err.message || \'Format data permintaan tidak valid.\',\n    });\n    return;\n  }\n  next();\n});\n\n// =========================================================\n// PENYIMPANAN AKUN PENGGUNA SERVER (DENGAN SCRYPT HASHING)\n// =========================================================\ninterface ServerUserRecord {\n  uid: string;\n  fullName: string;\n  email: string;\n  userType: \'Student\' | \'Estimator\' | \'Other\';\n  salt: string;\n  passwordHash: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\nconst DATA_DIR = path.resolve(process.cwd(), \'data\');\nconst USERS_FILE = path.join(DATA_DIR, \'users_store.json\');\n\nfunction loadServerUsers(): ServerUserRecord[] {\n  try {\n    if (!fs.existsSync(USERS_FILE)) return [];\n    const raw = fs.readFileSync(USERS_FILE, \'utf-8\');\n    const parsed = JSON.parse(raw);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    return [];\n  }\n}\n\nfunction saveServerUsers(users: ServerUserRecord[]): void {\n  try {\n    if (!fs.existsSync(DATA_DIR)) {\n      fs.mkdirSync(DATA_DIR, { recursive: true });\n    }\n    fs.writeFileSync(USERS_FILE, JSON.stringify(users, null, 2), \'utf-8\');\n  } catch (err) {\n    console.error(\'[RuangRAB Auth] Gagal menyimpan users_store.json:\', err);\n  }\n}\n\nfunction hashPasswordScrypt(password: string, salt: string): string {\n  return crypto.scryptSync(password, salt, 64).toString(\'hex\');\n}\n\napp.post(\'/api/auth/register\', (req: Request, res: Response): void => {\n  res.setHeader(\'Content-Type\', \'application/json\');\n  const { fullName, email, password, userType } = req.body || {};\n\n  if (!fullName || !email || !password) {\n    res.status(400).json({\n      success: false,\n      error: \'Nama lengkap, alamat email, dan password wajib diisi.\',\n    });\n    return;\n  }\n\n  const cleanEmail = String(email).trim().toLowerCase();\n  const cleanName = String(fullName).trim();\n  const cleanRole: \'Student\' | \'Estimator\' | \'Other\' =\n    userType === \'Student\' || userType === \'Estimator\' || userType === \'Other\'\n      ? userType\n      : \'Estimator\';\n\n  if (String(password).length < 6) {\n    res.status(400).json({\n      success: false,\n      error: \'Password minimal harus terdiri dari 6 karakter.\',\n    });\n    return;\n  }\n\n  const users = loadServerUsers();\n  if (users.some((u) => u.email.toLowerCase() === cleanEmail)) {\n    res.status(409).json({\n      success: false,\n      error: \'Alamat email ini sudah terdaftar. Silakan masuk melalui menu Sign In.\',\n    });\n    return;\n  }\n\n  const salt = crypto.randomBytes(16).toString(\'hex\');\n  const passwordHash = hashPasswordScrypt(String(password), salt);\n  const now = new Date().toISOString();\n\n  const newUser: ServerUserRecord = {\n    uid: `usr_${crypto.randomBytes(8).toString(\'hex\')}`,\n    fullName: cleanName,\n    email: cleanEmail,\n    userType: cleanRole,\n    salt,\n    passwordHash,\n    createdAt: now,\n    updatedAt: now,\n  };\n\n  users.push(newUser);\n  saveServerUsers(users);\n\n  res.json({\n    success: true,\n    user: {\n      uid: newUser.uid,\n      fullName: newUser.fullName,\n      email: newUser.email,\n      userType: newUser.userType,\n      createdAt: newUser.createdAt,\n      updatedAt: newUser.updatedAt,\n      authProvider: \'email\',\n    },\n  });\n});\n\napp.post(\'/api/auth/login\', (req: Request, res: Response): void => {\n  res.setHeader(\'Content-Type\', \'application/json\');\n  const { email, password } = req.body || {};\n\n  if (!email || !password) {\n    res.status(400).json({\n      success: false,\n      error: \'Email dan password wajib diisi.\',\n    });\n    return;\n  }\n\n  const cleanEmail = String(email).trim().toLowerCase();\n  const users = loadServerUsers();\n  const found = users.find((u) => u.email.toLowerCase() === cleanEmail);\n\n  if (!found) {\n    res.status(404).json({\n      success: false,\n      error: \'Akun dengan alamat email tersebut belum terdaftar. Silakan buat akun baru.\',\n    });\n    return;\n  }\n\n  const candidateHash = hashPasswordScrypt(String(password), found.salt);\n  if (candidateHash !== found.passwordHash) {\n    res.status(401).json({\n      success: false,\n      error: \'Password yang Anda masukkan tidak sesuai. Silakan periksa kembali.\',\n    });\n    return;\n  }\n\n  res.json({\n    success: true,\n    user: {\n      uid: found.uid,\n      fullName: found.fullName,\n      email: found.email,\n      userType: found.userType,\n      createdAt: found.createdAt,\n      updatedAt: found.updatedAt,\n      authProvider: \'email\',\n    },\n  });\n});\n\napp.post(\'/api/auth/update-profile\', (req: Request, res: Response): void => {\n  res.setHeader(\'Content-Type\', \'application/json\');\n  const { uid, email, fullName, userType } = req.body || {};\n  const users = loadServerUsers();\n  const idx = users.findIndex(\n    (u) => u.uid === uid || (email && u.email.toLowerCase() === String(email).toLowerCase())\n  );\n\n  if (idx >= 0) {\n    if (fullName) users[idx].fullName = String(fullName).trim();\n    if (userType === \'Student\' || userType === \'Estimator\' || userType === \'Other\') {\n      users[idx].userType = userType;\n    }\n    users[idx].updatedAt = new Date().toISOString();\n    saveServerUsers(users);\n  }\n\n  res.json({ success: true });\n});\n\napp.post(\'/api/auth/reset-password\', (req: Request, res: Response): void => {\n  res.setHeader(\'Content-Type\', \'application/json\');\n  const { email, newPassword } = req.body || {};\n  if (!email || !newPassword || String(newPassword).length < 6) {\n    res.status(400).json({\n      success: false,\n      error: \'Email dan password baru (minimal 6 karakter) wajib diisi.\',\n    });\n    return;\n  }\n\n  const cleanEmail = String(email).trim().toLowerCase();\n  const users = loadServerUsers();\n  const idx = users.findIndex((u) => u.email.toLowerCase() === cleanEmail);\n  if (idx < 0) {\n    res.status(404).json({\n      success: false,\n      error: \'Alamat email tidak ditemukan dalam sistem.\',\n    });\n    return;\n  }\n\n  const salt = crypto.randomBytes(16).toString(\'hex\');\n  users[idx].salt = salt;\n  users[idx].passwordHash = hashPasswordScrypt(String(newPassword), salt);\n  users[idx].updatedAt = new Date().toISOString();\n  saveServerUsers(users);\n\n  res.json({ success: true });\n});\n\n// Health check endpoint\napp.get(\'/api/health\', (req: Request, res: Response) => {\n  res.setHeader(\'Content-Type\', \'application/json\');\n  res.json({\n    status: \'ok\',\n    appName: \'RuangRAB\',\n    version: \'2.0.0\',\n    hasGeminiKey: Boolean(process.env.GEMINI_API_KEY),\n  });\n});\n\nfunction wait(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nfunction isRetryableError(err: any): boolean {\n  if (!err) return false;\n  const status = err.status || err.code || err.statusCode;\n  const message = String(err.message || \'\');\n\n  if (status === 503 || status === 429) return true;\n  if (message.includes(\'503\') || message.includes(\'UNAVAILABLE\') || message.includes(\'high demand\')) return true;\n  if (message.includes(\'429\') || message.includes(\'RESOURCE_EXHAUSTED\')) return true;\n  if (message.includes(\'ECONNRESET\') || message.includes(\'ETIMEDOUT\') || message.includes(\'fetch failed\')) return true;\n\n  if (status === 400 || status === 401 || status === 403) return false;\n  if (message.includes(\'API_KEY_INVALID\') || message.includes(\'PERMISSION_DENIED\')) return false;\n\n  return false;\n}\n\n/**\n * Endpoint Ekstraksi Parameter Dimensi & Segmen Struktur dari Gambar Teknik / PDF\n */\napp.post(\'/api/gemini/extract-dimensions\', async (req: Request, res: Response): Promise<void> => {\n  res.setHeader(\'Content-Type\', \'application/json\');\n\n  try {\n    const { fileBase64, mimeType, fileName, floorName, unitSetting, scaleSetting } = req.body;\n\n    if (!fileBase64 || !mimeType) {\n      res.status(400).json({\n        success: false,\n        error: \'Data file gambar atau dokumen PDF (base64) tidak ditemukan.\',\n      });\n      return;\n    }\n\n    if (!process.env.GEMINI_API_KEY) {\n      res.status(503).json({\n        success: false,\n        error: \'GEMINI_API_KEY belum dikonfigurasi pada environment server.\',\n      });\n      return;\n    }\n\n    const ai = new GoogleGenAI({\n      apiKey: process.env.GEMINI_API_KEY,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    });\n\n    const chosenUnit = unitSetting || \'cm\';\n    const chosenScale = scaleSetting || \'1:100\';\n\n    const systemInstruction = `\nAnda adalah Senior Civil Engineering Quantity Surveyor RuangRAB yang sangat teliti.\nTugas Anda adalah menganalisis dokumen gambar teknik konstruksi (PDF multi-halaman atau gambar tunggal) yang dapat memuat berbagai jenis gambar sekaligus, lalu mengekstrak informasi dimensi, kode elemen, serta rincian segmen Balok / Sloof untuk Auto Quantity Takeoff.\n\n1. KLASIFIKASI MULTI-JENIS GAMBAR TEKNIK (\"detectedRegions\"):\n   Periksa seluruh halaman dan bagian/region gambar dalam dokumen, lalu klasifikasikan masing-masing ke dalam salah satu dari 13 jenis gambar berikut:\n   - \"Denah Arsitektur\"\n   - \"Denah Kolom\"\n   - \"Denah Balok\"\n   - \"Denah Sloof\"\n   - \"Denah Pondasi\"\n   - \"Potongan Bangunan\"\n   - \"Tampak Bangunan\"\n   - \"Detail Tangga\"\n   - \"Detail Pondasi\"\n   - \"Detail Sambungan\"\n   - \"Detail Penulangan\"\n   - \"Tabel Dimensi dan Penulangan\"\n   - \"Detail Konstruksi Lainnya\"\n   Jika 1 halaman PDF memuat 2 bagian (misalnya di kiri ada \"Denah Sloof\" dan di kanan ada \"Tabel Dimensi dan Penulangan\" / potongan sloof), catat KEDUANYA di dalam array \"detectedRegions\"!\n\n2. ATURAN KHUSUS PERHITUNGAN PANJANG TOTAL BALOK DAN SLOOF (\"segments\"):\n   - JANGAN PERNAH menggunakan keliling luar bangunan sebagai panjang total balok atau sloof!\n   - Jika dokumen memuat \"Denah Sloof\" atau \"Denah Balok\":\n     a. Identifikasi setiap kode elemen sloof/balok pada denah (misal: \"S.1\", \"S1\", \"S2\", \"B1\", \"B2\", \"RB\").\n     b. Telusuri setiap jalur/segmen sloof atau balok pada grid (baik jalur horizontal sepanjang Grid 1, 2, 3... antar As A-H maupun jalur vertikal sepanjang Grid A, B, C... antar As 1-8).\n     c. Hitung panjang masing-masing segmen dari jarak antar grid yang tertulis pada gambar (perhatikan satuan jarak grid pada gambar: misalnya jika jarak grid tertulis 6.00, 3.00, 12.00 dalam meter atau 600, 300 dalam cm, konversikan secara tepat ke meter pada \"lengthMeters\").\n     d. Kelompokkan segmen per jalur grid atau per bentang ke dalam array \"segments\" dengan field:\n        - \"elementCode\": kode tipe (misal \"S.1\" atau \"B1\")\n        - \"elementCategory\": \"sloof\" atau \"balok\"\n        - \"segmentName\": nama jalur/segmen (misal \"Jalur Horizontal Grid 1 (As A-H)\" atau \"Jalur Vertikal Grid A (As 2-7)\")\n        - \"gridLocation\": lokasi as/grid (misal \"Grid 1 / As A-H\" atau \"As A-B\")\n        - \"rawLength\": angka panjang bentang tertulis pada gambar\n        - \"rawUnit\": satuan angka tertulis (\"m\", \"cm\", atau \"mm\")\n        - \"lengthMeters\": panjang 1 jalur/segmen dalam satuan meter (m)\n        - \"count\": jumlah jalur/segmen identik (misal 1 jika dirinci per jalur, atau jumlah bentang identik)\n        - \"subtotalMeters\": lengthMeters * count\n     e. Hindari penghitungan ganda pada segmen yang sama.\n     f. Jumlahkan seluruh \"subtotalMeters\" dari segmen-segmen tersebut sebagai nilai \"panjang_total\" untuk pekerjaan Sloof/Balok terkait di dalam \"items\"!\n\n3. PENGGABUNGAN INFORMASI ANTAR GAMBAR / TABEL DIMENSI:\n   - Jika pada \"Denah Sloof\" / \"Denah Balok\" / \"Denah Kolom\" terdapat kode elemen (misal \"S.1\", \"B1\", \"K1\") dan pada bagian \"Tabel Dimensi dan Penulangan\" atau \"Detail Penulangan\" tertulis ukuran penampangnya (contoh: TIPE SLOOF S.1 memiliki dimensi l = 40, t = 60 dalam cm -> lebar = 0.40 m dan tinggi = 0.60 m), GABUNGKAN informasi tersebut!\n   - Masukkan ke dalam \"items\":\n     * parameterId: \"panjang_total\" (dari total penjumlahan seluruh segmen S.1 dalam meter, detectedUnit: \"m\")\n     * parameterId: \"lebar\" (dari tabel dimensi l = 40 cm, rawExtractedValue: 40, detectedUnit: \"cm\")\n     * parameterId: \"tinggi\" (dari tabel dimensi t = 60 cm, rawExtractedValue: 60, detectedUnit: \"cm\")\n   - Jika tabel penulangan juga mencantumkan jumlah batang tulangan pokok memanjang (misal tulangan atas 4 D22 + tulangan bawah 4 D22 + tulangan tengah 2 D12 -> total 8 atau 10 batang), sertakan juga item untuk \"str-sloof-tulangan\" dan \"str-sloof-bekisting\" jika relevan.\n\n4. PEMETAAN KATALOG RUANGRAB (\"catalogId\" & \"parameterId\"):\n   Gunakan catalogId berikut HANYA untuk pekerjaan yang benar-benar tampak pada gambar:\n   - Sloof:\n     * \"str-sloof-beton\" (Sloof S1 / S.1) -> parameterId: \"panjang_total\", \"lebar\", \"tinggi\"\n     * \"str-sloof-s2\" (Sloof S2 / S.2) -> parameterId: \"panjang_total\", \"lebar\", \"tinggi\"\n     * \"str-sloof-s3\" (Sloof S3 / S.3) -> parameterId: \"panjang_total\", \"lebar\", \"tinggi\"\n   - Balok:\n     * \"str-balok-b1-beton\" (Balok B1) -> parameterId: \"panjang_total\", \"lebar\", \"tinggi\"\n     * \"str-balok-b2-beton\" (Balok B2) -> parameterId: \"panjang_total\", \"lebar\", \"tinggi\"\n     * \"str-balok-b3-beton\" (Balok B3) -> parameterId: \"panjang_total\", \"lebar\", \"tinggi\"\n   - Kolom:\n     * \"str-kolom-k1-beton\" (Kolom K1) -> parameterId: \"lebar\", \"tebal\", \"tinggi\", \"jumlah\"\n     * \"str-kolom-k2-beton\" (Kolom K2) -> parameterId: \"lebar\", \"tebal\", \"tinggi\", \"jumlah\"\n     * \"str-kolom-k3-beton\" (Kolom K3) -> parameterId: \"lebar\", \"tebal\", \"tinggi\", \"jumlah\"\n   - Persiapan & Arsitektur (HANYA jika gambar memuat Denah Arsitektur / ukuran bangunan):\n     * \"prep-pembersihan-lahan\" -> parameterId: \"panjang\", \"lebar\"\n     * \"prep-bouwplank\" -> parameterId: \"panjang\", \"lebar\"\n     * \"ars-dinding-bata-hebel\" -> parameterId: \"panjang_keliling\", \"tinggi_dinding\"\n     * \"ars-homogenous-tile-60x60\" -> parameterId: \"luas_lantai\" (detectedUnit: \"m\302\262\")\n     * \"ars-keramik-toilet-antislip\" -> parameterId: \"luas_total_toilet\" (detectedUnit: \"m\302\262\")\n\n5. ATURAN SATUAN & KEJUJURAN DATA:\n   - JANGAN PERNAH mengalikan angka dimensi tertulis dengan skala!\n   - Perhatikan dengan cermat apakah angka pada gambar tertulis dalam meter (misal \"6.00\", \"3.60\", \"2.40\", \"12.00\" -> detectedUnit: \"m\") atau dalam cm/mm (misal \"40\", \"60\", \"600\", \"300\" -> detectedUnit: \"${chosenUnit}\").\n   - Jangan mengarang parameter yang tidak ada pada gambar!\n`;\n\n    const userPrompt = `\nDokumen yang dianalisis: ${fileName || \'Dokumen Gambar Teknik\'}\nTarget Lantai: ${floorName || \'Lantai 1\'}\nSatuan dimensi default pilihan pengguna: ${chosenUnit}\nSkala pilihan pengguna: ${chosenScale}\n\nAnalisis dokumen ini secara menyeluruh:\n1. Identifikasi semua jenis gambar pada setiap halaman/bagian ke dalam \"detectedRegions\" (misal Denah Sloof, Tabel Dimensi dan Penulangan, Denah Arsitektur, Denah Kolom, Denah Balok, dll).\n2. Jika terdapat Denah Sloof atau Denah Balok, identifikasi setiap jalur segmen berdasarkan grid (As A-H, As 1-8, dsb.) ke dalam array \"segments\", hitung panjang setiap segmen dalam meter, dan jumlahkan total panjangnya.\n3. Jika terdapat Tabel Dimensi / Potongan Penulangan (misal S.1 dengan l = 40, t = 60), ekstrak lebar dan tinggi penampangnya dan hubungkan dengan kode elemen yang sama pada denah.\n4. Kembalikan seluruh parameter yang teridentifikasi ke dalam \"items\" beserta nomor halaman, jenis gambar, kode elemen, dan lokasi grid.\n`;\n\n    const cleanBase64 = fileBase64.replace(/^data:[^;]+;base64,/, \'\');\n\n    const documentPart = {\n      inlineData: {\n        mimeType: mimeType,\n        data: cleanBase64,\n      },\n    };\n\n    const textPart = {\n      text: userPrompt,\n    };\n\n    const plannedAttempts = [\n      { model: \'gemini-3.8-flash\', label: \'Primary (gemini-3.8-flash)\' },\n      { model: \'gemini-3.1-flash-lite\', label: \'Fallback 1 (gemini-3.1-flash-lite)\' },\n      { model: \'gemini-3.1-flash-lite\', label: \'Fallback 2 with Backoff (gemini-3.1-flash-lite)\' },\n    ];\n\n    let lastError: any = null;\n    let successfulResponseText: string | null = null;\n    let modelUsed = \'\';\n\n    for (let i = 0; i < plannedAttempts.length; i++) {\n      const { model, label } = plannedAttempts[i];\n      const attemptNum = i + 1;\n\n      try {\n        console.log(`[RuangRAB AI] Attempt ${attemptNum}/3: Invoking ${label}...`);\n\n        const response = await ai.models.generateContent({\n          model,\n          contents: { parts: [documentPart, textPart] },\n          config: {\n            systemInstruction,\n            responseMimeType: \'application/json\',\n            responseSchema: {\n              type: Type.OBJECT,\n              properties: {\n                documentSummary: {\n                  type: Type.STRING,\n                  description: \'Ringkasan lengkap isi dokumen gambar teknik.\',\n                },\n                drawingType: {\n                  type: Type.STRING,\n                  description: \'Kategori utama: arsitektur_denah, struktur_denah, potongan_detail, atau lainnya.\',\n                },\n                identifiedFloor: {\n                  type: Type.STRING,\n                  description: \'Lantai atau level struktur yang tertera pada gambar.\',\n                },\n                identifiedScale: {\n                  type: Type.STRING,\n                  description: \'Skala yang tertera pada etiket gambar (misal 1:200, 1:100).\',\n                },\n                detectedRegions: {\n                  type: Type.ARRAY,\n                  description: \'Daftar jenis gambar teknik yang terdeteksi pada setiap halaman atau bagian gambar.\',\n                  items: {\n                    type: Type.OBJECT,\n                    properties: {\n                      pageNumber: { type: Type.NUMBER, description: \'Nomor halaman (mulai dari 1).\' },\n                      drawingType: {\n                        type: Type.STRING,\n                        description:\n                          \'Salah satu dari: Denah Arsitektur, Denah Kolom, Denah Balok, Denah Sloof, Denah Pondasi, Potongan Bangunan, Tampak Bangunan, Detail Tangga, Detail Pondasi, Detail Sambungan, Detail Penulangan, Tabel Dimensi dan Penulangan, Detail Konstruksi Lainnya.\',\n                      },\n                      title: { type: Type.STRING, description: \'Judul bagian gambar pada lembar tersebut.\' },\n                      scale: { type: Type.STRING, description: \'Skala bagian gambar tersebut jika tertulis.\' },\n                      summary: { type: Type.STRING, description: \'Ringkasan informasi teknis pada bagian ini.\' },\n                    },\n                    required: [\'pageNumber\', \'drawingType\', \'title\', \'summary\'],\n                  },\n                },\n                segments: {\n                  type: Type.ARRAY,\n                  description:\n                    \'Rincian segmen balok atau sloof per jalur grid untuk menghitung panjang total secara akurat (kosongkan jika tidak ada denah balok/sloof).\',\n                  items: {\n                    type: Type.OBJECT,\n                    properties: {\n                      elementCode: {\n                        type: Type.STRING,\n                        description: \'Kode elemen struktur (misal: S.1, S1, B1, B2).\',\n                      },\n                      elementCategory: {\n                        type: Type.STRING,\n                        description: \'sloof atau balok\',\n                      },\n                      segmentName: {\n                        type: Type.STRING,\n                        description: \'Nama segmen atau jalur (misal: Segmen Horizontal Grid 1, Segmen Vertikal Grid A).\',\n                      },\n                      gridLocation: {\n                        type: Type.STRING,\n                        description: \'Lokasi grid/as (misal: Grid 1 / As A-H, Grid A / As 2-7).\',\n                      },\n                      rawLength: {\n                        type: Type.NUMBER,\n                        description: \'Angka panjang tertulis untuk 1 segmen/jalur.\',\n                      },\n                      rawUnit: {\n                        type: Type.STRING,\n                        description: \'Satuan angka tertulis (m, cm, mm).\',\n                      },\n                      lengthMeters: {\n                        type: Type.NUMBER,\n                        description: \'Panjang 1 segmen/jalur setelah dikonversi ke meter (m).\',\n                      },\n                      count: {\n                        type: Type.NUMBER,\n                        description: \'Jumlah jalur/segmen identik (default 1).\',\n                      },\n                      subtotalMeters: {\n                        type: Type.NUMBER,\n                        description: \'Hasil lengthMeters * count dalam meter (m).\',\n                      },\n                      pageNumber: {\n                        type: Type.NUMBER,\n                        description: \'Nomor halaman sumber.\',\n                      },\n                      drawingType: {\n                        type: Type.STRING,\n                        description: \'Jenis gambar sumber (Denah Sloof atau Denah Balok).\',\n                      },\n                    },\n                    required: [\n                      \'elementCode\',\n                      \'elementCategory\',\n                      \'segmentName\',\n                      \'gridLocation\',\n                      \'rawLength\',\n                      \'lengthMeters\',\n                      \'count\',\n                      \'subtotalMeters\',\n                    ],\n                  },\n                },\n                items: {\n                  type: Type.ARRAY,\n                  description: \'Daftar parameter dimensi dan kuantitas pekerjaan yang terbaca.\',\n                  items: {\n                    type: Type.OBJECT,\n                    properties: {\n                      pageNumber: {\n                        type: Type.NUMBER,\n                        description: \'Nomor halaman tempat parameter ditemukan.\',\n                      },\n                      drawingType: {\n                        type: Type.STRING,\n                        description: \'Jenis gambar tempat parameter ditemukan (misal Denah Sloof, Tabel Dimensi dan Penulangan, Denah Arsitektur).\',\n                      },\n                      elementCode: {\n                        type: Type.STRING,\n                        description: \'Kode elemen jika ada (misal S.1, B1, K1).\',\n                      },\n                      targetCategory: {\n                        type: Type.STRING,\n                        description: \'Kategori: Persiapan Dll, Struktural, Arsitektural, atau MEP.\',\n                      },\n                      suggestedWorkName: {\n                        type: Type.STRING,\n                        description: \'Nama pekerjaan (misal: Sloof S1, Balok B1, Kolom K1, Pembersihan Lahan, Dinding Bata Ringan).\',\n                      },\n                      catalogId: {\n                        type: Type.STRING,\n                        description: \'ID katalog RuangRAB jika cocok (misal: str-sloof-beton, str-balok-b1-beton, str-kolom-k1-beton, prep-pembersihan-lahan, prep-bouwplank, ars-dinding-bata-hebel, ars-homogenous-tile-60x60, ars-keramik-toilet-antislip).\',\n                      },\n                      parameterId: {\n                        type: Type.STRING,\n                        description: \'ID parameter katalog (misal: panjang_total, lebar, tinggi, tebal, jumlah, panjang, panjang_keliling, luas_lantai, luas_total_toilet).\',\n                      },\n                      parameterName: {\n                        type: Type.STRING,\n                        description: \'Nama parameter yang mudah dibaca.\',\n                      },\n                      rawExtractedValue: {\n                        type: Type.NUMBER,\n                        description: \'Angka asli tertulis pada gambar tanpa perkalian skala.\',\n                      },\n                      detectedUnit: {\n                        type: Type.STRING,\n                        description: \'Satuan angka tersebut (m, cm, mm, m\302\262, titik, unit, btg).\',\n                      },\n                      confidence: {\n                        type: Type.NUMBER,\n                        description: \'Tingkat keyakinan pembacaan antara 0.0 sampai 1.0.\',\n                      },\n                      pageOrLocation: {\n                        type: Type.STRING,\n                        description: \'Lokasi grid/as atau bagian tabel pada gambar.\',\n                      },\n                      notes: {\n                        type: Type.STRING,\n                        description: \'Keterangan teknis asal angka.\',\n                      },\n                    },\n                    required: [\n                      \'targetCategory\',\n                      \'suggestedWorkName\',\n                      \'parameterName\',\n                      \'rawExtractedValue\',\n                    ],\n                  },\n                },\n              },\n              required: [\'documentSummary\', \'items\'],\n            },\n          },\n        });\n\n        successfulResponseText = response.text || \'{}\';\n        modelUsed = model;\n        console.log(`[RuangRAB AI] Success on attempt ${attemptNum} with model: ${model}`);\n        break;\n      } catch (err: any) {\n        lastError = err;\n        console.warn(\n          `[RuangRAB AI] Attempt ${attemptNum} failed with error:`,\n          err?.status || err?.code || \'\',\n          err?.message || err\n        );\n\n        if (!isRetryableError(err)) {\n          console.error(\'[RuangRAB AI] Non-retryable error, aborting attempts.\');\n          break;\n        }\n\n        if (i < plannedAttempts.length - 1) {\n          const jitter = Math.floor(Math.random() * 400);\n          const backoffMs = 1000 + i * 1000 + jitter;\n          console.log(\n            `[RuangRAB AI] Waiting ${backoffMs}ms before fallback/retry attempt ${attemptNum + 1}...`\n          );\n          await wait(backoffMs);\n        }\n      }\n    }\n\n    if (!successfulResponseText) {\n      console.error(\'[RuangRAB AI] All attempts failed. Last error:\', lastError?.message || lastError);\n      res.status(503).json({\n        success: false,\n        isBusy: true,\n        error:\n          \'Layanan AI sedang mengalami beban tinggi (503). Dokumen belum berhasil dianalisis. Silakan coba kembali beberapa saat lagi.\',\n        technicalDetail: lastError?.message\n          ? String(lastError.message).slice(0, 200)\n          : \'Layanan AI mengalami beban tinggi.\',\n      });\n      return;\n    }\n\n    let parsedData: any;\n    try {\n      parsedData = JSON.parse(successfulResponseText);\n    } catch (parseErr) {\n      console.error(\n        \'[RuangRAB AI] Failed to parse model output as JSON:\',\n        parseErr,\n        successfulResponseText.slice(0, 300)\n      );\n      res.status(500).json({\n        success: false,\n        error: \'Format keluaran model AI tidak valid. Silakan coba analisis ulang.\',\n      });\n      return;\n    }\n\n    res.json({\n      success: true,\n      modelUsed,\n      data: parsedData,\n    });\n  } catch (error: unknown) {\n    console.error(\'[RuangRAB AI] Server unexpected error:\', error);\n    const errorMsg = error instanceof Error ? error.message : String(error);\n    res.status(500).json({\n      success: false,\n      error: `Gagal membaca gambar dengan AI: ${errorMsg}`,\n    });\n  }\n});\n\n// Setup Vite development middlewares or static files for production\nasync function startServer() {\n  if (!isProd) {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req: Request, res: Response) => {\n      res.sendFile(path.resolve(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`RuangRAB server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
        path {
          absolute_uri: "file:///server.ts"
        }
        overwrite: true
      }
    }
