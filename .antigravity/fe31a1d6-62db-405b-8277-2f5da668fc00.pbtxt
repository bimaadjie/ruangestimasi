      thinking_signature: "\022\317\002\n\314\002\001i\024}\023*\266\324\231c\214\307a\2442W\205\362\266\313N\276{m\217\226\177\360\a\t:\252\363\320\321\000\264\241\t\241,1\250\305\332\335CR\277\274\356\317Z\006\a\227k7\225}\205+\n\232!\320\022[C\312OzR\273\271\035\256\341\304\255\302\326\322\360g\255\"\305p\276\332\261\241\237\264i\r\020\024\217\245^\200\354\321\034x/\366x\0357g\224\n\030K\030iUB\3756{\016\b\200\026\265\204\006\275#2\201w\260c?%\304\311\252\251~\200A\034\265\016W:\255\350\313a,\242[\241\315\373\231\207&\n\272\234*88\275\273j\037\351\030\203i\031g\361A\034An\303\025\233\246jl\240Z\217O;\032\202N6\226\026\333\364o\324\304\017\277\3517\002N\250j\373\304l\002\022\344\314+\243\221\324\371j\vO\177\t\256T3\354\360\200\336\235\215\2574\034q\272o\2645\254S\355\n\227\016\231I\033\346\016m\207W\230\v{\335\a\276#\301o\033\017N\341`\nh\265y\327J\375\344\320\352\001E\201>b\036\t\214\335\2040\364\351\361\263\341 `~~q\371\023\211\b?\221\344c)\332T\232\312E\375=\"\207J\210\332\\\023"
