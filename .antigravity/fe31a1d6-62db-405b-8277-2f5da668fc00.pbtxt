    replacement_infos {
      original_chunk {
        target_content: "/**\n * RuangRAB \342\200\224 Modal Profil & Pengaturan Akun Pengguna\n * Menampilkan nama pengguna, email, jenis akun (Student / Estimator / Other), avatar inisial,\n * pengaturan profil, dan tombol Logout.\n */\n\nimport React, { useState, useEffect } from \'react\';\nimport {\n  X,\n  User,\n  Mail,\n  Briefcase,\n  GraduationCap,\n  Users,\n  LogOut,\n  Save,\n  CheckCircle2,\n} from \'lucide-react\';\nimport { UserAccountType, UserProfile } from \'../types\';\nimport { getInitials, updateUserProfileData } from \'../services/authService\';\n\ninterface UserProfileModalProps {\n  isOpen: boolean;\n  user: UserProfile;\n  onClose: () => void;\n  onUpdateUser: (updated: UserProfile) => void;\n  onLogout: () => void;\n}\n\nexport const UserProfileModal: React.FC<UserProfileModalProps> = ({\n  isOpen,\n  user,\n  onClose,\n  onUpdateUser,\n  onLogout,\n}) => {\n  if (!isOpen) return null;\n\n  const [fullName, setFullName] = useState(user.fullName);\n  const [userType, setUserType] = useState<UserAccountType>(user.userType);\n  const [isSaving, setIsSaving] = useState(false);\n  const [savedNotice, setSavedNotice] = useState(false);\n\n  useEffect(() => {\n    setFullName(user.fullName);\n    setUserType(user.userType);\n    setSavedNotice(false);\n  }, [user, isOpen]);\n\n  const handleSave = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!fullName.trim()) return;\n    setIsSaving(true);\n    try {\n      const updated = await updateUserProfileData(user, {\n        fullName: fullName.trim(),\n        userType,\n      });\n      onUpdateUser(updated);\n      setSavedNotice(true);\n      setTimeout(() => setSavedNotice(false), 2500);\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const roles: { id: UserAccountType; label: string; desc: string; icon: React.ReactNode }[] = [\n    {\n      id: \'Student\',\n      label: \'Student\',\n      desc: \'Mahasiswa atau pelajar\',\n      icon: <GraduationCap className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'Estimator\',\n      label: \'Estimator\',\n      desc: \'Quantity surveyor / praktisi volume\',\n      icon: <Briefcase className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'Other\',\n      label: \'Other\',\n      desc: \'Kategori pengguna lainnya\',\n      icon: <Users className=\"w-4 h-4\" />,\n    },\n  ];\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in duration-150\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-md overflow-hidden\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm ring-2 ring-blue-100\">\n              {getInitials(user.fullName)}\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">Profil &amp; Pengaturan Akun</h3>\n              <p className=\"text-xs text-slate-500\">{user.email}</p>\n            </div>\n          </div>"
        replacement_content: "/**\n * RuangEstimasi \342\200\224 Modal Profil & Pengaturan Akun Pengguna\n * Menampilkan nama pengguna, email, jenis akun (Student / Estimator / Other), avatar inisial,\n * pengaturan profil, dan tombol Logout.\n */\n\nimport React, { useState, useEffect } from \'react\';\nimport {\n  X,\n  User,\n  Mail,\n  Briefcase,\n  GraduationCap,\n  Users,\n  LogOut,\n  Save,\n  CheckCircle2,\n} from \'lucide-react\';\nimport { UserAccountType, UserProfile } from \'../types\';\nimport { getInitials, updateUserProfileData } from \'../services/authService\';\n\ninterface UserProfileModalProps {\n  isOpen: boolean;\n  user: UserProfile;\n  onClose: () => void;\n  onUpdateUser: (updated: UserProfile) => void;\n  onLogout: () => void;\n}\n\nexport const UserProfileModal: React.FC<UserProfileModalProps> = ({\n  isOpen,\n  user,\n  onClose,\n  onUpdateUser,\n  onLogout,\n}) => {\n  if (!isOpen) return null;\n\n  const [fullName, setFullName] = useState(user.fullName);\n  const [userType, setUserType] = useState<UserAccountType>(user.userType);\n  const [isSaving, setIsSaving] = useState(false);\n  const [savedNotice, setSavedNotice] = useState(false);\n\n  useEffect(() => {\n    setFullName(user.fullName);\n    setUserType(user.userType);\n    setSavedNotice(false);\n  }, [user, isOpen]);\n\n  const handleSave = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!fullName.trim()) return;\n    setIsSaving(true);\n    try {\n      const updated = await updateUserProfileData(user, {\n        fullName: fullName.trim(),\n        userType,\n      });\n      onUpdateUser(updated);\n      setSavedNotice(true);\n      setTimeout(() => setSavedNotice(false), 2500);\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const roles: { id: UserAccountType; label: string; desc: string; icon: React.ReactNode }[] = [\n    {\n      id: \'Student\',\n      label: \'Student\',\n      desc: \'Mahasiswa atau pelajar\',\n      icon: <GraduationCap className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'Estimator\',\n      label: \'Estimator\',\n      desc: \'Quantity surveyor / praktisi volume\',\n      icon: <Briefcase className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'Other\',\n      label: \'Other\',\n      desc: \'Kategori pengguna lainnya\',\n      icon: <Users className=\"w-4 h-4\" />,\n    },\n  ];\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in duration-150\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-md overflow-hidden\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm ring-2 ring-blue-100\">\n              {getInitials(user.fullName)}\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">Profil Akun RuangEstimasi</h3>\n              <p className=\"text-xs text-slate-500\">{user.email}</p>\n            </div>\n          </div>"
        start_line: 1
        end_line: 108
      }
      num_matches: 1
    }
