      thinking_signature: "\022\244\016\n\241\016\001i\024}\023\342#\033\265\351\306&\005C^\364\232\267\367\365\306\006\242\264\\|W\200\311\313\320\364\252K\203m\317W\022\347Nl\237\355\350r\227\r\360\240\020\252\005Z\177\217\224\315OIP\345\346\r\324\357\337SO\220W\201\253m\344\205\033\321\033\033-11lt\026\222Vi\v\256I~\3002\336\224\354{\267\216\315\256\022\303\005MT`rz\336\f\372w\324\331\204\225\3612\275\243\023\3263YY\226\345\226T\367\355\316\327\216\016\211\234Y\301A\252t\204\340\227,:!\2432\257\314\322n\300Q\217\355B\347\322\325L\323\t\300\0013a\224zGTr\003}\300\bs\037\345H\217\255g\v\177\364\235\3742\t\304\224J<\372\'_o\363g{\200\"\213P\3321\353M\356\247Hp\031i\346\\\343Z\\\242\204\262c$\262\360\b\016G |\270v\235\354\252\253\352\376\213\220\205\273y \265\220\232{x\256\302\262\276\f\247\006\235\241\240\276n*\210\305\203\247\306Q\372M\304\271 \213\321\343\2458J)\b\305\351p\215\272\331\341\274S\273\3162@\257\202\031u-cf\307st\355\362\025E\355\023\345Rg\v\300\234\376\222B\017\350\016N\2702H\r^a\017\240-V\317\315{\3607V\227\350\367\341\002>\324\0238N4\310\352\030!k\206G\032\232\2350S\2518\305Z;\311%3P\333\004\001\346w(\364\344\307\004\032\v\351\273\005\245\267\206E\363\2460R\001@f\363uf\247@\257\037_@\231|%\2134\006\201\377R\314\344\031\234\210\210\005\031\220\233\211\272\177\240\260\311\303\351\234\".[@\211\vW\032?^\353/\370\210l\213\321\347\305^\030\312\307\356\321\a\327y|\253\230\226K\v\216k>\334\203U\354Z\230(\232\245\177\016\r.\334\236&\236\213\367\242I\024\032\207\350\255S\001\227\017\241\364%\320\246j\337\235Q\277.\357\213\232T\367!\000M\020j{(\330\320\240\365;^66\204\2072\200\aXR,\367\242\022qz\271W\005\351\000\315\216\275D5v\327\026\321\226\016\277\276\301\267qsd\375b\345\322F\307Y\006w\305\215\2749\327i\023E\210\201\261\2301V\375\a\036O\354U\312\360\247\025~\205\247z\005\341K#R\177\ry$\207\022\225\357\031\231t\272\031\246\025E\226/\t\257\212\020\341\313\301\357a\035\352\210\005NT\235\213\251^S\305\255D\233\246\303\316\031$\027\320\v9(\030R\r`G*\016\241?\221\200a\017\256\277\220\2017\347\367^\317\005&\037GZD\334Q\267\267\037\277\025`\374 C\267\373\320\274L\264\3777\236Sv|+\246j3\016\b\rj\017\306\272\031\314z\366\306(\340\3126\312\272O/\'\365ML\030\376\374\020\215\030\375L\2622\326\232\323\373\204a\334\033\211\000\252C\323\321\323\237y\376\023\033>\314\016\306\225\201V\244\177\305\003\251\213\323\332#\366\201r^\346\2773BE\372\202\320\230\272\333\310\354\220`\030t\r\230u\211\271\324Q\363\3535\323\037\222B\260*\310I\352\341\3155\vC\206\342\310\315\255~\262\371c\254\220$\30198<\255l\274j\274\267\321\214\370\322\f\037$\365\000\360\300\261\334\016\261\b\232\336{^\340\021\210O\264*\246\264\220\343\316\315\207\263\327R\250w<\345\211sA\247\316J\300[+qk\350\241\037M}^\3403\333\313\372\245\271\236\036\265\210\377\322=p\027$Z\022\256\243&\361\243DoX\235\267\bR\2037\240j\355\2172LL\343\325D\000$\2563\037z\020\343r\255G\250M\332\223Y\304j[\023\206.\362\315zv9z\274\024$A\240\211R\021\320\016\307\272?s\t[F+\274\331\305jo[v\210\2755\276i\377\v\033\312i:JI\251\023y2\vJ{\220=m\202\021*\357\211\027\312C\2721\022\224\022\270\244\260\233^h\032\"\240\016\307\374\303\242\360\353\220\275\337\202\2475\354\321\214\017l\325X\276\v\320\230\000\361\2717\243Cj\227+\374.~\317i\362\260\265B\371\226+6L\266\n\003s+h\235;\366\366\001B\177G\244g^\250\303\377\366\224\314\223\nW\374RPF\177`r\226\364\006\217H\236`0n\257\301\265K\272I\032\335\245\366L\f\273BC6\251\240\376%\363\310\016\036\2656$\024\000\214\364Z\354\333\214r\241\027\035y\346\314\001q^\226\255\017\035Lh]\260\321\002\351\272B\033t\tY\026s,E\375\330\217}\321v\335;\374^\2106\356<\371V\243i\351p\244\315\373\3676\017\222\003\3724\245TB\203\207\204\270\351s2\266\227|Rq\303\324I7J\262\344\3422\363\027\260(n\254$\236\273\236\366\003_\tu\271\335\262\247\024\304\325\336\207\237\313%Vq\330[\016\347\312\355\247\321\343\346\243\342$\353\273\316\364\3269X\324W\247\254\305E\303k\212N\363\213&[\351\322>{\242\352\202\326\306:\261[\275\243\337\244\n@\371\234J\261F\360\227\261L\021\243\004Z\362\2461R\200R\303\207