      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Update header comment in UserOverviewBanner.tsx to RuangEstimasi\",\"EndLine\":6,\"Instruction\":\"Replace RuangRAB with RuangEstimasi in UserOverviewBanner.tsx\",\"ReplacementContent\":\"/**\\n * RuangEstimasi \342\200\224 Ringkasan Akun & Proyek Pengguna\\n * Menampilkan ucapan selamat datang, jumlah proyek, proyek terakhir dibuka,\\n * tombol Buat Proyek Baru, daftar proyek milik pengguna, dan aktivitas terakhir.\\n */\",\"StartLine\":1,\"TargetContent\":\"/**\\n * RuangRAB \342\200\224 Ringkasan Akun & Proyek Pengguna\\n * Menampilkan ucapan selamat datang, jumlah proyek, proyek terakhir dibuka,\\n * tombol Buat Proyek Baru, daftar proyek milik pengguna, dan aktivitas terakhir.\\n */\",\"TargetFile\":\"/src/components/UserOverviewBanner.tsx\",\"toolAction\":\"Updating UserOverviewBanner.tsx header comment\",\"toolSummary\":\"Update UserOverviewBanner.tsx header comment\"}"
