            }
            lines {
              text: "    verificationStatus: \'Belum Diisi\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'lebar\', name: \'lebar\', label: \'Lebar Penampang Pedestal\', placeholder: \'Masukkan lebar (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'tebal\', name: \'tebal\', label: \'Tebal Penampang Pedestal\', placeholder: \'Masukkan tebal (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'tinggi\', name: \'tinggi\', label: \'Tinggi Pedestal\', placeholder: \'Masukkan tinggi (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'jarak_begel\', name: \'jarak_begel\', label: \'Jarak Sengkang / Begel\', placeholder: \'Masukkan jarak begel (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'jumlah\', name: \'jumlah\', label: \'Jumlah Titik Pedestal\', placeholder: \'Masukkan jumlah titik\', value: null, unit: \'titik\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per Meter\', placeholder: \'Masukkan berat jenis (kg/m)\', value: null, unit: \'kg/m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const l = params[\'lebar\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const k = params[\'tebal\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const m = params[\'tinggi\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const s = params[\'jarak_begel\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const o = params[\'jumlah\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const t = params[\'berat_jenis\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (l == null || k == null || m == null || s == null || o == null || t == null || s <= 0) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return (l + k) * 2 * (m / s) * o * t;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
