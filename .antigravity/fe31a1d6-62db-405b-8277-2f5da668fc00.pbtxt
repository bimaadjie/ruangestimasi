      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Check } from \'lucide-react\';\\n\\ninterface StepperProps {\\n  currentStep: number;\\n  onStepClick: (step: number) => void;\\n}\\n\\nexport const Stepper: React.FC<StepperProps> = ({ currentStep, onStepClick }) => {\\n  const steps = [\\n    { number: 1, title: \'Data Proyek\' },\\n    { number: 2, title: \'Input Gambar / Manual\' },\\n    { number: 3, title: \'Perhitungan Volume\' },\\n    { number: 4, title: \'Rekap & Ekspor\' },\\n  ];\\n\\n  return (\\n    <div className=\\\"bg-white border-b border-slate-200 px-6 py-3.5\\\">\\n      <div className=\\\"max-w-7xl mx-auto flex items-center justify-between sm:justify-start sm:gap-10 overflow-x-auto text-xs\\\">\\n        {steps.map((step) => {\\n          const isDone = currentStep > step.number;\\n          const isActive = currentStep === step.number;\\n\\n          return (\\n            <button\\n              key={step.number}\\n              onClick={() => onStepClick(step.number)}\\n              className=\\\"flex items-center gap-2.5 shrink-0 group focus:outline-none\\\"\\n            >\\n              <div\\n                className={`w-6 h-6 rounded-full flex items-center justify-center font-bold text-[11px] transition-all ${\\n                  isDone\\n                    ? \'bg-emerald-500 text-white shadow-xs\'\\n                    : isActive\\n                    ? \'bg-blue-600 text-white shadow-xs\'\\n                    : \'bg-slate-100 text-slate-500 group-hover:bg-slate-200\'\\n                }`}\\n              >\\n                {isDone ? <Check className=\\\"w-3.5 h-3.5 stroke-[3]\\\" /> : step.number}\\n              </div>\\n              <span\\n                className={`font-semibold tracking-tight transition-colors ${\\n                  isActive ? \'text-blue-700 underline underline-offset-8 decoration-2\' : isDone ? \'text-slate-800\' : \'text-slate-500 group-hover:text-slate-700\'\\n                }`}\\n              >\\n                {step.title}\\n              </span>\\n            </button>\\n          );\\n        })}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create stepper progress component matching the screenshot mock with active and completed indicators\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Stepper.tsx\", \"toolAction\":\"Creating Stepper component\", \"toolSummary\":\"Create src/components/Stepper.tsx\"}"
