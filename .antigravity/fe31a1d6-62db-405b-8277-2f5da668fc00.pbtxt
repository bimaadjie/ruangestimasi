      thinking_signature: "\022\230\f\n\225\f\001i\024}\023\355\026\343\313i\024q\274\270\300<\312\3056\274\343\205QO\314t\372\273<\b\b\t\255\263\352\020\234\345\357\240\363\354\"\005\v\214I\2173S\212\366\261>P`k\221P\206B\267\222\307\034{\205\356\2034}\320u\364\337#(pcwn3\336\371R\367\021?\260o\000\203\336!)\354)N\377\331\213\246~E\321S\236\331\254\353\3227\205;\366Z,\334\334\315\232Z\234\357\006\330\032\224|\217Oqgb\027,1g\224cC\026\370\273\022\032o\276{\177\321\226\202\275\a\356\267\316H\355\317\341\b[\260\265\275\373\301\266dp\032GUs\325\346_\357\305h\022\272\b\3664\252\177v\364\347L\356\026\033\037\227\233\365^\211\252\277\177f%\305&\334V\353\307\332\256\027\001k(Gc\314\227\370\t\221+B\376G\254\310\t`\207\220\271`\324nO\021\311\345\360?\334E\343\263\314>\200\221\245\200Em[t){\372\236\362#$\207\274\313\213.\306\260\207\024\374\216\315\221\257\331\224\234\242\204\200,v\270e\334`!L%\330\220\333\363a%L4Kmfy\346h\302\330t\376\203\377\tp\316\236{b<\362\356\037\b\301\031\333X\310\316\346iuh\\\r\364.\033C\307\253\253\016E\004:\220\207\370,{X\207\357c`\355\255\204\325z\254\357a\027\000\001Th\372\307\001\f\2277\360\034\201M\025\f\277\026A\371\373\fJS\3632\036\344\002nY#\371v\220\376\311f7M\257\035\364\237\242\371x\304}\316\231\025\3551`\351\354\342\250s\343j\244\207\353\327\303\346\n~\206\347%\373\200\223t\364nV\323\372\351\t\031\276\006E-\350`\372]~\206K\311\3020\003J\021\222\035\225\223\213\026P1^\244\312\201\021\t]\310\005\361\v\265j\271\215k{\243\323\233\270\337\321\255\025H&\372\0265\300\n\267\353s\220\301\264\233\247\037?XF\0357W\025 \320\305\033\204,=\332n\346\016\016gx\251\221nrmN`\023\\\306\364;\362u\252\307\016K\221\2529GW+\246}\342v\226\271rG\215\205dDy\212\032p\267\267\245\211\177K\023\022\370\324\024\217\211\365.d\275\351\233Z\360\347\232\341\033\035\342\354\225L\rQ/\332\353\374\324\244\321\247NY[H\225\'C{@\b\022;\233\307\370.d\202\027\306O!\215 \371E9\313A\032C\233\223\216+\201\346\313\303B-\340\216\350\240\303\006\004\263\r\235\017\334\244\334R\356\036\336\020\b\370^\244A\005__\'\036\241a\275a\324\261\245)\314W\316\'x\310f\253\225\277\323\367\005\241\342/\3603yY{\004\255\334_\310]q\224f\314\vD\2612B&\365$\305\377h\363\220\223\006%\310\204wq\367\205\305\2716\224V\277\332\242\277Y3\004\274\352}m\256\031ZZ\304\211^\032:\365U>\365\265\017.\005\000\017\334\341\325\025\354\306\206y\320WS{a` \345r]]!\030\260\336\031D\246qjnV\a\323\251\367\300\200}\265s\313*\230j{\327u\236\275{\300\b\332\303\002\277\265k\272j\006\035\325\334\304\221\376,U\222\310\357\230\317\314)\271|\265\312306\302@&&x\342\321\267\337\025\345\3611\214/\354\231\246\032\254t\360\310\2055P\001\375\373;\311\301qK\370\266p\352\f\nI\374\224\252)\177\372=!z\352<\355\v5\234\226\360\216`\235\255\305\374\233\2148u\372\223Od\203\321G\272\316y\0175\037J4\271\206\232\340\264\023\332Y\313D\220\303b\"A\256\230\216\347\016C\201\274\332\003\'\313\306J3\316\3656\336\301\311L\262\260>\374<\243]!\240\304\347\263\243\257\301\352\201\356nk\227\363\212\by\017b\340b\313\2558\323\276\037\344T\240y\323\344\214\242\020]\005\037W\217\362~\023\272\025Q\205\304\3564\316\202\344g.\303\r4\rV\241\377\037\334\212\343}\375\t\245\260\vg\263\335\000\335}\332\201\2445Q\001\244\260\236\226\033f\003\037\220\275\025\beq\204\206\370\206\270}T\215{@+\3571\000\377\206\212l\267\3043Gt\t-j\244\274\324\212\326\341\033x\36045N\226\253\320nO\252\226U\265\265\023]\350Q`\375b\326\262\343\321\000TiM1V\253\335\a\224r,q\225\213\260Z|\237\301\306\312\242##!%\257\266\374\304\304s\361M*\023\246\"\006\226\255o\312\304<\201\3578\035\023\277\255\n\224)#\201\270\314\211c\342\242\3000\242A\260\373ug/\256\371\323&d\234\f\260\\\027\213\266\260:,\211Oc\264\234\'\226(\353q\232\000\355\"7!\320\242MY\244;\220z\004\363\222\224\017\321\2329\311-\003{\217\311{\355\bPV\276\225\322k\204F\262\211\' \376\226\b\"\356]B\202[\323\346\363\'\273\366\006\316\277-T\022^J??\241r\357\233\347R\267*\200\261\255\021\234\262\a\256\025\310Mf\3754A\216I\3209\270\266g\335\323\330&\240Ps\177\n0\317i\220\271\327\222\364*\346vr#0\315\n.\373I\023\261\207\037k\n\343\301\023\242\304\332k\323\276\246K\252\257\340\363{j\032HE\037/\315b\024p#\257\236\300\305n\203\314\342g\251\313\243x\330\343K|\021|\230U\237b\361\314\254-qV\277\033\341H\261a\345\333z\253hy\027\252\277O\264n\245\003(4N\262\232\353\275\276\304N\303\353qZQ\032\004HC\376\373\307\031\315\204\371\214)D%\324;\\\265\304\224X#<K\016\004\274\372i\216\323\037\0235\a\332\307W\333\324\300\257J\327WX\304\002\374+N\2429\036\376\"L\276=K\027\'8s]\323Yw\206,\aiT\033|\273OJ:{"
