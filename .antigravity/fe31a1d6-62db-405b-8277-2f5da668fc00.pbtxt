    end_line: 227
    content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Layers,\n  Plus,\n  Trash2,\n  Copy,\n  Pencil,\n  Check,\n  AlertCircle,\n} from \'lucide-react\';\nimport { FloorItem, ProjectWorkItem } from \'../types\';\n\ninterface FloorManagementModalProps {\n  isOpen: boolean;\n  floors: FloorItem[];\n  works: ProjectWorkItem[];\n  onClose: () => void;\n  onAddFloor: (name: string, elevation: string) => void;\n  onRenameFloor: (floorId: string, newName: string, newElevation: string) => void;\n  onDeleteFloor: (floorId: string) => void;\n  onDuplicateFloor: (floorId: string) => void;\n}\n\nexport const FloorManagementModal: React.FC<FloorManagementModalProps> = ({\n  isOpen,\n  floors,\n  works,\n  onClose,\n  onAddFloor,\n  onRenameFloor,\n  onDeleteFloor,\n  onDuplicateFloor,\n}) => {\n  if (!isOpen) return null;\n\n  const [newFloorName, setNewFloorName] = useState(\'\');\n  const [newElevation, setNewElevation] = useState(\'\');\n  const [editingFloorId, setEditingFloorId] = useState<string | null>(null);\n  const [editName, setEditName] = useState(\'\');\n  const [editElevation, setEditElevation] = useState(\'\');\n  const [deleteConfirmId, setDeleteConfirmId] = useState<string | null>(null);\n\n  const handleAddSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newFloorName.trim()) return;\n    onAddFloor(newFloorName.trim(), newElevation.trim() || \'+ 0.00 m\');\n    setNewFloorName(\'\');\n    setNewElevation(\'\');\n  };\n\n  const handleSaveEdit = (floorId: string) => {\n    if (editName.trim()) {\n      onRenameFloor(floorId, editName.trim(), editElevation.trim());\n    }\n    setEditingFloorId(null);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs\">\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-xl overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold\">\n              <Layers className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">Kelola Lantai &amp; Elevasi</h3>\n              <p className=\"text-xs text-slate-500\">\n                Tambah, ubah nama, duplikasi, atau kelola elevasi lantai bangunan.\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/50 transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-6 max-h-[60vh] overflow-y-auto space-y-5 text-xs\">\n          {/* Floor List */}\n          <div className=\"space-y-2.5\">\n            <label className=\"font-bold text-slate-800 block\">Daftar Lantai Aktif ({floors.length})</label>\n            {floors.map((floor) => {\n              const floorWorksCount = works.filter((w) => w.floorId === floor.id).length;\n              const isEditing = editingFloorId === floor.id;\n\n              return (\n                <div\n                  key={floor.id}\n                  className=\"p-3 bg-slate-50/70 border border-slate-200 rounded-xl flex items-center justify-between gap-3\"\n                >\n                  {isEditing ? (\n                    <div className=\"flex items-center gap-2 flex-1\">\n                      <input\n                        type=\"text\"\n                        value={editName}\n                        onChange={(e) => setEditName(e.target.value)}\n                        className=\"px-2 py-1 border border-slate-300 rounded text-xs font-bold w-36\"\n                        autoFocus\n                      />\n                      <input\n                        type=\"text\"\n                        placeholder=\"+ 4.00 m\"\n                        value={editElevation}\n                        onChange={(e) => setEditElevation(e.target.value)}\n                        className=\"px-2 py-1 border border-slate-300 rounded text-xs w-24 font-mono\"\n                      />\n                      <button\n                        onClick={() => handleSaveEdit(floor.id)}\n                        className=\"p-1 rounded bg-blue-600 text-white hover:bg-blue-700\"\n                      >\n                        <Check className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  ) : (\n                    <div>\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"font-bold text-slate-900\">{floor.name}</span>\n                        {floor.elevation && (\n                          <span className=\"text-[10px] font-mono font-semibold px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-100\">\n                            {floor.elevation}\n                          </span>\n                        )}\n                      </div>\n                      <span className=\"text-[11px] text-slate-500 block mt-0.5\">\n                        {floorWorksCount} pekerjaan terdaftar\n                      </span>\n                    </div>\n                  )}\n\n                  <div className=\"flex items-center gap-1.5 shrink-0\">\n                    {!isEditing && (\n                      <button\n                        onClick={() => {\n                          setEditingFloorId(floor.id);\n                          setEditName(floor.name);\n                          setEditElevation(floor.elevation || \'\');\n                        }}\n                        className=\"p-1.5 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition\"\n                        title=\"Ubah Nama/Elevasi\"\n                      >\n                        <Pencil className=\"w-3.5 h-3.5\" />\n                      </button>\n                    )}\n\n                    <button\n                      onClick={() => onDuplicateFloor(floor.id)}\n                      className=\"p-1.5 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition\"\n                      title=\"Duplikasi Lantai & Seluruh Pekerjaannya\"\n                    >\n                      <Copy className=\"w-3.5 h-3.5\" />\n                    </button>\n\n                    {floor.id !== \'fl-umum\' && (\n                      <button\n                        onClick={() => {\n                          if (deleteConfirmId === floor.id) {\n                            onDeleteFloor(floor.id);\n                            setDeleteConfirmId(null);\n                          } else {\n                            setDeleteConfirmId(floor.id);\n                          }\n                        }}\n                        className={`p-1.5 rounded-lg transition ${\n                          deleteConfirmId === floor.id\n                            ? \'bg-rose-600 text-white font-bold text-[10px] px-2\'\n                            : \'text-slate-400 hover:text-rose-600 hover:bg-rose-50\'\n                        }`}\n                        title=\"Hapus Lantai\"\n                      >\n                        {deleteConfirmId === floor.id ? \'Hapus?\' : <Trash2 className=\"w-3.5 h-3.5\" />}\n                      </button>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n          {/* Add New Floor Form */}\n          <form onSubmit={handleAddSubmit} className=\"pt-2 border-t border-slate-200/80 space-y-3\">\n            <label className=\"font-bold text-slate-800 block\">Tambah Lantai Baru</label>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <input\n                type=\"text\"\n                required\n                placeholder=\"Contoh: Lantai 4 / Rooftop\"\n                value={newFloorName}\n                onChange={(e) => setNewFloorName(e.target.value)}\n                className=\"px-3 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500\"\n              />\n              <input\n                type=\"text\"\n                placeholder=\"Elevasi (contoh: + 12.00 m)\"\n                value={newElevation}\n                onChange={(e) => setNewElevation(e.target.value)}\n                className=\"px-3 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono\"\n              />\n            </div>\n            <button\n              type=\"submit\"\n              className=\"w-full py-2.5 px-4 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition shadow-xs flex items-center justify-center gap-1.5\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Tambah Lantai</span>\n            </button>\n          </form>\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-3 border-t border-slate-100 flex items-center justify-end bg-slate-50/50\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition\"\n          >\n            Selesai\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 228
    num_bytes: 9297
    line_range_bytes: 9297
  }
}
