    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst data = JSON.parse(fs.readFileSync(\'public/assets/aistudio/katalog_volume_usc_639e973f.json\', \'utf8\'));\nfor (const sheet of data.sheets) {\n  console.log(\'=== SHEET:\', sheet.name, \'===\');\n  for (const r of sheet.rows) {\n    const texts = r.cells.filter(c => typeof c.value === \'string\' && c.value.trim().length > 1 && !c.value.startsWith(\'=\'));\n    const hasHeader = r.cells.some(c => [\'A\',\'B\',\'C\',\'D\'].includes(c.cell.replace(/[0-9]/g,\'\')) && typeof c.value === \'string\');\n    if (hasHeader) {\n      console.log(\'Row \' + r.row + \':\', r.cells.map(c => c.cell + \'=\' + JSON.stringify(c.value) + (c.excel_formula ? \' [\'+c.excel_formula+\']\' : \'\')).join(\' | \'));\n    }\n  }\n}\n\""
