      thinking_signature: "\022\213\r\n\210\r\001i\024}\023\205\366K\303\004\204\355F\264\031\337\002\rZ\346E\b\351\241\303\330\364\277\254\232\t\341\b\032\003\177\3226b\263\235\301\224\030\373.\317\267P\034\353\f\317\033E\372+Bo\241\350\021\031\233BL\346\340\214\254Y\v7z\321J\236\334Fw}L\016g\264s5\252y\204G\343\322/^\257\204\372\350\225\034\307U\320\216\306Z\a\224\300!\225_\020\231.JR\302k\223\037\000\351\326\234\201\336N\227\246\3668\354\236$\373n\0025_\253\2225#\355\r\264\035\362+\a\205\301\335\031\016F\321\242b\024\311\345\217\323\316r\237_\333Zr\227\202\3004\277j\357\371\246g\r\024\024\354J\237\026\032\372V\023\224\201J\352\272\325%\317\"\375A\247\203\004h\272 \330\311\314p\216-E\251\200\300\272\227f\253\266\277\225\237\037\331\t\023]\317d\002D1\027\364iK~\311\317\367\320\347\352\303e\225\234\373\337\227\323\250\304\017\333\347\216\031\356\033#\206\232\032\307\267A\001\024d\203\027!\023\376#\201\230f\312\373|\315\a\323\006\376ak\030\321Pb\'g\226\037\"\325\254W\315\\b6H\361\276\374\270\325\023\305\345\032\350\"R\"\'\256\355\320\360b\'\200\006\330(\360\233\327\341#\256z\271H?0v\005\303\3663\226\337c\357\233\002\370)m\037\035:\265\377\303\330\232\362,\337O\355D:/\225\016c\202\326\237\346\335\225\324\352\237\"\251\261\314\177\032\3337\256B\227\033\362%\202\355\003\223\003\234x\021\v\273N\263i\341\341\377!L\356f\201WbS\243+\vQq\326j0\357T?9\246\005d\310\321}\\\213\a\304.\374\254\225\301\254\250SI\004\317\200Y\364W\000\326\222$gq8,`Q\001\320\357\236\235B\331\344@{\240\367\333\036GW\210\360\351\201\a2c$\231R{\255\222B\354\316o\377\231\256\234\361@\240~\262\261\005\n\312Lk\255\347;M\215\215d\300m\351\352\327O\034\037L%\035>\224o\255\264l\024\350\201\336=\220$\253\362s\220\300\266\002\236\331\353\371\005\2329}\365\313\006\217\370\313\324v\242h.{\324\225\017\314\334\0059\tjoR\225>\223\025\373\036\363T\364\005\334\223\263\370\346\324\311\235\220\fj\001\324ut\326a\255$\312\251X\215\005\207\350\\s/ \244\242qz\361\005\300\203kf\327\315u\021<\274F\227\350\0262\241\233v\222\2