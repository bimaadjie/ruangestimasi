            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'panjang_bangunan\', name: \'panjang_bangunan\', label: \'Panjang Pelat Lantai\', placeholder: \'Masukkan panjang pelat (m)\', value: null, unit: \'m\', required: true },"
