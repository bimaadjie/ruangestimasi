    content: "bordes.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'(Antrede \303\227 Lebar Tangga \303\227 Jml Anak Tangga) + (Luas Bordes)\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U44, U179, U313, U447 (Formula =((0.27*1.4)*24)+(2.85*1.2))\',\n    excelFormula: \'=((0.27*1.4)*24)+(2.85*1.2)\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'0.27m antrede \303\227 1.4m lebar \303\227 24 trap + 2.85 \303\227 1.2 bordes.\',\n    parameters: [\n      { id: \'lebar_pijakan\', name: \'lebar_pijakan\', label: \'Lebar Pijakan (Antrede)\', value: 0.27, unit: \'m\', required: true },\n      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', value: 1.4, unit: \'m\', required: true },\n      { id: \'jumlah_trap\', name: \'jumlah_trap\', label: \'Jumlah Trap Anak Tangga\', value: 24, unit: \'buah\', required: true },\n      { id: \'luas_bordes\', name: \'luas_bordes\', label: \'Luas Bordes Tangga\', value: 3.42, unit: \'m\302\262\', required: false },\n    ],\n    calculationMethod: (params) => {\n      const a = params[\'lebar_pijakan\'] ?? 0.27;\n      const w = params[\'lebar_tangga\'] ?? 1.4;\n      const n = params[\'jumlah_trap\'] || 24;\n      const b = params[\'luas_bordes\'] || 0;\n      return a * w * n + b;\n    },\n  },\n  {\n    id: \'ars-plafond-gypsum\',\n    code: \'ARS-PLF-01\',\n    name: \'Pemasangan Plafond Gypsum Board (t = 9\342\200\22310 mm)\',\n    category: \'Arsitektural\',\n    subCategory: \'Pekerjaan Plafond\',\n    floorRule: \'per_lantai\',\n    description: \'Plafon gypsum board termasuk rangka hollow galvanis 35.35 modul 60x60 cm.\',\n    defaultUnit: \'m\302\262\',\n    formulaDisplay: \'Luas Bersih Langit-langit Ruangan\',\n    excelSheet: \'Volume Arsitektural\',\n    excelCell: \'U54, U188, U322, U456\',\n    excelFormula: \'=U52\',\n    verificationStatus: \'Lengkap\',\n    verificationNotes: \'Luas plafon lantai.\',\n    parameters: [\n      { id: \'luas_plafond\', n