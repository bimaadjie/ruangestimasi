  view_file {
    absolute_path_uri: "file:///src/components/RightPanel.tsx"
    end_line: 142
    content: "import React from \'react\';\nimport {\n  Sparkles,\n  Check,\n  Building,\n  Download,\n  FileText,\n  FileSpreadsheet,\n} from \'lucide-react\';\nimport { ProjectData } from \'../types\';\nimport { computeProjectSummaries } from \'../services/calculationEngine\';\n\ninterface RightPanelProps {\n  project: ProjectData;\n  onOpenAIAssistant: () => void;\n  onExportExcel: () => void;\n}\n\nexport const RightPanel: React.FC<RightPanelProps> = ({\n  project,\n  onOpenAIAssistant,\n  onExportExcel,\n}) => {\n  const summaries = computeProjectSummaries(project.works);\n  const activeCount = project.works.filter((w) => w.isActive).length;\n  const isAllComplete = activeCount > 0 && summaries.pendingWorks === 0;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* 1. Asisten AI Card (Beta) */}\n      <div className=\"bg-white rounded-2xl border border-blue-200/90 p-5 shadow-xs relative overflow-hidden\">\n        {/* Subtle decorative background gradient */}\n        <div className=\"absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-full blur-2xl pointer-events-none -mr-10 -mt-10\" />\n\n        <div className=\"flex items-center justify-between mb-3 relative z-10\">\n          <div className=\"flex items-center gap-1.5 text-xs font-bold text-slate-900\">\n            <Sparkles className=\"w-4 h-4 text-blue-600\" />\n            <span>Asisten AI (Opsional)</span>\n          </div>\n          <span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700 tracking-wider\">\n            Beta\n          </span>\n        </div>\n\n        <div className=\"text-center py-2 relative z-10\">\n          <div className=\"w-14 h-14 mx-auto rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 mb-3 shadow-2xs\">\n            <FileSpreadsheet className=\"w-7 h-7 stroke-[1.5]\" />\n          </div>\n\n          <h4 className=\"text-sm font-bold text-slate-900 leading-snug\">\n            Bantu baca gambar &amp; dokumen\n          </h4>\n          <p className=\"text-xs text-slate-500 mt-1 leading-relaxed px-1\">\n            Unggah gambar atau PDF denah bangunan, AI akan mengekstrak data dan memberi usulan parameter yang bisa kamu verifikasi.\n          </p>\n\n          <button\n            onClick={onOpenAIAssistant}\n            className=\"w-full mt-4 py-2.5 px-4 rounded-xl bg-white border border-blue-200 hover:border-blue-400 hover:bg-blue-50/60 text-blue-700 font-bold text-xs transition flex items-center justify-center gap-2 shadow-2xs\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>Coba Sekarang</span>\n          </button>\n        </div>\n\n        {/* Feature List */}\n        <div className=\"mt-4 pt-3.5 border-t border-slate-100 space-y-1.5 text-xs text-slate-600\">\n          <span className=\"text-[11px] font-semibold text-slate-700 block mb-1\">\n            Contoh data yang bisa dibaca:\n          </span>\n          <div className=\"flex items-center gap-2 text-[11px]\">\n            <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n            <span>Dimensi bangunan (P \303\227 L \303\227 T)</span>\n          </div>\n          <div className=\"flex items-center gap-2 text-[11px]\">\n            <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n            <span>Jumlah lantai &amp; elevasi</span>\n          </div>\n          <div className=\"flex items-center gap-2 text-[11px]\">\n            <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n            <span>Ukuran kolom, balok, pelat</span>\n          </div>\n          <div className=\"flex items-center gap-2 text-[11px]\">\n            <Check className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n            <span>Dan lainnya...</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. Ringkasan Proyek Card */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 p-5 shadow-xs\">\n        <h4 className=\"text-sm font-bold text-slate-900 mb-3\">Ringkasan Proyek</h4>\n\n        <div className=\"flex items-center gap-4 py-1\">\n          {/* Building Illustration Vector */}\n          <div className=\"w-20 h-20 rounded-2xl bg-slate-100 flex items-center justify-center shrink-0 border border-slate-200 overflow-hidden relative\">\n            <Building className=\"w-10 h-10 text-slate-400\" />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-blue-900/10 to-transparent pointer-events-none\" />\n          </div>\n\n          <div className=\"space-y-1 text-xs\">\n            <div>\n              <span className=\"text-[11px] text-slate-400 block\">Nama Proyek</span>\n              <span className=\"font-bold text-slate-900 block truncate max-w-[140px]\">\n                {project.name}\n              </span>\n            </div>\n            <div>\n              <span className=\"text-[11px] text-slate-400 block\">Jumlah Lantai</span>\n              <span className=\"font-bold text-slate-800\">{project.floorCount} Lantai</span>\n            </div>\n            <div>\n              <span className=\"text-[11px] text-slate-400 block\">Total Pekerjaan</span>\n              <span className=\"font-bold text-slate-800\">{activeCount} Item</span>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"mt-3\">\n          <span\n            className={`inline-block px-3 py-1 text-[11px] font-semibold rounded-full border ${\n              isAllComplete\n                ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                : \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n            }`}\n          >\n            {isAllComplete ? \'Kalkulasi Lengkap\' : \'Dalam Proses\'}\n          </span>\n        </div>\n\n        {/* Primary CTA Export Button */}\n        <button\n          onClick={onExportExcel}\n          className=\"w-full mt-4 py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs transition flex items-center justify-center gap-2 shadow-xs\"\n        >\n          <Download className=\"w-4 h-4\" />\n          <span>Ekspor Excel</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 143
    num_bytes: 5967
    line_range_bytes: 5967
  }
}
