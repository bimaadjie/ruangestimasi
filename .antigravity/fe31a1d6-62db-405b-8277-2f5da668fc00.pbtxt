    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst data = JSON.parse(fs.readFileSync(\'public/assets/aistudio/katalog_volume_usc_639e973f.json\', \'utf8\'));\nconst s1 = data.sheets.find(s => s.name === \'Volume Persiapan Dll\');\nconsole.log(\'=== Volume Persiapan Dll (All Rows) ===\');\nfor (const r of s1.rows) {\n  console.log(\'R\' + r.row + \':\', r.cells.map(c => c.cell + \'=\' + JSON.stringify(c.value)).join(\' | \'));\n}\nconst s2 = data.sheets.find(s => s.name === \'Volume Struktural\');\nconsole.log(\'=== Volume Struktural (Rows 30-155) ===\');\nfor (const r of s2.rows) {\n  if (r.row < 30 || r.row > 155) continue;\n  console.log(\'R\' + r.row + \':\', r.cells.map(c => c.cell + \'=\' + JSON.stringify(c.value) + (c.excel_formula ? \'[\'+c.excel_formula+\']\' : \'\')).join(\' | \'));\n}\n\""
