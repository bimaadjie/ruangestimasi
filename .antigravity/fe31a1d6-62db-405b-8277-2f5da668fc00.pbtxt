              text: "    excelCell: \'U115\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excelFormula: \'=K115/0.15*(0.27+0.16)*12*O115*Q115\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    verificationStatus: \'Belum Diisi\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    parameters: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'lebar_tangga\', name: \'lebar_tangga\', label: \'Lebar Tangga\', placeholder: \'Masukkan lebar tangga (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'jarak_tulangan\', name: \'jarak_tulangan\', label: \'Jarak Tulangan\', placeholder: \'Masukkan jarak tulangan (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'antrede\', name: \'antrede\', label: \'Lebar Antrede\', placeholder: \'Masukkan lebar antrede (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'optrede\', name: \'optrede\', label: \'Tinggi Optrede\', placeholder: \'Masukkan tinggi optrede (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'jumlah_anak_tangga\', name: \'jumlah_anak_tangga\', label: \'Jumlah Anak Tangga\', placeholder: \'Masukkan jumlah trap (bh)\', value: null, unit: \'bh\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { id: \'berat_jenis\', name: \'berat_jenis\', label: \'Berat Besi per Meter\', placeholder: \'Masukkan berat jenis (kg/m)\', value: null, unit: \'kg/m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const l = params[\'lebar_tangga\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const s = params[\'jarak_tulangan\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const a = params[\'antrede\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const o = params[\'optrede\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const n = params[\'jumlah_anak_tangga\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const bj = params[\'berat_jenis\'];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (l == null || s == null || a == null || o == null || n == null || bj == null || s <= 0) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return (l / s) * (a + o) * n * bj;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
