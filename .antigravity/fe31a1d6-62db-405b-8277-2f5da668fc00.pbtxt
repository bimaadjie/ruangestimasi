      id: "call_914333"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport {\\n  X,\\n  Calculator,\\n  Info,\\n  Save,\\n  Sparkles,\\n  AlertTriangle,\\n  FileText,\\n  CheckCircle2,\\n  Ruler,\\n  Table2,\\n  RotateCcw,\\n} from \'lucide-react\';\\nimport { AIVerificationBadge, ProjectWorkItem, ParameterItem } from \'../types\';\\nimport { calculateWorkItemVolume, formatIndonesianNumber } from \'../services/calculationEngine\';\\n\\ninterface WorkDetailModalProps {\\n  isOpen: boolean;\\n  work: ProjectWorkItem | null;\\n  floorName?: string;\\n  onClose: () => void;\\n  onSaveWork: (updatedWork: ProjectWorkItem) => void;\\n  onRejectDraftWork?: (workId: string) => void;\\n}\\n\\nexport const WorkDetailModal: React.FC<WorkDetailModalProps> = ({\\n  isOpen,\\n  work,\\n  floorName,\\n  onClose,\\n  onSaveWork,\\n  onRejectDraftWork,\\n}) => {\\n  if (!isOpen || !work) return null;\\n\\n  const [workName, setWorkName] = useState<string>(work.name);\\n  const [localParams, setLocalParams] = useState<ParameterItem[]>([]);\\n  const [activeTab, setActiveTab] = useState<\'params\' | \'formula\' | \'source\'>(\'params\');\\n  const [validationError, setValidationError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    if (work) {\\n      setWorkName(work.name);\\n      setLocalParams(JSON.parse(JSON.stringify(work.parameters || [])));\\n      setValidationError(null);\\n    }\\n  }, [work]);\\n\\n  const handleParamChange = (id: string, rawInput: string) => {\\n    setValidationError(null);\\n    const trimmed = rawInput.trim();\\n\\n    if (trimmed === \'\') {\\n      // Jangan pernah menganggap input kosong sebagai angka nol!\\n      setLocalParams((prev) =>\\n        prev.map((p) =>\\n          p.id === id\\n            ? {\\n                ...p,\\n                value: null,\\n                source: \'manual\',\\n                verificationBadge: undefined,\\n                isVerified: true,\\n                conflict: null,\\n              }\\n            : p\\n        )\\n      );\\n      return;\\n    }\\n\\n    const num = Number(trimmed);\\n    if (isNaN(num) || num < 0) {\\n      setValidationError(\'Nilai parameter harus berupa angka positif yang valid.\');\\n      return;\\n    }\\n\\n    setLocalParams((prev) =>\\n      prev.map((p) =>\\n        p.id === id\\n          ? {\\n              ...p,\\n              value: num,\\n              source: \'manual\',\\n              verificationBadge: undefined,\\n              isVerified: true,\\n              conflict: null,\\n            }\\n          : p\\n      )\\n    );\\n  };\\n\\n  const handleResolveConflict = (paramId: string, useNewValue: boolean) => {\\n    setLocalParams((prev) =>\\n      prev.map((p) => {\\n        if (p.id !== paramId || !p.conflict) return p;\\n        if (useNewValue) {\\n          return {\\n            ...p,\\n            value: p.conflict.newValue,\\n            rawExtractedValue: p.conflict.rawExtractedValue,\\n            rawUnit: p.conflict.rawUnit,\\n            sourceDocument: p.conflict.sourceDocument,\\n            pageOrLocation: p.conflict.pageOrLocation,\\n            sourceInfo: p.conflict.sourceInfo || p.sourceInfo,\\n            source: \'ai\',\\n            verificationBadge: \'Terbaca Jelas\',\\n            isVerified: true,\\n            conflict: null,\\n          };\\n        }\\n        return {\\n          ...p,\\n          isVerified: true,\\n          conflict: null,\\n        };\\n      })\\n    );\\n  };\\n\\n  const renderBadgePill = (badge?: AIVerificationBadge) => {\\n    if (!badge) return null;\\n    switch (badge) {\\n      case \'Terbaca Jelas\':\\n        return (\\n          <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200\\\">\\n            Terbaca Jelas\\n          </span>\\n        );\\n      case \'Hasil Penggabungan\':\\n        return (\\n          <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 border border-indigo-200\\\">\\n            Hasil Penggabungan\\n          </span>\\n        );\\n      case \'Tidak Ditemukan\':\\n        return (\\n          <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded bg-rose-100 text-rose-800 border border-rose-200\\\">\\n            Tidak Ditemukan\\n          </span>\\n        );\\n      case \'Perlu Verifikasi\':\\n      default:\\n        return (\\n          <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200\\\">\\n            Perlu Verifikasi\\n          </span>\\n        );\\n    }\\n  };\\n\\n  // Hitung live volume preview secara real-time saat parameter diubah\\n  const previewWork: ProjectWorkItem = {\\n    ...work,\\n    parameters: localParams,\\n  };\\n  const liveCalcResult = calculateWorkItemVolume(previewWork);\\n\\n  const handleSave = (approveAiDraft: boolean = false) => {\\n    for (const p of localParams) {\\n      if (p.value !== null && p.value !== \'\' && (isNaN(Number(p.value)) || Number(p.value) < 0)) {\\n        setValidationError(`Parameter \\\"${p.label || p.name}\\\" harus berisi angka positif yang valid.`);\\n        return;\\n      }\\n      if (p.required && p.value !== null && p.value !== \'\' && Number(p.value) <= 0) {\\n        setValidationError(`Parameter wajib \\\"${p.label || p.name}\\\" harus lebih besar dari 0.`);\\n        return;\\n      }\\n    }\\n\\n    const updatedParams = localParams.map((p) => ({\\n      ...p,\\n      isVerified: approveAiDraft ? true : p.isVerified,\\n      conflict: approveAiDraft ? null : p.conflict,\\n    }));\\n\\n    const updated: ProjectWorkItem = {\\n      ...work,\\n      name: workName.trim() || work.name,\\n      parameters: updatedParams,\\n      aiVerificationStatus: approveAiDraft ? \'verified\' : work.aiVerificationStatus,\\n      lastUpdated: new Date().toISOString(),\\n    };\\n    onSaveWork(updated);\\n    onClose();\\n  };\\n\\n  const isAiDraft = work.origin === \'ai\' && work.aiVerificationStatus === \'draft\';\\n  const hasMissingRequired = localParams.some(\\n    (p) =>\\n      p.required &&\\n      (p.value === null || p.value === \'\' || isNaN(Number(p.value)) || Number(p.value) <= 0)\\n  );\\n\\n  // Bangun substitusi rumus contoh\\n  const substitutionParts = localParams\\n    .filter((p) => p.value !== null && p.value !== \'\')\\n    .map((p) => `${p.label || p.name} = ${p.value} ${p.unit}`);\\n\\n  const hasSegments = Array.isArray(work.segments) && work.segments.length > 0;\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs\\\">\\n      <div className=\\\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150 flex flex-col max-h-[92vh]\\\">\\n        {/* Header */}\\n        <div className=\\\"px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60 shrink-0\\\">\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <div className=\\\"w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold shadow-2xs\\\">\\n              <Calculator className=\\\"w-4 h-4\\\" />\\n            </div>\\n            <div>\\n              <div className=\\\"flex items-center gap-2 flex-wrap\\\">\\n                <h3 className=\\\"text-sm font-bold text-slate-900\\\">{work.name}</h3>\\n                {work.elementCode && (\\n                  <span className=\\\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-200 text-slate-800\\\">\\n                    Kode: {work.elementCode}\\n                  </span>\\n                )}\\n                {renderBadgePill(work.verificationBadge)}\\n                {isAiDraft && (\\n                  <span className=\\\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-100 text-blue-800\\\">\\n                    <Sparkles className=\\\"w-2.5 h-2.5\\\" />\\n                    Draf AI \342\200\224 Perlu Verifikasi\\n                  </span>\\n                )}\\n              </div>\\n              <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n                {work.category} \302\267 {floorName || work.floorId}\\n                {work.elementLocation ? ` \302\267 Lokasi: ${work.elementLocation}` : \'\'}\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/50 transition cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Modal Tabs */}\\n        <div className=\\\"flex items-center px-6 border-b border-slate-100 text-xs font-semibold gap-6 shrink-0 bg-white\\\">\\n          <button\\n            onClick={() => setActiveTab(\'params\')}\\n            className={`py-3 border-b-2 transition cursor-pointer ${\\n              activeTab === \'params\'\\n                ? \'border-blue-600 text-blue-600\'\\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\\n            }`}\\n          >\\n            Form Parameter Dimensi\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'formula\')}\\n            className={`py-3 border-b-2 transition cursor-pointer ${\\n              activeTab === \'formula\'\\n                ? \'border-blue-600 text-blue-600\'\\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\\n            }`}\\n          >\\n            Rumus &amp; Rincian Segmen\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'source\')}\\n            className={`py-3 border-b-2 transition cursor-pointer ${\\n              activeTab === \'source\'\\n                ? \'border-blue-600 text-blue-600\'\\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\\n            }`}\\n          >\\n            Sumber &amp; Verifikasi\\n          </button>\\n        </div>\\n\\n        {/* Content Area */}\\n        <div className=\\\"p-6 overflow-y-auto space-y-5 flex-1\\\">\\n          {validationError && (\\n            <div className=\\\"p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2\\\">\\n              <AlertTriangle className=\\\"w-4 h-4 shrink-0\\\" />\\n              <span>{validationError}</span>\\n            </div>\\n          )}\\n\\n          {activeTab === \'params\' && (\\n            <div className=\\\"space-y-4\\\">\\n              {/* Editable Work Name Field */}\\n              <div className=\\\"p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/90\\\">\\n                <label\\n                  htmlFor=\\\"edit-work-name-input\\\"\\n                  className=\\\"text-xs font-bold text-slate-800 block mb-1.5\\\"\\n                >\\n                  Nama Pekerjaan (Proyek Ini)\\n                </label>\\n                <input\\n                  id=\\\"edit-work-name-input\\\"\\n                  type=\\\"text\\\"\\n                  value={workName}\\n                  onChange={(e) => setWorkName(e.target.value)}\\n                  placeholder=\\\"Masukkan nama pekerjaan...\\\"\\n                  className=\\\"w-full px-3.5 py-2 text-xs font-bold bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900\\\"\\n                />\\n                <span className=\\\"text-[10px] text-slate-500 block mt-1\\\">\\n                  Mengubah nama pekerjaan di proyek ini tidak mengubah template standar USC global.\\n                </span>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between text-xs text-slate-500\\\">\\n                <span>Lengkapi parameter ukuran di bawah ini secara vertikal:</span>\\n                <span className=\\\"font-bold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-100\\\">\\n                  Satuan Volume: {work.unit}\\n                </span>\\n              </div>\\n\\n              {/* Vertical Parameter Input Cards */}\\n              <div className=\\\"space-y-3.5\\\">\\n                {localParams.map((param) => {\\n                  const isEmptyRequired =\\n                    param.required &&\\n                    (param.value === null ||\\n                      param.value === \'\' ||\\n                      isNaN(Number(param.value)) ||\\n                      Number(param.value) <= 0);\\n\\n                  const defaultPlaceholder =\\n                    param.placeholder ||\\n                    `Masukkan ${(param.label || param.name).toLowerCase()} (${param.unit})`;\\n\\n                  return (\\n                    <div\\n                      key={param.id}\\n                      className={`p-4 rounded-xl border transition ${\\n                        param.conflict\\n                          ? \'bg-rose-50/60 border-rose-300\'\\n                          : isEmptyRequired\\n                          ? \'bg-amber-50/40 border-amber-300\'\\n                          : \'bg-slate-50/70 border-slate-200/90\'\\n                      }`}\\n                    >\\n                      {/* 1. Label Parameter di Atas Input */}\\n                      <div className=\\\"flex flex-wrap items-center justify-between gap-2 mb-2\\\">\\n                        <label\\n                          htmlFor={`param-input-${param.id}`}\\n                          className=\\\"text-xs font-bold text-slate-900 flex items-center gap-1\\\"\\n                        >\\n                          <span>{param.label || param.name}</span>\\n                          <span className=\\\"text-slate-500 font-normal\\\">({param.unit})</span>\\n                          {param.required && (\\n                            <span className=\\\"text-rose-600 font-bold ml-0.5\\\" title=\\\"Parameter Wajib\\\">\\n                              *\\n                            </span>\\n                          )}\\n                        </label>\\n\\n                        {/* Badge Status Parameter */}\\n                        <div className=\\\"flex flex-wrap items-center gap-1.5\\\">\\n                          {renderBadgePill(param.verificationBadge)}\\n\\n                          {param.source === \'ai\' && param.value !== null && param.value !== \'\' ? (\\n                            <span className=\\\"inline-flex items-center gap-1 text-[10px] font-semibold text-blue-700 bg-blue-100/90 px-2 py-0.5 rounded-md\\\">\\n                              <Sparkles className=\\\"w-2.5 h-2.5\\\" />\\n                              Terbaca AI\\n                              {param.rawExtractedValue !== undefined && param.rawUnit\\n                                ? ` (${param.rawExtractedValue} ${param.rawUnit})`\\n                                : \'\'}\\n                            </span>\\n                          ) : param.value !== null && param.value !== \'\' ? (\\n                            <span className=\\\"text-[10px] font-medium text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-md\\\">\\n                              Terisi ({param.value} {param.unit})\\n                            </span>\\n                          ) : (\\n                            <span className=\\\"text-[10px] font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded-md\\\">\\n                              {param.required ? \'Wajib Diisi \342\200\224 Belum Ada Nilai\' : \'Opsional (Kosong)\'}\\n                            </span>\\n                          )}\\n\\n                          {param.drawingType && (\\n                            <span className=\\\"text-[10px] font-medium text-slate-600 bg-white border border-slate-200 px-1.5 py-0.5 rounded\\\">\\n                              {param.drawingType}\\n                              {param.pageNumber ? ` (Hal. ${param.pageNumber})` : \'\'}\\n                            </span>\\n                          )}\\n                        </div>\\n                      </div>\\n\\n                      {/* 2. Kotak Input Vertikal Penuh dengan Satuan Jelas */}\\n                      <div className=\\\"relative flex items-center\\\">\\n                        <input\\n                          id={`param-input-${param.id}`}\\n                          type=\\\"number\\\"\\n                          min=\\\"0\\\"\\n                          step=\\\"any\\\"\\n                          placeholder={defaultPlaceholder}\\n                          value={param.value ?? \'\'}\\n                          onChange={(e) => handleParamChange(param.id, e.target.value)}\\n                          className={`w-full pl-3.5 pr-16 py-2.5 text-sm font-mono font-bold bg-white border rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 transition text-slate-900 placeholder:font-sans placeholder:font-normal placeholder:text-slate-400 ${\\n                            isEmptyRequired ? \'border-amber-400\' : \'border-slate-300\'\\n                          }`}\\n                        />\\n                        <div className=\\\"absolute right-2 px-2.5 py-1 rounded-lg bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700 pointer-events-none\\\">\\n                          {param.unit}\\n                        </div>\\n                      </div>\\n\\n                      {(param.sourceInfo || param.pageOrLocation) && (\\n                        <p className=\\\"text-[11px] text-slate-600 mt-1.5 flex items-center gap-1\\\">\\n                          <Ruler className=\\\"w-3 h-3 text-blue-600 shrink-0\\\" />\\n                          <span>\\n                            Sumber Gambar:{\' \'}\\n                            <strong>{param.sourceInfo || param.pageOrLocation}</strong>\\n                          </span>\\n                        </p>\\n                      )}\\n\\n                      {/* Conflict Resolution Box if another drawing has a different value */}\\n                      {param.conflict && (\\n                        <div className=\\\"mt-3 pt-2.5 border-t border-rose-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px]\\\">\\n                          <div className=\\\"flex items-start gap-1.5 text-rose-800\\\">\\n                            <AlertTriangle className=\\\"w-3.5 h-3.5 text-rose-600 shrink-0 mt-0.5\\\" />\\n                            <span>\\n                              Dokumen <strong>{param.conflict.sourceDocument}</strong> mencantumkan\\n                              nilai berbeda:{\' \'}\\n                              <strong>\\n                                {param.conflict.newValue} {param.unit}\\n                              </strong>{\' \'}\\n                              (tertulis {param.conflict.rawExtractedValue} {param.conflict.rawUnit})\\n                            </span>\\n                          </div>\\n                          <div className=\\\"flex items-center gap-1.5 shrink-0\\\">\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleResolveConflict(param.id, false)}\\n                              className=\\\"px-2.5 py-1 rounded bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 font-semibold transition cursor-pointer\\\"\\n                            >\\n                              Pertahankan ({param.value})\\n                            </button>\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleResolveConflict(param.id, true)}\\n                              className=\\\"px-2.5 py-1 rounded bg-blue-600 text-white hover:bg-blue-700 font-semibold transition cursor-pointer\\\"\\n                            >\\n                              Gunakan Nilai Baru ({param.conflict.newValue})\\n                            </button>\\n                          </div>\\n                        </div>\\n                      )}\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n\\n              {/* Tabel Rincian Segmen Balok / Sloof (Jika ada) */}\\n              {hasSegments && (\\n                <div className=\\\"p-4 rounded-xl border border-blue-200 bg-blue-50/30 space-y-2.5\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <div className=\\\"flex items-center gap-2 text-xs font-bold text-blue-950\\\">\\n                      <Table2 className=\\\"w-4 h-4 text-blue-600\\\" />\\n                      <span>Rincian Penjumlahan Segmen ({work.segments!.length} Jalur Segmen)</span>\\n                    </div>\\n                    <span className=\\\"text-[11px] font-semibold text-blue-700\\\">\\n                      Total Panjang ={\' \'}\\n                      {formatIndonesianNumber(\\n                        work.segments!.reduce((acc, s) => acc + (s.subtotalMeters || 0), 0)\\n                      )}{\' \'}\\n                      m\\n                    </span>\\n                  </div>\\n                  <div className=\\\"border border-blue-200/80 rounded-lg overflow-hidden bg-white\\\">\\n                    <table className=\\\"w-full text-left text-[11px] border-collapse\\\">\\n                      <thead>\\n                        <tr className=\\\"bg-slate-50 border-b border-slate-200 text-slate-700 font-bold\\\">\\n                          <th className=\\\"py-2 px-2.5\\\">Tipe</th>\\n                          <th className=\\\"py-2 px-2.5\\\">Segmen</th>\\n                          <th className=\\\"py-2 px-2.5\\\">Lokasi Grid</th>\\n                          <th className=\\\"py-2 px-2.5 text-right\\\">Panjang (m)</th>\\n                          <th className=\\\"py-2 px-2.5 text-center\\\">Jml</th>\\n                          <th className=\\\"py-2 px-2.5 text-right\\\">Subtotal (m)</th>\\n                        </tr>\\n                      </thead>\\n                      <tbody className=\\\"divide-y divide-slate-100\\\">\\n                        {work.segments!.map((seg) => (\\n                          <tr key={seg.id} className=\\\"hover:bg-slate-50/70\\\">\\n                            <td className=\\\"py-1.5 px-2.5 font-mono font-bold text-blue-800\\\">\\n                              {seg.elementCode}\\n                            </td>\\n                            <td className=\\\"py-1.5 px-2.5 text-slate-800\\\">{seg.segmentName}</td>\\n                            <td className=\\\"py-1.5 px-2.5 font-mono text-slate-600\\\">\\n                              {seg.gridLocation}\\n                            </td>\\n                            <td className=\\\"py-1.5 px-2.5 text-right font-mono\\\">\\n                              {formatIndonesianNumber(seg.lengthMeters)}\\n                            </td>\\n                            <td className=\\\"py-1.5 px-2.5 text-center font-mono\\\">{seg.count || 1}</td>\\n                            <td className=\\\"py-1.5 px-2.5 text-right font-mono font-bold text-slate-900\\\">\\n                              {formatIndonesianNumber(seg.subtotalMeters)}\\n                            </td>\\n                          </tr>\\n                        ))}\\n                      </tbody>\\n                    </table>\\n                  </div>\\n                </div>\\n              )}\\n\\n              {/* Rumus & Hasil Perhitungan Otomatis di Bawah Form */}\\n              <div className=\\\"p-4 rounded-xl border border-blue-200 bg-gradient-to-r from-blue-50/80 to-indigo-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n                <div className=\\\"space-y-1\\\">\\n                  <span className=\\\"text-[10px] font-bold uppercase tracking-wider text-blue-800 block\\\">\\n                    Rumus Perhitungan Pekerjaan\\n                  </span>\\n                  <span className=\\\"text-xs font-mono font-bold text-slate-900 block\\\">\\n                    Volume = {work.formulaDisplay || \'Perkalian Parameter\'}\\n                  </span>\\n                  {substitutionParts.length > 0 && (\\n                    <span className=\\\"text-[11px] font-mono text-slate-600 block\\\">\\n                      {substitutionParts.join(\' \302\267 \')}\\n                    </span>\\n                  )}\\n                </div>\\n\\n                <div className=\\\"text-left sm:text-right shrink-0 bg-white px-4 py-2.5 rounded-xl border border-blue-200 shadow-2xs\\\">\\n                  <span className=\\\"text-[10px] font-bold uppercase tracking-wider text-slate-400 block\\\">\\n                    Hasil Volume Otomatis\\n                  </span>\\n                  <span\\n                    className={`text-base font-mono font-bold block ${\\n                      liveCalcResult.volume !== null ? \'text-emerald-700\' : \'text-amber-700\'\\n                    }`}\\n                  >\\n                    {liveCalcResult.volume !== null\\n                      ? `${formatIndonesianNumber(liveCalcResult.volume)} ${work.unit}`\\n                      : \'Menunggu Parameter Wajib\'}\\n                  </span>\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {activeTab === \'formula\' && (\\n            <div className=\\\"space-y-4 text-xs\\\">\\n              <div className=\\\"p-4 bg-blue-50/60 rounded-xl border border-blue-100\\\">\\n                <span className=\\\"text-[11px] font-bold text-blue-800 uppercase tracking-wider block mb-1\\\">\\n                  Rumus Perhitungan Volume\\n                </span>\\n                <p className=\\\"text-sm font-bold text-blue-950 font-mono\\\">\\n                  {work.formulaDisplay || \'V = perkalian parameter\'}\\n                </p>\\n              </div>\\n\\n              <div className=\\\"p-4 bg-slate-50 rounded-xl border border-slate-200\\\">\\n                <span className=\\\"text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-1\\\">\\n                  Substitusi Nilai Parameter\\n                </span>\\n                <p className=\\\"font-mono text-slate-800 leading-relaxed\\\">\\n                  {substitutionParts.length > 0\\n                    ? substitutionParts.join(\' ; \')\\n                    : \'Belum ada parameter yang diinput.\'}\\n                </p>\\n              </div>\\n\\n              {hasSegments && (\\n                <div className=\\\"p-4 bg-white rounded-xl border border-slate-200 space-y-2\\\">\\n                  <span className=\\\"text-[11px] font-bold text-slate-700 uppercase tracking-wider block\\\">\\n                    Tabel Rincian Segmen Balok / Sloof\\n                  </span>\\n                  <div className=\\\"border border-slate-200 rounded-lg overflow-hidden\\\">\\n                    <table className=\\\"w-full text-left text-xs border-collapse\\\">\\n                      <thead>\\n                        <tr className=\\\"bg-slate-50 border-b border-slate-200 text-slate-700 font-bold\\\">\\n                          <th className=\\\"py-2 px-3\\\">Tipe</th>\\n                          <th className=\\\"py-2 px-3\\\">Segmen</th>\\n                          <th className=\\\"py-2 px-3\\\">Lokasi Grid</th>\\n                          <th className=\\\"py-2 px-3 text-right\\\">Panjang (m)</th>\\n                          <th className=\\\"py-2 px-3 text-center\\\">Jml</th>\\n                          <th className=\\\"py-2 px-3 text-right\\\">Subtotal (m)</th>\\n                        </tr>\\n                      </thead>\\n                      <tbody className=\\\"divide-y divide-slate-100\\\">\\n                        {work.segments!.map((seg) => (\\n                          <tr key={seg.id}>\\n                            <td className=\\\"py-2 px-3 font-mono font-bold text-blue-700\\\">\\n                              {seg.elementCode}\\n                            </td>\\n                            <td className=\\\"py-2 px-3\\\">{seg.segmentName}</td>\\n                            <td className=\\\"py-2 px-3 font-mono text-slate-600\\\">\\n                              {seg.gridLocation}\\n                            </td>\\n                            <td className=\\\"py-2 px-3 text-right font-mono\\\">\\n                              {formatIndonesianNumber(seg.lengthMeters)}\\n                            </td>\\n                            <td className=\\\"py-2 px-3 text-center font-mono\\\">{seg.count || 1}</td>\\n                            <td className=\\\"py-2 px-3 text-right font-mono font-bold\\\">\\n                              {formatIndonesianNumber(seg.subtotalMeters)}\\n                            </td>\\n                          </tr>\\n                        ))}\\n                      </tbody>\\n                    </table>\\n                  </div>\\n                </div>\\n              )}\\n\\n              <div className=\\\"p-4 bg-emerald-50/70 rounded-xl border border-emerald-200 flex items-center justify-between\\\">\\n                <div>\\n                  <span className=\\\"text-[11px] font-bold text-emerald-800 uppercase tracking-wider block\\\">\\n                    Volume Terhitung Saat Ini\\n                  </span>\\n                  <span className=\\\"text-xl font-bold text-emerald-950 font-mono\\\">\\n                    {liveCalcResult.volume !== null\\n                      ? `${formatIndonesianNumber(liveCalcResult.volume)} ${work.unit}`\\n                      : \'Menunggu parameter lengkap\'}\\n                  </span>\\n                </div>\\n                <span className=\\\"px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800\\\">\\n                  {liveCalcResult.status}\\n                </span>\\n              </div>\\n            </div>\\n          )}\\n\\n          {activeTab === \'source\' && (\\n            <div className=\\\"space-y-3.5 text-xs\\\">\\n              <div className=\\\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-1.5\\\">\\n                <div className=\\\"flex items-center justify-between\\\">\\n                  <span className=\\\"font-bold text-slate-800\\\">Asal Pekerjaan</span>\\n                  <span className=\\\"font-semibold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded border border-blue-100\\\">\\n                    {work.origin === \'ai\' ? \'Otomatis dari Analisis Gambar AI\' : \'Input / Katalog Proyek\'}\\n                  </span>\\n                </div>\\n                {work.sourceDocument && (\\n                  <p className=\\\"text-slate-600 text-[11px] flex items-center gap-1.5\\\">\\n                    <FileText className=\\\"w-3.5 h-3.5 text-blue-600\\\" />\\n                    Dokumen Sumber: <strong>{work.sourceDocument}</strong>\\n                  </p>\\n                )}\\n                {work.sourceInfo && (\\n                  <p className=\\\"text-slate-700 text-[11px]\\\">\\n                    Halaman &amp; Jenis Gambar: <strong>{work.sourceInfo}</strong>\\n                  </p>\\n                )}\\n                {work.identificationReason && (\\n                  <p className=\\\"text-slate-500 text-[11px]\\\">\\n                    Alasan Identifikasi: {work.identificationReason}\\n                  </p>\\n                )}\\n              </div>\\n\\n              <div className=\\\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\\\">\\n                <div>\\n                  <span className=\\\"text-slate-500 block mb-0.5\\\">Status Verifikasi Estimator</span>\\n                  <span className=\\\"font-bold text-slate-900 block text-sm\\\">\\n                    {isAiDraft\\n                      ? \'Draf AI \342\200\224 Menunggu Persetujuan Pengguna\'\\n                      : \'Terverifikasi (Masuk ke Rekap Volume Final)\'}\\n                  </span>\\n                </div>\\n                {renderBadgePill(work.verificationBadge)}\\n              </div>\\n\\n              {liveCalcResult.message && (\\n                <div className=\\\"p-3.5 bg-amber-50/70 rounded-xl border border-amber-200/80 text-amber-900 text-xs\\\">\\n                  <div className=\\\"flex items-start gap-2\\\">\\n                    <Info className=\\\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\\\" />\\n                    <p>{liveCalcResult.message}</p>\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Footer */}\\n        <div className=\\\"px-6 py-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 bg-slate-50/40 shrink-0\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              onClick={onClose}\\n              className=\\\"px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition cursor-pointer\\\"\\n            >\\n              Batal\\n            </button>\\n\\n            {isAiDraft && onRejectDraftWork && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  onRejectDraftWork(work.id);\\n                  onClose();\\n                }}\\n                className=\\\"inline-flex items-center gap-1 px-3 py-2 text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg transition cursor-pointer\\\"\\n              >\\n                <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Tolak Usulan AI</span>\\n              </button>\\n            )}\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              onClick={() => handleSave(false)}\\n              className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-lg transition shadow-2xs cursor-pointer\\\"\\n            >\\n              <Save className=\\\"w-3.5 h-3.5 text-blue-600\\\" />\\n              <span>Simpan Parameter</span>\\n            </button>\\n\\n            {isAiDraft && !hasMissingRequired && (\\n              <button\\n                onClick={() => handleSave(true)}\\n                className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition shadow-xs cursor-pointer\\\"\\n              >\\n                <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Simpan &amp; Setujui Draf AI</span>\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Update WorkDetailModal.tsx to display AI verification badges, source page/drawing type metadata, and a reject AI proposal option\",\"Overwrite\":true,\"TargetFile\":\"/src/components/WorkDetailModal.tsx\",\"toolAction\":\"Updating WorkDetailModal.tsx\",\"toolSummary\":\"Update WorkDetailModal.tsx\"}"
      thinking_signature: "\022\263\r\n\260\r\001i\024}\023\317\035\243\rLd\244X\330*\240\257\v\252~\250\357o\257\313\233\345dBU\023lad\346\302h\3323rn\240\264\346Fm\342\357\304\270\016\212x\216w&m\020\030&\246\317\323$\330\364\364\022\250\326+$\374\026&\255\247\304\267D\203f0\t\317\265i\323\270\276\230}\337\341\232\304q\261\f\237\3765\345\317C\214\233\\\247\331C\255\360U\316@\264\355\257y\327\221\316_5\340\200j\264\324P+\036\243\263x\300\001\366\342\227\316k\016\2627\260\255\350&&a\360\031\236=pe\267`.k\374\3777\330\022\301\360\324^\000\271\'\234\035-\370\274\230\030\260J\r\320\274\335\030\323\256\301\\0\344\005\360\247\242!\031\2665`5y\351D\234[\271\202\321\035G\303\367\256\311\230\327\0233\261\213\225?\260\357@\303\255\304\037\021\017\223\301\037:\334\231\005UX1l\266\213s=:,\323\376uQX[\021\005b\240.\315;\237\345\022\002\265\021dwx\304N\201\225 \225~W\002\204*\357\300\214\313\353\374\017z4:\226\265\303\331\262\331Q\363\325\354=q\0336!;\203\334\301<+\337:\304M:\3553o%e\277\243\211bo6\247U\352\246\335`\273\361K\213H\266\373\035\205v\001L\315nK\025\227p\037\207\276+\375}\240\344\aB\251\356\353\026\022\274l\325?O\314\a\247S\3124B1v\352\337~\247\000.\254II\271\345\3618o8R\363\374j\023+/f\243\277=0)\275\325=\365\362^-\340a\231\0338\336\367\247X\033W\355G\037\355\361\034\355VN(\r\244\211\352s{\353R\316C\342\253\016\033_/\2026\323\023.\202Y\231\3446\336\317\353\246\3374\2247\023\342\304\036\226l\311\305>\327\367{r\262\222B\315o\232\236h\034\256\343\353}\325\253*\321\246\334\030*D\006\307\320Sf\371\324\233\211\331\343q\346f\"\204\037\377\001\375\240\375\020\215\247\214_\244v\306\r\255\240\205\364\321T\236t\342\214{\256*S\016\0374\337\313\355?2\260\034,\234u\006\024 \265\320\204\325\f\313\016\3615BF\305f\a\271\016\202\277\261\2529\260\371\210\255oz\370Ux\v\274\301\243\373\030\017\\\204\366\035\"\361\227\326WI*c\204\377P\020\032F\362\025\351\215:G\231r\255U\264\f\0060\220Q\333?y,\t\367z\327\223\326\320\270,\026\307\244\370\203\227\306\026\2707\033\272\362x\323\204\177\321\362f\302\031\325\357\"\031\355\020\263du\346\001\220MY\255\337f\326\244g9\036\003\271\246\270\233\372\304J0\303\200\303~\264\247\367a\356\340K\206~\227i\203\331\346\f\025!\221\376\332qp\222\000\311\203\301\aA&\026{\000i!\261\223+=\331\366\353r\300EF\316K4\035\332\336\241:s\304\306,^Qc\022\324\347\267\375\214s\337\273\270O\266\027OC\213}\311l\310\235\215/\022\317\263\345\vR\235\316\325JuB\377{\243\b}\365\n\352Br\306e!\361\022a\343\026\026\374s=\367\271(\334f\325^{\266\320ZnGk4\344\212\b5\033\024GuM\225\305\024\216\306\247\343P\312\236\230\"\332R%\n3\266\322e\265\005\026\305\374\203\312\016:n\300\356\302c\261\230\t\224`\331\030.\\\234\377\003\326x\000u:Z\346$%\b\237<\340:r\255\340e\026\021\303g\315\265S\003a\225$\321\2109\305\234\"\335\232\a\311\300\245/h\206\232p\177\216\247\372\241\030\371\002uI\377pJ\373(\240\235\253\r\362\t\\\342\337\215\023\315i\202[K5\305\265\aFj\027\217\231k\027\021\270&\275\345\337\177\272\352a\227Q\363\001y\001\021g\347k\345\346\245\367\313\177\371QR_\312z\311j\242\215\002\354\326\263\210\227sX\306b\340:\3631\277\372-^\310\017\310\022\274\027\177\217\210\333\037\342\346\310\213\215\022\017uI\366Ak\357T(\035x\023\021k+\215\004K\246\270\262c\377\372\337\274O\205\252\216,\350\300<p\276\232/OFs<\217LGXZ\346\2114l\265U\313\\\350\372\202JDy[\337\240\350i\324\315\274X\225\352\347n\343\314\243C\"\311\273\251\3457\036\'\341=\"\246b\260\b@\000\004\342\005\260\340M\316\376g\331B\331Rq\033U\373@ \025\325\340t\264\323\201\224<\004;\224 \373?\266\265$b\316\2367:\2512\376\224\f\276+\327\372\326\260\216J\"\263\363:r\344S\234\203rG\016\353\202b\341\246b>\021v\030y\364\246\205\253>r\366\177\251\246\237\313g\2555\215\232\210\b\376\361\212D\341\"\230\003\2137H\272\354\211\202\'\236g5\035{\001\027x(\202|=\017\217\027|\232\020\a\030\236E\277\230J\337#\314[\'UI-G\360\246\254\204\240\257Y\256\2720\232\000\177P\017\241)\266\\W\275\271\vh \267\226\200\260d\321#\220RJu\270\305A&\245a\342\377U\217$E\365\316#\205\277M\001N\v\246\311\243\031\2254\254\302\274%D\267\324E\350\b\334\217\275d\340R\316\331\v!\234S\210\346\rr)\315\3607\027\221\205\302%\0235H\303\202\223\021D@\313\'\311-\274q\031.q\370\311T}\034\003\372t\266f\267l\n\373\204\203V\314]D\023>\027\211\212\314\261\376/\341\377\224\274\3479&\335\252\204+\220\253#\016\312\351\273\333\336\244\376\216cQ l\'^\a\304\364\220\355#\236\001\353j]\205\303;\026q\030\315\006\205\'\222\036W\205\323B\335\362\n\355\232\252Bw\2545\256\225\246\206,\327\n\177\nJ\327`7\253`\370Q\252\3260\352\232\331\261\313\302NQ\016&\362\322+\'\210E\016YJs\027\227\221t\003\312\f\204\216\365BE\353@\335\276\r\277\201\215\233\207@\206\373|mB\266o\345\253B\333bbA\036K\252\272\306\037L\211,\240L\315\350\022\352\203\356\350\230\220\375\022Y\237\273\262\272\2529R\257b\334\023\005\035\272z\205\315\307\026K\024y\330\247\334\261KX\244\366K\245UJ\031\231\351\214\315\322j\342\306\307_\263\373\311n$n\263\270\346\271/\252\004ppY\211\304\037M\270\303h\030\000\'\006\236\023$\222\342\201\366\305\276\005@p\372\323\346\354\253\327\031DFwi\271{W\360\037"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_915440"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * RuangEstimasi \342\200\224 Platform AI Quantity Takeoff & Kalkulator Volume Konstruksi\\n * Main Application Component (Protected by User Authentication & Strict Account Isolation)\\n */\\n\\nimport React, { useState, useEffect } from \'react\';\\nimport { Sidebar, NavTab } from \'./components/Sidebar\';\\nimport { Header } from \'./components/Header\';\\nimport { Stepper } from \'./components/Stepper\';\\nimport { UserOverviewBanner } from \'./components/UserOverviewBanner\';\\nimport { AutoQuantityTakeoffSection } from \'./components/AutoQuantityTakeoffSection\';\\nimport { WorkTable } from \'./components/WorkTable\';\\nimport { RightPanel } from \'./components/RightPanel\';\\nimport { RecapCards } from \'./components/RecapCards\';\\nimport { WorkDetailModal } from \'./components/WorkDetailModal\';\\nimport { AddWorkModal } from \'./components/AddWorkModal\';\\nimport { AIAssistantModal } from \'./components/AIAssistantModal\';\\nimport { FloorManagementModal } from \'./components/FloorManagementModal\';\\nimport { ProjectManagementModal } from \'./components/ProjectManagementModal\';\\nimport { AuthPage } from \'./components/AuthPage\';\\nimport { UserProfileModal } from \'./components/UserProfileModal\';\\n\\nimport {\\n  loadAllProjects,\\n  saveAllProjects,\\n  getActiveProjectId,\\n  setActiveProjectId,\\n  createNewProject,\\n  createDefaultWorksForFloor,\\n  loadSidebarCollapsed,\\n  saveSidebarCollapsed,\\n  applyAutoQuantityTakeoff,\\n  getAllCatalogItems,\\n  createProjectWorkFromCatalog,\\n  fetchProjectsFromServer,\\n  deleteProjectFromServer,\\n  fetchProjectsFromFirestore,\\n  deleteProjectFromFirestore,\\n} from \'./services/projectStorage\';\\nimport {\\n  getCurrentSessionUser,\\n  saveCurrentSessionUser,\\n  logoutUserAccount,\\n  fetchUserProfileFromFirestore,\\n} from \'./services/authService\';\\nimport { auth, onAuthStateChanged } from \'./firebase\';\\nimport { recalculateAllProjectWorks } from \'./services/calculationEngine\';\\nimport { exportProjectToExcel } from \'./services/excelExport\';\\nimport {\\n  AIAutoTakeoffSummary,\\n  AIBeamSloofSegment,\\n  AIDetectedRegion,\\n  AIExtractionItem,\\n  FloorItem,\\n  ProjectData,\\n  ProjectWorkItem,\\n  UserProfile,\\n} from \'./types\';\\n\\nexport default function App() {\\n  // Authentication state\\n  const [currentUser, setCurrentUser] = useState<UserProfile | null>(() => getCurrentSessionUser());\\n  const [isAuthReady, setIsAuthReady] = useState<boolean>(false);\\n  const [isUserProfileOpen, setIsUserProfileOpen] = useState<boolean>(false);\\n\\n  // Project state\\n  const [projects, setProjects] = useState<ProjectData[]>([]);\\n  const [activeProjectId, setActiveId] = useState<string>(\'\');\\n  const [activeTab, setActiveTab] = useState<NavTab>(\'dashboard\');\\n  const [currentStep, setCurrentStep] = useState<number>(2);\\n  const [isSaving, setIsSaving] = useState<boolean>(false);\\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\\n\\n  // Status Filter for WorkTable\\n  const [tableStatusFilter, setTableStatusFilter] = useState<\'all\' | \'ai_draft\' | \'incomplete\'>(\'all\');\\n\\n  // Sidebar state (Desktop collapse & Mobile drawer)\\n  const [isSidebarCollapsed, setIsSidebarCollapsed] = useState<boolean>(() =>\\n    loadSidebarCollapsed()\\n  );\\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState<boolean>(false);\\n\\n  // Modals & Undo state\\n  const [selectedWorkForDetail, setSelectedWorkForDetail] = useState<ProjectWorkItem | null>(null);\\n  const [isAddWorkOpen, setIsAddWorkOpen] = useState<boolean>(false);\\n  const [targetFloorForAdd, setTargetFloorForAdd] = useState<string | undefined>(undefined);\\n  const [isAIOpen, setIsAIOpen] = useState<boolean>(false);\\n  const [isFloorsOpen, setIsFloorsOpen] = useState<boolean>(false);\\n  const [isProjectsOpen, setIsProjectsOpen] = useState<boolean>(false);\\n  const [recentlyDeletedWorks, setRecentlyDeletedWorks] = useState<ProjectWorkItem[]>([]);\\n\\n  // Pantau status autentikasi Firebase & sesi pengguna\\n  useEffect(() => {\\n    const unsubscribe = onAuthStateChanged(auth, async (firebaseUser) => {\\n      if (firebaseUser) {\\n        const existingLocal = getCurrentSessionUser();\\n        if (!existingLocal || existingLocal.uid !== firebaseUser.uid) {\\n          const firestoreProfile = await fetchUserProfileFromFirestore(firebaseUser.uid);\\n          if (firestoreProfile) {\\n            setCurrentUser(firestoreProfile);\\n            saveCurrentSessionUser(firestoreProfile);\\n          }\\n        }\\n      }\\n      setIsAuthReady(true);\\n    });\\n    return () => unsubscribe();\\n  }, []);\\n\\n  // Muat daftar proyek terisolasi setiap kali currentUser berubah\\n  useEffect(() => {\\n    // Reset modal & state sementara saat akun pengguna berubah\\n    setSelectedWorkForDetail(null);\\n    setIsAIOpen(false);\\n    setIsAddWorkOpen(false);\\n    setIsFloorsOpen(false);\\n    setIsProjectsOpen(false);\\n    setRecentlyDeletedWorks([]);\\n\\n    if (!currentUser) {\\n      setProjects([]);\\n      setActiveId(\'\');\\n      return;\\n    }\\n\\n    const uid = currentUser.uid;\\n    const localProjects = loadAllProjects(uid);\\n    const savedActiveId = getActiveProjectId(uid);\\n\\n    setProjects(localProjects);\\n    const found = localProjects.find((p) => p.id === savedActiveId);\\n    if (found) {\\n      setActiveId(found.id);\\n    } else if (localProjects[0]) {\\n      setActiveId(localProjects[0].id);\\n      setActiveProjectId(localProjects[0].id, uid);\\n    }\\n\\n    // 1. Sinkronkan dengan Server Database (/api/projects) dengan verifikasi kepemilikan userId\\n    fetchProjectsFromServer(uid)\\n      .then((serverProjs) => {\\n        if (serverProjs && serverProjs.length > 0) {\\n          setProjects(serverProjs);\\n          saveAllProjects(serverProjs, uid);\\n          if (!serverProjs.some((p) => p.id === savedActiveId)) {\\n            setActiveId(serverProjs[0].id);\\n            setActiveProjectId(serverProjs[0].id, uid);\\n          }\\n        } else {\\n          // Simpan proyek lokal milik pengguna ini ke server jika di server belum ada\\n          saveAllProjects(localProjects, uid);\\n        }\\n      })\\n      .catch(() => {\\n        // Gunakan proyek terisolasi lokal jika offline\\n      });\\n\\n    // 2. Jika pengguna juga terautentikasi di Firebase, sinkronkan dengan Cloud Firestore\\n    if (auth.currentUser && auth.currentUser.uid === uid) {\\n      fetchProjectsFromFirestore(uid)\\n        .then((remoteProjs) => {\\n          if (remoteProjs && remoteProjs.length > 0) {\\n            setProjects(remoteProjs);\\n            saveAllProjects(remoteProjs, uid);\\n            if (!remoteProjs.some((p) => p.id === savedActiveId)) {\\n              setActiveId(remoteProjs[0].id);\\n              setActiveProjectId(remoteProjs[0].id, uid);\\n            }\\n          }\\n        })\\n        .catch(() => {\\n          // Gunakan proyek lokal jika offline\\n        });\\n    }\\n  }, [currentUser?.uid]);\\n\\n  const showToast = (msg: string) => {\\n    setToastMessage(msg);\\n    setTimeout(() => {\\n      setToastMessage(null);\\n    }, 3800);\\n  };\\n\\n  const handleUserAuthenticated = (user: UserProfile) => {\\n    setCurrentUser(user);\\n    saveCurrentSessionUser(user);\\n    showToast(`Selamat datang di RuangEstimasi, ${user.fullName}!`);\\n  };\\n\\n  const handleLogout = async () => {\\n    setIsUserProfileOpen(false);\\n    setSelectedWorkForDetail(null);\\n    setIsAIOpen(false);\\n    setRecentlyDeletedWorks([]);\\n    await logoutUserAccount();\\n    setProjects([]);\\n    setActiveId(\'\');\\n    setCurrentUser(null);\\n  };\\n\\n  const handleToggleSidebarCollapse = () => {\\n    setIsSidebarCollapsed((prev) => {\\n      const next = !prev;\\n      saveSidebarCollapsed(next);\\n      return next;\\n    });\\n  };\\n\\n  // Proteksi halaman dashboard: tampilkan halaman Sign In / Create Account jika belum login\\n  if (!currentUser) {\\n    if (!isAuthReady) {\\n      return (\\n        <div className=\\\"min-h-screen bg-[#F7F9FC] flex items-center justify-center text-xs font-semibold text-slate-500\\\">\\n          Memuat sesi RuangEstimasi...\\n        </div>\\n      );\\n    }\\n    return <AuthPage onAuthenticated={handleUserAuthenticated} />;\\n  }\\n\\n  const userId = currentUser.uid;\\n\\n  const activeProject: ProjectData =\\n    projects.find((p) => p.id === activeProjectId) ||\\n    projects[0] ||\\n    createNewProject(\'Proyek Baru\', 2, \'\', userId);\\n\\n  // Update proyek aktif\\n  const handleUpdateActiveProject = (updated: ProjectData) => {\\n    const recalculatedWorks = recalculateAllProjectWorks(updated.works);\\n    const finalProject: ProjectData = {\\n      ...updated,\\n      ownerUid: userId,\\n      works: recalculatedWorks,\\n      updatedAt: new Date().toISOString(),\\n    };\\n\\n    const exists = projects.some((p) => p.id === finalProject.id);\\n    const newProjects = exists\\n      ? projects.map((p) => (p.id === finalProject.id ? finalProject : p))\\n      : [finalProject, ...projects];\\n\\n    setProjects(newProjects);\\n    saveAllProjects(newProjects, userId);\\n  };\\n\\n  // Simpan proyek manual\\n  const handleSaveProject = () => {\\n    setIsSaving(true);\\n    saveAllProjects(projects, userId);\\n    setTimeout(() => {\\n      setIsSaving(false);\\n      showToast(\'Perubahan data proyek berhasil disimpan ke akun Anda.\');\\n    }, 400);\\n  };\\n\\n  // Ubah nama proyek\\n  const handleUpdateProjectName = (newName: string) => {\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      name: newName,\\n    });\\n    showToast(`Nama proyek diubah menjadi \\\"${newName}\\\".`);\\n  };\\n\\n  // Ekspor Excel\\n  const handleExportExcel = async () => {\\n    try {\\n      showToast(\'Mempersiapkan ekspor file Excel...\');\\n      await exportProjectToExcel(activeProject);\\n      showToast(\'File Excel (.xlsx) berhasil diekspor.\');\\n    } catch (err: unknown) {\\n      const msg = err instanceof Error ? err.message : String(err);\\n      showToast(`Gagal mengekspor file Excel: ${msg}`);\\n    }\\n  };\\n\\n  // Detail & Simpan pekerjaan yang diedit\\n  const handleSaveWorkItem = (updatedWork: ProjectWorkItem) => {\\n    const newWorks = activeProject.works.map((w) =>\\n      w.id === updatedWork.id ? updatedWork : w\\n    );\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n    });\\n    showToast(`Pekerjaan \\\"${updatedWork.name}\\\" diperbarui.`);\\n  };\\n\\n  // Tambah pekerjaan tunggal baru\\n  const handleAddWorkItem = (newWork: ProjectWorkItem) => {\\n    const newWorks = [newWork, ...activeProject.works];\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n    });\\n    showToast(`Pekerjaan \\\"${newWork.name}\\\" berhasil ditambahkan ke kalkulator.`);\\n  };\\n\\n  // Tambah banyak pekerjaan sekaligus (Multi-select)\\n  const handleAddMultipleWorks = (\\n    newWorks: ProjectWorkItem[],\\n    floorName: string,\\n    skippedCount: number\\n  ) => {\\n    const updatedWorks = [...newWorks, ...activeProject.works];\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: updatedWorks,\\n    });\\n    if (skippedCount > 0) {\\n      showToast(\\n        `Berhasil menambahkan ${newWorks.length} pekerjaan ke ${floorName} (${skippedCount} dilewati karena sudah ada).`\\n      );\\n    } else {\\n      showToast(`Berhasil menambahkan ${newWorks.length} pekerjaan ke ${floorName}.`);\\n    }\\n  };\\n\\n  // Hapus pekerjaan tunggal dari kalkulator\\n  const handleDeleteWorkItem = (workId: string) => {\\n    const workToDelete = activeProject.works.find((w) => w.id === workId);\\n    const newWorks = activeProject.works.filter((w) => w.id !== workId);\\n\\n    const existingRejected = new Set<string>(activeProject.rejectedDraftKeys || []);\\n    if (workToDelete?.dedupKey && workToDelete.origin === \'ai\') {\\n      existingRejected.add(workToDelete.dedupKey);\\n    }\\n\\n    if (workToDelete) {\\n      setRecentlyDeletedWorks((prev) => [workToDelete, ...prev]);\\n    }\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n      rejectedDraftKeys: Array.from(existingRejected),\\n    });\\n\\n    if (selectedWorkForDetail?.id === workId) {\\n      setSelectedWorkForDetail(null);\\n    }\\n\\n    showToast(`Pekerjaan \\\"${workToDelete?.name || \'\'}\\\" berhasil dihapus dari proyek ini.`);\\n  };\\n\\n  // Tolak usulan AI pada pekerjaan standar USC (mengosongkan parameter AI kembali ke Belum Diisi tanpa menghapus pekerjaan standar)\\n  const handleRejectDraftWork = (workId: string) => {\\n    const targetWork = activeProject.works.find((w) => w.id === workId);\\n    if (!targetWork) return;\\n\\n    const newWorks = activeProject.works.map((w) => {\\n      if (w.id !== workId) return w;\\n      return {\\n        ...w,\\n        origin: \'manual\' as const,\\n        aiVerificationStatus: undefined,\\n        verificationBadge: undefined,\\n        sourceDocument: undefined,\\n        sourceInfo: undefined,\\n        identificationReason: undefined,\\n        segments: undefined,\\n        elementCode: undefined,\\n        elementLocation: undefined,\\n        calculatedVolume: null,\\n        status: \'Belum Diisi\' as const,\\n        parameters: w.parameters.map((p) => ({\\n          ...p,\\n          value: null,\\n          source: \'manual\' as const,\\n          sourceDocument: undefined,\\n          sourceInfo: undefined,\\n          drawingType: undefined,\\n          drawingTitle: undefined,\\n          pageNumber: undefined,\\n          rawExtractedValue: undefined,\\n          rawUnit: undefined,\\n          verificationBadge: undefined,\\n          isVerified: false,\\n          conflict: null,\\n        })),\\n      };\\n    });\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n    });\\n    showToast(`Usulan AI pada \\\"${targetWork.name}\\\" ditolak dan parameter dikosongkan.`);\\n  };\\n\\n  // Hapus banyak pekerjaan sekaligus (Multi-select)\\n  const handleDeleteMultipleWorks = (workIds: string[]) => {\\n    if (workIds.length === 0) return;\\n    const idSet = new Set(workIds);\\n    const deletedItems = activeProject.works.filter((w) => idSet.has(w.id));\\n    const newWorks = activeProject.works.filter((w) => !idSet.has(w.id));\\n\\n    const existingRejected = new Set<string>(activeProject.rejectedDraftKeys || []);\\n    deletedItems.forEach((w) => {\\n      if (w.dedupKey && w.origin === \'ai\') {\\n        existingRejected.add(w.dedupKey);\\n      }\\n    });\\n\\n    setRecentlyDeletedWorks((prev) => [...deletedItems, ...prev]);\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n      rejectedDraftKeys: Array.from(existingRejected),\\n    });\\n\\n    if (selectedWorkForDetail && idSet.has(selectedWorkForDetail.id)) {\\n      setSelectedWorkForDetail(null);\\n    }\\n\\n    showToast(`Berhasil menghapus ${deletedItems.length} pekerjaan terpilih dari proyek ini.`);\\n  };\\n\\n  // Pulihkan pekerjaan yang baru dihapus\\n  const handleRestoreDeletedWorks = () => {\\n    if (recentlyDeletedWorks.length === 0) return;\\n    const existingIds = new Set(activeProject.works.map((w) => w.id));\\n    const toRestore = recentlyDeletedWorks.filter((w) => !existingIds.has(w.id));\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: [...toRestore, ...activeProject.works],\\n    });\\n    setRecentlyDeletedWorks([]);\\n    showToast(`Berhasil memulihkan ${toRestore.length} pekerjaan ke proyek aktif.`);\\n  };\\n\\n  // Muat kembali daftar pekerjaan standar yang belum ada pada suatu lantai\\n  const handleRestoreStandardFloorWorks = (floorId: string) => {\\n    const floor = activeProject.floors.find((f) => f.id === floorId);\\n    if (!floor) return;\\n\\n    const standardFloorWorks = createDefaultWorksForFloor(\\n      floor.id,\\n      floor.level,\\n      activeProject.floorCount\\n    );\\n    const existingCatalogIdsOnFloor = new Set(\\n      activeProject.works\\n        .filter((w) => w.floorId === floorId && w.catalogId)\\n        .map((w) => w.catalogId!)\\n    );\\n\\n    const missingWorks = standardFloorWorks.filter(\\n      (w) => w.catalogId && !existingCatalogIdsOnFloor.has(w.catalogId)\\n    );\\n\\n    if (missingWorks.length === 0) {\\n      showToast(`Seluruh pekerjaan standar untuk ${floor.name} sudah tersedia.`);\\n      return;\\n    }\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: [...activeProject.works, ...missingWorks],\\n    });\\n    showToast(\\n      `Berhasil memulihkan ${missingWorks.length} pekerjaan standar ke ${floor.name}.`\\n    );\\n  };\\n\\n  // Duplikasi pekerjaan\\n  const handleDuplicateWorkItem = (work: ProjectWorkItem) => {\\n    const duplicated: ProjectWorkItem = {\\n      ...work,\\n      id: `work-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\\n      name: `${work.name} (Salinan)`,\\n      dedupKey: undefined,\\n      lastUpdated: new Date().toISOString(),\\n    };\\n    const newWorks = [duplicated, ...activeProject.works];\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n    });\\n    showToast(`Pekerjaan \\\"${work.name}\\\" berhasil diduplikasi.`);\\n  };\\n\\n  // Nonaktifkan / Aktifkan pekerjaan\\n  const handleToggleActive = (workId: string) => {\\n    const newWorks = activeProject.works.map((w) =>\\n      w.id === workId ? { ...w, isActive: !w.isActive } : w\\n    );\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n    });\\n  };\\n\\n  // Setujui satu pekerjaan draf AI\\n  const handleApproveDraftWork = (workId: string) => {\\n    const targetWork = activeProject.works.find((w) => w.id === workId);\\n    if (!targetWork) return;\\n\\n    const newWorks: ProjectWorkItem[] = activeProject.works.map((w) =>\\n      w.id === workId\\n        ? {\\n            ...w,\\n            aiVerificationStatus: \'verified\',\\n            parameters: w.parameters.map((p) => ({ ...p, isVerified: true })),\\n            lastUpdated: new Date().toISOString(),\\n          }\\n        : w\\n    );\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n    });\\n    showToast(`Draf AI \\\"${targetWork.name}\\\" disetujui dan masuk ke total volume terverifikasi.`);\\n  };\\n\\n  // Setujui semua draf AI yang sudah lengkap parameternya\\n  const handleApproveAllReadyDrafts = () => {\\n    let approvedCount = 0;\\n    const newWorks: ProjectWorkItem[] = activeProject.works.map((w) => {\\n      const hasConflicts = w.parameters.some((p) => Boolean(p.conflict));\\n      if (w.aiVerificationStatus === \'draft\' && w.calculatedVolume !== null && !hasConflicts) {\\n        approvedCount++;\\n        return {\\n          ...w,\\n          aiVerificationStatus: \'verified\',\\n          parameters: w.parameters.map((p) => ({ ...p, isVerified: true })),\\n          lastUpdated: new Date().toISOString(),\\n        };\\n      }\\n      return w;\\n    });\\n\\n    if (approvedCount === 0) {\\n      showToast(\'Tidak ada draf AI yang siap disetujui (lengkapi parameter yang kosong terlebih dahulu).\');\\n      return;\\n    }\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n    });\\n    showToast(\\n      `Berhasil menyetujui ${approvedCount} pekerjaan hasil AI ke dalam rekap volume terverifikasi.`\\n    );\\n  };\\n\\n  // Auto Quantity Takeoff: Integrasi langsung hasil bacaan AI ke kalkulator proyek aktif\\n  const handleAutoTakeoff = (\\n    items: AIExtractionItem[],\\n    targetFloorId: string,\\n    sourceDocument: string,\\n    meta?: {\\n      documentSummary?: string;\\n      drawingType?: \'arsitektur_denah\' | \'struktur_denah\' | \'potongan_detail\' | \'lainnya\';\\n      detectedRegions?: AIDetectedRegion[];\\n      segments?: AIBeamSloofSegment[];\\n      identifiedFloor?: string;\\n      identifiedScale?: string;\\n      forceIncludeRejected?: boolean;\\n      fromCache?: boolean;\\n      documentHash?: string;\\n    }\\n  ): {\\n    summary: AIAutoTakeoffSummary;\\n    affectedWorks: ProjectWorkItem[];\\n  } => {\\n    const { updatedProject, summary, affectedWorkIds } = applyAutoQuantityTakeoff(\\n      activeProject,\\n      items,\\n      targetFloorId,\\n      sourceDocument,\\n      meta\\n    );\\n\\n    handleUpdateActiveProject(updatedProject);\\n\\n    if (summary.createdDraftWorksCount > 0 || summary.updatedExistingWorksCount > 0) {\\n      showToast(\\n        `Auto Quantity Takeoff selesai: ${summary.updatedExistingWorksCount} pekerjaan standar diperbarui, +${summary.createdDraftWorksCount} baru.`\\n      );\\n    } else {\\n      showToast(\'Analisis selesai. Parameter sudah sinkron dengan gambar.\');\\n    }\\n\\n    const recalculated = recalculateAllProjectWorks(updatedProject.works);\\n    const affectedWorks = recalculated.filter((w) => affectedWorkIds.includes(w.id));\\n\\n    return { summary, affectedWorks };\\n  };\\n\\n  // Tambahkan rekomendasi pekerjaan lanjutan ke kalkulator sebagai Draf AI\\n  const handleAddRecommendationWork = (catalogId: string, floorId: string, reason: string) => {\\n    const allCatalog = getAllCatalogItems(userId);\\n    const catItem = allCatalog.find((c) => c.id === catalogId);\\n    if (!catItem) return;\\n\\n    const dedupKey = `${floorId}::${catalogId}`;\\n    const existing = activeProject.works.find(\\n      (w) => w.dedupKey === dedupKey || (w.floorId === floorId && w.catalogId === catalogId)\\n    );\\n\\n    const floorWorks = activeProject.works.filter(\\n      (w) => w.floorId === floorId || w.floorId === \'fl-umum\'\\n    );\\n    const dindingWork = floorWorks.find((w) => w.catalogId === \'ars-dinding-bata-hebel\');\\n    const lantaiWork = floorWorks.find(\\n      (w) =>\\n        w.catalogId === \'ars-homogenous-tile-60x60\' ||\\n        w.catalogId === \'ars-lantai-homogenous-60x60\'\\n    );\\n    const sloofWork = floorWorks.find((w) => w.catalogId === \'str-sloof-beton\');\\n\\n    const initialParams: Record<string, number | null> = {};\\n    if (dindingWork && dindingWork.calculatedVolume !== null) {\\n      initialParams[\'luas_dinding\'] = Number(dindingWork.calculatedVolume.toFixed(2));\\n      initialParams[\'luas_dinding_bersih\'] = Number(dindingWork.calculatedVolume.toFixed(2));\\n    }\\n    if (lantaiWork && lantaiWork.calculatedVolume !== null) {\\n      initialParams[\'luas_cat\'] = Number(lantaiWork.calculatedVolume.toFixed(2));\\n      initialParams[\'luas_plafond\'] = Number(lantaiWork.calculatedVolume.toFixed(2));\\n    }\\n    if (sloofWork) {\\n      const pTotal = sloofWork.parameters.find((p) => p.id === \'panjang_total\')?.value;\\n      const tSloof = sloofWork.parameters.find((p) => p.id === \'tinggi\')?.value;\\n      if (typeof pTotal === \'number\') initialParams[\'panjang_total\'] = pTotal;\\n      if (typeof tSloof === \'number\') initialParams[\'tinggi\'] = tSloof;\\n    }\\n\\n    if (existing) {\\n      const updatedWorks = activeProject.works.map((w) => {\\n        if (w.id !== existing.id) return w;\\n        return {\\n          ...w,\\n          origin: \'ai\' as const,\\n          aiVerificationStatus: \'draft\' as const,\\n          verificationBadge: \'Hasil Penggabungan\' as const,\\n          identificationReason: reason,\\n          parameters: w.parameters.map((p) =>\\n            initialParams[p.id] !== undefined && initialParams[p.id] !== null\\n              ? {\\n                  ...p,\\n                  value: initialParams[p.id],\\n                  source: \'ai\' as const,\\n                  verificationBadge: \'Hasil Penggabungan\' as const,\\n                }\\n              : p\\n          ),\\n        };\\n      });\\n      handleUpdateActiveProject({\\n        ...activeProject,\\n        works: updatedWorks,\\n      });\\n      showToast(`Pekerjaan standar \\\"${catItem.name}\\\" dihubungkan dengan parameter rekomendasi AI.`);\\n      return;\\n    }\\n\\n    const newWork = createProjectWorkFromCatalog(catalogId, floorId, initialParams, {\\n      origin: \'ai\',\\n      aiVerificationStatus: \'draft\',\\n      verificationBadge: \'Hasil Penggabungan\',\\n      identificationReason: reason,\\n      dedupKey,\\n      userId,\\n    });\\n\\n    if (!newWork) return;\\n\\n    const newWorks: ProjectWorkItem[] = [newWork, ...activeProject.works];\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      works: newWorks,\\n    });\\n    showToast(`Rekomendasi \\\"${catItem.name}\\\" ditambahkan ke kalkulator sebagai Draf AI.`);\\n  };\\n\\n  // Manajemen Lantai\\n  const handleAddFloor = (name: string, elevation: string) => {\\n    const nextLevel = activeProject.floors.filter((f) => f.id !== \'fl-umum\').length + 1;\\n    const newFloor: FloorItem = {\\n      id: `fl-${Date.now()}`,\\n      name,\\n      elevation,\\n      level: nextLevel,\\n      description: `Elevasi ${elevation}`,\\n    };\\n    const defaultFloorWorks = createDefaultWorksForFloor(newFloor.id, nextLevel, nextLevel);\\n    const newFloors = [...activeProject.floors, newFloor];\\n    const newWorks = [...activeProject.works, ...defaultFloorWorks];\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      floorCount: newFloors.filter((f) => f.id !== \'fl-umum\').length,\\n      floors: newFloors,\\n      works: newWorks,\\n    });\\n    showToast(\\n      `Lantai \\\"${name}\\\" beserta ${defaultFloorWorks.length} pekerjaan standar berhasil ditambahkan.`\\n    );\\n  };\\n\\n  const handleRenameFloor = (floorId: string, newName: string, newElevation: string) => {\\n    const newFloors = activeProject.floors.map((f) =>\\n      f.id === floorId ? { ...f, name: newName, elevation: newElevation } : f\\n    );\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      floors: newFloors,\\n    });\\n    showToast(`Lantai berhasil diubah menjadi \\\"${newName}\\\".`);\\n  };\\n\\n  const handleDeleteFloor = (floorId: string, moveWorksToFloorId?: string) => {\\n    const floor = activeProject.floors.find((f) => f.id === floorId);\\n    const newFloors = activeProject.floors.filter((f) => f.id !== floorId);\\n\\n    let newWorks: ProjectWorkItem[];\\n    if (moveWorksToFloorId) {\\n      newWorks = activeProject.works.map((w) =>\\n        w.floorId === floorId\\n          ? {\\n              ...w,\\n              floorId: moveWorksToFloorId,\\n              dedupKey: w.catalogId ? `${moveWorksToFloorId}::${w.catalogId}` : w.dedupKey,\\n            }\\n          : w\\n      );\\n    } else {\\n      newWorks = activeProject.works.filter((w) => w.floorId !== floorId);\\n    }\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      floorCount: newFloors.filter((f) => f.id !== \'fl-umum\').length,\\n      floors: newFloors,\\n      works: newWorks,\\n    });\\n\\n    if (moveWorksToFloorId) {\\n      const targetFloor = activeProject.floors.find((f) => f.id === moveWorksToFloorId);\\n      showToast(\\n        `Lantai \\\"${floor?.name || \'\'}\\\" dihapus dan pekerjaannya dipindahkan ke ${targetFloor?.name || \'lantai lain\'}.`\\n      );\\n    } else {\\n      showToast(`Lantai \\\"${floor?.name || \'\'}\\\" beserta pekerjaannya telah dihapus.`);\\n    }\\n  };\\n\\n  const handleDuplicateFloor = (sourceFloorId: string) => {\\n    const sourceFloor = activeProject.floors.find((f) => f.id === sourceFloorId);\\n    if (!sourceFloor) return;\\n\\n    const newFloorId = `fl-${Date.now()}`;\\n    const newFloorName = `${sourceFloor.name} (Duplikat)`;\\n    const newFloor: FloorItem = {\\n      id: newFloorId,\\n      name: newFloorName,\\n      elevation: sourceFloor.elevation,\\n      level: activeProject.floors.length,\\n    };\\n\\n    const sourceWorks = activeProject.works.filter((w) => w.floorId === sourceFloorId);\\n    const duplicatedWorks: ProjectWorkItem[] = sourceWorks.map((w) => ({\\n      ...w,\\n      id: `work-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\\n      floorId: newFloorId,\\n      dedupKey: w.catalogId ? `${newFloorId}::${w.catalogId}` : undefined,\\n    }));\\n\\n    const newFloors = [...activeProject.floors, newFloor];\\n    const newWorks = [...activeProject.works, ...duplicatedWorks];\\n\\n    handleUpdateActiveProject({\\n      ...activeProject,\\n      floorCount: newFloors.filter((f) => f.id !== \'fl-umum\').length,\\n      floors: newFloors,\\n      works: newWorks,\\n    });\\n    showToast(\\n      `Lantai \\\"${sourceFloor.name}\\\" dan ${sourceWorks.length} pekerjaan berhasil diduplikasi.`\\n    );\\n  };\\n\\n  const currentWorkFloor = activeProject.floors.find(\\n    (f) => f.id === selectedWorkForDetail?.floorId\\n  );\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#F7F9FC] text-slate-800 flex flex-row\\\">\\n      {/* 1. Left Sidebar (Collapsible on Desktop + Drawer on Mobile) */}\\n      <Sidebar\\n        activeTab={activeTab}\\n        onSelectTab={(tab) => {\\n          setActiveTab(tab);\\n          if (tab === \'rekap\') setCurrentStep(4);\\n          if (tab === \'kalkulator\') setCurrentStep(3);\\n          if (tab === \'dashboard\') setCurrentStep(2);\\n        }}\\n        onOpenAI={() => setIsAIOpen(true)}\\n        onExportExcel={handleExportExcel}\\n        onOpenFloors={() => setIsFloorsOpen(true)}\\n        onOpenProjects={() => setIsProjectsOpen(true)}\\n        isCollapsed={isSidebarCollapsed}\\n        onToggleCollapse={handleToggleSidebarCollapse}\\n        isMobileOpen={isMobileMenuOpen}\\n        onCloseMobile={() => setIsMobileMenuOpen(false)}\\n      />\\n\\n      {/* 2. Main Content Viewport */}\\n      <main className=\\\"flex-1 flex flex-col min-w-0 transition-all duration-200\\\">\\n        {/* Top Header */}\\n        <Header\\n          user={currentUser}\\n          project={activeProject}\\n          onUpdateProjectName={handleUpdateProjectName}\\n          onOpenFloors={() => setIsFloorsOpen(true)}\\n          onNewProject={() => setIsProjectsOpen(true)}\\n          onSaveProject={handleSaveProject}\\n          onExportExcel={handleExportExcel}\\n          isSaving={isSaving}\\n          onOpenMobileMenu={() => setIsMobileMenuOpen(true)}\\n          onOpenUserProfile={() => setIsUserProfileOpen(true)}\\n          onLogout={handleLogout}\\n          isSidebarCollapsed={isSidebarCollapsed}\\n          onToggleSidebarCollapse={handleToggleSidebarCollapse}\\n        />\\n\\n        {/* 4-Step Stepper Progress */}\\n        <Stepper\\n          currentStep={currentStep}\\n          onStepClick={(step) => {\\n            setCurrentStep(step);\\n            if (step === 1) setIsProjectsOpen(true);\\n            if (step === 4) handleExportExcel();\\n          }}\\n        />\\n\\n        {/* Workspace Canvas */}\\n        <div className=\\\"flex-1 p-4 sm:p-6 max-w-7xl w-full mx-auto\\\">\\n          {/* User Overview & Projects Hub Banner */}\\n          <UserOverviewBanner\\n            user={currentUser}\\n            projects={projects}\\n            activeProject={activeProject}\\n            onSelectProject={(id) => {\\n              setSelectedWorkForDetail(null);\\n              setRecentlyDeletedWorks([]);\\n              setActiveId(id);\\n              setActiveProjectId(id, userId);\\n            }}\\n            onOpenProjectModal={() => setIsProjectsOpen(true)}\\n          />\\n\\n          {/* Main Hero: Asisten AI & Input Manual (Bersebelahan) */}\\n          <AutoQuantityTakeoffSection\\n            floors={activeProject.floors}\\n            activeFloorId={activeProject.floors[1]?.id || \'fl-1\'}\\n            onOpenManualForm={(floorId) => {\\n              setTargetFloorForAdd(floorId);\\n              setIsAddWorkOpen(true);\\n            }}\\n            onOpenDetailedModal={() => setIsAIOpen(true)}\\n            existingWorks={activeProject.works}\\n          />\\n\\n          {/* Main 2-Column Split: Work Table (Left) + Right Panel (Right) */}\\n          <div className=\\\"grid grid-cols-1 xl:grid-cols-12 gap-6 items-start\\\">\\n            {/* Left 8-9 cols: Work & Volume Table with Category Accordion Drawers */}\\n            <div className=\\\"xl:col-span-8 2xl:col-span-9 min-w-0\\\">\\n              <WorkTable\\n                key={`table-${userId}-${activeProject.id}`}\\n                userId={userId}\\n                projectId={activeProject.id}\\n                works={activeProject.works}\\n                floors={activeProject.floors}\\n                onOpenWorkDetail={(work) => setSelectedWorkForDetail(work)}\\n                onOpenAddWork={(floorId) => {\\n                  setTargetFloorForAdd(floorId || activeProject.floors[1]?.id || \'fl-1\');\\n                  setIsAddWorkOpen(true);\\n                }}\\n                onDeleteWork={handleDeleteWorkItem}\\n                onDeleteMultipleWorks={handleDeleteMultipleWorks}\\n                onRestoreDeletedWorks={handleRestoreDeletedWorks}\\n                recentlyDeletedCount={recentlyDeletedWorks.length}\\n                onRestoreStandardFloorWorks={handleRestoreStandardFloorWorks}\\n                onDuplicateWork={handleDuplicateWorkItem}\\n                onToggleActive={handleToggleActive}\\n                onApproveDraftWork={handleApproveDraftWork}\\n                onApproveAllReadyDrafts={handleApproveAllReadyDrafts}\\n                activeStatusFilter={tableStatusFilter}\\n                onStatusFilterChange={(f) => setTableStatusFilter(f)}\\n              />\\n            </div>\\n\\n            {/* Right 3-4 cols: Project Summary & Excel Export */}\\n            <div className=\\\"xl:col-span-4 2xl:col-span-3\\\">\\n              <RightPanel\\n                project={activeProject}\\n                onExportExcel={handleExportExcel}\\n              />\\n            </div>\\n          </div>\\n\\n          {/* Bottom Recap Total Volume Section */}\\n          <RecapCards\\n            works={activeProject.works}\\n            onApproveAllReadyDrafts={handleApproveAllReadyDrafts}\\n          />\\n        </div>\\n      </main>\\n\\n      {/* Toast Notification */}\\n      {toastMessage && (\\n        <div className=\\\"fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl text-xs font-semibold flex items-center gap-2 animate-in slide-in-from-bottom-3 duration-200 max-w-md\\\">\\n          <span>{toastMessage}</span>\\n        </div>\\n      )}\\n\\n      {/* Modals (Keyed by userId and activeProject.id to guarantee strict state isolation) */}\\n      <UserProfileModal\\n        isOpen={isUserProfileOpen}\\n        user={currentUser}\\n        onClose={() => setIsUserProfileOpen(false)}\\n        onUpdateUser={(updated) => {\\n          setCurrentUser(updated);\\n          showToast(\'Profil akun berhasil diperbarui.\');\\n        }}\\n        onLogout={handleLogout}\\n      />\\n\\n      <WorkDetailModal\\n        key={`detail-${userId}-${activeProject.id}-${selectedWorkForDetail?.id || \'none\'}`}\\n        isOpen={Boolean(selectedWorkForDetail)}\\n        work={selectedWorkForDetail}\\n        floorName={currentWorkFloor?.name}\\n        onClose={() => setSelectedWorkForDetail(null)}\\n        onSaveWork={handleSaveWorkItem}\\n        onRejectDraftWork={handleRejectDraftWork}\\n      />\\n\\n      <AddWorkModal\\n        key={`add-${userId}-${activeProject.id}`}\\n        isOpen={isAddWorkOpen}\\n        floors={activeProject.floors}\\n        defaultFloorId={targetFloorForAdd}\\n        projectWorks={activeProject.works}\\n        onClose={() => setIsAddWorkOpen(false)}\\n        onAddWork={handleAddWorkItem}\\n        onAddMultipleWorks={handleAddMultipleWorks}\\n      />\\n\\n      <AIAssistantModal\\n        key={`ai-${userId}-${activeProject.id}`}\\n        isOpen={isAIOpen}\\n        userId={userId}\\n        projectId={activeProject.id}\\n        floors={activeProject.floors}\\n        currentFloorId={activeProject.floors[0]?.id || \'fl-umum\'}\\n        onClose={() => setIsAIOpen(false)}\\n        onAutoTakeoff={handleAutoTakeoff}\\n        onAddRecommendationWork={handleAddRecommendationWork}\\n        onApproveDraftWork={handleApproveDraftWork}\\n        onRejectDraftWork={handleRejectDraftWork}\\n        onApproveAllReadyDrafts={handleApproveAllReadyDrafts}\\n        onOpenWorkDetail={(work) => {\\n          setIsAIOpen(false);\\n          setSelectedWorkForDetail(work);\\n        }}\\n        existingWorks={activeProject.works}\\n      />\\n\\n      <FloorManagementModal\\n        isOpen={isFloorsOpen}\\n        floors={activeProject.floors}\\n        works={activeProject.works}\\n        onClose={() => setIsFloorsOpen(false)}\\n        onAddFloor={handleAddFloor}\\n        onRenameFloor={handleRenameFloor}\\n        onDeleteFloor={handleDeleteFloor}\\n        onDuplicateFloor={handleDuplicateFloor}\\n      />\\n\\n      <ProjectManagementModal\\n        isOpen={isProjectsOpen}\\n        projects={projects}\\n        activeProjectId={activeProjectId}\\n        userId={userId}\\n        onClose={() => setIsProjectsOpen(false)}\\n        onSelectProject={(id) => {\\n          setSelectedWorkForDetail(null);\\n          setRecentlyDeletedWorks([]);\\n          setActiveId(id);\\n          setActiveProjectId(id, userId);\\n        }}\\n        onSaveProjects={(newProjs, deletedProjectId) => {\\n          setProjects(newProjs);\\n          saveAllProjects(newProjs, userId);\\n          if (deletedProjectId) {\\n            deleteProjectFromServer(userId, deletedProjectId).catch(() => {});\\n            deleteProjectFromFirestore(userId, deletedProjectId).catch(() => {});\\n          }\\n        }}\\n      />\\n    </div>\\n  );\\n}\\n\",\"Description\":\"Update App.tsx to enforce per-user & per-project state isolation, backend /api/projects synchronization, and AI draft rejection handling\",\"Overwrite\":true,\"TargetFile\":\"/src/App.tsx\",\"toolAction\":\"Updating src/App.tsx\",\"toolSummary\":\"Update src/App.tsx\"}"
      original_name: "write_to_file"
    }
