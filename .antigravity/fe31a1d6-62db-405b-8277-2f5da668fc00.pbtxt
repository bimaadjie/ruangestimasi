        use_fast_apply: true
        replacement_chunks {
          target_content: "import { CATALOG_WORK_ITEMS, USC_CATALOG_VERSION } from \'../data/uscCatalog\';\nimport { FloorItem, ProjectData, ProjectWorkItem } from \'../types\';\nimport { recalculateAllProjectWorks } from \'./calculationEngine\';\n\nconst STORAGE_KEY_PROJECTS = \'ruangrab_projects_v1\';\nconst STORAGE_KEY_ACTIVE_PROJECT_ID = \'ruangrab_active_project_id_v1\';\n\n/**\n * Buat pekerjaan proyek dari entri katalog untuk lantai tertentu\n */\nexport function createProjectWorkFromCatalog(\n  catalogId: string,\n  floorId: string,\n  initialParamValues: Record<string, number> = {}\n): ProjectWorkItem | null {\n  const catalog = CATALOG_WORK_ITEMS.find((c) => c.id === catalogId);\n  if (!catalog) return null;\n\n  const params = catalog.parameters.map((p) => ({\n    ...p,\n    value: initialParamValues[p.id] !== undefined ? initialParamValues[p.id] : p.value,\n  }));\n\n  const item: ProjectWorkItem = {\n    id: `work-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,\n    catalogId: catalog.id,\n    name: catalog.name,\n    category: catalog.category,\n    subCategory: catalog.subCategory,\n    floorId,\n    unit: catalog.defaultUnit,\n    formulaDisplay: catalog.formulaDisplay,\n    parameters: params,\n    components: [],\n    calculatedVolume: null,\n    status: \'Perlu Input\',\n    excelSheet: catalog.excelSheet,\n    excelCell: catalog.excelCell,\n    excelFormula: catalog.excelFormula,\n    isActive: true,\n    lastUpdated: new Date().toISOString(),\n  };\n\n  return item;\n}\n\n/**\n * Inisialisasi Proyek Default \"Gedung USC\" (Sesuai referensi gambar & workbook asli)\n */\nexport function createDefaultUscProject(): ProjectData {\n  const floors: FloorItem[] = [\n    { id: \'fl-umum\', name: \'Umum & Pondasi\', level: 0, elevation: \'\302\261 0.00 m\', description: \'Pekerjaan persiapan, tanah, dan pondasi\' },\n    { id: \'fl-1\', name: \'Lantai 1\', level: 1, elevation: \'+ 0.00 m\', description: \'Elevasi lantai dasar\' },\n    { id: \'fl-2\', name: \'Lantai 2\', level: 2, elevation: \'+ 4.00 m\', description: \'Elevasi +4.00 m\' },\n    { id: \'fl-3\', name: \'Lantai 3\', level: 3, elevation: \'+ 8.00 m\', description: \'Elevasi +8.00 m\' },\n  ];\n\n  const works: ProjectWorkItem[] = [];\n\n  // 1. Umum & Pondasi\n  // Pembersihan Lahan (36 x 34 = 1224 m2)\n  const pLahan = createProjectWorkFromCatalog(\'prep-pembersihan-lahan\', \'fl-umum\', { panjang: 36, lebar: 34 });\n  if (pLahan) works.push(pLahan);\n\n  // Bouwplank (22 x 27 = 98 m)\n  const pBouw = createProjectWorkFromCatalog(\'prep-bouwplank\', \'fl-umum\', { panjang: 22, lebar: 27 });\n  if (pBouw) works.push(pBouw);\n\n  // Pondasi Batu Belah (Lb 0.8, La 0.5, T 0.8, P 214.72 = 111.65 m3)\n  const pBatuKali = createProjectWorkFromCatalog(\'str-pasangan-batu-belah-1sp6pp\', \'fl-umum\', {\n    tinggi: 0.8,\n    lebar_atas: 0.5,\n    lebar_bawah: 0.8,\n    panjang_total: 214.72,\n  });\n  if (pBatuKali) works.push(pBatuKali);\n\n  // Galian Tanah Biasa\n  const pGalian = createProjectWorkFromCatalog(\'str-galian-tanah-biasa-1m\', \'fl-umum\', {\n    lebar_bawah: 1.5,\n    lebar_atas: 1.1,\n    kedalaman: 1.0,\n    panjang_total: 214.72,\n  });\n  if (pGalian) works.push(pGalian);\n\n  // Sloof Beton (214.72 x 0.4 x 0.6 = 51.53 m3)\n  const pSloof = createProjectWorkFromCatalog(\'str-sloof-beton\', \'fl-umum\', {\n    panjang_total: 214.72,\n    lebar: 0.4,\n    tinggi: 0.6,\n  });\n  if (pSloof) works.push(pSloof);\n\n  // 2. Lantai 1 Works\n  const k1Lt1 = createProjectWorkFromCatalog(\'str-kolom-k1-beton\', \'fl-1\', { lebar: 0.5, tebal: 0.5, tinggi: 4.0, jumlah: 20 });\n  if (k1Lt1) works.push(k1Lt1);\n\n  const k2Lt1 = createProjectWorkFromCatalog(\'str-kolom-k2-beton\', \'fl-1\', { lebar: 0.3, tebal: 0.3, tinggi: 4.0, jumlah: 5 });\n  if (k2Lt1) works.push(k2Lt1);\n\n  const b1Lt1 = createProjectWorkFromCatalog(\'str-balok-b1-beton\', \'fl-1\', { panjang_total: 184, lebar: 0.3, tinggi: 0.6 });\n  if (b1Lt1) works.push(b1Lt1);\n\n  const dndLt1 = createProjectWorkFromCatalog(\'ars-dinding-bata-hebel\', \'fl-1\', { panjang_keliling: 94.45, tinggi_dinding: 3.4, luas_bukaan: 23.2 });\n  if (dndLt1) works.push(dndLt1);\n\n  const plfLt1 = createProjectWorkFromCatalog(\'ars-plafond-gypsum\', \'fl-1\', { luas_plafond: 95.35 });\n  if (plfLt1) works.push(plfLt1);\n\n  const htLt1 = createProjectWorkFromCatalog(\'ars-homogenous-tile-60x60\', \'fl-1\', { luas_lantai: 95.35 });\n  if (htLt1) works.push(htLt1);\n\n  const pntLt1 = createProjectWorkFromCatalog(\'ars-pintu-p1-lengkap\', \'fl-1\', { jumlah_unit: 1 });\n  if (pntLt1) works.push(pntLt1);\n\n  const mepLt1 = createProjectWorkFromCatalog(\'mep-titik-lampu\', \'fl-1\', { lampu_led_12w: 18, lampu_led_7w: 12, lampu_led_4w: 6, lampu_tl_40w: 24 });\n  if (mepLt1) works.push(mepLt1);\n\n  // 3. Lantai 2 Works\n  const k1Lt2 = createProjectWorkFromCatalog(\'str-kolom-k1-beton\', \'fl-2\', { lebar: 0.5, tebal: 0.5, tinggi: 4.0, jumlah: 20 });\n  if (k1Lt2) works.push(k1Lt2);\n\n  const b1Lt2 = createProjectWorkFromCatalog(\'str-balok-b1-beton\', \'fl-2\', { panjang_total: 192, lebar: 0.3, tinggi: 0.6 });\n  if (b1Lt2) works.push(b1Lt2);\n\n  const pltLt2 = createProjectWorkFromCatalog(\'str-pelat-lantai-beton\', \'fl-2\', { panjang_bangunan: 25, lebar_bangunan: 20, luas_bukaan: 90.5, tebal_pelat: 0.12 });\n  if (pltLt2) works.push(pltLt2);\n\n  const dndLt2 = createProjectWorkFromCatalog(\'ars-dinding-bata-hebel\', \'fl-2\', { panjang_keliling: 169.18, tinggi_dinding: 3.4, luas_bukaan: 91.7 });\n  if (dndLt2) works.push(dndLt2);\n\n  const plfLt2 = createProjectWorkFromCatalog(\'ars-plafond-gypsum\', \'fl-2\', { luas_plafond: 399.79 });\n  if (plfLt2) works.push(plfLt2);\n\n  const htLt2 = createProjectWorkFromCatalog(\'ars-homogenous-tile-60x60\', \'fl-2\', { luas_lantai: 422.2 });\n  if (htLt2) works.push(htLt2);\n\n  const jndLt2 = createProjectWorkFromCatalog(\'ars-jendela-j3-lengkap\', \'fl-2\', { jumlah_unit: 7 });\n  if (jndLt2) works.push(jndLt2);\n\n  // 4. Lantai 3 Works\n  const k1Lt3 = createProjectWorkFromCatalog(\'str-kolom-k1-beton\', \'fl-3\', { lebar: 0.5, tebal: 0.5, tinggi: 4.0, jumlah: 20 });\n  if (k1Lt3) works.push(k1Lt3);\n\n  const b1Lt3 = createProjectWorkFromCatalog(\'str-balok-b1-beton\', \'fl-3\', { panjang_total: 200, lebar: 0.3, tinggi: 0.6 });\n  if (b1Lt3) works.push(b1Lt3);\n\n  const pltLt3 = createProjectWorkFromCatalog(\'str-pelat-lantai-beton\', \'fl-3\', { panjang_bangunan: 25, lebar_bangunan: 20, luas_bukaan: 89.6, tebal_pelat: 0.12 });\n  if (pltLt3) works.push(pltLt3);\n\n  const dndLt3 = createProjectWorkFromCatalog(\'ars-dinding-bata-hebel\', \'fl-3\', { panjang_keliling: 177.25, tinggi_dinding: 3.4, luas_bukaan: 108.4 });\n  if (dndLt3) works.push(dndLt3);\n\n  const plfLt3 = createProjectWorkFromCatalog(\'ars-plafond-gypsum\', \'fl-3\', { luas_plafond: 394.8 });\n  if (plfLt3) works.push(plfLt3);\n\n  // Item perlu input untuk menunjukkan status dinamis\n  const htLt3 = createProjectWorkFromCatalog(\'ars-homogenous-tile-60x60\', \'fl-3\', {});\n  if (htLt3) works.push(htLt3);\n\n  const calculatedWorks = recalculateAllProjectWorks(works);\n\n  return {\n    id: \'proj-gedung-usc\',\n    name: \'Gedung USC\',\n    location: \'Sidotopo, Magelang\',\n    description: \'Pekerjaan Pembangunan Gedung Untidar Study Center (USC) 3 Lantai + Struktur Bawah\',\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    floorCount: 3,\n    floors,\n    works: calculatedWorks,\n    catalogVersion: USC_CATALOG_VERSION,\n  };\n}\n\n/**\n * Muat semua proyek dari LocalStorage\n */\nexport function loadAllProjects(): ProjectData[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY_PROJECTS);\n    if (!raw) {\n      const defaultProj = createDefaultUscProject();\n      saveAllProjects([defaultProj]);\n      setActiveProjectId(defaultProj.id);\n      return [defaultProj];\n    }\n    const parsed: ProjectData[] = JSON.parse(raw);\n    if (!Array.isArray(parsed) || parsed.length === 0) {\n      const defaultProj = createDefaultUscProject();\n      saveAllProjects([defaultProj]);\n      setActiveProjectId(defaultProj.id);\n      return [defaultProj];\n    }\n    return parsed;\n  } catch (err) {\n    console.error(\'Gagal memuat proyek dari storage, membuat proyek default:\', err);\n    const defaultProj = createDefaultUscProject();\n    return [defaultProj];\n  }\n}\n\n/**\n * Simpan seluruh daftar proyek ke LocalStorage\n */\nexport function saveAllProjects(projects: ProjectData[]): boolean {\n  try {\n    localStorage.setItem(STORAGE_KEY_PROJECTS, JSON.stringify(projects));\n    return true;\n  } catch (err) {\n    console.error(\'Gagal menyimpan proyek ke LocalStorage:\', err);\n    return false;\n  }\n}\n\n/**\n * Dapatkan ID proyek aktif\n */\nexport function getActiveProjectId(): string {\n  try {\n    return localStorage.getItem(STORAGE_KEY_ACTIVE_PROJECT_ID) || \'proj-gedung-usc\';\n  } catch {\n    return \'proj-gedung-usc\';\n  }\n}\n\n/**\n * Set ID proyek aktif\n */\nexport function setActiveProjectId(id: string): void {\n  try {\n    localStorage.setItem(STORAGE_KEY_ACTIVE_PROJECT_ID, id);\n  } catch (err) {\n    console.error(\'Gagal menyimpan ID proyek aktif:\', err);\n  }\n}\n\n/**\n * Buat proyek baru kosong\n */\nexport function createNewProject(name: string, floorCount: number = 3, location: string = \'\'): ProjectData {\n  const floors: FloorItem[] = [\n    { id: \'fl-umum\', name: \'Umum & Pondasi\', level: 0, elevation: \'\302\261 0.00 m\', description: \'Pekerjaan persiapan dan struktur dasar\' },\n  ];\n\n  for (let i = 1; i <= floorCount; i++) {\n    floors.push({\n      id: `fl-${i}`,\n      name: `Lantai ${i}`,\n      level: i,\n      elevation: `+ ${(i - 1) * 4}.00 m`,\n      description: `Elevasi lantai tingkat ${i}`,\n    });\n  }\n\n  // Masukkan pekerjaan persiapan standar otomatis ke kelompok umum\n  const defaultPrepWorks: ProjectWorkItem[] = [];\n  const pLahan = createProjectWorkFromCatalog(\'prep-pembersihan-lahan\', \'fl-umum\');\n  if (pLahan) defaultPrepWorks.push(pLahan);\n  const pBouw = createProjectWorkFromCatalog(\'prep-bouwplank\', \'fl-umum\');\n  if (pBouw) defaultPrepWorks.push(pBouw);\n\n  return {\n    id: `proj-${Date.now()}`,\n    name: name.trim() || \'Proyek Konstruksi Baru\',\n    location: location.trim(),\n    description: `Kalkulator quantity takeoff bangunan ${floorCount} lantai.`,\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    floorCount,\n    floors,\n    works: defaultPrepWorks,\n    catalogVersion: USC_CATALOG_VERSION,\n  };\n}"
          replacement_content: "import { CATALOG_WORK_ITEMS, USC_CATALOG_VERSION } from \'../data/uscCatalog\';\nimport {\n  AIAutoTakeoffSummary,\n  AIExtractionItem,\n  CatalogWorkItem,\n  FloorItem,\n  ParameterItem,\n  ProjectData,\n  ProjectWorkItem,\n} from \'../types\';\nimport { recalculateAllProjectWorks, safeEvaluateMath } from \'./calculationEngine\';\n\nconst STORAGE_KEY_PROJECTS = \'ruangrab_projects_v1\';\nconst STORAGE_KEY_ACTIVE_PROJECT_ID = \'ruangrab_active_project_id_v1\';\nconst STORAGE_KEY_SIDEBAR_COLLAPSED = \'ruangrab_sidebar_collapsed_v1\';\nconst STORAGE_KEY_DISABLED_CATALOG_IDS = \'ruangrab_disabled_catalog_ids_v1\';\nconst STORAGE_KEY_CUSTOM_CATALOG_ITEMS = \'ruangrab_custom_catalog_items_v1\';\n\n/**\n * Preferensi Sidebar Buka-Tutup (Desktop)\n */\nexport function loadSidebarCollapsed(): boolean {\n  try {\n    return localStorage.getItem(STORAGE_KEY_SIDEBAR_COLLAPSED) === \'true\';\n  } catch {\n    return false;\n  }\n}\n\nexport function saveSidebarCollapsed(collapsed: boolean): void {\n  try {\n    localStorage.setItem(STORAGE_KEY_SIDEBAR_COLLAPSED, collapsed ? \'true\' : \'false\');\n  } catch {\n    // ignore storage errors\n  }\n}\n\n/**\n * Pengelolaan Katalog Bawaan yang Dinonaktifkan\n */\nexport function loadDisabledCatalogIds(): string[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY_DISABLED_CATALOG_IDS);\n    if (!raw) return [];\n    const parsed = JSON.parse(raw);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    return [];\n  }\n}\n\nexport function saveDisabledCatalogIds(ids: string[]): void {\n  try {\n    localStorage.setItem(STORAGE_KEY_DISABLED_CATALOG_IDS, JSON.stringify(ids));\n  } catch (err) {\n    console.error(\'Gagal menyimpan status katalog nonaktif:\', err);\n  }\n}\n\n/**\n * Pengelolaan Katalog Pekerjaan Kustom\n */\nexport function loadCustomCatalogItems(): CatalogWorkItem[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS);\n    if (!raw) return [];\n    const parsed: CatalogWorkItem[] = JSON.parse(raw);\n    if (!Array.isArray(parsed)) return [];\n    return parsed.map((item) => ({\n      ...item,\n      isCustomCatalog: true,\n      calculationMethod: (params: Record<string, number>) => {\n        if (item.customFormula) {\n          const res = safeEvaluateMath(item.customFormula, params);\n          return isNaN(res) || !isFinite(res) ? null : res;\n        }\n        const keys = Object.keys(params);\n        if (keys.length === 0) return null;\n        return keys.reduce((acc, k) => acc * params[k], 1);\n      },\n    }));\n  } catch {\n    return [];\n  }\n}\n\nexport function saveCustomCatalogItems(items: CatalogWorkItem[]): void {\n  try {\n    // Strip function before serializing\n    const serializable = items.map(({ calculationMethod, ...rest }) => ({\n      ...rest,\n      isCustomCatalog: true,\n    }));\n    localStorage.setItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS, JSON.stringify(serializable));\n  } catch (err) {\n    console.error(\'Gagal menyimpan katalog kustom:\', err);\n  }\n}\n\nexport function getAllCatalogItems(): CatalogWorkItem[] {\n  return [...CATALOG_WORK_ITEMS, ...loadCustomCatalogItems()];\n}\n\n/**\n * Buat pekerjaan proyek dari entri katalog untuk lantai tertentu\n */\nexport function createProjectWorkFromCatalog(\n  catalogId: string,\n  floorId: string,\n  initialParamValues: Record<string, number | null> = {},\n  options?: {\n    origin?: \'manual\' | \'ai\';\n    aiVerificationStatus?: \'draft\' | \'verified\';\n    sourceDocument?: string;\n    identificationReason?: string;\n    dedupKey?: string;\n    elementLocation?: string;\n  }\n): ProjectWorkItem | null {\n  const allCatalog = getAllCatalogItems();\n  const catalog = allCatalog.find((c) => c.id === catalogId);\n  if (!catalog) return null;\n\n  const params: ParameterItem[] = catalog.parameters.map((p) => {\n    const hasInitial = Object.prototype.hasOwnProperty.call(initialParamValues, p.id);\n    const val = hasInitial ? initialParamValues[p.id] : p.value;\n    return {\n      ...p,\n      value: val,\n      source: hasInitial && val !== null ? (options?.origin === \'ai\' ? \'ai\' : \'manual\') : p.source,\n      sourceDocument: hasInitial && val !== null ? options?.sourceDocument : undefined,\n      isVerified: options?.origin === \'ai\' ? false : true,\n    };\n  });\n\n  const item: ProjectWorkItem = {\n    id: `work-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,\n    catalogId: catalog.id,\n    dedupKey: options?.dedupKey,\n    name: catalog.name,\n    category: catalog.category,\n    subCategory: catalog.subCategory,\n    floorId,\n    elementLocation: options?.elementLocation,\n    unit: catalog.defaultUnit,\n    formulaDisplay: catalog.formulaDisplay,\n    customFormula: catalog.customFormula,\n    parameters: params,\n    components: [],\n    calculatedVolume: null,\n    status: options?.origin === \'ai\' ? \'Draf AI \342\200\224 Perlu Verifikasi\' : \'Perlu Input\',\n    origin: options?.origin || \'manual\',\n    aiVerificationStatus: options?.aiVerificationStatus || \'verified\',\n    sourceDocument: options?.sourceDocument,\n    identificationReason: options?.identificationReason,\n    excelSheet: catalog.excelSheet,\n    excelCell: catalog.excelCell,\n    excelFormula: catalog.excelFormula,\n    isActive: true,\n    lastUpdated: new Date().toISOString(),\n  };\n\n  return item;\n}\n\n/**\n * Pemetaan cerdas item ekstraksi AI ke catalogId dan parameterId RuangRAB\n */\nfunction resolveCatalogMapping(item: AIExtractionItem): {\n  mappings: { catalogId: string; parameterId: string; reason: string }[];\n} {\n  const mappings: { catalogId: string; parameterId: string; reason: string }[] = [];\n  const workLower = (item.suggestedWorkName || \'\').toLowerCase();\n  const paramLower = (item.parameterName || \'\').toLowerCase();\n  const explicitCatId = (item.catalogId || \'\').trim();\n  const explicitParamId = (item.parameterId || \'\').trim();\n\n  // 1. Jika Gemini sudah memberikan catalogId & parameterId yang valid\n  if (explicitCatId && CATALOG_WORK_ITEMS.some((c) => c.id === explicitCatId)) {\n    const cat = CATALOG_WORK_ITEMS.find((c) => c.id === explicitCatId)!;\n    let resolvedParamId = explicitParamId;\n    if (!cat.parameters.some((p) => p.id === resolvedParamId)) {\n      if (paramLower.includes(\'panjang\') || paramLower.includes(\'keliling\')) {\n        resolvedParamId =\n          cat.parameters.find((p) => p.id.includes(\'panjang\') || p.id.includes(\'keliling\'))?.id ||\n          cat.parameters[0]?.id;\n      } else if (paramLower.includes(\'lebar\')) {\n        resolvedParamId =\n          cat.parameters.find((p) => p.id.includes(\'lebar\'))?.id || cat.parameters[0]?.id;\n      } else if (paramLower.includes(\'tinggi\') || paramLower.includes(\'kedalaman\')) {\n        resolvedParamId =\n          cat.parameters.find((p) => p.id.includes(\'tinggi\') || p.id.includes(\'kedalaman\'))?.id ||\n          cat.parameters[0]?.id;\n      } else if (paramLower.includes(\'luas\')) {\n        resolvedParamId =\n          cat.parameters.find((p) => p.id.includes(\'luas\'))?.id || cat.parameters[0]?.id;\n      } else if (paramLower.includes(\'jumlah\') || paramLower.includes(\'titik\')) {\n        resolvedParamId =\n          cat.parameters.find((p) => p.id.includes(\'jumlah\'))?.id || cat.parameters[0]?.id;\n      }\n    }\n\n    if (resolvedParamId && cat.parameters.some((p) => p.id === resolvedParamId)) {\n      mappings.push({\n        catalogId: explicitCatId,\n        parameterId: resolvedParamId,\n        reason: item.notes || `Teridentifikasi dari ${item.pageOrLocation || \'gambar teknik\'}`,\n      });\n      // Jika pembersihan lahan mendapat dimensi total bangunan, otomatis lengkapi juga bouwplank\n      if (\n        explicitCatId === \'prep-pembersihan-lahan\' &&\n        (resolvedParamId === \'panjang\' || resolvedParamId === \'lebar\')\n      ) {\n        mappings.push({\n          catalogId: \'prep-bouwplank\',\n          parameterId: resolvedParamId,\n          reason: `Dimensi batas bangunan (${item.pageOrLocation || \'denah\'}) untuk pengukuran & bouwplank`,\n        });\n      }\n      return { mappings };\n    }\n  }\n\n  // 2. Fallback Pencocokan Berbasis Nama Pekerjaan & Parameter\n  if (\n    workLower.includes(\'pembersihan lahan\') ||\n    workLower.includes(\'dimensi bangunan\') ||\n    workLower.includes(\'luas lahan\') ||\n    workLower.includes(\'total bangunan\')\n  ) {\n    const pid = paramLower.includes(\'lebar\') ? \'lebar\' : \'panjang\';\n    mappings.push({\n      catalogId: \'prep-pembersihan-lahan\',\n      parameterId: pid,\n      reason: `Dimensi terluar bangunan dari ${item.pageOrLocation || \'denah\'}`,\n    });\n    mappings.push({\n      catalogId: \'prep-bouwplank\',\n      parameterId: pid,\n      reason: `Dimensi keliling bangunan dari ${item.pageOrLocation || \'denah\'}`,\n    });\n    return { mappings };\n  }\n\n  if (workLower.includes(\'bouwplank\')) {\n    const pid = paramLower.includes(\'lebar\') ? \'lebar\' : \'panjang\';\n    mappings.push({\n      catalogId: \'prep-bouwplank\',\n      parameterId: pid,\n      reason: `Dimensi batas pengukuran bangunan dari ${item.pageOrLocation || \'denah\'}`,\n    });\n    return { mappings };\n  }\n\n  if (\n    workLower.includes(\'dinding bata\') ||\n    workLower.includes(\'hebel\') ||\n    workLower.includes(\'pasangan dinding\') ||\n    (workLower.includes(\'dinding\') && !workLower.includes(\'keramik\') && !workLower.includes(\'cat\'))\n  ) {\n    let pid = \'panjang_keliling\';\n    if (paramLower.includes(\'tinggi\')) pid = \'tinggi_dinding\';\n    else if (paramLower.includes(\'bukaan\')) pid = \'luas_bukaan\';\n    mappings.push({\n      catalogId: \'ars-dinding-bata-hebel\',\n      parameterId: pid,\n      reason: `Garis pasangan dinding pada ${item.pageOrLocation || \'denah\'}`,\n    });\n    return { mappings };\n  }\n\n  if (\n    workLower.includes(\'homogenous\') ||\n    workLower.includes(\'granit\') ||\n    workLower.includes(\'ht 60\') ||\n    workLower.includes(\'penutup lantai utama\')\n  ) {\n    if (paramLower.includes(\'luas\') || item.convertedUnit === \'m\302\262\') {\n      mappings.push({\n        catalogId: \'ars-homogenous-tile-60x60\',\n        parameterId: \'luas_lantai\',\n        reason: `Akumulasi luas lantai ruang utama pada ${item.pageOrLocation || \'denah\'}`,\n      });\n    }\n    return { mappings };\n  }\n\n  if (\n    workLower.includes(\'keramik lantai toilet\') ||\n    workLower.includes(\'lantai km\') ||\n    workLower.includes(\'lantai toilet\') ||\n    workLower.includes(\'anti-slip\')\n  ) {\n    if (paramLower.includes(\'luas\') || item.convertedUnit === \'m\302\262\') {\n      mappings.push({\n        catalogId: \'ars-keramik-toilet-antislip\',\n        parameterId: \'luas_total_toilet\',\n        reason: `Luas area lantai KM/WC pada ${item.pageOrLocation || \'denah\'}`,\n      });\n    }\n    return { mappings };\n  }\n\n  if (workLower.includes(\'kolom k1\') || workLower.includes(\'kolom utama\')) {\n    let pid = \'jumlah\';\n    if (paramLower.includes(\'lebar\')) pid = \'lebar\';\n    else if (paramLower.includes(\'tebal\')) pid = \'tebal\';\n    else if (paramLower.includes(\'tinggi\')) pid = \'tinggi\';\n    mappings.push({\n      catalogId: \'str-kolom-k1-beton\',\n      parameterId: pid,\n      reason: `Elemen struktur kolom pada ${item.pageOrLocation || \'gambar\'}`,\n    });\n    return { mappings };\n  }\n\n  if (workLower.includes(\'balok b1\') || workLower.includes(\'balok induk\')) {\n    let pid = \'panjang_total\';\n    if (paramLower.includes(\'lebar\')) pid = \'lebar\';\n    else if (paramLower.includes(\'tinggi\')) pid = \'tinggi\';\n    mappings.push({\n      catalogId: \'str-balok-b1-beton\',\n      parameterId: pid,\n      reason: `Bentang balok induk pada ${item.pageOrLocation || \'gambar\'}`,\n    });\n    return { mappings };\n  }\n\n  return { mappings };\n}\n\n/**\n * Mesin Auto Quantity Takeoff:\n * Menghubungkan hasil pembacaan AI secara otomatis ke daftar pekerjaan proyek & parameter kalkulator.\n * - Mencegah duplikasi dengan dedupKey stabil\n * - Menghormati daftar rejectedDraftKeys\n * - Melengkapi parameter kosong pada pekerjaan yang sudah ada\n * - Menandai konflik dimensi jika gambar kedua memiliki nilai berbeda\n */\nexport function applyAutoQuantityTakeoff(\n  project: ProjectData,\n  extractionItems: AIExtractionItem[],\n  targetFloorId: string,\n  sourceDocument: string,\n  meta?: {\n    documentSummary?: string;\n    drawingType?: \'arsitektur_denah\' | \'struktur_denah\' | \'potongan_detail\' | \'lainnya\';\n    identifiedFloor?: string;\n    identifiedScale?: string;\n    forceIncludeRejected?: boolean;\n  }\n): {\n  updatedProject: ProjectData;\n  summary: AIAutoTakeoffSummary;\n  affectedWorkIds: string[];\n} {\n  const rejectedKeys = new Set(project.rejectedDraftKeys || []);\n  const updatedWorks = project.works.map((w) => ({\n    ...w,\n    parameters: w.parameters.map((p) => ({ ...p })),\n  }));\n\n  let createdDraftWorksCount = 0;\n  let updatedExistingWorksCount = 0;\n  let conflictCount = 0;\n  const affectedWorkIds = new Set<string>();\n\n  // Kelompokkan hasil ekstraksi berdasarkan catalogId target\n  interface PendingParamUpdate {\n    parameterId: string;\n    convertedValue: number;\n    rawExtractedValue: number;\n    rawUnit: AIExtractionItem[\'rawUnit\'];\n    pageOrLocation?: string;\n    reason: string;\n  }\n\n  const catalogUpdates = new Map<string, PendingParamUpdate[]>();\n\n  // Selain pemetaan langsung, hitung juga agregasi otomatis jika AI mengekstrak Panjang & Lebar ruang-ruang individual\n  let detectedToiletArea = 0;\n  let detectedMainRoomArea = 0;\n  const roomDims = new Map<string, { p?: number; l?: number; isToilet?: boolean }>();\n\n  for (const item of extractionItems) {\n    if (item.status === \'rejected\' || item.isRecommendationOnly) continue;\n\n    const val = item.userCorrection !== undefined ? item.userCorrection : item.convertedValue;\n    if (val === null || val === undefined || isNaN(val) || val <= 0) continue;\n\n    const { mappings } = resolveCatalogMapping(item);\n    for (const m of mappings) {\n      const list = catalogUpdates.get(m.catalogId) || [];\n      list.push({\n        parameterId: m.parameterId,\n        convertedValue: val,\n        rawExtractedValue: item.rawExtractedValue,\n        rawUnit: item.rawUnit,\n        pageOrLocation: item.pageOrLocation,\n        reason: m.reason,\n      });\n      catalogUpdates.set(m.catalogId, list);\n    }\n\n    // Cek apakah ini dimensi ruang individual (misal KM/WC Panjang & Lebar)\n    const locKey = (item.pageOrLocation || item.suggestedWorkName || \'\').toLowerCase();\n    const pName = (item.parameterName || \'\').toLowerCase();\n    if (locKey && (pName.includes(\'panjang\') || pName.includes(\'lebar\'))) {\n      const entry = roomDims.get(locKey) || {\n        isToilet: locKey.includes(\'km\') || locKey.includes(\'wc\') || locKey.includes(\'toilet\'),\n      };\n      if (pName.includes(\'panjang\')) entry.p = val;\n      if (pName.includes(\'lebar\')) entry.l = val;\n      roomDims.set(locKey, entry);\n    }\n  }\n\n  for (const [, dim] of roomDims.entries()) {\n    if (dim.p && dim.l) {\n      const area = Number((dim.p * dim.l).toFixed(2));\n      if (dim.isToilet) {\n        detectedToiletArea += area;\n      } else {\n        detectedMainRoomArea += area;\n      }\n    }\n  }\n\n  // Jika belum ada luas toilet eksplisit tetapi ada ruang KM/WC dengan P & L\n  if (!catalogUpdates.has(\'ars-keramik-toilet-antislip\') && detectedToiletArea > 0) {\n    catalogUpdates.set(\'ars-keramik-toilet-antislip\', [\n      {\n        parameterId: \'luas_total_toilet\',\n        convertedValue: Number(detectedToiletArea.toFixed(2)),\n        rawExtractedValue: Number(detectedToiletArea.toFixed(2)),\n        rawUnit: \'m\',\n        pageOrLocation: \'Ruang KM/WC\',\n        reason: \'Dihitung dari dimensi Panjang \303\227 Lebar ruang KM/WC pada denah\',\n      },\n    ]);\n  }\n\n  // Jika belum ada luas lantai HT eksplisit tetapi ada ruang utama dengan P & L\n  if (!catalogUpdates.has(\'ars-homogenous-tile-60x60\') && detectedMainRoomArea > 0) {\n    catalogUpdates.set(\'ars-homogenous-tile-60x60\', [\n      {\n        parameterId: \'luas_lantai\',\n        convertedValue: Number(detectedMainRoomArea.toFixed(2)),\n        rawExtractedValue: Number(detectedMainRoomArea.toFixed(2)),\n        rawUnit: \'m\',\n        pageOrLocation: \'Ruang Utama Denah\',\n        reason: \'Dihitung dari akumulasi luas ruang utama pada denah\',\n      },\n    ]);\n  }\n\n  // Jika ada Pembersihan Lahan (P & L bangunan), pastikan Dinding Bata Ringan juga diestimasi jika belum ada\n  if (\n    !catalogUpdates.has(\'ars-dinding-bata-hebel\') &&\n    catalogUpdates.has(\'prep-pembersihan-lahan\') &&\n    (meta?.drawingType === \'arsitektur_denah\' || !meta?.drawingType)\n  ) {\n    const lahanParams = catalogUpdates.get(\'prep-pembersihan-lahan\') || [];\n    const pVal = lahanParams.find((x) => x.parameterId === \'panjang\')?.convertedValue;\n    const lVal = lahanParams.find((x) => x.parameterId === \'lebar\')?.convertedValue;\n    if (pVal && lVal) {\n      const kelilingDasar = Number((2 * (pVal + lVal)).toFixed(2));\n      catalogUpdates.set(\'ars-dinding-bata-hebel\', [\n        {\n          parameterId: \'panjang_keliling\',\n          convertedValue: kelilingDasar,\n          rawExtractedValue: kelilingDasar,\n          rawUnit: \'m\',\n          pageOrLocation: \'Keliling Dinding Denah\',\n          reason: \'Estimasi keliling dinding dari garis denah lantai (tinggi dinding menunggu gambar potongan/input manual)\',\n        },\n      ]);\n    }\n  }\n\n  // Terapkan setiap pembaruan katalog ke pekerjaan proyek\n  for (const [catalogId, paramUpdates] of catalogUpdates.entries()) {\n    const dedupKey = `${targetFloorId}::${catalogId}`;\n\n    // Lewati jika pernah ditolak/dihapus pengguna (kecuali dipaksa)\n    if (rejectedKeys.has(dedupKey) && !meta?.forceIncludeRejected) {\n      continue;\n    }\n\n    // Cari apakah sudah ada pekerjaan dengan dedupKey ini, atau pekerjaan di lantai yang sama yang berasal dari AI / masih memiliki parameter kosong\n    let existingWork = updatedWorks.find(\n      (w) =>\n        w.isActive &&\n        (w.dedupKey === dedupKey ||\n          (w.floorId === targetFloorId &&\n            w.catalogId === catalogId &&\n            (w.origin === \'ai\' || w.parameters.some((p) => p.required && p.value === null))))\n    );\n\n    if (existingWork) {\n      let workModified = false;\n      for (const upd of paramUpdates) {\n        const param = existingWork.parameters.find((p) => p.id === upd.parameterId);\n        if (!param) continue;\n\n        const currentVal =\n          param.value !== null && param.value !== \'\' && !isNaN(Number(param.value))\n            ? Number(param.value)\n            : null;\n\n        if (currentVal === null) {\n          // Parameter masih kosong -> isi otomatis!\n          param.value = upd.convertedValue;\n          param.source = \'ai\';\n          param.sourceDocument = sourceDocument;\n          param.pageOrLocation = upd.pageOrLocation;\n          param.rawExtractedValue = upd.rawExtractedValue;\n          param.rawUnit = upd.rawUnit;\n          param.isVerified = false;\n          param.conflict = null;\n          workModified = true;\n        } else if (Math.abs(currentVal - upd.convertedValue) < 0.001) {\n          // Nilai sama persis (analisis ulang dokumen yang sama) -> perbarui metadata sumber saja\n          param.sourceDocument = param.sourceDocument || sourceDocument;\n          param.pageOrLocation = param.pageOrLocation || upd.pageOrLocation;\n          param.rawExtractedValue = param.rawExtractedValue ?? upd.rawExtractedValue;\n          param.rawUnit = param.rawUnit ?? upd.rawUnit;\n        } else {\n          // Nilai berbeda!\n          const isSameUnverifiedDoc =\n            existingWork.origin === \'ai\' &&\n            existingWork.aiVerificationStatus === \'draft\' &&\n            !param.isVerified &&\n            param.sourceDocument === sourceDocument;\n\n          if (isSameUnverifiedDoc) {\n            // Pengguna mengubah satuan (misal mm ke cm) dan menganalisis ulang dokumen yang sama\n            param.value = upd.convertedValue;\n            param.rawExtractedValue = upd.rawExtractedValue;\n            param.rawUnit = upd.rawUnit;\n            param.pageOrLocation = upd.pageOrLocation;\n            param.conflict = null;\n            workModified = true;\n          } else {\n            // Konflik dimensi antar gambar atau terhadap data yang sudah diverifikasi\n            param.conflict = {\n              newValue: upd.convertedValue,\n              rawExtractedValue: upd.rawExtractedValue,\n              rawUnit: upd.rawUnit,\n              sourceDocument,\n              pageOrLocation: upd.pageOrLocation,\n            };\n            conflictCount++;\n            workModified = true;\n          }\n        }\n      }\n\n      if (workModified) {\n        existingWork.dedupKey = existingWork.dedupKey || dedupKey;\n        existingWork.lastUpdated = new Date().toISOString();\n        updatedExistingWorksCount++;\n        affectedWorkIds.add(existingWork.id);\n      }\n    } else {\n      // Buat pekerjaan Draf AI baru pada lantai tujuan\n      const initialValues: Record<string, number | null> = {};\n\n      // Khusus Dinding Bata Ringan dari gambar denah lantai:\n      // Kosongkan tinggi_dinding (null) jika tidak ditemukan pada gambar, agar berstatus \"Belum Lengkap\"\n      if (catalogId === \'ars-dinding-bata-hebel\') {\n        const hasHeightInUpdates = paramUpdates.some((u) => u.parameterId === \'tinggi_dinding\');\n        if (!hasHeightInUpdates) {\n          initialValues[\'tinggi_dinding\'] = null;\n        }\n      }\n\n      for (const upd of paramUpdates) {\n        initialValues[upd.parameterId] = upd.convertedValue;\n      }\n\n      const firstUpdate = paramUpdates[0];\n      const newWork = createProjectWorkFromCatalog(catalogId, targetFloorId, initialValues, {\n        origin: \'ai\',\n        aiVerificationStatus: \'draft\',\n        sourceDocument,\n        identificationReason: firstUpdate?.reason || \'Teridentifikasi dari analisis gambar AI\',\n        dedupKey,\n        elementLocation: firstUpdate?.pageOrLocation,\n      });\n\n      if (newWork) {\n        // Lengkapi metadata per parameter yang diisi AI\n        for (const upd of paramUpdates) {\n          const p = newWork.parameters.find((param) => param.id === upd.parameterId);\n          if (p) {\n            p.source = \'ai\';\n            p.sourceDocument = sourceDocument;\n            p.pageOrLocation = upd.pageOrLocation;\n            p.rawExtractedValue = upd.rawExtractedValue;\n            p.rawUnit = upd.rawUnit;\n            p.isVerified = false;\n          }\n        }\n\n        updatedWorks.push(newWork);\n        createdDraftWorksCount++;\n        affectedWorkIds.add(newWork.id);\n      }\n    }\n  }\n\n  const recalculated = recalculateAllProjectWorks(updatedWorks);\n\n  // Hitung berapa pekerjaan AI yang masih belum lengkap parameternya\n  const incompleteWorksCount = recalculated.filter(\n    (w) =>\n      w.isActive &&\n      w.origin === \'ai\' &&\n      w.aiVerificationStatus === \'draft\' &&\n      w.calculatedVolume === null\n  ).length;\n\n  // Susun daftar Rekomendasi Pekerjaan Lanjutan (tidak langsung dimasukkan ke kalkulator tanpa persetujuan)\n  const recommendations: AIAutoTakeoffSummary[\'recommendations\'] = [];\n  const hasWall = recalculated.some(\n    (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-dinding-bata-hebel\'\n  );\n  const hasToilet = recalculated.some(\n    (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-keramik-toilet-antislip\'\n  );\n\n  if (hasWall) {\n    if (\n      !recalculated.some(\n        (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-plesteran-acian-15mm\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'ars-plesteran-acian-15mm\',\n        name: \'Plesteran 1SP : 6PP (t = 15 mm) & Acian\',\n        category: \'Arsitektural\',\n        reason: \'Rekomendasi lanjutan otomatis karena terdeteksi pasangan dinding bata ringan pada lantai ini (2 \303\227 luas dinding bersih).\',\n      });\n    }\n    if (\n      !recalculated.some(\n        (w) =>\n          w.isActive &&\n          w.floorId === targetFloorId &&\n          w.catalogId === \'ars-pengecatan-dinding-interior\'\n      )\n    ) {\n      recommendations.push({\n        catalogId: \'ars-pengecatan-dinding-interior\',\n        name: \'Pengecatan Dinding Interior (Catylac / Setara)\',\n        category: \'Arsitektural\',\n        reason: \'Rekomendasi pekerjaan finishing cat dinding setelah pekerjaan plesteran dan acian.\',\n      });\n    }\n  }\n\n  if (\n    hasToilet &&\n    !recalculated.some(\n      (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-keramik-dinding-toilet\'\n    )\n  ) {\n    recommendations.push({\n      catalogId: \'ars-keramik-dinding-toilet\',\n      name: \'Pemasangan Keramik Dinding Toilet 25 x 40 cm\',\n      category: \'Arsitektural\',\n      reason: \'Rekomendasi pelapis dinding area basah karena terdeteksi ruang KM/WC pada denah.\',\n    });\n  }\n\n  if (\n    !recalculated.some(\n      (w) => w.isActive && w.floorId === targetFloorId && w.catalogId === \'ars-plafond-gypsum\'\n    )\n  ) {\n    recommendations.push({\n      catalogId: \'ars-plafond-gypsum\',\n      name: \'Pemasangan Plafond Gypsum Board (t = 9\342\200\22310 mm)\',\n      category: \'Arsitektural\',\n      reason: \'Rekomendasi pekerjaan langit-langit mengikuti luas bersih ruangan pada denah.\',\n    });\n  }\n\n  const updatedProject: ProjectData = {\n    ...project,\n    works: recalculated,\n    updatedAt: new Date().toISOString(),\n  };\n\n  const summary: AIAutoTakeoffSummary = {\n    documentSummary: meta?.documentSummary || `Analisis dokumen ${sourceDocument}`,\n    drawingType: meta?.drawingType || \'arsitektur_denah\',\n    identifiedFloor: meta?.identifiedFloor || targetFloorId,\n    identifiedScale: meta?.identifiedScale || \'1:100\',\n    extractedCount: extractionItems.length,\n    createdDraftWorksCount,\n    updatedExistingWorksCount,\n    incompleteWorksCount,\n    conflictCount,\n    recommendations,\n  };\n\n  return {\n    updatedProject,\n    summary,\n    affectedWorkIds: Array.from(affectedWorkIds),\n  };\n}\n\n/**\n * Inisialisasi Proyek Default \"Gedung USC\" (Sesuai referensi gambar & workbook asli)\n */\nexport function createDefaultUscProject(): ProjectData {\n  const floors: FloorItem[] = [\n    { id: \'fl-umum\', name: \'Umum & Pondasi\', level: 0, elevation: \'\302\261 0.00 m\', description: \'Pekerjaan persiapan, tanah, dan pondasi\' },\n    { id: \'fl-1\', name: \'Lantai 1\', level: 1, elevation: \'+ 0.00 m\', description: \'Elevasi lantai dasar\' },\n    { id: \'fl-2\', name: \'Lantai 2\', level: 2, elevation: \'+ 4.00 m\', description: \'Elevasi +4.00 m\' },\n    { id: \'fl-3\', name: \'Lantai 3\', level: 3, elevation: \'+ 8.00 m\', description: \'Elevasi +8.00 m\' },\n  ];\n\n  const works: ProjectWorkItem[] = [];\n\n  // 1. Umum & Pondasi\n  const pLahan = createProjectWorkFromCatalog(\'prep-pembersihan-lahan\', \'fl-umum\', { panjang: 36, lebar: 34 });\n  if (pLahan) works.push(pLahan);\n\n  const pBouw = createProjectWorkFromCatalog(\'prep-bouwplank\', \'fl-umum\', { panjang: 22, lebar: 27 });\n  if (pBouw) works.push(pBouw);\n\n  const pBatuKali = createProjectWorkFromCatalog(\'str-pasangan-batu-belah-1sp6pp\', \'fl-umum\', {\n    tinggi: 0.8,\n    lebar_atas: 0.5,\n    lebar_bawah: 0.8,\n    panjang_total: 214.72,\n  });\n  if (pBatuKali) works.push(pBatuKali);\n\n  const pGalian = createProjectWorkFromCatalog(\'str-galian-tanah-biasa-1m\', \'fl-umum\', {\n    lebar_bawah: 1.5,\n    lebar_atas: 1.1,\n    kedalaman: 1.0,\n    panjang_total: 214.72,\n  });\n  if (pGalian) works.push(pGalian);\n\n  const pSloof = createProjectWorkFromCatalog(\'str-sloof-beton\', \'fl-umum\', {\n    panjang_total: 214.72,\n    lebar: 0.4,\n    tinggi: 0.6,\n  });\n  if (pSloof) works.push(pSloof);\n\n  // 2. Lantai 1 Works\n  const k1Lt1 = createProjectWorkFromCatalog(\'str-kolom-k1-beton\', \'fl-1\', { lebar: 0.5, tebal: 0.5, tinggi: 4.0, jumlah: 20 });\n  if (k1Lt1) works.push(k1Lt1);\n\n  const k2Lt1 = createProjectWorkFromCatalog(\'str-kolom-k2-beton\', \'fl-1\', { lebar: 0.3, tebal: 0.3, tinggi: 4.0, jumlah: 5 });\n  if (k2Lt1) works.push(k2Lt1);\n\n  const b1Lt1 = createProjectWorkFromCatalog(\'str-balok-b1-beton\', \'fl-1\', { panjang_total: 184, lebar: 0.3, tinggi: 0.6 });\n  if (b1Lt1) works.push(b1Lt1);\n\n  const dndLt1 = createProjectWorkFromCatalog(\'ars-dinding-bata-hebel\', \'fl-1\', { panjang_keliling: 94.45, tinggi_dinding: 3.4, luas_bukaan: 23.2 });\n  if (dndLt1) works.push(dndLt1);\n\n  const plfLt1 = createProjectWorkFromCatalog(\'ars-plafond-gypsum\', \'fl-1\', { luas_plafond: 95.35 });\n  if (plfLt1) works.push(plfLt1);\n\n  const htLt1 = createProjectWorkFromCatalog(\'ars-homogenous-tile-60x60\', \'fl-1\', { luas_lantai: 95.35 });\n  if (htLt1) works.push(htLt1);\n\n  const pntLt1 = createProjectWorkFromCatalog(\'ars-pintu-p1-lengkap\', \'fl-1\', { jumlah_unit: 1 });\n  if (pntLt1) works.push(pntLt1);\n\n  const mepLt1 = createProjectWorkFromCatalog(\'mep-titik-lampu\', \'fl-1\', { lampu_led_12w: 18, lampu_led_7w: 12, lampu_led_4w: 6, lampu_tl_40w: 24 });\n  if (mepLt1) works.push(mepLt1);\n\n  // 3. Lantai 2 Works\n  const k1Lt2 = createProjectWorkFromCatalog(\'str-kolom-k1-beton\', \'fl-2\', { lebar: 0.5, tebal: 0.5, tinggi: 4.0, jumlah: 20 });\n  if (k1Lt2) works.push(k1Lt2);\n\n  const b1Lt2 = createProjectWorkFromCatalog(\'str-balok-b1-beton\', \'fl-2\', { panjang_total: 192, lebar: 0.3, tinggi: 0.6 });\n  if (b1Lt2) works.push(b1Lt2);\n\n  const pltLt2 = createProjectWorkFromCatalog(\'str-pelat-lantai-beton\', \'fl-2\', { panjang_bangunan: 25, lebar_bangunan: 20, luas_bukaan: 90.5, tebal_pelat: 0.12 });\n  if (pltLt2) works.push(pltLt2);\n\n  const dndLt2 = createProjectWorkFromCatalog(\'ars-dinding-bata-hebel\', \'fl-2\', { panjang_keliling: 169.18, tinggi_dinding: 3.4, luas_bukaan: 91.7 });\n  if (dndLt2) works.push(dndLt2);\n\n  const plfLt2 = createProjectWorkFromCatalog(\'ars-plafond-gypsum\', \'fl-2\', { luas_plafond: 399.79 });\n  if (plfLt2) works.push(plfLt2);\n\n  const htLt2 = createProjectWorkFromCatalog(\'ars-homogenous-tile-60x60\', \'fl-2\', { luas_lantai: 422.2 });\n  if (htLt2) works.push(htLt2);\n\n  const jndLt2 = createProjectWorkFromCatalog(\'ars-jendela-j3-lengkap\', \'fl-2\', { jumlah_unit: 7 });\n  if (jndLt2) works.push(jndLt2);\n\n  // 4. Lantai 3 Works\n  const k1Lt3 = createProjectWorkFromCatalog(\'str-kolom-k1-beton\', \'fl-3\', { lebar: 0.5, tebal: 0.5, tinggi: 4.0, jumlah: 20 });\n  if (k1Lt3) works.push(k1Lt3);\n\n  const b1Lt3 = createProjectWorkFromCatalog(\'str-balok-b1-beton\', \'fl-3\', { panjang_total: 200, lebar: 0.3, tinggi: 0.6 });\n  if (b1Lt3) works.push(b1Lt3);\n\n  const pltLt3 = createProjectWorkFromCatalog(\'str-pelat-lantai-beton\', \'fl-3\', { panjang_bangunan: 25, lebar_bangunan: 20, luas_bukaan: 89.6, tebal_pelat: 0.12 });\n  if (pltLt3) works.push(pltLt3);\n\n  const dndLt3 = createProjectWorkFromCatalog(\'ars-dinding-bata-hebel\', \'fl-3\', { panjang_keliling: 177.25, tinggi_dinding: 3.4, luas_bukaan: 108.4 });\n  if (dndLt3) works.push(dndLt3);\n\n  const plfLt3 = createProjectWorkFromCatalog(\'ars-plafond-gypsum\', \'fl-3\', { luas_plafond: 394.8 });\n  if (plfLt3) works.push(plfLt3);\n\n  // Item perlu input untuk menunjukkan status dinamis\n  const htLt3 = createProjectWorkFromCatalog(\'ars-homogenous-tile-60x60\', \'fl-3\', {});\n  if (htLt3) works.push(htLt3);\n\n  const calculatedWorks = recalculateAllProjectWorks(works);\n\n  return {\n    id: \'proj-gedung-usc\',\n    name: \'Gedung USC\',\n    location: \'Sidotopo, Magelang\',\n    description: \'Pekerjaan Pembangunan Gedung Untidar Study Center (USC) 3 Lantai + Struktur Bawah\',\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    floorCount: 3,\n    floors,\n    works: calculatedWorks,\n    rejectedDraftKeys: [],\n    catalogVersion: USC_CATALOG_VERSION,\n  };\n}\n\n/**\n * Muat semua proyek dari LocalStorage\n */\nexport function loadAllProjects(): ProjectData[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY_PROJECTS);\n    if (!raw) {\n      const defaultProj = createDefaultUscProject();\n      saveAllProjects([defaultProj]);\n      setActiveProjectId(defaultProj.id);\n      return [defaultProj];\n    }\n    const parsed: ProjectData[] = JSON.parse(raw);\n    if (!Array.isArray(parsed) || parsed.length === 0) {\n      const defaultProj = createDefaultUscProject();\n      saveAllProjects([defaultProj]);\n      setActiveProjectId(defaultProj.id);\n      return [defaultProj];\n    }\n    return parsed;\n  } catch (err) {\n    console.error(\'Gagal memuat proyek dari storage, membuat proyek default:\', err);\n    const defaultProj = createDefaultUscProject();\n    return [defaultProj];\n  }\n}\n\n/**\n * Simpan seluruh daftar proyek ke LocalStorage\n */\nexport function saveAllProjects(projects: ProjectData[]): boolean {\n  try {\n    localStorage.setItem(STORAGE_KEY_PROJECTS, JSON.stringify(projects));\n    return true;\n  } catch (err) {\n    console.error(\'Gagal menyimpan proyek ke LocalStorage:\', err);\n    return false;\n  }\n}\n\n/**\n * Dapatkan ID proyek aktif\n */\nexport function getActiveProjectId(): string {\n  try {\n    return localStorage.getItem(STORAGE_KEY_ACTIVE_PROJECT_ID) || \'proj-gedung-usc\';\n  } catch {\n    return \'proj-gedung-usc\';\n  }\n}\n\n/**\n * Set ID proyek aktif\n */\nexport function setActiveProjectId(id: string): void {\n  try {\n    localStorage.setItem(STORAGE_KEY_ACTIVE_PROJECT_ID, id);\n  } catch (err) {\n    console.error(\'Gagal menyimpan ID proyek aktif:\', err);\n  }\n}\n\n/**\n * Buat proyek baru kosong\n */\nexport function createNewProject(name: string, floorCount: number = 3, location: string = \'\'): ProjectData {\n  const floors: FloorItem[] = [\n    { id: \'fl-umum\', name: \'Umum & Pondasi\', level: 0, elevation: \'\302\261 0.00 m\', description: \'Pekerjaan persiapan dan struktur dasar\' },\n  ];\n\n  for (let i = 1; i <= floorCount; i++) {\n    floors.push({\n      id: `fl-${i}`,\n      name: `Lantai ${i}`,\n      level: i,\n      elevation: `+ ${(i - 1) * 4}.00 m`,\n      description: `Elevasi lantai tingkat ${i}`,\n    });\n  }\n\n  // Masukkan pekerjaan persiapan standar otomatis ke kelompok umum\n  const defaultPrepWorks: ProjectWorkItem[] = [];\n  const pLahan = createProjectWorkFromCatalog(\'prep-pembersihan-lahan\', \'fl-umum\');\n  if (pLahan) defaultPrepWorks.push(pLahan);\n  const pBouw = createProjectWorkFromCatalog(\'prep-bouwplank\', \'fl-umum\');\n  if (pBouw) defaultPrepWorks.push(pBouw);\n\n  return {\n    id: `proj-${Date.now()}`,\n    name: name.trim() || \'Proyek Konstruksi Baru\',\n    location: location.trim(),\n    description: `Kalkulator quantity takeoff bangunan ${floorCount} lantai.`,\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    floorCount,\n    floors,\n    works: defaultPrepWorks,\n    rejectedDraftKeys: [],\n    catalogVersion: USC_CATALOG_VERSION,\n  };\n}\n"
