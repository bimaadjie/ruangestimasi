    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst data = JSON.parse(fs.readFileSync(\'public/assets/aistudio/katalog_volume_usc_639e973f.json\', \'utf8\'));\nfor (const sheetName of [\'Volume Persiapan Dll\', \'Volume Struktural\']) {\n  const sheet = data.sheets.find(s => s.name === sheetName);\n  console.log(\'\\n================ SHEET:\', sheet.name, \'================\');\n  for (const r of sheet.rows) {\n    const map = {};\n    for (const c of r.cells) {\n      const col = c.cell.replace(/[0-9]/g, \'\');\n      map[col] = c.value + (c.excel_formula ? \' {\'+c.excel_formula+\'}\' : \'\');\n    }\n    if (sheetName === \'Volume Persiapan Dll\') {\n      console.log(\'R\' + r.row + \':\', JSON.stringify(map));\n    } else if (map.A || map.B || map.C || (map.D && !map.I && !map.M && !map.O)) {\n      console.log(\'R\' + r.row + \':\', JSON.stringify(map));\n    }\n  }\n}\n\""
    proposed_command_line: "node -e \"\nconst fs = require(\'fs\');\nconst data = JSON.parse(fs.readFileSync(\'public/assets/aistudio/katalog_volume_usc_639e973f.json\', \'utf8\'));\nfor (const sheetName of [\'Volume Persiapan Dll\', \'Volume Struktural\']) {\n  const sheet = data.sheets.find(s => s.name === sheetName);\n  console.log(\'\\n================ SHEET:\', sheet.name, \'================\');\n  for (const r of sheet.rows) {\n    const map = {};\n    for (const c of r.cells) {\n      const col = c.cell.replace(/[0-9]/g, \'\');\n      map[col] = c.value + (c.excel_formula ? \' {\'+c.excel_formula+\'}\' : \'\');\n    }\n    if (sheetName === \'Volume Persiapan Dll\') {\n      console.log(\'R\' + r.row + \':\', JSON.stringify(map));\n    } else if (map.A || map.B || map.C || (map.D && !map.I && !map.M && !map.O)) {\n      console.log(\'R\' + r.row + \':\', JSON.stringify(map));\n    }\n  }\n}\n\""
