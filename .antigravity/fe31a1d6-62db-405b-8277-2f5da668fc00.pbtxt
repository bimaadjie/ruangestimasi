            lines {
              text: "      const t = params[\'tinggi_dinding\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (p == null || t == null || isNaN(p) || isNaN(t)) return null;"
