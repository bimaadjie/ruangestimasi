          absolute_uri: "file:///server.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "// Setup Vite development middlewares or static files for production\nasync function startServer() {\n  if (!isProd) {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req: Request, res: Response) => {\n      res.sendFile(path.resolve(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`RuangEstimasi server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();"
          replacement_content: "// Setup Vite development middlewares or static files for production\nasync function startServer() {\n  if (!isProd) {\n    let viteMiddleware: any = null;\n    const viteReady = createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    }).then((vite) => {\n      viteMiddleware = vite.middlewares;\n      return vite;\n    });\n\n    app.use(async (req: Request, res: Response, next: NextFunction) => {\n      try {\n        if (!viteMiddleware) {\n          await viteReady;\n        }\n        viteMiddleware(req, res, next);\n      } catch (err) {\n        next(err);\n      }\n    });\n  } else {\n    const distPath = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req: Request, res: Response) => {\n      res.sendFile(path.resolve(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`RuangEstimasi server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
          start_line: 578
          end_line: 600
        }
      }
