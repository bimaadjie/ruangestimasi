              text: "      { id: \'panjang_bangunan\', name: \'panjang_bangunan\', label: \'Panjang Pelat Lantai\', placeholder: \'Masukkan panjang pelat (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'lebar_bangunan\', name: \'lebar_bangunan\', label: \'Lebar Pelat Lantai\', placeholder: \'Masukkan lebar pelat (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'luas_bukaan\', name: \'luas_bukaan\', label: \'Total Luas Bukaan / Void\', placeholder: \'Masukkan luas void jika ada (m\302\262)\', value: 0, unit: \'m\302\262\', required: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { id: \'tebal_pelat\', name: \'tebal_pelat\', label: \'Tebal Pelat Lantai\', placeholder: \'Contoh: 0.12 (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    calculationMethod: (params) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const p = params[\'panjang_bangunan\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const l = params[\'lebar_bangunan\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const voidArea = params[\'luas_bukaan\'] || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const t = params[\'tebal_pelat\'];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (p == null || l == null || t == null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const luasBersih = Math.max(0, p * l - voidArea);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return luasBersih * t;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
