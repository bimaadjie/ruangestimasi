      thinking_signature: "\022\344\020\n\341\020\001i\024}\023]\215t\v\033\267\270\335F\224 \247\230\335W\301C[E4\2259\300.\257Aq\3105\332\206\017M\232\367J\3508\223d\356M\203\341\030\022O\326\257\03237\321\335\253\275\271\332*\235\311\316\264\f\207\224\032.\035\2716^\240EqUH\230\n\322\036\002\220\271\267D\207\3113\316P\316\327ty\210\204\317\201\254dV\361t\366r\2752Qr\307\320U\335\344\325.\340\241Nb8\031\" w\264x4{\274\225\366\274\300+\200>z\371\366\030\202\243bX\034v\300\024\031\373k\251\273\220\311y\242rIxO\025\322-.1\037ri,`2\234\245SE\220\245\211T\242v\223Se\212\267M\0064\352\261I\031(\203\rEe|K\361\035PIqwL\327\201\335\202\240\253\350\245.\217\314g}[=\026H\256\033\252\311\351nr\363\b\356\303\340\373\214\236\354\340\024\v\024\202\240b\353K0\216\333\370}sL\333\220\033!\313&@\230\a\231;\2060p\354Y\3729\006\f}\246\244\2360\233\360\257\230\376\275\'^\3723\211G\226J~\226N\3242\343v\375\203\231\231\227\342)\234\206\235\244\336\234\376F\351\323~\361\306\232\273~\255\377]\345\021x\344\250\233\303t|\003^\217\305C#Yo\373\004?Z\257M\271\351]\324\003\200\315\340\346\304\377\237\323\242R\304\232\322\357\023\223 \274\330\236\202\'T\222\334=\310\254\025\036\032\353:pn\220G\314\025r\200=\023\225\305\')j\3141c\343\305QR\277\2764\330:\204f#\217\"qG\343`\360HR\265\3363+{\027\a\321\365L\217\205\3147\343\254O2\367\022\025\204\226\320`*&\334I}\005-\273\324\271\"(\033\233\244\022]\365\034\250\336X\224\300\3028\327E\245z\254\267\357\\M\242\271peC\355\270\024Fm\361*\006\367\207\006$\202\363\027\316\3248\205\274h\371\026\3438\032@\233\362\333\026\037bi\3266F\355i\321P\230T\"\202\"\261\233\016\377\3055\204`\304\323\241\036\376\324\n\a\247\342\320\\7$+5Z\305>\207\304\334\266\345\342\365:|\234+\272\202\275\260c\220\1777\257\266\177\213\036\346\221i\252\251\300*\333\231\377U8\256\221\206]\316\375q/%\030\376\277\312\\/#qU\252\370ss,9\207\307\035\341\3227\201gv\240\370\267_\237\232\271y\305\261\214CV\311\341\2567\307\276&\252\324\241O\321\005\vI\240\364\2673)|\202fJj\343\b\315\341\027\201\353