  view_file {
    absolute_path_uri: "file:///src/components/RecapCards.tsx"
    end_line: 81
    content: "import React from \'react\';\nimport { Box, Layers, Ruler, FileText } from \'lucide-react\';\nimport { ProjectWorkItem } from \'../types\';\nimport { computeProjectSummaries, formatIndonesianNumber } from \'../services/calculationEngine\';\n\ninterface RecapCardsProps {\n  works: ProjectWorkItem[];\n}\n\nexport const RecapCards: React.FC<RecapCardsProps> = ({ works }) => {\n  const summaries = computeProjectSummaries(works);\n\n  const stats = [\n    {\n      label: \'Volume Beton\',\n      value: `${formatIndonesianNumber(summaries.totalBetonM3)} m\302\263`,\n      icon: Box,\n      color: \'text-blue-700\',\n      bgColor: \'bg-blue-50/80\',\n      borderColor: \'border-blue-100\',\n    },\n    {\n      label: \'Luas Pekerjaan\',\n      value: `${formatIndonesianNumber(summaries.totalLuasM2)} m\302\262`,\n      icon: Layers,\n      color: \'text-indigo-700\',\n      bgColor: \'bg-indigo-50/80\',\n      borderColor: \'border-indigo-100\',\n    },\n    {\n      label: \'Panjang Pekerjaan\',\n      value: `${formatIndonesianNumber(summaries.totalPanjangM)} m`,\n      icon: Ruler,\n      color: \'text-teal-700\',\n      bgColor: \'bg-teal-50/80\',\n      borderColor: \'border-teal-100\',\n    },\n    {\n      label: \'Jumlah Pekerjaan\',\n      value: `${summaries.totalWorks} item`,\n      icon: FileText,\n      color: \'text-slate-700\',\n      bgColor: \'bg-slate-100\',\n      borderColor: \'border-slate-200\',\n    },\n  ];\n\n  return (\n    <div className=\"mt-7\">\n      <h4 className=\"text-sm font-bold text-slate-900 mb-3.5\">\n        Rekap Total Volume (Bangunan)\n      </h4>\n\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {stats.map((stat, idx) => {\n          const Icon = stat.icon;\n          return (\n            <div\n              key={idx}\n              className=\"bg-white rounded-2xl border border-slate-200 p-4 shadow-xs flex items-center gap-3.5 hover:border-slate-300 transition\"\n            >\n              <div\n                className={`w-11 h-11 rounded-xl ${stat.bgColor} ${stat.borderColor} border flex items-center justify-center shrink-0`}\n              >\n                <Icon className={`w-5 h-5 ${stat.color}`} />\n              </div>\n              <div className=\"min-w-0\">\n                <span className=\"text-xs text-slate-500 font-medium block truncate\">\n                  {stat.label}\n                </span>\n                <span className=\"text-base font-bold text-slate-900 font-mono tracking-tight block truncate\">\n                  {stat.value}\n                </span>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 82
    num_bytes: 2566
    line_range_bytes: 2566
  }
}
