    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst data = JSON.parse(fs.readFileSync(\'public/assets/aistudio/katalog_volume_usc_639e973f.json\', \'utf8\'));\nconst s2 = data.sheets.find(s => s.name === \'Volume Struktural\');\nconsole.log(\'=== Volume Struktural (Rows 30-106) ===\');\nfor (const r of s2.rows) {\n  if (r.row < 30 || r.row > 106) continue;\n  console.log(\'R\' + r.row + \':\', r.cells.map(c => c.cell + \'=\' + JSON.stringify(c.value) + (c.excel_formula ? \'[\'+c.excel_formula+\']\' : \'\')).join(\' | \'));\n}\nconst s3 = data.sheets.find(s => s.name === \'Volume Arsitektural\');\nconsole.log(\'=== Volume Arsitektural (Rows 1-170) ===\');\nfor (const r of s3.rows) {\n  if (r.row > 170) break;\n  const cells = {};\n  r.cells.forEach(c => cells[c.cell.replace(/[0-9]/g,\'\')] = c.value);\n  if (cells.A || cells.B || cells.C || cells.D) {\n    console.log(\'R\' + r.row + \':\', r.cells.map(c => c.cell + \'=\' + JSON.stringify(c.value) + (c.excel_formula ? \'[\'+c.excel_formula+\']\' : \'\')).join(\' | \'));\n  }\n}\n\""
    proposed_command_line: "node -e \"\nconst fs = require(\'fs\');\nconst data = JSON.parse(fs.readFileSync(\'public/assets/aistudio/katalog_volume_usc_639e973f.json\', \'utf8\'));\nconst s2 = data.sheets.find(s => s.name === \'Volume Struktural\');\nconsole.log(\'=== Volume Struktural (Rows 30-106) ===\');\nfor (const r of s2.rows) {\n  if (r.row < 30 || r.row > 106) continue;\n  console.log(\'R\' + r.row + \':\', r.cells.map(c => c.cell + \'=\' + JSON.stringify(c.value) + (c.excel_formula ? \'[\'+c.excel_formula+\']\' : \'\')).join(\' | \'));\n}\nconst s3 = data.sheets.find(s => s.name === \'Volume Arsitektural\');\nconsole.log(\'=== Volume Arsitektural (Rows 1-170) ===\');\nfor (const r of s3.rows) {\n  if (r.row > 170) break;\n  const cells = {};\n  r.cells.forEach(c => cells[c.cell.replace(/[0-9]/g,\'\')] = c.value);\n  if (cells.A || cells.B || cells.C || cells.D) {\n    console.log(\'R\' + r.row + \':\', r.cells.map(c => c.cell + \'=\' + JSON.stringify(c.value) + (c.excel_formula ? \'[\'+c.excel_formula+\']\' : \'\')).join(\' | \'));\n  }\n}\n\""
