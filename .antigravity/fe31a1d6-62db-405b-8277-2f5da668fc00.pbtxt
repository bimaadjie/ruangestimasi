    replacement_infos {
      original_chunk {
        target_content: "/**\n * Proyek Default Bersih Tanpa Data Demo Gedung USC\n * Menyediakan daftar pekerjaan konstruksi standar dengan parameter kosong.\n */\nexport function createDefaultUscProject(ownerUid?: string): ProjectData {\n  return createNewProject(\'Proyek Baru\', 2, \'\', ownerUid);\n}\n\n/**\n * Buat proyek baru lengkap dengan daftar pekerjaan standar per kelompok lantai\n * (Tanpa isian dimensi, jumlah, atau volume dari proyek demo USC)\n */\nexport function createNewProject(\n  name: string = \'Proyek Baru\',\n  floorCount: number = 2,\n  location: string = \'\',\n  ownerUid?: string\n): ProjectData {\n  const floors: FloorItem[] = [\n    {\n      id: \'fl-umum\',\n      name: \'Umum & Pondasi\',\n      level: 0,\n      elevation: \'\302\261 0.00 m\',\n      description: \'Pekerjaan persiapan, tanah, pondasi, dan sloof\',\n    },\n  ];\n\n  for (let i = 1; i <= floorCount; i++) {\n    floors.push({\n      id: `fl-${i}`,\n      name: `Lantai ${i}`,\n      level: i,\n      elevation: `+ ${(i - 1) * 4}.00 m`,\n      description: `Elevasi lantai tingkat ${i}`,\n    });\n  }\n\n  // Sediakan daftar pekerjaan standar (template kosong) untuk setiap lantai\n  const defaultWorks: ProjectWorkItem[] = [];\n  for (const floor of floors) {\n    const floorWorks = createDefaultWorksForFloor(floor.id, floor.level);\n    defaultWorks.push(...floorWorks);\n  }\n\n  return {\n    id: `proj-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\n    ownerUid,\n    name: name.trim() || \'Proyek Baru\',\n    location: location.trim(),\n    description: `Kalkulator volume pekerjaan konstruksi (${floorCount} lantai).`,\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    floorCount,\n    floors,\n    works: recalculateAllProjectWorks(defaultWorks),\n    rejectedDraftKeys: [],\n    catalogVersion: USC_CATALOG_VERSION,\n  };\n}\n\n/**\n * Sinkronisasi proyek milik pengguna ke Cloud Firestore jika pengguna login melalui Firebase Auth\n */\nexport async function syncProjectsToFirestore(userId: string, projects: ProjectData[]): Promise<void> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return;\n  for (const proj of projects) {\n    const path = `users/${userId}/projects/${proj.id}`;\n    try {\n      await setDoc(\n        doc(db, \'users\', userId, \'projects\', proj.id),\n        {\n          id: proj.id,\n          ownerUid: userId,\n          name: proj.name,\n          location: proj.location || \'\',\n          description: proj.description || \'\',\n          floorCount: proj.floorCount,\n          floors: proj.floors,\n          works: JSON.parse(JSON.stringify(proj.works || [])),\n          rejectedDraftKeys: proj.rejectedDraftKeys || [],\n          catalogVersion: proj.catalogVersion || USC_CATALOG_VERSION,\n          createdAt: proj.createdAt,\n          updatedAt: proj.updatedAt,\n        },\n        { merge: true }\n      );\n    } catch (err) {\n      handleFirestoreError(err, OperationType.WRITE, path);\n    }\n  }\n}\n\nexport async function deleteProjectFromFirestore(userId: string, projectId: string): Promise<void> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return;\n  const path = `users/${userId}/projects/${projectId}`;\n  try {\n    await deleteDoc(doc(db, \'users\', userId, \'projects\', projectId));\n  } catch (err) {\n    handleFirestoreError(err, OperationType.DELETE, path);\n  }\n}\n\nexport async function fetchProjectsFromFirestore(userId: string): Promise<ProjectData[] | null> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return null;\n  const path = `users/${userId}/projects`;\n  try {\n    const snap = await getDocs(collection(db, \'users\', userId, \'projects\'));\n    if (snap.empty) return [];\n    const loaded: ProjectData[] = [];\n    snap.forEach((docSnap) => {\n      const data = docSnap.data() as ProjectData;\n      loaded.push({\n        ...data,\n        works: recalculateAllProjectWorks(data.works || []),\n      });\n    });\n    return loaded;\n  } catch (err) {\n    handleFirestoreError(err, OperationType.LIST, path);\n    return null;\n  }\n}\n\n/**\n * Muat semua proyek milik pengguna tertentu dari penyimpanan terisolasi.\n */\nexport function loadAllProjects(userId: string = \'default\'): ProjectData[] {\n  const userKey = `${STORAGE_PREFIX_USER_PROJECTS}${userId}`;\n  try {\n    const rawUser = localStorage.getItem(userKey);\n    if (rawUser) {\n      const parsed: ProjectData[] = JSON.parse(rawUser);\n      if (Array.isArray(parsed) && parsed.length > 0) {\n        return parsed.map((p) => {\n          // Jika proyek baru dari versi sebelumnya masih memiliki 0 pekerjaan sama sekali,\n          // sediakan daftar pekerjaan standar per lantai\n          let projectWorks = p.works || [];\n          if (projectWorks.length === 0 && Array.isArray(p.floors)) {\n            for (const fl of p.floors) {\n              projectWorks.push(...createDefaultWorksForFloor(fl.id, fl.level));\n            }\n          }\n          return {\n            ...p,\n            works: recalculateAllProjectWorks(projectWorks),\n          };\n        });\n      }\n    }\n\n    // Cek apakah ada proyek di penyimpanan legacy yang dibuat oleh pengguna (bukan demo Gedung USC bawaan)\n    const legacyRaw = localStorage.getItem(LEGACY_STORAGE_KEY_PROJECTS);\n    if (legacyRaw) {\n      const legacyParsed: ProjectData[] = JSON.parse(legacyRaw);\n      if (Array.isArray(legacyParsed) && legacyParsed.length > 0) {\n        const nonDemoProjects = legacyParsed.filter(\n          (p) => p.id !== \'proj-gedung-usc\' && p.name !== \'Gedung USC\'\n        );\n        if (nonDemoProjects.length > 0) {\n          const migrated = nonDemoProjects.map((p) => {\n            let projectWorks = p.works || [];\n            if (projectWorks.length === 0 && Array.isArray(p.floors)) {\n              for (const fl of p.floors) {\n                projectWorks.push(...createDefaultWorksForFloor(fl.id, fl.level));\n              }\n            }\n            return {\n              ...p,\n              ownerUid: userId,\n              works: recalculateAllProjectWorks(projectWorks),\n            };\n          });\n          saveAllProjects(migrated, userId);\n          setActiveProjectId(migrated[0].id, userId);\n          return migrated;\n        }\n      }\n    }\n\n    // Buat proyek baru dengan daftar pekerjaan konstruksi standar (tanpa dimensi Gedung USC)\n    const freshProject = createNewProject(\'Proyek Baru\', 2, \'\', userId);\n    saveAllProjects([freshProject], userId);\n    setActiveProjectId(freshProject.id, userId);\n    return [freshProject];\n  } catch (err) {\n    console.error(\'Gagal memuat proyek pengguna, membuat proyek baru:\', err);\n    const freshProject = createNewProject(\'Proyek Baru\', 2, \'\', userId);\n    return [freshProject];\n  }\n}\n\n/**\n * Simpan seluruh daftar proyek pengguna ke LocalStorage (dan sinkronkan ke Firestore jika aktif)\n */\nexport function saveAllProjects(projects: ProjectData[], userId: string = \'default\'): boolean {\n  const userKey = `${STORAGE_PREFIX_USER_PROJECTS}${userId}`;\n  try {\n    localStorage.setItem(userKey, JSON.stringify(projects));\n    if (auth.currentUser && auth.currentUser.uid === userId) {\n      syncProjectsToFirestore(userId, projects).catch((e) =>\n        console.warn(\'Sinkronisasi Firestore tertunda:\', e)\n      );\n    }\n    return true;\n  } catch (err) {\n    console.error(\'Gagal menyimpan proyek ke LocalStorage:\', err);\n    return false;\n  }\n}\n\n/**\n * Dapatkan ID proyek aktif untuk pengguna\n */\nexport function getActiveProjectId(userId: string = \'default\'): string {\n  try {\n    return localStorage.getItem(`${STORAGE_PREFIX_ACTIVE_PROJECT}${userId}`) || \'\';\n  } catch {\n    return \'\';\n  }\n}\n\n/**\n * Set ID proyek aktif untuk pengguna\n */\nexport function setActiveProjectId(id: string, userId: string = \'default\'): void {\n  try {\n    localStorage.setItem(`${STORAGE_PREFIX_ACTIVE_PROJECT}${userId}`, id);\n  } catch (err) {\n    console.error(\'Gagal menyimpan ID proyek aktif:\', err);\n  }\n}"
        replacement_content: "/**\n * Proyek Default Bersih Menggunakan Struktur Katalog Gedung USC Lengkap (Tanpa Nilai Dimensi Demo USC)\n */\nexport function createDefaultUscProject(ownerUid?: string): ProjectData {\n  return createNewProject(\'Proyek Baru\', 2, \'\', ownerUid);\n}\n\n/**\n * Buat proyek baru lengkap dengan seluruh daftar pekerjaan standar dari Katalog Gedung USC per kelompok lantai\n * (Tanpa membawa nilai dimensi, panjang, lebar, tinggi, jumlah elemen, luas, atau volume dari proyek demo USC)\n */\nexport function createNewProject(\n  name: string = \'Proyek Baru\',\n  floorCount: number = 2,\n  location: string = \'\',\n  ownerUid?: string\n): ProjectData {\n  const safeFloorCount = Math.max(1, Math.floor(floorCount || 2));\n  const floors: FloorItem[] = [\n    {\n      id: \'fl-umum\',\n      name: \'Umum & Pondasi\',\n      level: 0,\n      elevation: \'\302\261 0.00 m\',\n      description: \'Pekerjaan persiapan, tanah, pondasi, kolom pedestal, dan sloof\',\n    },\n  ];\n\n  for (let i = 1; i <= safeFloorCount; i++) {\n    floors.push({\n      id: `fl-${i}`,\n      name: `Lantai ${i}`,\n      level: i,\n      elevation: `+ ${(i - 1) * 4}.00 m`,\n      description: `Elevasi lantai tingkat ${i}`,\n    });\n  }\n\n  // Salin struktur pekerjaan standar dari Template Global USC untuk setiap lantai (seluruh parameter bernilai null)\n  const defaultWorks: ProjectWorkItem[] = [];\n  for (const floor of floors) {\n    const floorWorks = createDefaultWorksForFloor(floor.id, floor.level, safeFloorCount);\n    defaultWorks.push(...floorWorks);\n  }\n\n  return {\n    id: `proj-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\n    ownerUid,\n    name: name.trim() || \'Proyek Baru\',\n    location: location.trim(),\n    description: `Kalkulator volume pekerjaan konstruksi (${safeFloorCount} lantai).`,\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    floorCount: safeFloorCount,\n    floors,\n    works: recalculateAllProjectWorks(defaultWorks),\n    rejectedDraftKeys: [],\n    catalogVersion: USC_CATALOG_VERSION,\n  };\n}\n\n/**\n * Migrasi & Pemulihan Non-Destruktif Proyek ke Template Standar USC Lengkap:\n * 1. Mempertahankan 100% proyek pengguna, pekerjaan kustom buatan pengguna, dan parameter valid yang sudah diisi pengguna.\n * 2. Membersihkan nilai demonstrasi lama (`source === \'reference\'` atau proyek demo `proj-gedung-usc`) menjadi `null` dan status `Belum Diisi`.\n * 3. Memulihkan seluruh pekerjaan standar Katalog USC yang belum ada pada setiap kelompok lantai proyek (untuk proyek versi lama).\n */\nexport function migrateProjectToFullUscTemplate(\n  project: ProjectData,\n  userId?: string\n): { project: ProjectData; wasMigrated: boolean } {\n  const isLegacyDemoProject =\n    project.id === \'proj-gedung-usc\' || project.name?.trim() === \'Gedung USC\';\n  const needsTemplateUpgrade =\n    project.catalogVersion !== USC_CATALOG_VERSION ||\n    !Array.isArray(project.works) ||\n    project.works.length === 0 ||\n    isLegacyDemoProject;\n\n  // Pastikan struktur lantai selalu memiliki Umum & Pondasi serta lantai bertingkat\n  const safeFloorCount = Math.max(1, project.floorCount || 2);\n  let floors: FloorItem[] = Array.isArray(project.floors) && project.floors.length > 0\n    ? project.floors.map((f) => ({ ...f }))\n    : [];\n\n  if (!floors.some((f) => f.id === \'fl-umum\' || f.level === 0)) {\n    floors = [\n      {\n        id: \'fl-umum\',\n        name: \'Umum & Pondasi\',\n        level: 0,\n        elevation: \'\302\261 0.00 m\',\n        description: \'Pekerjaan persiapan, tanah, pondasi, kolom pedestal, dan sloof\',\n      },\n      ...floors,\n    ];\n  }\n\n  if (floors.filter((f) => f.id !== \'fl-umum\' && f.level > 0).length === 0) {\n    for (let i = 1; i <= safeFloorCount; i++) {\n      floors.push({\n        id: `fl-${i}`,\n        name: `Lantai ${i}`,\n        level: i,\n        elevation: `+ ${(i - 1) * 4}.00 m`,\n        description: `Elevasi lantai tingkat ${i}`,\n      });\n    }\n  }\n\n  const uscMap = new Map<string, CatalogWorkItem>(\n    USC_STANDARD_TEMPLATE.map((item) => [item.id, item])\n  );\n\n  // Salin & bersihkan pekerjaan yang sudah ada tanpa menghapus pekerjaan kustom atau input pengguna\n  const preservedWorks: ProjectWorkItem[] = (project.works || []).map((w) => {\n    const catEntry = w.catalogId ? uscMap.get(w.catalogId) : undefined;\n    const cleanedParams: ParameterItem[] = (w.parameters || []).map((p) => {\n      // Kosongkan nilai demonstrasi lama dari proyek referensi USC (`source === \'reference\'` atau proyek demo USC)\n      const isOldUscDemoValue = isLegacyDemoProject || p.source === \'reference\';\n      if (isOldUscDemoValue) {\n        return {\n          ...p,\n          value: null,\n          source: \'manual\',\n          sourceDocument: undefined,\n          isVerified: false,\n          conflict: null,\n        };\n      }\n      return { ...p };\n    });\n\n    const hasAnyValue = cleanedParams.some((p) => p.value !== null && p.value !== \'\');\n\n    return {\n      ...w,\n      name: catEntry && !w.name ? catEntry.name : w.name,\n      category: w.category || catEntry?.category || \'Struktural\',\n      subCategory: w.subCategory || catEntry?.subCategory,\n      unit: w.unit || catEntry?.defaultUnit || \'m\302\263\',\n      formulaDisplay: w.formulaDisplay || catEntry?.formulaDisplay || \'\',\n      excelSheet: w.excelSheet || catEntry?.excelSheet,\n      excelCell: w.excelCell || catEntry?.excelCell,\n      excelFormula: w.excelFormula || catEntry?.excelFormula,\n      parameters: cleanedParams,\n      calculatedVolume: hasAnyValue ? w.calculatedVolume : null,\n      status: hasAnyValue ? w.status : \'Belum Diisi\',\n      aiVerificationStatus:\n        w.origin === \'ai\'\n          ? w.aiVerificationStatus || \'draft\'\n          : hasAnyValue\n          ? w.aiVerificationStatus\n          : undefined,\n    };\n  });\n\n  if (!needsTemplateUpgrade) {\n    return {\n      project: {\n        ...project,\n        ownerUid: project.ownerUid || userId,\n        floors,\n        works: recalculateAllProjectWorks(preservedWorks),\n      },\n      wasMigrated: false,\n    };\n  }\n\n  // Pulihkan seluruh pekerjaan standar Katalog USC yang belum ada pada setiap lantai proyek\n  const mergedWorks: ProjectWorkItem[] = [...preservedWorks];\n  for (const floor of floors) {\n    const existingCatIdsOnFloor = new Set(\n      mergedWorks\n        .filter((w) => w.floorId === floor.id && w.catalogId)\n        .map((w) => w.catalogId!)\n    );\n\n    const standardFloorWorks = createDefaultWorksForFloor(\n      floor.id,\n      floor.level,\n      floors.filter((f) => f.id !== \'fl-umum\').length || safeFloorCount\n    );\n\n    for (const stdWork of standardFloorWorks) {\n      if (stdWork.catalogId && !existingCatIdsOnFloor.has(stdWork.catalogId)) {\n        mergedWorks.push(stdWork);\n        existingCatIdsOnFloor.add(stdWork.catalogId);\n      }\n    }\n  }\n\n  const finalProject: ProjectData = {\n    ...project,\n    id: isLegacyDemoProject ? `proj-${Date.now()}-usc` : project.id,\n    ownerUid: project.ownerUid || userId,\n    name: isLegacyDemoProject ? \'Proyek Baru\' : project.name,\n    floors,\n    floorCount: floors.filter((f) => f.id !== \'fl-umum\').length || safeFloorCount,\n    works: recalculateAllProjectWorks(mergedWorks),\n    catalogVersion: USC_CATALOG_VERSION,\n    updatedAt: new Date().toISOString(),\n  };\n\n  return {\n    project: finalProject,\n    wasMigrated: true,\n  };\n}\n\n/**\n * Sinkronisasi proyek milik pengguna ke Cloud Firestore jika pengguna login melalui Firebase Auth\n */\nexport async function syncProjectsToFirestore(userId: string, projects: ProjectData[]): Promise<void> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return;\n  for (const proj of projects) {\n    const path = `users/${userId}/projects/${proj.id}`;\n    try {\n      await setDoc(\n        doc(db, \'users\', userId, \'projects\', proj.id),\n        {\n          id: proj.id,\n          ownerUid: userId,\n          name: proj.name,\n          location: proj.location || \'\',\n          description: proj.description || \'\',\n          floorCount: proj.floorCount,\n          floors: proj.floors,\n          works: JSON.parse(JSON.stringify(proj.works || [])),\n          rejectedDraftKeys: proj.rejectedDraftKeys || [],\n          catalogVersion: proj.catalogVersion || USC_CATALOG_VERSION,\n          createdAt: proj.createdAt,\n          updatedAt: proj.updatedAt,\n        },\n        { merge: true }\n      );\n    } catch (err) {\n      handleFirestoreError(err, OperationType.WRITE, path);\n    }\n  }\n}\n\nexport async function deleteProjectFromFirestore(userId: string, projectId: string): Promise<void> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return;\n  const path = `users/${userId}/projects/${projectId}`;\n  try {\n    await deleteDoc(doc(db, \'users\', userId, \'projects\', projectId));\n  } catch (err) {\n    handleFirestoreError(err, OperationType.DELETE, path);\n  }\n}\n\nexport async function fetchProjectsFromFirestore(userId: string): Promise<ProjectData[] | null> {\n  if (!auth.currentUser || auth.currentUser.uid !== userId) return null;\n  const path = `users/${userId}/projects`;\n  try {\n    const snap = await getDocs(collection(db, \'users\', userId, \'projects\'));\n    if (snap.empty) return [];\n    const loaded: ProjectData[] = [];\n    let anyMigrated = false;\n    snap.forEach((docSnap) => {\n      const data = docSnap.data() as ProjectData;\n      const { project: migratedProj, wasMigrated } = migrateProjectToFullUscTemplate(data, userId);\n      if (wasMigrated) anyMigrated = true;\n      loaded.push(migratedProj);\n    });\n    if (anyMigrated && loaded.length > 0) {\n      syncProjectsToFirestore(userId, loaded).catch(() => {});\n    }\n    return loaded;\n  } catch (err) {\n    handleFirestoreError(err, OperationType.LIST, path);\n    return null;\n  }\n}\n\n/**\n * Muat semua proyek milik pengguna tertentu dari penyimpanan terisolasi.\n * Melakukan migrasi & pemulihan otomatis template USC tanpa menghapus data proyek atau pekerjaan kustom pengguna.\n */\nexport function loadAllProjects(userId: string = \'default\'): ProjectData[] {\n  const userKey = `${STORAGE_PREFIX_USER_PROJECTS}${userId}`;\n  try {\n    // Periksa apakah ada pekerjaan kustom di penyimpanan legacy yang perlu diselamatkan\n    let legacyCustomWorks: ProjectWorkItem[] = [];\n    let legacyUserProjects: ProjectData[] = [];\n    const legacyRaw = localStorage.getItem(LEGACY_STORAGE_KEY_PROJECTS);\n    if (legacyRaw) {\n      try {\n        const legacyParsed: ProjectData[] = JSON.parse(legacyRaw);\n        if (Array.isArray(legacyParsed)) {\n          for (const lp of legacyParsed) {\n            const isLegacyDemo = lp.id === \'proj-gedung-usc\' || lp.name === \'Gedung USC\';\n            if (!isLegacyDemo) {\n              legacyUserProjects.push(lp);\n            } else if (Array.isArray(lp.works)) {\n              // Selamatkan pekerjaan kustom yang pernah dibuat pengguna di dalam proyek Gedung USC lama\n              const customInDemo = lp.works.filter(\n                (w) => !w.catalogId || w.catalogId.startsWith(\'custom-\')\n              );\n              legacyCustomWorks.push(...customInDemo);\n            }\n          }\n        }\n      } catch {\n        // abaikan kesalahan parse legacy\n      }\n    }\n\n    const rawUser = localStorage.getItem(userKey);\n    if (rawUser) {\n      const parsed: ProjectData[] = JSON.parse(rawUser);\n      if (Array.isArray(parsed) && parsed.length > 0) {\n        let anyMigrated = false;\n        const migratedList = parsed.map((p, idx) => {\n          let projToMigrate = p;\n          if (idx === 0 && legacyCustomWorks.length > 0) {\n            const existingIds = new Set((p.works || []).map((w) => w.id));\n            const missingCustom = legacyCustomWorks.filter((cw) => !existingIds.has(cw.id));\n            if (missingCustom.length > 0) {\n              projToMigrate = {\n                ...p,\n                works: [...missingCustom, ...(p.works || [])],\n              };\n              anyMigrated = true;\n            }\n          }\n          const { project: migratedProj, wasMigrated } = migrateProjectToFullUscTemplate(\n            projToMigrate,\n            userId\n          );\n          if (wasMigrated) anyMigrated = true;\n          return migratedProj;\n        });\n\n        // Tambahkan proyek pengguna dari penyimpanan legacy jika belum ada\n        const existingProjectIds = new Set(migratedList.map((p) => p.id));\n        for (const lup of legacyUserProjects) {\n          if (!existingProjectIds.has(lup.id)) {\n            const { project: migratedLegacy } = migrateProjectToFullUscTemplate(lup, userId);\n            migratedList.push(migratedLegacy);\n            anyMigrated = true;\n          }\n        }\n\n        if (anyMigrated) {\n          saveAllProjects(migratedList, userId);\n        }\n        return migratedList;\n      }\n    }\n\n    if (legacyUserProjects.length > 0) {\n      const migrated = legacyUserProjects.map((p, idx) => {\n        const withCustom =\n          idx === 0 && legacyCustomWorks.length > 0\n            ? { ...p, works: [...legacyCustomWorks, ...(p.works || [])] }\n            : p;\n        return migrateProjectToFullUscTemplate(withCustom, userId).project;\n      });\n      saveAllProjects(migrated, userId);\n      setActiveProjectId(migrated[0].id, userId);\n      return migrated;\n    }\n\n    // Buat proyek baru dengan daftar pekerjaan konstruksi standar lengkap dari Katalog Gedung USC (tanpa dimensi Gedung USC)\n    const freshProject = createNewProject(\'Proyek Baru\', 2, \'\', userId);\n    if (legacyCustomWorks.length > 0) {\n      freshProject.works = recalculateAllProjectWorks([\n        ...legacyCustomWorks,\n        ...freshProject.works,\n      ]);\n    }\n    saveAllProjects([freshProject], userId);\n    setActiveProjectId(freshProject.id, userId);\n    return [freshProject];\n  } catch (err) {\n    console.error(\'Gagal memuat proyek pengguna, membuat proyek baru:\', err);\n    const freshProject = createNewProject(\'Proyek Baru\', 2, \'\', userId);\n    return [freshProject];\n  }\n}\n\n/**\n * Simpan seluruh daftar proyek pengguna ke LocalStorage (dan sinkronkan ke Firestore jika aktif)\n */\nexport function saveAllProjects(projects: ProjectData[], userId: string = \'default\'): boolean {\n  const userKey = `${STORAGE_PREFIX_USER_PROJECTS}${userId}`;\n  try {\n    localStorage.setItem(userKey, JSON.stringify(projects));\n    if (auth.currentUser && auth.currentUser.uid === userId) {\n      syncProjectsToFirestore(userId, projects).catch((e) =>\n        console.warn(\'Sinkronisasi Firestore tertunda:\', e)\n      );\n    }\n    return true;\n  } catch (err) {\n    console.error(\'Gagal menyimpan proyek ke LocalStorage:\', err);\n    return false;\n  }\n}\n\n/**\n * Dapatkan ID proyek aktif untuk pengguna\n */\nexport function getActiveProjectId(userId: string = \'default\'): string {\n  try {\n    return localStorage.getItem(`${STORAGE_PREFIX_ACTIVE_PROJECT}${userId}`) || \'\';\n  } catch {\n    return \'\';\n  }\n}\n\n/**\n * Set ID proyek aktif untuk pengguna\n */\nexport function setActiveProjectId(id: string, userId: string = \'default\'): void {\n  try {\n    localStorage.setItem(`${STORAGE_PREFIX_ACTIVE_PROJECT}${userId}`, id);\n  } catch (err) {\n    console.error(\'Gagal menyimpan ID proyek aktif:\', err);\n  }\n}"
