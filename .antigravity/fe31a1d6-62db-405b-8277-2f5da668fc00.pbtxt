  planner_response {
    thinking: "**Analyzing Catalog IDs**\n\nI\'m currently focused on `projectStorage.ts`, specifically how `DEFAULT_UMUM_PONDASI_CATALOG_IDS`, `DEFAULT_LANTAI_1_CATALOG_IDS`, and `DEFAULT_LANTAI_ATAS_CATALOG_IDS` are defined. My next step is to dynamically generate these IDs from `USC_STANDARD_TEMPLATE`, which appears to be a crucial reference point.\n\n\n**Expanding Catalog Inclusion**\n\nI\'ve expanded the catalog inclusion logic to ensure 100% coverage of the USC work catalog. I\'m now dynamically generating the default catalog IDs. I\'ve updated the logic for determining which catalog items to include in `createDefaultWorksForFloor` based on floor ID and level, including special considerations for one-story projects to cover roof works.\n\n\n**Tracing Data Migration**\n\nI\'m now tracing the data migration process, focusing on `createProjectWorkFromCatalog` in `projectStorage.ts`, specifically lines 231 and 255. I see that the `isVerified` status handles cases with null values, and the `aiVerificationStatus` is only set if the origin is from AI. I\'m investigating how projects are safely migrated from `localStorage` or Firestore, especially handling custom works from `LEGACY_STORAGE_KEY_PROJECTS`. I\'m concerned about potential data loss, so I\'m writing a helper to extract legacy works.\n\n\n**Preserving Custom Data**\n\nI\'m focusing on data preservation during migration, especially for custom works created by users in \'proj-gedung-usc\'. It seems I can now ensure custom works with invalid catalog IDs or manual sources are saved. Demonstration values are cleared. The process then calls migrateProjectToFullUscTemplate for all projects. If the project is already USC-FULL, user-deleted works are untouched.\n\n\n**Refining Migration Logic**\n\nI\'m refining the migration logic for projects lacking the full USC catalog, particularly those with older catalog versions. I\'m focusing on `migrateProjectToFullUscTemplate` to preserve all existing works, including custom entries. I\'m carefully managing \'reference\' parameter values, ensuring they\'re cleared, volumes are recalculated, and the status is updated. I\'m also confirming the presence and structure of floor data.\n\n\n"
    tool_calls {
      id: "call_333370"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Use the complete USC_STANDARD_TEMPLATE for default floor works and ensure all initial template parameters and verification statuses are empty/null\",\"EndLine\":296,\"Instruction\":\"Update DEFAULT_*_CATALOG_IDS, createProjectWorkFromCatalog, and createDefaultWorksForFloor in src/services/projectStorage.ts to use the full USC_STANDARD_TEMPLATE with null values and Belum Diisi status\",\"ReplacementContent\":\"import { CATALOG_WORK_ITEMS, USC_CATALOG_VERSION, USC_STANDARD_TEMPLATE } from \'../data/uscCatalog\';\\nimport {\\n  AIAutoTakeoffSummary,\\n  AIBeamSloofSegment,\\n  AIDetectedRegion,\\n  AIExtractionItem,\\n  CatalogWorkItem,\\n  FloorItem,\\n  ParameterItem,\\n  ProjectData,\\n  ProjectWorkItem,\\n} from \'../types\';\\nimport { recalculateAllProjectWorks, safeEvaluateMath } from \'./calculationEngine\';\\nimport {\\n  auth,\\n  db,\\n  doc,\\n  setDoc,\\n  getDocs,\\n  deleteDoc,\\n  collection,\\n  OperationType,\\n  handleFirestoreError,\\n} from \'../firebase\';\\n\\nconst LEGACY_STORAGE_KEY_PROJECTS = \'ruangrab_projects_v1\';\\nconst STORAGE_PREFIX_USER_PROJECTS = \'ruangrab_user_projects_v2_\';\\nconst STORAGE_PREFIX_ACTIVE_PROJECT = \'ruangrab_active_project_v2_\';\\nconst STORAGE_KEY_SIDEBAR_COLLAPSED = \'ruangrab_sidebar_collapsed_v1\';\\nconst STORAGE_KEY_DISABLED_CATALOG_IDS = \'ruangrab_disabled_catalog_ids_v1\';\\nconst STORAGE_KEY_CUSTOM_CATALOG_ITEMS = \'ruangrab_custom_catalog_items_v1\';\\n\\n/**\\n * Daftar ID Katalog Pekerjaan Standar Global dari Referensi Gedung USC per Kelompok Lantai\\n * Mencakup seluruh pekerjaan Persiapan, Struktural, Arsitektural, dan MEP dari katalog USC\\n * (Hanya membawa nama, kategori, satuan, rumus, dan definisi parameter \342\200\224 TANPA nilai dimensi proyek USC)\\n */\\nexport const DEFAULT_UMUM_PONDASI_CATALOG_IDS: string[] = USC_STANDARD_TEMPLATE.filter(\\n  (item) => item.floorRule === \'umum\' || item.floorRule === \'fondasi_saja\'\\n).map((item) => item.id);\\n\\nexport const DEFAULT_LANTAI_1_CATALOG_IDS: string[] = USC_STANDARD_TEMPLATE.filter(\\n  (item) => item.floorRule === \'per_lantai\'\\n).map((item) => item.id);\\n\\nexport const DEFAULT_LANTAI_ATAS_CATALOG_IDS: string[] = USC_STANDARD_TEMPLATE.filter(\\n  (item) => item.floorRule === \'per_lantai\' || item.floorRule === \'atap_saja\'\\n).map((item) => item.id);\\n\\n/**\\n * Ambil salinan bersih Template Standar Global USC (Read-Only Deep Clone)\\n * Memastikan perubahan pada proyek pengguna tidak pernah mengubah template standar global.\\n */\\nexport function getGlobalUscTemplate(): CatalogWorkItem[] {\\n  return USC_STANDARD_TEMPLATE.map((item) => ({\\n    ...item,\\n    parameters: item.parameters.map((p) => ({\\n      ...p,\\n      value: null,\\n    })),\\n  }));\\n}\\n\\n/**\\n * Preferensi Sidebar Buka-Tutup (Desktop)\\n */\\nexport function loadSidebarCollapsed(): boolean {\\n  try {\\n    return localStorage.getItem(STORAGE_KEY_SIDEBAR_COLLAPSED) === \'true\';\\n  } catch {\\n    return false;\\n  }\\n}\\n\\nexport function saveSidebarCollapsed(collapsed: boolean): void {\\n  try {\\n    localStorage.setItem(STORAGE_KEY_SIDEBAR_COLLAPSED, collapsed ? \'true\' : \'false\');\\n  } catch {\\n    // ignore storage errors\\n  }\\n}\\n\\n/**\\n * Pengelolaan Katalog Bawaan yang Dinonaktifkan\\n */\\nexport function loadDisabledCatalogIds(): string[] {\\n  try {\\n    const raw = localStorage.getItem(STORAGE_KEY_DISABLED_CATALOG_IDS);\\n    if (!raw) return [];\\n    const parsed = JSON.parse(raw);\\n    return Array.isArray(parsed) ? parsed : [];\\n  } catch {\\n    return [];\\n  }\\n}\\n\\nexport function saveDisabledCatalogIds(ids: string[]): void {\\n  try {\\n    localStorage.setItem(STORAGE_KEY_DISABLED_CATALOG_IDS, JSON.stringify(ids));\\n  } catch (err) {\\n    console.error(\'Gagal menyimpan status katalog nonaktif:\', err);\\n  }\\n}\\n\\n/**\\n * Pengelolaan Katalog Pekerjaan Kustom\\n */\\nexport function loadCustomCatalogItems(): CatalogWorkItem[] {\\n  try {\\n    const raw = localStorage.getItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS);\\n    if (!raw) return [];\\n    const parsed: CatalogWorkItem[] = JSON.parse(raw);\\n    if (!Array.isArray(parsed)) return [];\\n    return parsed.map((item) => ({\\n      ...item,\\n      isCustomCatalog: true,\\n      calculationMethod: (params: Record<string, number>) => {\\n        if (item.customFormula) {\\n          const res = safeEvaluateMath(item.customFormula, params);\\n          return isNaN(res) || !isFinite(res) ? null : res;\\n        }\\n        const keys = Object.keys(params);\\n        if (keys.length === 0) return null;\\n        return keys.reduce((acc, k) => acc * params[k], 1);\\n      },\\n    }));\\n  } catch {\\n    return [];\\n  }\\n}\\n\\nexport function saveCustomCatalogItems(items: CatalogWorkItem[]): void {\\n  try {\\n    const serializable = items.map(({ calculationMethod, ...rest }) => ({\\n      ...rest,\\n      isCustomCatalog: true,\\n    }));\\n    localStorage.setItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS, JSON.stringify(serializable));\\n  } catch (err) {\\n    console.error(\'Gagal menyimpan katalog kustom:\', err);\\n  }\\n}\\n\\nexport function getAllCatalogItems(): CatalogWorkItem[] {\\n  return [...getGlobalUscTemplate(), ...loadCustomCatalogItems()];\\n}\\n\\n/**\\n * Buat pekerjaan proyek dari entri katalog untuk lantai tertentu\\n * Seluruh parameter di-clone secara independen dengan nilai awal null agar modifikasi pada satu proyek\\n * tidak pernah mengubah katalog global atau proyek lain.\\n */\\nexport function createProjectWorkFromCatalog(\\n  catalogId: string,\\n  floorId: string,\\n  initialParamValues: Record<string, number | null> = {},\\n  options?: {\\n    origin?: \'manual\' | \'ai\';\\n    aiVerificationStatus?: \'draft\' | \'verified\';\\n    sourceDocument?: string;\\n    identificationReason?: string;\\n    dedupKey?: string;\\n    elementLocation?: string;\\n    elementCode?: string;\\n    segments?: AIBeamSloofSegment[];\\n  }\\n): ProjectWorkItem | null {\\n  const allCatalog = getAllCatalogItems();\\n  const catalog = allCatalog.find((c) => c.id === catalogId);\\n  if (!catalog) return null;\\n\\n  const params: ParameterItem[] = catalog.parameters.map((p) => {\\n    const hasInitial =\\n      initialParamValues !== undefined &&\\n      Object.prototype.hasOwnProperty.call(initialParamValues, p.id) &&\\n      initialParamValues[p.id] !== null &&\\n      initialParamValues[p.id] !== undefined;\\n    const val = hasInitial ? initialParamValues[p.id] : null; // Selalu bernilai null jika belum diisi\\n    return {\\n      ...p,\\n      value: val,\\n      source: hasInitial ? (options?.origin === \'ai\' ? \'ai\' : \'manual\') : \'manual\',\\n      sourceDocument: hasInitial ? options?.sourceDocument : undefined,\\n      isVerified: hasInitial && options?.origin !== \'ai\' ? true : false,\\n      conflict: null,\\n    };\\n  });\\n\\n  const hasAnyFilledParam = params.some((p) => p.value !== null && p.value !== \'\');\\n\\n  const item: ProjectWorkItem = {\\n    id: `work-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,\\n    catalogId: catalog.id,\\n    dedupKey: options?.dedupKey || `${floorId}::${catalog.id}`,\\n    name: catalog.name,\\n    category: catalog.category,\\n    subCategory: catalog.subCategory,\\n    floorId,\\n    elementLocation: options?.elementLocation,\\n    elementCode: options?.elementCode,\\n    segments: options?.segments ? options.segments.map((s) => ({ ...s })) : undefined,\\n    unit: catalog.defaultUnit,\\n    formulaDisplay: catalog.formulaDisplay,\\n    customFormula: catalog.customFormula,\\n    parameters: params,\\n    components: [],\\n    calculatedVolume: null,\\n    status: options?.origin === \'ai\' ? \'Perlu Verifikasi\' : \'Belum Diisi\',\\n    origin: options?.origin || \'manual\',\\n    aiVerificationStatus:\\n      options?.origin === \'ai\'\\n        ? options?.aiVerificationStatus || \'draft\'\\n        : hasAnyFilledParam\\n        ? options?.aiVerificationStatus || \'verified\'\\n        : undefined,\\n    sourceDocument: options?.sourceDocument,\\n    identificationReason: options?.identificationReason,\\n    excelSheet: catalog.excelSheet,\\n    excelCell: catalog.excelCell,\\n    excelFormula: catalog.excelFormula,\\n    isActive: true,\\n    lastUpdated: new Date().toISOString(),\\n  };\\n\\n  return item;\\n}\\n\\n/**\\n * Buat daftar pekerjaan konstruksi standar lengkap dari Katalog Gedung USC untuk lantai tertentu\\n * Seluruh parameter bernilai null, volume bernilai null, dan status awal \\\"Belum Diisi\\\".\\n */\\nexport function createDefaultWorksForFloor(\\n  floorId: string,\\n  floorLevel: number,\\n  totalFloors: number = 2\\n): ProjectWorkItem[] {\\n  let catalogIds: string[];\\n  if (floorId === \'fl-umum\' || floorLevel === 0) {\\n    catalogIds = DEFAULT_UMUM_PONDASI_CATALOG_IDS;\\n  } else if (floorLevel === 1 && totalFloors > 1) {\\n    catalogIds = DEFAULT_LANTAI_1_CATALOG_IDS;\\n  } else {\\n    // Untuk Lantai 2, lantai atas lainnya, atau bangunan 1 lantai (mencakup pekerjaan per_lantai + atap)\\n    catalogIds = DEFAULT_LANTAI_ATAS_CATALOG_IDS;\\n  }\\n\\n  const works: ProjectWorkItem[] = [];\\n  for (const catId of catalogIds) {\\n    const work = createProjectWorkFromCatalog(catId, floorId, {}, {\\n      origin: \'manual\',\\n      dedupKey: `${floorId}::${catId}`,\\n    });\\n    if (work) {\\n      works.push(work);\\n    }\\n  }\\n  return works;\\n}\",\"StartLine\":11,\"TargetContent\":\"import { CATALOG_WORK_ITEMS, USC_CATALOG_VERSION } from \'../data/uscCatalog\';\\nimport {\\n  AIAutoTakeoffSummary,\\n  AIBeamSloofSegment,\\n  AIDetectedRegion,\\n  AIExtractionItem,\\n  CatalogWorkItem,\\n  FloorItem,\\n  ParameterItem,\\n  ProjectData,\\n  ProjectWorkItem,\\n} from \'../types\';\\nimport { recalculateAllProjectWorks, safeEvaluateMath } from \'./calculationEngine\';\\nimport {\\n  auth,\\n  db,\\n  doc,\\n  setDoc,\\n  getDocs,\\n  deleteDoc,\\n  collection,\\n  OperationType,\\n  handleFirestoreError,\\n} from \'../firebase\';\\n\\nconst LEGACY_STORAGE_KEY_PROJECTS = \'ruangrab_projects_v1\';\\nconst STORAGE_PREFIX_USER_PROJECTS = \'ruangrab_user_projects_v2_\';\\nconst STORAGE_PREFIX_ACTIVE_PROJECT = \'ruangrab_active_project_v2_\';\\nconst STORAGE_KEY_SIDEBAR_COLLAPSED = \'ruangrab_sidebar_collapsed_v1\';\\nconst STORAGE_KEY_DISABLED_CATALOG_IDS = \'ruangrab_disabled_catalog_ids_v1\';\\nconst STORAGE_KEY_CUSTOM_CATALOG_ITEMS = \'ruangrab_custom_catalog_items_v1\';\\n\\n/**\\n * Daftar ID Katalog Pekerjaan Standar Default per Kelompok Lantai\\n * (Hanya membawa nama, satuan, rumus, dan struktur parameter kosong \342\200\224 TANPA nilai dimensi proyek USC)\\n */\\nexport const DEFAULT_UMUM_PONDASI_CATALOG_IDS: string[] = [\\n  \'prep-pembersihan-lahan\',\\n  \'prep-pagar-sementara\',\\n  \'prep-bouwplank\',\\n  \'prep-gudang-alat\',\\n  \'str-galian-tanah-biasa-1m\',\\n  \'str-galian-pondasi-footplat\',\\n  \'str-urugan-kembali-tanah\',\\n  \'str-urugan-pasir-bawah-pondasi\',\\n  \'str-pasangan-batu-belah-1sp6pp\',\\n  \'str-pondasi-footplat-beton\',\\n  \'str-pondasi-footplat-tulangan\',\\n  \'str-pondasi-footplat-bekisting\',\\n  \'str-sloof-beton\',\\n  \'str-sloof-s2\',\\n  \'str-sloof-tulangan\',\\n  \'str-sloof-bekisting\',\\n  \'mep-septic-tank-biotank\',\\n];\\n\\nexport const DEFAULT_LANTAI_1_CATALOG_IDS: string[] = [\\n  \'str-kolom-k1-beton\',\\n  \'str-kolom-k2-beton\',\\n  \'str-kolom-praktis\',\\n  \'str-balok-induk\',\\n  \'str-balok-anak\',\\n  \'str-balok-b1-beton\',\\n  \'str-balok-b2-beton\',\\n  \'str-pelat-lantai-beton\',\\n  \'str-tangga-beton\',\\n  \'ars-dinding-bata-hebel\',\\n  \'ars-plesteran-acian-15mm\',\\n  \'ars-pengecatan-dinding-interior\',\\n  \'ars-homogenous-tile-60x60\',\\n  \'ars-keramik-toilet-antislip\',\\n  \'ars-plafond-gypsum\',\\n  \'ars-pintu-p1-lengkap\',\\n  \'ars-jendela-j1-lengkap\',\\n  \'mep-titik-lampu\',\\n  \'mep-stop-kontak\',\\n  \'mep-sanitasi-kran-air\',\\n  \'mep-pipa-pvc-air-bersih\',\\n];\\n\\nexport const DEFAULT_LANTAI_ATAS_CATALOG_IDS: string[] = [\\n  \'str-kolom-k1-beton\',\\n  \'str-kolom-k2-beton\',\\n  \'str-kolom-praktis\',\\n  \'str-balok-induk\',\\n  \'str-balok-anak\',\\n  \'str-balok-b1-beton\',\\n  \'str-balok-b2-beton\',\\n  \'str-ring-balok\',\\n  \'str-pelat-lantai-beton\',\\n  \'str-tangga-beton\',\\n  \'ars-dinding-bata-hebel\',\\n  \'ars-plesteran-acian-15mm\',\\n  \'ars-pengecatan-dinding-interior\',\\n  \'ars-homogenous-tile-60x60\',\\n  \'ars-keramik-toilet-antislip\',\\n  \'ars-plafond-gypsum\',\\n  \'ars-pintu-p1-lengkap\',\\n  \'ars-jendela-j1-lengkap\',\\n  \'mep-titik-lampu\',\\n  \'mep-stop-kontak\',\\n  \'mep-sanitasi-kran-air\',\\n  \'mep-pipa-pvc-air-bersih\',\\n];\\n\\n/**\\n * Preferensi Sidebar Buka-Tutup (Desktop)\\n */\\nexport function loadSidebarCollapsed(): boolean {\\n  try {\\n    return localStorage.getItem(STORAGE_KEY_SIDEBAR_COLLAPSED) === \'true\';\\n  } catch {\\n    return false;\\n  }\\n}\\n\\nexport function saveSidebarCollapsed(collapsed: boolean): void {\\n  try {\\n    localStorage.setItem(STORAGE_KEY_SIDEBAR_COLLAPSED, collapsed ? \'true\' : \'false\');\\n  } catch {\\n    // ignore storage errors\\n  }\\n}\\n\\n/**\\n * Pengelolaan Katalog Bawaan yang Dinonaktifkan\\n */\\nexport function loadDisabledCatalogIds(): string[] {\\n  try {\\n    const raw = localStorage.getItem(STORAGE_KEY_DISABLED_CATALOG_IDS);\\n    if (!raw) return [];\\n    const parsed = JSON.parse(raw);\\n    return Array.isArray(parsed) ? parsed : [];\\n  } catch {\\n    return [];\\n  }\\n}\\n\\nexport function saveDisabledCatalogIds(ids: string[]): void {\\n  try {\\n    localStorage.setItem(STORAGE_KEY_DISABLED_CATALOG_IDS, JSON.stringify(ids));\\n  } catch (err) {\\n    console.error(\'Gagal menyimpan status katalog nonaktif:\', err);\\n  }\\n}\\n\\n/**\\n * Pengelolaan Katalog Pekerjaan Kustom\\n */\\nexport function loadCustomCatalogItems(): CatalogWorkItem[] {\\n  try {\\n    const raw = localStorage.getItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS);\\n    if (!raw) return [];\\n    const parsed: CatalogWorkItem[] = JSON.parse(raw);\\n    if (!Array.isArray(parsed)) return [];\\n    return parsed.map((item) => ({\\n      ...item,\\n      isCustomCatalog: true,\\n      calculationMethod: (params: Record<string, number>) => {\\n        if (item.customFormula) {\\n          const res = safeEvaluateMath(item.customFormula, params);\\n          return isNaN(res) || !isFinite(res) ? null : res;\\n        }\\n        const keys = Object.keys(params);\\n        if (keys.length === 0) return null;\\n        return keys.reduce((acc, k) => acc * params[k], 1);\\n      },\\n    }));\\n  } catch {\\n    return [];\\n  }\\n}\\n\\nexport function saveCustomCatalogItems(items: CatalogWorkItem[]): void {\\n  try {\\n    const serializable = items.map(({ calculationMethod, ...rest }) => ({\\n      ...rest,\\n      isCustomCatalog: true,\\n    }));\\n    localStorage.setItem(STORAGE_KEY_CUSTOM_CATALOG_ITEMS, JSON.stringify(serializable));\\n  } catch (err) {\\n    console.error(\'Gagal menyimpan katalog kustom:\', err);\\n  }\\n}\\n\\nexport function getAllCatalogItems(): CatalogWorkItem[] {\\n  return [...CATALOG_WORK_ITEMS, ...loadCustomCatalogItems()];\\n}\\n\\n/**\\n * Buat pekerjaan proyek dari entri katalog untuk lantai tertentu\\n * Seluruh parameter di-clone secara independen agar modifikasi pada satu proyek tidak mengubah katalog global atau proyek lain.\\n */\\nexport function createProjectWorkFromCatalog(\\n  catalogId: string,\\n  floorId: string,\\n  initialParamValues: Record<string, number | null> = {},\\n  options?: {\\n    origin?: \'manual\' | \'ai\';\\n    aiVerificationStatus?: \'draft\' | \'verified\';\\n    sourceDocument?: string;\\n    identificationReason?: string;\\n    dedupKey?: string;\\n    elementLocation?: string;\\n    elementCode?: string;\\n    segments?: AIBeamSloofSegment[];\\n  }\\n): ProjectWorkItem | null {\\n  const allCatalog = getAllCatalogItems();\\n  const catalog = allCatalog.find((c) => c.id === catalogId);\\n  if (!catalog) return null;\\n\\n  const params: ParameterItem[] = catalog.parameters.map((p) => {\\n    const hasInitial = Object.prototype.hasOwnProperty.call(initialParamValues, p.id);\\n    const val = hasInitial ? initialParamValues[p.id] : null; // Selalu mulai dengan null (kosong) jika tidak diberikan\\n    return {\\n      ...p,\\n      value: val,\\n      source: hasInitial && val !== null ? (options?.origin === \'ai\' ? \'ai\' : \'manual\') : \'manual\',\\n      sourceDocument: hasInitial && val !== null ? options?.sourceDocument : undefined,\\n      isVerified: options?.origin === \'ai\' ? false : true,\\n      conflict: null,\\n    };\\n  });\\n\\n  const item: ProjectWorkItem = {\\n    id: `work-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,\\n    catalogId: catalog.id,\\n    dedupKey: options?.dedupKey || `${floorId}::${catalog.id}`,\\n    name: catalog.name,\\n    category: catalog.category,\\n    subCategory: catalog.subCategory,\\n    floorId,\\n    elementLocation: options?.elementLocation,\\n    elementCode: options?.elementCode,\\n    segments: options?.segments,\\n    unit: catalog.defaultUnit,\\n    formulaDisplay: catalog.formulaDisplay,\\n    customFormula: catalog.customFormula,\\n    parameters: params,\\n    components: [],\\n    calculatedVolume: null,\\n    status: options?.origin === \'ai\' ? \'Perlu Verifikasi\' : \'Belum Diisi\',\\n    origin: options?.origin || \'manual\',\\n    aiVerificationStatus: options?.aiVerificationStatus || \'verified\',\\n    sourceDocument: options?.sourceDocument,\\n    identificationReason: options?.identificationReason,\\n    excelSheet: catalog.excelSheet,\\n    excelCell: catalog.excelCell,\\n    excelFormula: catalog.excelFormula,\\n    isActive: true,\\n    lastUpdated: new Date().toISOString(),\\n  };\\n\\n  return item;\\n}\\n\\n/**\\n * Buat daftar pekerjaan konstruksi standar (template kosong tanpa dimensi/volume) untuk lantai tertentu\\n */\\nexport function createDefaultWorksForFloor(\\n  floorId: string,\\n  floorLevel: number\\n): ProjectWorkItem[] {\\n  const catalogIds =\\n    floorId === \'fl-umum\' || floorLevel === 0\\n      ? DEFAULT_UMUM_PONDASI_CATALOG_IDS\\n      : floorLevel === 1\\n      ? DEFAULT_LANTAI_1_CATALOG_IDS\\n      : DEFAULT_LANTAI_ATAS_CATALOG_IDS;\\n\\n  const works: ProjectWorkItem[] = [];\\n  for (const catId of catalogIds) {\\n    const work = createProjectWorkFromCatalog(catId, floorId, {}, {\\n      origin: \'manual\',\\n      aiVerificationStatus: \'verified\',\\n      dedupKey: `${floorId}::${catId}`,\\n    });\\n    if (work) {\\n      works.push(work);\\n    }\\n  }\\n  return works;\\n}\",\"TargetFile\":\"/src/services/projectStorage.ts\",\"toolAction\":\"Updating template generation in projectStorage.ts\",\"toolSummary\":\"Update template generation in projectStorage.ts\"}"
