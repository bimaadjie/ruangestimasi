            }
            lines {
              text: "    excelCell: \'U57\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excelFormula: \'=(I57+K57)*2*(M57/0.15)*O57*T57\',"
