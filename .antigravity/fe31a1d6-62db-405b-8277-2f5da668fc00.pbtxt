      thinking_signature: "\022\362\002\n\357\002\001i\024}\023k\242\t\v\206\v\350\276W\232\342\"|\266\365\256\321\236\225^\177x=\337\252\217\366\275\275\343\234\211\357\257\312\0376\263\341\247\264\222\251\316\353O\204\317\215\264\v\'\034\210\311\332-\035\a\213\016vn\265\002\026\317\223\333\357:\303A\177/D&\207\335\367\2629:I\372\3046H\3015\261\'\243_\353\272\273\212\222U\327\234c\275\310J\223\302\b\222\250\235\307\235:.0H\302L+\005\v\241\352^ \342\003\205\235\375\343T\b\311\331l\216\352rc\030jY\250zF\377\352\264Q\353\312r\354\264\272s\002\240\017\034\222\242\2018\232\251\201\006\262j\201zk!.\235)\361?K\233\037\260W\317@\312\264\313`\324/\327{I\243\212\261\223\303K\032m\301&\335\\\031]\356\017\033\030\352\331\261,\335\005\037:3\275\257\363\223\024\227R\0225\364\n\321 \231\351\315\323\017\315\2479/\213\220\226\312E\210+\343Q0\333$\263\340\374\217[\377\362\366\027Nk\372$\212\356\343\f=\324\337\344\t7\032\374\346\033\021\304\331\210\212\023\261N6\367\022\314\3554\247\027O\337\"\211\023\267F\006\000\266\020\362+Ln\236<,q\230\370\260\216Z\303%\311t0z I\206!\216\t\223(\255\373\306\271\017X\344\252q\373\362\351\236\372$r\253\353\300[1\201"
