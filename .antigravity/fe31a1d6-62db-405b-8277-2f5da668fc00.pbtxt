            lines {
              text: "      { id: \'tinggi_dinding\', name: \'tinggi_dinding\', label: \'Tinggi Dinding Luar\', placeholder: \'Masukkan tinggi dinding (m)\', value: null, unit: \'m\', required: true },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
