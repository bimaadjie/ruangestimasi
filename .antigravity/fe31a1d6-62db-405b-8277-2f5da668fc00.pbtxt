    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "  // Masukkan parameter hasil ekstraksi AI ke pekerjaan yang relevan\n  const handleApplyExtractedParameters = (\n    items: AIExtractionItem[],\n    targetFloorId: string\n  ) => {\n    let matchCount = 0;\n    const updatedWorks = [...activeProject.works];\n\n    for (const item of items) {\n      const finalVal =\n        item.userCorrection !== undefined ? Number(item.userCorrection) : Number(item.extractedValue);\n      if (isNaN(finalVal)) continue;\n\n      // Cari pekerjaan di lantai target yang sesuai\n      const targetWork = updatedWorks.find((w) => {\n        const matchFloor = w.floorId === targetFloorId || w.floorId === \'fl-umum\';\n        const matchName =\n          w.name.toLowerCase().includes(item.suggestedWorkName.toLowerCase()) ||\n          item.suggestedWorkName.toLowerCase().includes(w.name.toLowerCase());\n        return matchFloor && matchName;\n      });\n\n      if (targetWork) {\n        // Cari parameter yang sesuai\n        const param = targetWork.parameters.find(\n          (p) =>\n            p.name.toLowerCase().includes(item.parameterName.toLowerCase()) ||\n            item.parameterName.toLowerCase().includes(p.name.toLowerCase()) ||\n            (p.label && p.label.toLowerCase().includes(item.parameterName.toLowerCase()))\n        );\n\n        if (param) {\n          param.value = finalVal;\n          param.source = \'ai\';\n          param.notes = `Hasil bacaan AI dari file: ${item.sourceDocument}`;\n          matchCount++;\n        }\n      }\n    }\n\n    handleUpdateActiveProject({\n      ...activeProject,\n      works: updatedWorks,\n    });\n\n    showToast(`Berhasil memasukkan ${items.length} parameter AI ke kalkulator.`);\n  };"
        replacement_content: "  // Masukkan parameter hasil ekstraksi AI ke pekerjaan yang relevan\n  const handleApplyExtractedParameters = (\n    items: AIExtractionItem[],\n    targetFloorId: string\n  ) => {\n    let matchCount = 0;\n    const updatedWorks = [...activeProject.works];\n\n    for (const item of items) {\n      const finalVal =\n        item.userCorrection !== undefined ? Number(item.userCorrection) : Number(item.convertedValue);\n      if (isNaN(finalVal)) continue;\n\n      const pNameLower = item.parameterName.toLowerCase();\n      const sNameLower = item.suggestedWorkName.toLowerCase();\n\n      // Kasus 1: Dimensi Utama Bangunan (Panjang atau Lebar Total Gedung)\n      if (\n        sNameLower.includes(\'lebar\') ||\n        sNameLower.includes(\'panjang\') ||\n        sNameLower.includes(\'dimensi utama\') ||\n        item.targetCategory.toLowerCase().includes(\'dimensi utama\')\n      ) {\n        // Terapkan ke Pembersihan Lahan & Bouwplank di fl-umum\n        const prepWorks = updatedWorks.filter((w) => w.floorId === \'fl-umum\');\n        for (const w of prepWorks) {\n          for (const p of w.parameters) {\n            if (\n              (pNameLower.includes(\'lebar\') || sNameLower.includes(\'lebar\')) &&\n              p.id === \'lebar\'\n            ) {\n              p.value = finalVal;\n              p.source = \'ai\';\n              p.notes = `Hasil bacaan AI dari denah (${item.rawExtractedValue} ${item.rawUnit} -> ${finalVal} m)`;\n              matchCount++;\n            } else if (\n              (pNameLower.includes(\'panjang\') || sNameLower.includes(\'panjang\')) &&\n              p.id === \'panjang\'\n            ) {\n              p.value = finalVal;\n              p.source = \'ai\';\n              p.notes = `Hasil bacaan AI dari denah (${item.rawExtractedValue} ${item.rawUnit} -> ${finalVal} m)`;\n              matchCount++;\n            }\n          }\n        }\n\n        // Terapkan ke Pelat Lantai pada lantai target\n        const floorPlatWorks = updatedWorks.filter(\n          (w) => w.floorId === targetFloorId && w.id.includes(\'pelat\')\n        );\n        for (const w of floorPlatWorks) {\n          for (const p of w.parameters) {\n            if (\n              (pNameLower.includes(\'lebar\') || sNameLower.includes(\'lebar\')) &&\n              p.id === \'lebar_bangunan\'\n            ) {\n              p.value = finalVal;\n              p.source = \'ai\';\n              matchCount++;\n            } else if (\n              (pNameLower.includes(\'panjang\') || sNameLower.includes(\'panjang\')) &&\n              p.id === \'panjang_bangunan\'\n            ) {\n              p.value = finalVal;\n              p.source = \'ai\';\n              matchCount++;\n            }\n          }\n        }\n      }\n\n      // Kasus 2: Pekerjaan Spesifik di Lantai Target\n      const targetWork = updatedWorks.find((w) => {\n        const matchFloor = w.floorId === targetFloorId || w.floorId === \'fl-umum\';\n        const matchName =\n          w.name.toLowerCase().includes(sNameLower) ||\n          sNameLower.includes(w.name.toLowerCase()) ||\n          (sNameLower.includes(\'dinding\') && w.id.includes(\'dinding\')) ||\n          (sNameLower.includes(\'toilet\') && w.id.includes(\'toilet\')) ||\n          (sNameLower.includes(\'lantai\') && w.id.includes(\'tile\'));\n        return matchFloor && matchName;\n      });\n\n      if (targetWork) {\n        const param = targetWork.parameters.find(\n          (p) =>\n            p.name.toLowerCase().includes(pNameLower) ||\n            pNameLower.includes(p.name.toLowerCase()) ||\n            (p.label && p.label.toLowerCase().includes(pNameLower))\n        );\n\n        if (param) {\n          param.value = finalVal;\n          param.source = \'ai\';\n          param.notes = `AI dari ${item.sourceDocument} (${item.pageOrLocation || \'\'}): ${item.rawExtractedValue} ${item.rawUnit} -> ${finalVal} m`;\n          matchCount++;\n        }\n      }\n    }\n\n    handleUpdateActiveProject({\n      ...activeProject,\n      works: updatedWorks,\n    });\n\n    showToast(`Berhasil menerapkan ${items.length} parameter AI (${matchCount} parameter kalkulator diperbarui).`);\n  };"
        start_line: 260
        end_line: 308
      }
      num_matches: 1
    }
    description: "Update handleApplyExtractedParameters to use convertedValue and intelligent parameter mapping"
    diff_stats {
      additions: 71
      deletions: 10
    }
  }
